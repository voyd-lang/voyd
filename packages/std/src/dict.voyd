//! Hash-map style dictionary collection.
//!
//! Provides key/value storage with entry APIs, merge helpers, and iteration utilities.
//! Keys must implement `DictKey<K>` to supply hash and equality behavior.

use std::array::{ Array, new_array_unchecked }
use std::fixed_array::fns::{ new_fixed_array }
use std::math::{ MathError, mod_euclid, next_power_of_two }
use std::optional::types::all
use std::string::type::String
use std::subscript::SubscriptRead

/// Key behavior required by `Dict<K, V>`.
///
/// Implementors define stable hashing and equality for dictionary lookups.
pub trait DictKey<K>
  /// Returns a hash used to choose the key bucket.
  @isolated
  fn dict_hash(self): () -> i32

  /// Returns true when this key equals `other`.
  @isolated
  fn dict_eq(self, other: K): () -> bool

/// Entry handle for conditional dictionary updates.
///
/// Use this value with `or_insert`, `or_insert_with`, and `and_modify`.
pub obj DictEntry<K, V> {
  /// Dictionary being accessed by this entry handle.
  api dict: Dict<K, V>,
  /// Associated key for this entry.
  api key: K
}

/// Result of removing a value through a dictionary entry.
pub obj DictEntryRemove<K, V> {
  /// Dictionary after the removal.
  api dict: Dict<K, V>,
  /// Removed value, when the entry existed.
  api value: Optional<V>
}

/// Mutable dictionary with hash-bucket storage.
///
/// Stores values by key and preserves only one value per key.
pub obj Dict<K, V> {
  buckets: FixedArray<Array<DictPair<K, V>>>,
  count: i32
}

obj DictPair<K, V> {
  key: K,
  value: V
}

obj BucketDeleteResult<K, V> {
  bucket: Array<DictPair<K, V>>,
  deleted: bool
}

impl<K: DictKey<K>, V> Dict<K, V>
  /// Creates an empty dictionary.
  api fn init() -> Dict<K, V>
    Dict<K, V> { buckets: new_buckets<K, V>(16), count: 0 }

  /// Creates an empty dictionary sized for an expected entry count.
  ///
  /// Capacity is clamped to safe bounds and rounded up for bucket growth behavior.
  api fn with_capacity(
    /// Estimated number of entries to store.
    capacity: i32
  ) -> Dict<K, V>
    let bucket_count = bucket_count_for_capacity(capacity)
    Dict<K, V> { buckets: new_buckets<K, V>(bucket_count), count: 0 }

  /// Returns the number of stored elements.
  api fn len(self) -> i32
    self.count

  /// Returns true when no values are stored.
  api fn is_empty(self) -> bool
    self.count == 0

  /// Returns true when the dictionary currently stores `key`.
  api fn contains(
    self,
    /// Key to look up.
    key: K
  ) -> bool
    if self.count == 0:
      return false

    let bucket_count = __array_len(self.buckets)
    let bucket_index = bucket_index_for_key(bucket_count, key)
    let bucket = __array_get(self.buckets, bucket_index)
    find_entry_index_in_bucket(bucket, key) >= 0

  /// Returns the value for `key`, or `None` when absent.
  api fn get(
    self,
    /// Key to look up.
    key: K
  ) -> Optional<V>
    if self.count == 0:
      return None {}

    let bucket_count = __array_len(self.buckets)
    let bucket_index = bucket_index_for_key(bucket_count, key)
    let bucket = __array_get(self.buckets, bucket_index)
    let entry_index = find_entry_index_in_bucket(bucket, key)
    if entry_index < 0:
      return None {}

    let storage = bucket.raw_storage()
    let entry = __array_get(storage, entry_index)
    Some<V> { value: entry.value }

  /// Inserts or replaces the value for a key.
  api fn set(
    ~self,
    /// Key to insert or update.
    key: K,
    /// Value to store at `key`.
    value: V
  ) -> void
    let bucket_count = __array_len(self.buckets)
    let bucket_index = bucket_index_for_key(bucket_count, key)
    let bucket = __array_get(self.buckets, bucket_index)
    let bucket_storage = bucket.storage
    let bucket_len = bucket.count
    let entry_index = self.find_entry_index(bucket_index, key)
    let inserted = entry_index < 0
    let next_count = if inserted then: bucket_len + 1 else: bucket_len
    let next_storage = new_fixed_array<DictPair<K, V>>(next_count)
    __array_copy(next_storage, {
      from: bucket_storage,
      to_index: 0,
      from_index: 0,
      count: bucket_len
    })
    let write_index = if inserted then: bucket_len else: entry_index
    __array_set(
      next_storage,
      write_index,
      DictPair<K, V> { key, value }
    )
    let next_bucket = new_array_unchecked<DictPair<K, V>>({ from: next_storage })
    __array_set(self.buckets, bucket_index, next_bucket)
    if inserted:
      self.count = self.count + 1
      if should_grow(self.count, bucket_count):
        rehash_owned(~self, bucket_count * 2)

  fn find_entry_index(self, bucket_index: i32, key: K) -> i32
    let bucket = __array_get(self.buckets, bucket_index)
    let storage = bucket.storage
    var index = 0
    while index < bucket.count:
      let entry = __array_get(storage, index)
      if key_equals(entry.key, key):
        return index
      index = index + 1
    -1

  /// Returns a dictionary with `key` inserted or updated.
  api fn setting(self, key: K, value: V) -> Dict<K, V>
    self.with_set(key, value)

  /// Returns a dictionary without `key`.
  api fn removing(self, key: K) -> Dict<K, V>
    self.with_deleted(key)

  /// Returns an independently mutable copy of this dictionary.
  api fn copied(self) -> Dict<K, V>
    Dict<K, V> {
      buckets: copy_buckets(self.buckets),
      count: self.count
    }

  /// Removes all stored values.
  api fn clear(~self) -> void
    if self.count == 0:
      return void

    let bucket_count = __array_len(self.buckets)
    self.buckets = new_buckets<K, V>(bucket_count)
    self.count = 0

  /// Returns all dictionary keys.
  api fn keys(self) -> Array<K>
    if self.count == 0:
      return Array<K>::with_capacity(0)

    let ~out = Array<K>::with_capacity(self.count)
    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        out.push(entry.key)
        index = index + 1
      bucket_index = bucket_index + 1
    out

  /// Returns dictionary values.
  api fn values(self) -> Array<V>
    if self.count == 0:
      return Array<V>::with_capacity(0)

    let ~out = Array<V>::with_capacity(self.count)
    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        out.push(entry.value)
        index = index + 1
      bucket_index = bucket_index + 1
    out

  /// Returns dictionary entries as key-value tuples.
  api fn entries(self) -> Array<(K, V)>
    if self.count == 0:
      return Array<(K, V)>::with_capacity(0)

    let ~out = Array<(K, V)>::with_capacity(self.count)
    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        out.push((entry.key, entry.value))
        index = index + 1
      bucket_index = bucket_index + 1
    out

  /// Invokes a callback for each element.
  api fn each(self, f: (key: K, value: V) -> void) -> void
    if self.count == 0:
      return void

    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        f(entry.key, entry.value)
        index = index + 1
      bucket_index = bucket_index + 1

  /// Returns a new dictionary containing entries from both inputs.
  api fn merged(self, other: Dict<K, V>) -> Dict<K, V>
    self.merged(
      other,
      (_key: K, _left: V, right: V) -> V => right
    )

  /// Returns a new dictionary containing entries from both inputs.
  ///
  /// If a key appears in both dictionaries, `resolve` chooses the output value.
  api fn merged(
    self,
    /// Dictionary whose entries are merged into `self`.
    other: Dict<K, V>,
    /// Conflict resolver receiving key, existing value, and incoming value.
    resolve: (key: K, left: V, right: V) : () -> V
  ) -> Dict<K, V>
    if other.count == 0:
      return self

    let max_count =
      if self.count > 2147483647 - other.count
        then: 2147483647
        else: self.count + other.count
    let output_bucket_count = bucket_count_for_capacity(max_count)
    let ~output_buckets = new_fixed_array<Array<DictPair<K, V>>>(output_bucket_count)
    initialize_buckets(~output_buckets)
    var output = Dict<K, V> { buckets: output_buckets, count: 0 }

    let self_bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < self_bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        output = output.with_set(entry.key, entry.value)
        index = index + 1
      bucket_index = bucket_index + 1

    let other_bucket_count = __array_len(other.buckets)
    bucket_index = 0
    while bucket_index < other_bucket_count:
      let bucket = __array_get(other.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        match(output.get(entry.key))
          Some<V> { value: left }:
            let next_value = resolve(entry.key, left, entry.value)
            output = output.with_set(entry.key, next_value)
          None:
            output = output.with_set(entry.key, entry.value)
        index = index + 1
      bucket_index = bucket_index + 1
    output

  /// Transforms each value and keeps the original keys.
  api fn map<U>(self, f: (key: K, value: V) -> U) -> Dict<K, U>
    if self.count == 0:
      return Dict<K, U>::init()

    let output_bucket_count = bucket_count_for_capacity(self.count)
    let ~output_buckets = new_fixed_array<Array<DictPair<K, U>>>(output_bucket_count)
    initialize_buckets(~output_buckets)
    var output = Dict<K, U> { buckets: output_buckets, count: 0 }
    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        let next_value = f(entry.key, entry.value)
        output = output.with_set(entry.key, next_value)
        index = index + 1
      bucket_index = bucket_index + 1
    output

  /// Returns a collection containing only values that satisfy the predicate.
  api fn filter(self, pred: (key: K, value: V) -> bool) -> Dict<K, V>
    if self.count == 0:
      return self

    let output_bucket_count = bucket_count_for_capacity(self.count)
    let ~output_buckets = new_fixed_array<Array<DictPair<K, V>>>(output_bucket_count)
    initialize_buckets(~output_buckets)
    var output = Dict<K, V> { buckets: output_buckets, count: 0 }
    let bucket_count = __array_len(self.buckets)
    var bucket_index = 0
    while bucket_index < bucket_count:
      let bucket = __array_get(self.buckets, bucket_index)
      let storage = bucket.raw_storage()
      let len = bucket.len()
      var index = 0
      while index < len:
        let entry = __array_get(storage, index)
        if pred(entry.key, entry.value):
          output = output.with_set(entry.key, entry.value)
        index = index + 1
      bucket_index = bucket_index + 1
    output

  /// Returns an entry handle for in-place updates on a specific key.
  api fn entry(self, key: K) -> DictEntry<K, V>
    DictEntry<K, V> { dict: self, key: key }

  fn with_set(self, key: K, value: V) -> Dict<K, V>
    let bucket_count = __array_len(self.buckets)
    let bucket_index = bucket_index_for_key(bucket_count, key)
    let bucket = __array_get(self.buckets, bucket_index)
    let bucket_storage = bucket.storage
    let bucket_len = bucket.count
    var entry_index = -1
    var index = 0
    while index < bucket_len:
      let candidate = __array_get(bucket_storage, index)
      if key_equals(candidate.key, key):
        entry_index = index
        break
      index = index + 1
    let inserted = entry_index < 0
    let next_bucket_count = if inserted then: bucket_len + 1 else: bucket_len
    let next_bucket_storage = new_fixed_array<DictPair<K, V>>(next_bucket_count)
    __array_copy(next_bucket_storage, {
      from: bucket_storage,
      to_index: 0,
      from_index: 0,
      count: bucket_len
    })
    let write_index = if inserted then: bucket_len else: entry_index
    __array_set(
      next_bucket_storage,
      write_index,
      DictPair<K, V> { key, value }
    )
    let ~next_buckets = new_fixed_array<Array<DictPair<K, V>>>(bucket_count)
    __array_copy(next_buckets, {
      from: self.buckets,
      to_index: 0,
      from_index: 0,
      count: bucket_count
    })
    let next_bucket = new_array_unchecked<DictPair<K, V>>({
      from: next_bucket_storage
    })
    __array_set(next_buckets, bucket_index, next_bucket)
    Dict<K, V> {
      buckets: next_buckets,
      count: if inserted then: self.count + 1 else: self.count
    }

  fn with_deleted(self, key: K) -> Dict<K, V>
    let bucket_count = __array_len(self.buckets)
    let bucket_index = bucket_index_for_key(bucket_count, key)
    let bucket = __array_get(self.buckets, bucket_index)
    let result = delete_from_bucket(bucket, key)
    let ~next_buckets = new_fixed_array<Array<DictPair<K, V>>>(bucket_count)
    __array_copy(next_buckets, {
      from: self.buckets,
      to_index: 0,
      from_index: 0,
      count: bucket_count
    })
    if result.deleted:
      __array_set(next_buckets, bucket_index, result.bucket)
      return Dict<K, V> { buckets: next_buckets, count: self.count - 1 }
    Dict<K, V> { buckets: next_buckets, count: self.count }

impl<K: DictKey<K>, V> DictEntry<K, V>
  /// Inserts the default value when the entry is vacant and returns the dictionary.
  api fn or_insert(self, default: V) -> Dict<K, V>
    if self.dict.contains(self.key):
      return self.dict

    self.dict.with_set(self.key, default)

  /// Lazily inserts a computed value when the entry is vacant and returns the dictionary.
  api fn or_insert_with(self, make: () -> V) -> Dict<K, V>
    if self.dict.contains(self.key):
      return self.dict

    self.dict.with_set(self.key, make())

  /// Applies a modifier function to the value when the entry already exists.
  api fn and_modify(self, f: (value: V) -> V) -> DictEntry<K, V>
    let next =
      match(self.dict.get(self.key))
        Some<V> { value }:
          self.dict.with_set(self.key, f(value))
        None:
          self.dict
    DictEntry<K, V> { dict: next, key: self.key }

  /// Removes the entry and returns the updated dictionary and previous value.
  api fn remove(self) -> DictEntryRemove<K, V>
    DictEntryRemove<K, V> {
      dict: self.dict.with_deleted(self.key),
      value: self.dict.get(self.key)
    }

impl<K: DictKey<K>, V> SubscriptRead<K, Optional<V>> for Dict<K, V>
  /// Returns the value addressed by subscript syntax.
  api fn subscript_get(self, key: K) -> Optional<V>
    self.get(key)

impl<T> Array<T>
  /// Groups sequence values by key and returns grouped arrays.
  api fn group_by<K: DictKey<K>>(self, f: (value: T) -> K) -> Dict<K, Array<T>>
    let output_bucket_count = bucket_count_for_capacity(self.len())
    let ~output_buckets = new_fixed_array<Array<DictPair<K, Array<T>>>>(output_bucket_count)
    initialize_buckets(~output_buckets)
    var output = Dict<K, Array<T>> { buckets: output_buckets, count: 0 }
    var index = 0
    while index < self.len():
      match(self.get(index))
        Some<T> { value }:
          let group_key = f(value)
          match(output.get(group_key))
            Some<Array<T>> { value: existing }:
              let next = existing.pushed(value)
              output = output.with_set(group_key, next)
            None:
              let next = Array<T>::with_capacity(1).pushed(value)
              output = output.with_set(group_key, next)
        None:
          void
      index = index + 1
    output

impl DictKey<String> for String
  /// Returns the hash code used for dictionary key bucketing.
  api fn dict_hash(self) -> i32
    self.hash_i32()

  /// Compares this key with another key for dictionary equality.
  api fn dict_eq(self, other: String) -> bool
    self == other

fn bucket_count_for_capacity(capacity: i32) -> i32
  let target = if capacity > 0 then: capacity else: 0
  let min_bucket_count = 16
  let max_initial_bucket_count = 65536
  let grown_target = if target > 1073741823 then: 2147483647 else: target * 2
  let desired_bucket_count = next_power_of_two_or_limit(grown_target, max_initial_bucket_count)
  if desired_bucket_count > min_bucket_count
    then: desired_bucket_count
    else: min_bucket_count

fn new_buckets<K, V>(bucket_count: i32) -> FixedArray<Array<DictPair<K, V>>>
  let safe_bucket_count = if bucket_count > 0 then: bucket_count else: 1
  let buckets = new_fixed_array<Array<DictPair<K, V>>>(safe_bucket_count)
  var index = 0
  while index < safe_bucket_count:
    __array_set(buckets, index, Array<DictPair<K, V>>::init())
    index = index + 1
  buckets

fn initialize_buckets<K, V>(
  ~buckets: FixedArray<Array<DictPair<K, V>>>
) -> void
  let bucket_count = __array_len(buckets)
  var index = 0
  while index < bucket_count:
    __array_set(buckets, index, Array<DictPair<K, V>>::init())
    index = index + 1

fn copy_buckets<K, V>(
  source: FixedArray<Array<DictPair<K, V>>>
) -> FixedArray<Array<DictPair<K, V>>>
  let length = __array_len(source)
  let copy = new_fixed_array<Array<DictPair<K, V>>>(length)
  __array_copy(copy, {
    from: source,
    to_index: 0,
    from_index: 0,
    count: length
  })
  copy

fn should_grow(count: i32, bucket_count: i32) -> bool
  if bucket_count <= 0:
    return true
  (count * 4) > (bucket_count * 3)

fn rehash_owned<K: DictKey<K>, V>(
  ~dict: Dict<K, V>,
  bucket_count: i32
) -> void
  let next_bucket_count = if bucket_count > 0 then: bucket_count else: 1
  let ~next_buckets = new_fixed_array<Array<DictPair<K, V>>>(next_bucket_count)
  initialize_buckets(~next_buckets)

  let previous_bucket_count = __array_len(dict.buckets)
  var bucket_index = 0
  while bucket_index < previous_bucket_count:
    let bucket = __array_get(dict.buckets, bucket_index)
    let source_storage = bucket.storage
    var source_index = 0
    while source_index < bucket.count:
      let next_bucket_index = bucket_index_for_stored_entry(
        dict,
        next_bucket_count,
        bucket_index,
        source_index
      )
      let entry = __array_get(source_storage, source_index)
      let next_bucket = __array_get(next_buckets, next_bucket_index)
      let next_count = next_bucket.count + 1
      let next_storage = new_fixed_array<DictPair<K, V>>(next_count)
      __array_copy(next_storage, {
        from: next_bucket.storage,
        to_index: 0,
        from_index: 0,
        count: next_bucket.count
      })
      __array_set(next_storage, next_bucket.count, entry)
      let copied_bucket = new_array_unchecked<DictPair<K, V>>({ from: next_storage })
      __array_set(next_buckets, next_bucket_index, copied_bucket)
      source_index = source_index + 1
    bucket_index = bucket_index + 1

  dict.buckets = next_buckets

fn bucket_index_for_stored_entry<K: DictKey<K>, V>(
  dict: Dict<K, V>,
  bucket_count: i32,
  bucket_index: i32,
  entry_index: i32
) -> i32
  let bucket = __array_get(dict.buckets, bucket_index)
  let entry = __array_get(bucket.storage, entry_index)
  bucket_index_for_key(bucket_count, entry.key)

fn find_entry_index_in_bucket<K: DictKey<K>, V>(bucket: Array<DictPair<K, V>>, key: K) -> i32
  let storage = bucket.raw_storage()
  let len = bucket.len()
  var index = 0
  while index < len:
    let entry = __array_get(storage, index)
    if key_equals(entry.key, key):
      return index
    index = index + 1
  -1

fn delete_from_bucket<K: DictKey<K>, V>(bucket: Array<DictPair<K, V>>, key: K) -> BucketDeleteResult<K, V>
  let index = find_entry_index_in_bucket(bucket, key)
  if index < 0:
    return BucketDeleteResult<K, V> { bucket: bucket, deleted: false }

  let next_count = bucket.count - 1
  let next_storage = new_fixed_array<DictPair<K, V>>(next_count)
  __array_copy(next_storage, {
    from: bucket.storage,
    to_index: 0,
    from_index: 0,
    count: index
  })
  __array_copy(next_storage, {
    from: bucket.storage,
    to_index: index,
    from_index: index + 1,
    count: next_count - index
  })
  let next_bucket = new_array_unchecked<DictPair<K, V>>({ from: next_storage })
  BucketDeleteResult<K, V> { bucket: next_bucket, deleted: true }

fn bucket_index_for_key<K: DictKey<K>>(bucket_count: i32, key: K) -> i32
  let safe_bucket_count = if bucket_count > 0 then: bucket_count else: 1
  mod_euclid_or_zero(hash_key(key), safe_bucket_count)

fn key_equals<K: DictKey<K>>(left: K, right: K) -> bool
  left.dict_eq(right)

fn hash_key<K: DictKey<K>>(key: K) -> i32
  key.dict_hash()

fn mod_euclid_or_zero(value: i32, modulus: i32) -> i32
  match(mod_euclid(value, modulus))
    Ok<i32> { value }:
      value
    Err<MathError>:
      0

fn next_power_of_two_or_limit(value: i32, limit: i32) -> i32
  let safe_limit = if limit > 0 then: limit else: 1
  match(next_power_of_two(value))
    Ok<i32> { value: next }:
      if next > safe_limit then: safe_limit else: next
    Err<MathError>:
      safe_limit
