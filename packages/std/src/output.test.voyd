use std::array::Array
use std::bytes::{ ByteBuffer, Bytes }
use std::error::IoError
use std::optional::types::all
use std::result::types::all
use std::string::type::{ String, StringSlice }
use std::test::assertions::all

obj StringOutputCapture {
  values: Array<String>,
  targets: Array<String>
}

obj ByteOutputCapture {
  values: Array<i32>,
  targets: Array<String>
}

test "output write defaults to stdout":
  let ~capture = StringOutputCapture {
    values: Array<String>::init(),
    targets: Array<String>::init()
  }
  let result = write_with_capture(capture)

  match(result)
    Ok<Unit>:
      assert(optional_string_or(capture.values.get(0), "missing".as_slice()).equals("hello"), eq: true)
      assert(optional_string_or(capture.targets.get(0), "missing".as_slice()).equals("stdout"), eq: true)
    Err<IoError>:
      assert(false, eq: true)

test "output write encodes stderr target":
  let ~targets = Array<String>::init()
  let result = write_stderr_with_capture(targets)

  match(result)
    Ok<Unit>:
      assert(optional_string_or(targets.get(0), "missing".as_slice()).equals("stderr"), eq: true)
    Err<IoError>:
      assert(false, eq: true)

test "output write_line appends exactly newline":
  let ~capture = StringOutputCapture {
    values: Array<String>::init(),
    targets: Array<String>::init()
  }
  let result = write_line_with_capture(capture)

  match(result)
    Ok<Unit>:
      assert(optional_string_or(capture.targets.get(0), "missing".as_slice()).equals("stdout"), eq: true)
      assert(capture.targets.len(), eq: 1)
      assert(capture.values.len(), eq: 1)
      let line = optional_string_or(capture.values.get(0), "missing".as_slice())
      let bytes = line.to_utf8()
      assert(optional_i32_or(bytes.get(0), -1), eq: 104)
      assert(optional_i32_or(bytes.get(1), -1), eq: 105)
      assert(optional_i32_or(bytes.get(2), -1), eq: 10)
    Err<IoError>:
      assert(false, eq: true)

test "output print appends exactly newline and ignores result":
  let ~capture = StringOutputCapture {
    values: Array<String>::init(),
    targets: Array<String>::init()
  }
  print_with_capture(capture)

  assert(optional_string_or(capture.targets.get(0), "missing".as_slice()).equals("stdout"), eq: true)
  assert(capture.targets.len(), eq: 1)
  assert(capture.values.len(), eq: 1)
  let line = optional_string_or(capture.values.get(0), "missing".as_slice())
  let bytes = line.to_utf8()
  assert(optional_i32_or(bytes.get(0), -1), eq: 104)
  assert(optional_i32_or(bytes.get(1), -1), eq: 105)
  assert(optional_i32_or(bytes.get(2), -1), eq: 10)

test "output write(Bytes) encodes stderr target":
  let ~capture = ByteOutputCapture {
    values: Array<i32>::init(),
    targets: Array<String>::init()
  }
  let result = write_byte_payload_with_capture(capture)

  match(result)
    Ok<Unit>:
      assert(optional_string_or(capture.targets.get(0), "missing".as_slice()).equals("stderr"), eq: true)
      assert(optional_i32_or(capture.values.get(0), -1), eq: 7)
      assert(optional_i32_or(capture.values.get(1), -1), eq: 8)
    Err<IoError>:
      assert(false, eq: true)

test "output flush defaults to stdout":
  let ~targets = Array<String>::init()
  let result = flush_with_capture(targets)

  match(result)
    Ok<Unit>:
      assert(optional_string_or(targets.get(0), "missing".as_slice()).equals("stdout"), eq: true)
    Err<IoError>:
      assert(false, eq: true)

test "output is_tty forwards host bool with selected target":
  let ~targets = Array<String>::init()
  let stdout_tty = is_tty_with_stdout_payload(value: true, targets: targets)
  let stderr_tty = is_tty_with_stderr_payload(value: false, targets: targets)

  assert(stdout_tty, eq: true)
  assert(stderr_tty, eq: false)
  assert(optional_string_or(targets.get(0), "missing".as_slice()).equals("stdout"), eq: true)
  assert(optional_string_or(targets.get(1), "missing".as_slice()).equals("stderr"), eq: true)

test "output write decodes host errors":
  let result = write_with_payload(output_error(code: 32, message: "broken pipe"))

  match(result)
    Err<IoError> { error }:
      assert(error.code, eq: 32)
      assert(error.message.equals("broken pipe"), eq: true)
    Ok<Unit>:
      assert(false, eq: true)

fn write_with_capture(~capture: StringOutputCapture): () -> Result<Unit, IoError>
  try
    write("hello".as_slice().to_string())
  Output::write_op(tail, payload):
    capture.values.push(payload.value)
    capture.targets.push(payload.target)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_stderr_with_capture(~targets: Array<String>): () -> Result<Unit, IoError>
  try
    write("warn".as_slice().to_string(), StdErr {})
  Output::write_op(tail, payload):
    targets.push(payload.target)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_line_with_capture(~capture: StringOutputCapture): () -> Result<Unit, IoError>
  try
    write_line("hi".as_slice().to_string())
  Output::write_op(tail, payload):
    capture.targets.push(payload.target)
    capture.values.push(payload.value)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn print_with_capture(~capture: StringOutputCapture): () -> void
  try
    print("hi".as_slice().to_string())
  Output::write_op(tail, payload):
    capture.targets.push(payload.target)
    capture.values.push(payload.value)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_byte_payload_with_capture(~capture: ByteOutputCapture): () -> Result<Unit, IoError>
  let ~buffer = ByteBuffer::with_capacity(2)
  buffer.push(7)
  buffer.push(8)

  try
    write(buffer.as_bytes(), StdErr {})
  Output::write_bytes_op(tail, payload):
    capture.targets.push(payload.target)
    decode_bytes_into(payload.bytes, capture.values)
    tail(output_ok())
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn flush_with_capture(~targets: Array<String>): () -> Result<Unit, IoError>
  try
    flush()
  Output::flush_op(tail, payload):
    targets.push(payload.target)
    tail(output_ok())
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn is_tty_with_stdout_payload({ value: bool, ~targets: Array<String> }): () -> bool
  try
    is_tty()
  Output::is_tty_op(tail, payload):
    targets.push(payload.target)
    tail(value)
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))

fn is_tty_with_stderr_payload({ value: bool, ~targets: Array<String> }): () -> bool
  try
    is_tty(StdErr {})
  Output::is_tty_op(tail, payload):
    targets.push(payload.target)
    tail(value)
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))

fn write_with_payload(payload: OutputResult): () -> Result<Unit, IoError>
  try
    write("hello".as_slice().to_string())
  Output::write_op(tail, _payload):
    tail(payload)
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn decode_bytes_into(payload: Bytes, ~values: Array<i32>) -> void
  let source = payload.to_array()
  var index = 0
  while index < source.len():
    match(source.get(index))
      Some<i32> { value }:
        values.push(value)
      None:
        void
    index = index + 1

fn optional_string_or(value: Option<String>, fallback: StringSlice): () -> String
  match(value)
    Some<String> { value: present }:
      present
    None:
      fallback.to_string()

fn optional_i32_or(value: Option<i32>, fallback: i32): () -> i32
  match(value)
    Some<i32> { value: present }:
      present
    None:
      fallback

fn output_ok() -> OutputResult
  OutputResult { ok: true, code: 0, message: "" }

fn output_error({ code: i32, message: String }) -> OutputResult
  OutputResult { ok: false, code: code, message: message }
