use std::bytes::ByteBuffer
use std::error::IoError
use std::result::types::all
use std::string::type::String
use std::test::assertions::all

test "output write defaults to stdout":
  let result = write_with_assertions()

  match(result)
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "output write encodes stderr target":
  let result = write_stderr_with_assertions()

  match(result)
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "output write_line appends exactly newline":
  let result = write_line_with_assertions()

  match(result)
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "output print appends exactly newline and ignores result":
  print_with_assertions()

test "output write(Bytes) encodes stderr target":
  let result = write_byte_payload_with_assertions()

  match(result)
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "output flush defaults to stdout":
  let result = flush_with_assertions()

  match(result)
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "output is_tty forwards host bool with selected target":
  let stdout_tty = is_tty_with_stdout_payload(true)
  let stderr_tty = is_tty_with_stderr_payload(false)

  assert(stdout_tty, eq: true)
  assert(stderr_tty, eq: false)

test "output write decodes host errors":
  let result = write_with_payload(output_error(code: 32, message: "broken pipe"))

  match(result)
    Err<IoError> { error }:
      assert(error.code, eq: 32)
      assert(error.message.equals("broken pipe"), eq: true)
    Ok<Unit>:
      assert(false, eq: true)

fn write_with_assertions(): Test -> Result<Unit, IoError>
  try
    write("hello".as_slice().to_string())
  Output::write_op(tail, payload):
    assert(payload.value.equals("hello"), eq: true)
    assert(payload.target.equals("stdout"), eq: true)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_stderr_with_assertions(): Test -> Result<Unit, IoError>
  try
    write("warn".as_slice().to_string(), StdErr {})
  Output::write_op(tail, payload):
    assert(payload.target.equals("stderr"), eq: true)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_line_with_assertions(): Test -> Result<Unit, IoError>
  try
    write_line("hi".as_slice().to_string())
  Output::write_op(tail, payload):
    assert(payload.target.equals("stdout"), eq: true)
    let bytes = payload.value.to_utf8()
    assert(bytes.len(), eq: 3)
    assert(bytes.at(0), eq: 104)
    assert(bytes.at(1), eq: 105)
    assert(bytes.at(2), eq: 10)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn print_with_assertions(): Test -> void
  try
    print("hi".as_slice().to_string())
  Output::write_op(tail, payload):
    assert(payload.target.equals("stdout"), eq: true)
    let bytes = payload.value.to_utf8()
    assert(bytes.len(), eq: 3)
    assert(bytes.at(0), eq: 104)
    assert(bytes.at(1), eq: 105)
    assert(bytes.at(2), eq: 10)
    tail(output_ok())
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn write_byte_payload_with_assertions(): Test -> Result<Unit, IoError>
  let ~buffer = ByteBuffer::with_capacity(2)
  buffer.push(7)
  buffer.push(8)

  try
    write(buffer.as_bytes(), StdErr {})
  Output::write_bytes_op(tail, payload):
    assert(payload.target.equals("stderr"), eq: true)
    assert(payload.bytes.len(), eq: 2)
    assert(payload.bytes.at(0), eq: 7)
    assert(payload.bytes.at(1), eq: 8)
    tail(output_ok())
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn flush_with_assertions(): Test -> Result<Unit, IoError>
  try
    flush()
  Output::flush_op(tail, payload):
    assert(payload.target.equals("stdout"), eq: true)
    tail(output_ok())
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn is_tty_with_stdout_payload(value: bool): Test -> bool
  try
    is_tty()
  Output::is_tty_op(tail, payload):
    assert(payload.target.equals("stdout"), eq: true)
    tail(value)
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))

fn is_tty_with_stderr_payload(value: bool): Test -> bool
  try
    is_tty(StdErr {})
  Output::is_tty_op(tail, payload):
    assert(payload.target.equals("stderr"), eq: true)
    tail(value)
  Output::write_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))

fn write_with_payload(payload: OutputResult): () -> Result<Unit, IoError>
  try
    write("hello".as_slice().to_string())
  Output::write_op(tail, _payload):
    tail(payload)
  Output::write_bytes_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::flush_op(tail, _payload):
    tail(output_error(code: 1, message: "unexpected"))
  Output::is_tty_op(tail, _payload):
    tail(false)

fn output_ok() -> OutputResult
  OutputResult { ok: true, code: 0, message: "" }

fn output_error({ code: i32, message: String }) -> OutputResult
  OutputResult { ok: false, code: code, message: message }
