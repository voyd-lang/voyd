//! Private provider-neutral VX renderer wire helpers.

use std::array::Array
use std::data::{
  DataArray,
  DataBool,
  DataF64,
  DataField,
  DataI32,
  DataI64,
  DataNull,
  DataObject,
  DataString,
  DataValue,
  DataVariant
}
use std::dict::{ Dict, DictKey }
use std::optional::types::all
use std::result::types::all
use std::string::type::{ String, StringSlice }

pub obj WireMap { values: Dict<String, DataValue> }
pub obj WireError {}

impl WireMap
  pub fn init() -> WireMap
    WireMap { values: Dict<String, DataValue>::init() }

  api fn len(self) -> i32
    self.values.len()

  api fn get(self, name: String) -> Optional<DataValue>
    self.values.get(name)

  api fn set(~self, name: String, value: DataValue) -> void
    self.values.set(name, value)

  api fn set(~self, name: String, value: String) -> void
    self.values.set(name, make_string(value))

  api fn set(~self, name: String, value: Array<DataValue>) -> void
    self.values.set(name, make_array(value))

  api fn setting(self, name: String, value: DataValue) -> WireMap
    WireMap { values: self.values.setting(name, value) }

  api fn setting(self, name: String, value: String) -> WireMap
    self.setting(name, make_string(value))

pub fn make_null() -> DataValue
  DataNull {}

pub fn make_bool(value: bool) -> DataValue
  DataBool { value }

pub fn make_i32(value: i32) -> DataValue
  DataI32 { value }

pub fn make_i64(value: i64) -> DataValue
  DataI64 { value }

pub fn make_f64(value: f64) -> DataValue
  DataF64 { value }

pub fn make_string(value: String) -> DataValue
  DataString { value }

pub fn make_string(value: StringSlice) -> DataValue
  make_string(value.to_string())

pub fn make_array(values: Array<DataValue>) -> DataValue
  DataArray { values }

pub fn make_map(values: WireMap) -> DataValue
  DataObject { fields: fields_from(values) }

pub fn from_data_value(value: DataValue) -> DataValue
  value

pub fn to_data_value(value: DataValue) -> DataValue
  value

pub fn unpack_array(value: DataValue) -> Result<Array<DataValue>, WireError>
  value.match(active)
    DataArray:
      Ok<Array<DataValue>> { value: active.values }
    else:
      Err<WireError> { error: WireError {} }

pub fn unpack_i32(value: DataValue) -> Result<i32, WireError>
  value.match(active)
    DataI32:
      Ok<i32> { value: active.value }
    else:
      Err<WireError> { error: WireError {} }

pub fn unpack_string(value: DataValue) -> Result<String, WireError>
  value.match(active)
    DataString:
      Ok<String> { value: active.value }
    else:
      Err<WireError> { error: WireError {} }

pub fn unpack_map(value: DataValue) -> Result<WireMap, WireError>
  value.match(active)
    DataObject:
      Ok<WireMap> { value: map_from(active.fields) }
    DataVariant:
      let ~out = map_from(active.fields)
      out.set("$variant", active.name)
      Ok<WireMap> { value: out }
    else:
      Err<WireError> { error: WireError {} }

fn fields_from(values: WireMap) -> Array<DataField>
  let entries = values.values.entries()
  let ~fields = Array<DataField>::with_capacity(entries.len())
  var index = 0
  while index < entries.len():
    let entry = entries.at(index)
    fields.push(DataField { name: entry.0, value: entry.1 })
    index = index + 1
  fields

fn map_from(fields: Array<DataField>) -> WireMap
  let ~values = WireMap::init()
  var index = 0
  while index < fields.len():
    let field = fields.at(index)
    values.set(field.name, field.value)
    index = index + 1
  values
