//! Typed Canvas rendering and measurement commands for VX.

use std::array::Array
use std::data::{ CustomDto, CustomDtoError }
use std::enums::{ enum }
use std::optional::types::all
use std::result::types::all
use std::string::type::String
use super::command::{ CommandWire, Cmd, command_plan, mark_owned_handler, retain_typed_message_mapper }
use super::payload::encode_payload

/// A logical point in CSS-pixel canvas coordinates.
pub obj Point {
  api x: f64,
  api y: f64
}

/// A 2D affine transform using the browser Canvas matrix convention.
pub obj Transform {
  api a: f64,
  api b: f64,
  api c: f64,
  api d: f64,
  api e: f64,
  api f: f64
}

obj RadialGradientDto {
  api innerColor: String,
  api outerColor: String,
  api innerRadius: f64,
  api outerRadius?: f64
}

obj PathSegmentDto {
  api kind: String,
  api point?: Point,
  api control?: Point,
  api to?: Point,
  api control1?: Point,
  api control2?: Point,
  api center?: Point,
  api origin?: Point,
  api radius?: f64,
  api radiusX?: f64,
  api radiusY?: f64,
  api rotation?: f64,
  api startAngle?: f64,
  api endAngle?: f64,
  api counterClockwise?: bool,
  api width?: f64,
  api height?: f64
}

obj DrawDto {
  api kind: String,
  api from?: Point,
  api to?: Point,
  api color?: String,
  api width?: f64,
  api alpha?: f64,
  api glowColor?: String,
  api glowBlur?: f64,
  api points?: Array<Point>,
  api closed?: bool,
  api fill?: String,
  api center?: Point,
  api radius?: f64,
  api stroke?: String,
  api strokeWidth?: f64,
  api radialGradient?: RadialGradientDto,
  api radiusX?: f64,
  api radiusY?: f64,
  api rotation?: f64,
  api position?: Point,
  api value?: String,
  api font?: String,
  api align?: String,
  api baseline?: String,
  api maxWidth?: f64,
  api segments?: Array<PathSegmentDto>,
  api fillRule?: String,
  api a?: f64,
  api b?: f64,
  api c?: f64,
  api d?: f64,
  api e?: f64,
  api f?: f64,
  api x?: f64,
  api y?: f64,
  api radians?: f64,
  api pattern?: Array<f64>,
  api offset?: f64,
  api operation?: String
}

obj FrameDto {
  api version: i32,
  api selector: String,
  api width: f64,
  api height: f64,
  api clear: bool,
  api background?: String,
  api draws: Array<DrawDto>
}

/// A typed segment in a Canvas path.
pub obj PathSegment {
  pri dto: PathSegmentDto
}

pub enum FillRule
  NonZero
  EvenOdd

pub enum CompositeOperation
  SourceOver
  SourceIn
  SourceOut
  SourceAtop
  DestinationOver
  DestinationIn
  DestinationOut
  DestinationAtop
  Lighter
  Copy
  Xor
  Multiply
  Screen
  Overlay
  Darken
  Lighten
  ColorDodge
  ColorBurn
  HardLight
  SoftLight
  Difference
  Exclusion
  Hue
  Saturation
  Color
  Luminosity

/// A typed canvas draw or state operation produced by the Canvas constructors.
pub obj Draw {
  pri dto: DrawDto
}

/// A versioned canvas frame ready for the browser VX runtime.
pub obj Frame {
  pri dto: FrameDto
}

/// A radial fill used by canvas circles.
pub obj RadialGradient {
  pri dto: RadialGradientDto
}

impl PathSegment
  fn from_boundary_dto(dto: PathSegmentDto) -> PathSegment
    PathSegment { dto }

  fn boundary_dto(self) -> PathSegmentDto
    self.dto

impl Draw
  fn from_boundary_dto(dto: DrawDto) -> Draw
    Draw { dto }

  fn boundary_dto(self) -> DrawDto
    self.dto

impl RadialGradient
  fn from_boundary_dto(dto: RadialGradientDto) -> RadialGradient
    RadialGradient { dto }

  fn boundary_dto(self) -> RadialGradientDto
    self.dto

impl Frame
  fn from_boundary_dto(dto: FrameDto) -> Frame
    Frame { dto }

  fn boundary_dto(self) -> FrameDto
    self.dto

impl CustomDto<PathSegment, PathSegmentDto> for PathSegment
  fn write(value: PathSegment) -> PathSegmentDto
    value.boundary_dto()

  fn read(value: PathSegmentDto) -> Result<PathSegment, CustomDtoError>
    Ok<PathSegment> { value: PathSegment::from_boundary_dto(value) }

impl CustomDto<Draw, DrawDto> for Draw
  fn write(value: Draw) -> DrawDto
    value.boundary_dto()

  fn read(value: DrawDto) -> Result<Draw, CustomDtoError>
    Ok<Draw> { value: Draw::from_boundary_dto(value) }

impl CustomDto<RadialGradient, RadialGradientDto> for RadialGradient
  fn write(value: RadialGradient) -> RadialGradientDto
    value.boundary_dto()

  fn read(value: RadialGradientDto) -> Result<RadialGradient, CustomDtoError>
    Ok<RadialGradient> { value: RadialGradient::from_boundary_dto(value) }

impl CustomDto<Frame, FrameDto> for Frame
  fn write(value: Frame) -> FrameDto
    value.boundary_dto()

  fn read(value: FrameDto) -> Result<Frame, CustomDtoError>
    Ok<Frame> { value: Frame::from_boundary_dto(value) }

/// Logical CSS-pixel metrics returned by `measure_text`.
pub type TextMetrics = {
  width: f64,
  actual_bounding_box_left: f64,
  actual_bounding_box_right: f64,
  actual_bounding_box_ascent: f64,
  actual_bounding_box_descent: f64
}

/// Paints a typed canvas frame through the browser VX runtime host.
pub fn render<Msg>(value: Frame) -> Cmd<Msg>
  let dto = value.boundary_dto()
  command_plan<Msg>(() -> CommandWire =>
    CommandWire::CommandCanvasRender { payload: encode_payload<FrameDto>(dto) }
  )

fn measure_text_with_handler_id<Msg>({
  selector: String,
  value: String,
  font: String = "12px sans-serif",
  handler_id: i32
}) -> Cmd<Msg>
  command_plan<Msg>(() -> CommandWire =>
    CommandWire::CommandCanvasMeasureText {
      selector,
      value,
      font,
      handler_ref: handler_id
    }
  )

/// Measures text in logical CSS pixels and dispatches the typed metrics.
pub fn measure_text<Msg>({
  selector: String,
  value: String,
  font: String = "12px sans-serif",
  handler: fn(TextMetrics) -> Msg
}) -> Cmd<Msg>
  let handler_id = retain_typed_message_mapper(handler)
  mark_owned_handler(
    measure_text_with_handler_id<Msg>(
      selector: selector,
      value: value,
      font: font,
      handler_id: handler_id
    ),
    handler_id
  )

/// Creates a radial color fill for a canvas circle.
pub fn radial_gradient({
  inner_color: String,
  outer_color: String,
  inner_radius: f64 = 0.0,
  outer_radius?: f64
}) -> RadialGradient
  radial_gradient_value(RadialGradientDto {
    innerColor: inner_color,
    outerColor: outer_color,
    innerRadius: inner_radius,
    outerRadius: outer_radius
  })

/// Starts a path at a logical CSS-pixel point without drawing a segment.
pub fn path_move_to(point: Point) -> PathSegment
  path_segment(PathSegmentDto { kind: "moveTo", point })

/// Adds a straight segment to a logical CSS-pixel point.
pub fn path_line_to(point: Point) -> PathSegment
  path_segment(PathSegmentDto { kind: "lineTo", point })

/// Adds a quadratic Bézier segment.
pub fn path_quadratic_curve_to({
  control: Point,
  to: Point
}) -> PathSegment
  path_segment(PathSegmentDto { kind: "quadraticCurveTo", control, to })

/// Adds a cubic Bézier segment.
pub fn path_bezier_curve_to({
  control_1: Point,
  control_2: Point,
  to: Point
}) -> PathSegment
  path_segment(PathSegmentDto {
    kind: "bezierCurveTo",
    control1: control_1,
    control2: control_2,
    to
  })

/// Adds a circular arc. Angles are expressed in radians.
pub fn path_arc({
  center: Point,
  radius: f64,
  start_angle: f64,
  end_angle: f64,
  counter_clockwise: bool = false
}) -> PathSegment
  path_segment(PathSegmentDto {
    kind: "arc",
    center,
    radius,
    startAngle: start_angle,
    endAngle: end_angle,
    counterClockwise: counter_clockwise
  })

/// Adds an arc tangent to two lines.
pub fn path_arc_to({
  control_1: Point,
  control_2: Point,
  radius: f64
}) -> PathSegment
  path_segment(PathSegmentDto {
    kind: "arcTo",
    control1: control_1,
    control2: control_2,
    radius
  })

/// Adds an elliptical arc. Angles and rotation are expressed in radians.
pub fn path_ellipse({
  center: Point,
  radius_x: f64,
  radius_y: f64,
  rotation: f64,
  start_angle: f64,
  end_angle: f64,
  counter_clockwise: bool = false
}) -> PathSegment
  path_segment(PathSegmentDto {
    kind: "ellipse",
    center,
    radiusX: radius_x,
    radiusY: radius_y,
    rotation,
    startAngle: start_angle,
    endAngle: end_angle,
    counterClockwise: counter_clockwise
  })

/// Adds a rectangular subpath.
pub fn path_rect({
  origin: Point,
  width: f64,
  height: f64
}) -> PathSegment
  path_segment(PathSegmentDto { kind: "rect", origin, width, height })

/// Closes the current path subpath.
pub fn path_close() -> PathSegment
  path_segment(PathSegmentDto { kind: "closePath" })

/// Paints a typed path from its segments.
pub fn path({
  segments: Array<PathSegment>,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  fill_rule: FillRule = FillRule::NonZero {},
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0
}) -> Draw
  draw(DrawDto {
    kind: "path",
    segments: path_segment_dtos(segments),
    fill,
    stroke,
    strokeWidth: stroke_width,
    fillRule: fill_rule_name(fill_rule),
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur
  })

/// Saves the current transform, dash, compositing, and paint state.
pub fn save() -> Draw
  draw(DrawDto { kind: "save" })

/// Restores the most recently saved Canvas state.
pub fn restore() -> Draw
  draw(DrawDto { kind: "restore" })

/// Multiplies the current Canvas transform by an affine matrix.
pub fn transform(matrix: Transform) -> Draw
  draw(DrawDto {
    kind: "transform",
    a: matrix.a,
    b: matrix.b,
    c: matrix.c,
    d: matrix.d,
    e: matrix.e,
    f: matrix.f
  })

/// Translates subsequent draws in logical CSS pixels.
pub fn translate({ x: f64, y: f64 }) -> Draw
  draw(DrawDto { kind: "translate", x, y })

/// Rotates subsequent draws by radians.
pub fn rotate(radians: f64) -> Draw
  draw(DrawDto { kind: "rotate", radians })

/// Scales subsequent draws along each axis.
pub fn scale({ x: f64, y: f64 }) -> Draw
  draw(DrawDto { kind: "scale", x, y })

/// Sets the line-dash pattern for subsequent draws. An empty pattern resets it.
pub fn line_dash({ pattern: Array<f64>, offset: f64 = 0.0 }) -> Draw
  draw(DrawDto { kind: "lineDash", pattern, offset })

/// Sets the compositing operation for subsequent draws.
pub fn composite(operation: CompositeOperation) -> Draw
  draw(DrawDto {
    kind: "composite",
    operation: composite_operation_name(operation)
  })

/// Creates a versioned canvas frame in CSS-pixel logical coordinates.
pub fn frame({
  selector: String,
  width: f64,
  height: f64,
  draws: Array<Draw>,
  clear: bool = true,
  background?: String
}) -> Frame
  let value = FrameDto {
    version: 2,
    selector,
    width,
    height,
    clear,
    background,
    draws: draw_dtos(draws)
  }
  Frame { dto: value }

/// Creates a straight canvas line.
pub fn line({
  from: Point,
  to: Point,
  color: String,
  width: f64 = 1.0,
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0
}) -> Draw
  draw(DrawDto {
    kind: "line",
    from,
    to,
    color,
    width,
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur
  })

/// Creates a connected canvas path, optionally closed and filled.
pub fn polyline({
  points: Array<Point>,
  color: String,
  width: f64 = 1.0,
  alpha: f64 = 1.0,
  closed: bool = false,
  fill?: String
}) -> Draw
  draw(DrawDto { kind: "polyline", points, color, width, alpha, closed, fill })

/// Creates a canvas circle with optional stroke, glow, and radial fill.
pub fn circle({
  center: Point,
  radius: f64,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0,
  radial_gradient?: RadialGradient
}) -> Draw
  draw(DrawDto {
    kind: "circle",
    center,
    radius,
    fill,
    stroke,
    strokeWidth: stroke_width,
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur,
    radialGradient: radial_gradient_dto(radial_gradient)
  })

/// Creates a canvas ellipse. Rotation is expressed in radians.
pub fn ellipse({
  center: Point,
  radius_x: f64,
  radius_y: f64,
  rotation: f64 = 0.0,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  alpha: f64 = 1.0
}) -> Draw
  draw(DrawDto {
    kind: "ellipse",
    center,
    radiusX: radius_x,
    radiusY: radius_y,
    rotation,
    fill,
    stroke,
    strokeWidth: stroke_width,
    alpha
  })

/// Creates canvas text using a CSS canvas font string.
pub fn text({
  position: Point,
  value: String,
  color: String,
  font: String = "12px sans-serif",
  align: String = "left",
  baseline: String = "alphabetic",
  alpha: f64 = 1.0,
  max_width?: f64
}) -> Draw
  draw(DrawDto {
    kind: "text",
    position,
    value,
    color,
    font,
    align,
    baseline,
    alpha,
    maxWidth: max_width
  })

fn radial_gradient_value(dto: RadialGradientDto) -> RadialGradient
  RadialGradient::from_boundary_dto(dto)

fn radial_gradient_dto(
  value: Optional<RadialGradient>
) -> Optional<RadialGradientDto>
  match(value)
    Some<RadialGradient> { value }:
      Some<RadialGradientDto> { value: value.boundary_dto() }
    None:
      None {}

fn path_segment(dto: PathSegmentDto) -> PathSegment
  PathSegment::from_boundary_dto(dto)

fn path_segment_dtos(
  segments: Array<PathSegment>
) -> Array<PathSegmentDto>
  let ~out = Array<PathSegmentDto>::with_capacity(segments.len())
  var index = 0
  while index < segments.len():
    match(segments.get(index))
      Some<PathSegment> { value }:
        out.push(value.boundary_dto())
      None:
        void
    index = index + 1
  out

fn draw(dto: DrawDto) -> Draw
  Draw::from_boundary_dto(dto)

fn draw_dtos(draws: Array<Draw>) -> Array<DrawDto>
  let ~out = Array<DrawDto>::with_capacity(draws.len())
  var index = 0
  while index < draws.len():
    match(draws.get(index))
      Some<Draw> { value }:
        out.push(value.boundary_dto())
      None:
        void
    index = index + 1
  out

fn fill_rule_name(value: FillRule) -> String
  value.match(active)
    NonZero:
      "nonzero".to_string()
    EvenOdd:
      "evenodd".to_string()

fn composite_operation_name(value: CompositeOperation) -> String
  value.match(active)
    SourceOver:
      "source-over".to_string()
    SourceIn:
      "source-in".to_string()
    SourceOut:
      "source-out".to_string()
    SourceAtop:
      "source-atop".to_string()
    DestinationOver:
      "destination-over".to_string()
    DestinationIn:
      "destination-in".to_string()
    DestinationOut:
      "destination-out".to_string()
    DestinationAtop:
      "destination-atop".to_string()
    Lighter:
      "lighter".to_string()
    Copy:
      "copy".to_string()
    Xor:
      "xor".to_string()
    Multiply:
      "multiply".to_string()
    Screen:
      "screen".to_string()
    Overlay:
      "overlay".to_string()
    Darken:
      "darken".to_string()
    Lighten:
      "lighten".to_string()
    ColorDodge:
      "color-dodge".to_string()
    ColorBurn:
      "color-burn".to_string()
    HardLight:
      "hard-light".to_string()
    SoftLight:
      "soft-light".to_string()
    Difference:
      "difference".to_string()
    Exclusion:
      "exclusion".to_string()
    Hue:
      "hue".to_string()
    Saturation:
      "saturation".to_string()
    Color:
      "color".to_string()
    Luminosity:
      "luminosity".to_string()
