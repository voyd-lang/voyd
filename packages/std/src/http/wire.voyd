//! Provider-neutral DTOs for standard HTTP host effects.

use std::array::Array
use std::bytes::Bytes
use std::error::HostError
use std::http::self as http
use std::http::{ Body, Header, HeaderName, Headers, IncomingRequest, QueryString, Response, Status }
use std::optional::types::all
use std::result::types::all
use std::string::type::String

pub obj HttpResult<T> {
  api ok: bool,
  api value: T,
  api error_code: i32,
  api error_message: String
}

pub obj HeaderDto {
  api name: String,
  api value: String
}

pub obj ResponseDto {
  api status: i32,
  api reason: String,
  api headers: Array<HeaderDto>,
  api body: Bytes
}

pub obj PendingRequestDto {
  api request_id: i32,
  api method: String,
  api path: String,
  api query?: String,
  api headers: Array<HeaderDto>,
  api body: Bytes,
  api body_streaming: bool
}

pub obj RequestChunkDto {
  api chunk: Bytes,
  api done: bool
}

pub fn decode_result<T>(result: HttpResult<T>) -> Result<T, HostError>
  if result.ok:
    Ok<T> { value: result.value }
  else:
    Err<HostError> {
      error: HostError {
        code: result.error_code,
        message: result.error_message
      }
    }

pub fn encode_result<T>(result: Result<T, HostError>, fallback: T) -> HttpResult<T>
  match(result)
    Ok<T> { value }:
      HttpResult<T> {
        ok: true,
        value: value,
        error_code: 0,
        error_message: ""
      }
    Err<HostError> { error }:
      HttpResult<T> {
        ok: false,
        value: fallback,
        error_code: error.code,
        error_message: error.message
      }

pub fn encode_headers(headers: Headers) -> Array<HeaderDto>
  let entries = headers.entries()
  let ~encoded = Array<HeaderDto>::with_capacity(entries.len())
  var index = 0
  while index < entries.len():
    let value = entries.at(index)
    encoded.push(HeaderDto {
      name: value.name.as_string(),
      value: value.value
    })
    index = index + 1
  encoded

pub fn decode_headers(source: Array<HeaderDto>) -> Result<Headers, HostError>
  var headers = Headers::empty()
  var index = 0
  while index < source.len():
    let value = source.at(index)
    match(HeaderName::from(value.name))
      Ok<HeaderName> { value: name }:
        headers = headers.append(header: { name: name, value: value.value })
      Err:
        return Err<HostError> {
          error: HostError {
            code: 2,
            message: "host returned invalid http header name"
          }
        }
    index = index + 1
  Ok<Headers> { value: headers }

pub fn encode_response(response: Response) -> ResponseDto
  ResponseDto {
    status: response.status.code(),
    reason: response.status.reason(),
    headers: encode_headers(response.headers),
    body: response.body.as_bytes()
  }

pub fn decode_response(value: ResponseDto) -> Result<Response, HostError>
  match(Status::custom(code: value.status, reason: value.reason))
    Err:
      Err<HostError> {
        error: HostError {
          code: 1,
          message: "host returned invalid http status code"
        }
      }
    Ok<Status> { value: status }:
      match(decode_headers(value.headers))
        Err<HostError> { error }:
          Err<HostError> { error: error }
        Ok<Headers> { value: headers }:
          Ok<Response> {
            value: Response {
              status: status,
              headers: headers,
              body: body_from_bytes(value.body)
            }
          }

pub fn decode_response_result(result: HttpResult<ResponseDto>) -> Result<Response, HostError>
  match(decode_result(result))
    Err<HostError> { error }:
      Err<HostError> { error: error }
    Ok<ResponseDto> { value }:
      decode_response(value)

pub fn decode_pending_request_result(
  result: HttpResult<PendingRequestDto>
) -> Result<(i32, IncomingRequest, bool), HostError>
  match(decode_result(result))
    Err<HostError> { error }:
      Err<HostError> { error: error }
    Ok<PendingRequestDto> { value }:
      match(decode_headers(value.headers))
        Err<HostError> { error }:
          Err<HostError> { error: error }
        Ok<Headers> { value: headers }:
          let query = match(value.query)
            Some<String> { value }:
              Some<QueryString> { value: QueryString { raw: value } }
            None:
              None {}
          Ok<(i32, IncomingRequest, bool)> {
            value: (
              value.request_id,
              IncomingRequest {
                method: http::method(value.method),
                path: value.path,
                query: query,
                headers: headers,
                body: body_from_bytes(value.body)
              },
              value.body_streaming
            )
          }

pub fn body_from_bytes(bytes: Bytes) -> Body
  if bytes.is_empty(): Body::empty() else: Body::bytes(bytes)
