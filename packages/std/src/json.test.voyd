use std::array::{ Array, new_array_unchecked }
use std::dict::Dict
use std::string::{ String, new_string }
use std::test::assertions::all

obj DecodeProfile {
  age: i32,
  nickname?: String
}

obj DecodeStarted { id: i32 }
obj DecodeStopped { reason: String }
type DecodeEvent = DecodeStarted | DecodeStopped

obj DecodeRequest {
  version: i32,
  profiles: Array<DecodeProfile>,
  event: DecodeEvent
}

obj VersionedName {
  version: i32,
  name: String
}

obj DecodeFloat { value: f32 }

test "typed JSON decode composes nested arrays optional fields and enum payloads":
  let source = "{\"version\":1,\"profiles\":[{\"age\":7},{\"age\":9,\"nickname\":\"nine\"}],\"event\":{\"$variant\":\"DecodeStarted\",\"id\":42}}"
  match(decode<DecodeRequest>(source))
    Err<JsonDecodeError>:
      assert(false, eq: true)
    Ok<DecodeRequest> { value }:
      assert(value.version, eq: 1)
      assert(value.profiles.len(), eq: 2)
      assert(value.profiles.at(0).age, eq: 7)
      value.event.match(event)
        DecodeStarted:
          assert(event.id, eq: 42)
        else:
          assert(false, eq: true)

test "typed JSON decode reports precise nested paths and strict unknown fields":
  let mistyped = "{\"version\":1,\"profiles\":[{\"age\":7},{\"age\":\"old\"}],\"event\":\"DecodeStopped\"}"
  match(decode<DecodeRequest>(mistyped))
    Ok<DecodeRequest>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.profiles[1].age")
      error.kind.match(kind)
        JsonSchemaFailure:
          void
        else:
          assert(false, eq: true)

  let unknown = "{\"version\":1,\"name\":\"orbit\",\"extra\":true}"
  match(decode<VersionedName>(unknown))
    Ok<VersionedName>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.extra")

  match(decode<VersionedName>(unknown, options: permissive_decode_options()))
    Err<JsonDecodeError>:
      assert(false, eq: true)
    Ok<VersionedName> { value }:
      assert(value.name, eq: "orbit")

test "version dispatch requires explicit migration to the current version":
  match(decode_versioned<VersionedName>(
    "{\"version\":0,\"name\":\"legacy\"}",
    current: 1,
    migrate: migrate_versioned_name
  ))
    Err<JsonDecodeError>:
      assert(false, eq: true)
    Ok<VersionedName> { value }:
      assert(value.version, eq: 1)
      assert(value.name, eq: "legacy")

  match(decode_versioned<VersionedName>(
    "{\"version\":9,\"name\":\"future\"}",
    current: 1,
    migrate: migrate_versioned_name
  ))
    Ok<VersionedName>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.version")
      error.kind.match(kind)
        JsonVersionFailure:
          void
        else:
          assert(false, eq: true)

  match(decode_versioned<VersionedName>(
    "{\"version\":1.5,\"name\":\"fractional\"}",
    current: 1,
    migrate: migrate_versioned_name
  ))
    Ok<VersionedName>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.version")
      error.kind.match(kind)
        JsonVersionFailure:
          void
        else:
          assert(false, eq: true)

test "typed JSON decode rejects fractional integers and overflowing f32 values":
  match(decode<VersionedName>("{\"version\":1.5,\"name\":\"fractional\"}"))
    Ok<VersionedName>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.version")

  match(decode<DecodeFloat>("{\"value\":1e100}"))
    Ok<DecodeFloat>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.value")

test "numeric constraints retain the caller path":
  match(number_in_range(JsonNumber { value: 12.0 }, at: "$.mass", min: 0.0, max: 10.0))
    Ok<f64>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.mass")
      error.kind.match(kind)
        JsonConstraintFailure:
          void
        else:
          assert(false, eq: true)

  match(number_in_range(JsonNumber { value: 1.0 / 0.0 }, at: "$.mass", min: 0.0, max: 10.0))
    Ok<f64>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.mass")
      error.kind.match(kind)
        JsonConstraintFailure:
          void
        else:
          assert(false, eq: true)

fn migrate_versioned_name(version: i32, document: JsonValue) -> Result<JsonValue, JsonDecodeError>
  if version != 0:
    return Err<JsonDecodeError> {
      error: JsonDecodeError {
        kind: JsonVersionFailure {},
        path: "$.version",
        message: "unsupported version"
      }
    }
  document.match(decoded)
    JsonObject:
      Ok<JsonValue> {
        value: JsonObject {
          value: decoded.value.setting("version", JsonNumber { value: 1.0 })
        }
      }
    else:
      Err<JsonDecodeError> {
        error: JsonDecodeError {
          kind: JsonVersionFailure {},
          path: "$",
          message: "document must be an object"
        }
      }

test "json parse handles objects, arrays, booleans, and numbers":
  let input = from_ascii([
    123,34,111,107,34,58,116,114,117,101,44,34,110,34,58,49,50,44,
    34,97,114,114,34,58,91,102,97,108,115,101,44,110,117,108,108,93,125
  ])

  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonObject:
          assert(root.value.contains("ok"), eq: true)
          assert(root.value.contains("n"), eq: true)
          assert(root.value.contains("arr"), eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse decodes escaped strings":
  let input = from_ascii([34,108,105,110,101,92,110,34])
  let expected = from_ascii([108,105,110,101,10])

  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonString:
          assert(root.value.equals(expected), eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse decodes escaped surrogate pairs":
  let input = from_ascii([34,92,117,68,56,51,68,92,117,68,69,48,48,34])
  let expected = from_ascii([240,159,152,128])

  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonString:
          assert(root.value.equals(expected), eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse keeps escapes after unmatched high surrogate":
  let input = from_ascii([34,92,117,68,56,51,68,92,117,48,48,52,49,34])
  let expected = from_ascii([239,191,189,65])

  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonString:
          assert(root.value.equals(expected), eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse rejects invalid input":
  match(parse("{"))
    Ok<JsonValue>:
      assert(false, eq: true)
    Err<JsonError> { error }:
      assert(error.code, eq: 1)
      assert(error.message.as_slice().contains("json parse error"), eq: true)

test "json parse rejects oversized exponents":
  match(parse("1e100000000"))
    Ok<JsonValue>:
      assert(false, eq: true)
    Err<JsonError>:
      assert(true, eq: true)

test "json parse preserves subnormal magnitudes":
  match(parse("1e-309"))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          assert(root.value > 0.0, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse rejects overflowing mantissas":
  let too_large = repeat_byte(57, 500)
  match(parse(too_large))
    Ok<JsonValue>:
      assert(false, eq: true)
    Err<JsonError>:
      assert(true, eq: true)

test "json parse accepts long fractional mantissas":
  let input = long_fraction_input(49, 400)
  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          assert(root.value > 0.0, eq: true)
          assert(root.value < 1.0, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse allows zero mantissa with large exponent":
  match(parse("0e309"))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          assert(root.value, eq: 0.0)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

  match(parse("-0e400"))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          assert(root.value, eq: 0.0)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse accepts normalized finite exponents above 308":
  match(parse("0.1e309"))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          var expected = 1.0
          var index = 0
          while index < 308:
            expected = expected * 10.0
            index = index + 1
          let ratio = root.value / expected
          assert(ratio > 0.999999999, eq: true)
          assert(ratio < 1.000000001, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json parse keeps late fractional digits with exponent compensation":
  let input = compensated_fraction_input(350)
  match(parse(input))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          var expected = 1.0
          var index = 0
          while index < 26:
            expected = expected / 10.0
            index = index + 1
          let ratio = root.value / expected
          assert(ratio > 0.999999999, eq: true)
          assert(ratio < 1.000000001, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json stringify emits compact object envelope":
  let ~fields = Dict<String, JsonValue>::init()
  fields.set("ok", JsonBool { value: true })
  fields.set("count", JsonNumber { value: 12.5 })

  let ~items = Array<JsonValue>::with_capacity(2)
  items.push(JsonString { value: "x" })
  items.push(JsonNull {})
  fields.set("items", JsonArray { value: items })

  let value = JsonObject { value: fields }
  let compact = must_stringify(value)

  assert(compact.as_slice().starts_with("{"), eq: true)
  assert(compact.as_slice().ends_with("}"), eq: true)

test "json stringify includes object keys":
  let ~fields = Dict<String, JsonValue>::init()
  fields.set("ok", JsonBool { value: true })
  fields.set("count", JsonNumber { value: 12.5 })

  let ~items = Array<JsonValue>::with_capacity(2)
  items.push(JsonString { value: "x" })
  items.push(JsonNull {})
  fields.set("items", JsonArray { value: items })

  let value = JsonObject { value: fields }
  let compact = must_stringify(value)

  match(parse(compact))
    Ok<JsonValue> { value: roundtrip }:
      roundtrip.match(root)
        JsonObject:
          assert(root.value.contains("ok"), eq: true)
          assert(root.value.contains("count"), eq: true)
          assert(root.value.contains("items"), eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json stringify_pretty emits newlines":
  let ~fields = Dict<String, JsonValue>::init()
  fields.set("ok", JsonBool { value: true })
  fields.set("count", JsonNumber { value: 12.5 })

  let ~items = Array<JsonValue>::with_capacity(2)
  items.push(JsonString { value: "x" })
  items.push(JsonNull {})
  fields.set("items", JsonArray { value: items })

  let value = JsonObject { value: fields }
  let pretty = must_stringify_pretty(value)

  assert(pretty.as_slice().contains(from_ascii([10])), eq: true)

test "json stringify rejects non-finite numbers":
  assert_json_stringify_error(stringify(JsonNumber { value: 0.0 / 0.0 }))
  assert_json_stringify_error(stringify(JsonNumber { value: 1.0 / 0.0 }))
  assert_json_stringify_error(stringify(JsonNumber { value: (0.0 - 1.0) / 0.0 }))
  assert_json_stringify_error(stringify_pretty(JsonNumber { value: 1.0 / 0.0 }))

test "json stringify preserves magnitude for large finite numbers":
  var huge = 1.0
  var index = 0
  while index < 20:
    huge = huge * 10.0
    index = index + 1

  let encoded = must_stringify(JsonNumber { value: huge })
  match(parse(encoded))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          let ratio = root.value / huge
          assert(ratio > 0.999999999, eq: true)
          assert(ratio < 1.000000001, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json stringify preserves tiny non-zero magnitude":
  var tiny = 1.0
  var index = 0
  while index < 14:
    tiny = tiny / 10.0
    index = index + 1

  let encoded = must_stringify(JsonNumber { value: tiny })
  assert(encoded.equals("0"), eq: false)
  assert(encoded.equals("-0"), eq: false)

  match(parse(encoded))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          let ratio = root.value / tiny
          assert(ratio > 0.999999999, eq: true)
          assert(ratio < 1.000000001, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json stringify preserves extended fractional precision":
  let source = JsonNumber { value: 0.1234567890123456 }
  let encoded = must_stringify(source)
  assert(encoded.equals("0.123456789012"), eq: false)

  match(parse(encoded))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          let ratio = root.value / 0.1234567890123456
          assert(ratio > 0.999999999999, eq: true)
          assert(ratio < 1.000000000001, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

test "json stringify preserves subnormal numbers":
  match(parse("1e-309"))
    Ok<JsonValue> { value }:
      value.match(root)
        JsonNumber:
          let encoded = must_stringify(JsonNumber { value: root.value })
          assert(encoded.equals("0"), eq: false)
          assert(encoded.equals("-0"), eq: false)
          match(parse(encoded))
            Ok<JsonValue> { value: roundtrip }:
              roundtrip.match(roundtrip_root)
                JsonNumber:
                  assert(roundtrip_root.value > 0.0, eq: true)
                else:
                  assert(false, eq: true)
            Err<JsonError>:
              assert(false, eq: true)
        else:
          assert(false, eq: true)
    Err<JsonError>:
      assert(false, eq: true)

fn from_ascii(bytes: Array<i32>): () -> String
  new_string(bytes.to_fixed_array())

fn must_stringify(value: JsonValue): Test -> String
  match(stringify(value))
    Ok<String> { value }:
      value
    Err<JsonError>:
      assert(false, eq: true)
      String::init()

fn must_stringify_pretty(value: JsonValue): Test -> String
  match(stringify_pretty(value))
    Ok<String> { value }:
      value
    Err<JsonError>:
      assert(false, eq: true)
      String::init()

fn assert_json_stringify_error(result: Result<String, JsonError>): Test -> void
  match(result)
    Ok<String>:
      assert(false, eq: true)
    Err<JsonError> { error }:
      assert(error.code, eq: 2)
      assert(error.message.as_slice().contains("numbers must be finite"), eq: true)

fn repeat_byte(byte: i32, count: i32): () -> String
  let ~bytes = Array<i32>::with_capacity(count)
  var index = 0
  while index < count:
    bytes.push(byte)
    index = index + 1
  new_string(bytes.to_fixed_array())

fn long_fraction_input(digit: i32, digits: i32): () -> String
  let ~bytes = Array<i32>::with_capacity(digits + 2)
  bytes.push(48)
  bytes.push(46)

  var index = 0
  while index < digits:
    bytes.push(digit)
    index = index + 1

  new_string(bytes.to_fixed_array())

fn compensated_fraction_input(zero_digits: i32): () -> String
  let ~bytes = Array<i32>::with_capacity(zero_digits + 7)
  bytes.push(48)
  bytes.push(46)

  var index = 0
  while index < zero_digits:
    bytes.push(48)
    index = index + 1

  bytes.push(49)
  bytes.push(101)
  bytes.push(51)
  bytes.push(50)
  bytes.push(53)
  new_string(bytes.to_fixed_array())
