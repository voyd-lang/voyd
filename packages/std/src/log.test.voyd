use std::optional::types::all
use std::test::assertions::all

test "trace with fields emits a typed event":
  let fields = make_fields()

  let ~seen = Array<i32>::init()
  let ~payload_sizes = Array<i32>::init()

  try
    trace("hello", fields)
  Log::emit(tail, payload):
    seen.push(1)
    assert(payload.level.equals("trace"), eq: true)
    assert(payload.message.equals("hello"), eq: true)
    payload_sizes.push(payload.fields.len())
    tail()

  assert(seen.len(), eq: 1)
  match(payload_sizes.get(0))
    Some<i32> { value: payload_size }:
      assert(payload_size, eq: 1)
    None:
      assert(false, eq: true)

test "trace accepts string slices without rebuilding call-site strings":
  let ~seen = Array<i32>::init()

  try
    trace("hello".as_slice())
  Log::emit(tail, payload):
    assert(payload.message.equals("hello"), eq: true)
    seen.push(payload.fields.len())
    tail()

  match(seen.get(0))
    Some<i32> { value }:
      assert(value, eq: 0)
    None:
      assert(false)

fn i64_from_i32(value: i32): () -> i64 __i64_extend_s(value)

fn make_fields(): () -> LogFields
  let ~fields = Array<LogField>::init()
  fields.push(LogField {
    key: "count",
    value: LogInt { value: i64_from_i32(7) }
  })
  fields
