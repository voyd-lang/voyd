use std::test::assertions::all

test "to_f32 and to_f64 convert primitive values":
  assert(to_f64(7), eq: 7.0)
  assert(to_f64(to_i64(9)), eq: 9.0)
  assert(to_f64(to_f32(2.5)), eq: 2.5)
  assert(to_f32(11), eq: to_f32(11.0))

test "to_i32_wrapping and checked i64 narrowing":
  let in_range = to_i64(1234)
  match(to_i32_checked(in_range))
    Ok<i32> { value }:
      assert(value, eq: 1234)
    Err<CastError>:
      assert(false, eq: true)

  let overflow = to_i64(2147483647) + to_i64(1)
  assert(to_i32_wrapping(overflow), eq: -2147483648)

  match(to_i32_checked(overflow))
    Ok<i32>:
      assert(false, eq: true)
    Err<CastError> { error }:
      assert(error.code, eq: cast_error_code_overflow())

test "to_i32_checked validates float inputs":
  match(to_i32_checked(42.0))
    Ok<i32> { value }:
      assert(value, eq: 42)
    Err<CastError>:
      assert(false, eq: true)

  match(to_i32_checked(42.5))
    Ok<i32> { value }:
      assert(value, eq: 42)
    Err<CastError>:
      assert(false, eq: true)

  match(to_i32_checked(2147483648.0))
    Ok<i32>:
      assert(false, eq: true)
    Err<CastError> { error }:
      assert(error.code, eq: cast_error_code_overflow())

  match(to_i32_checked(1.0 / 0.0))
    Ok<i32>:
      assert(false, eq: true)
    Err<CastError> { error }:
      assert(error.code, eq: cast_error_code_invalid_input())

test "to_i64_checked validates float inputs":
  match(to_i64_checked(99.0))
    Ok<i64> { value }:
      assert(value, eq: to_i64(99))
    Err<CastError>:
      assert(false, eq: true)

  match(to_i64_checked(99.25))
    Ok<i64> { value }:
      assert(value, eq: to_i64(99))
    Err<CastError>:
      assert(false, eq: true)

  match(to_i64_checked(9223372036854775808.0))
    Ok<i64>:
      assert(false, eq: true)
    Err<CastError> { error }:
      assert(error.code, eq: cast_error_code_overflow())

test "reinterpret helpers preserve bit patterns":
  let i32_bits = 1069547520
  assert(reinterpret_i32(reinterpret_f32(i32_bits)), eq: i32_bits)

  let i64_bits = to_i64(1234567)
  assert(reinterpret_i64(reinterpret_f64(i64_bits)), eq: i64_bits)

test "to_string formats signed integers":
  assert(to_string(0).equals("0"), eq: true)
  assert(to_string(-42).equals("-42"), eq: true)
  assert(to_string(2147483647).equals("2147483647"), eq: true)
  assert(to_string(-2147483647 - 1).equals("-2147483648"), eq: true)

  let huge = pow2_i64(62)
  assert(to_string(huge).equals("4611686018427387904"), eq: true)

  let min_i64 = to_i64(0) - huge - huge
  assert(to_string(min_i64).equals("-9223372036854775808"), eq: true)

test "to_string formats floating-point values":
  assert(to_string(12.5).equals("12.5"), eq: true)
  assert(to_string(to_f32(12.5)).equals("12.5"), eq: true)

  var tiny = 1.0
  var index = 0
  while index < 14:
    tiny = tiny / 10.0
    index = index + 1
  assert(to_string(tiny).equals("0"), eq: false)

  assert(to_string(1.0 / 0.0).equals("Infinity"), eq: true)
  assert(to_string((0.0 - 1.0) / 0.0).equals("-Infinity"), eq: true)
  assert(to_string(0.0 / 0.0).equals("NaN"), eq: true)

test "format_fixed uses deterministic ties-to-even rounding and zero policy":
  assert_formatted(format_fixed(12.5, decimal_places: 2), "12.50")
  assert_formatted(
    format_fixed(12.5, decimal_places: 2, trim_trailing_zeros: true),
    "12.5"
  )
  assert_formatted(format_fixed(2.5, decimal_places: 0), "2")
  assert_formatted(format_fixed(3.5, decimal_places: 0), "4")
  assert_formatted(format_fixed(to_f32(2.5), decimal_places: 0), "2")
  let negative_zero = (0.0 - 1.0) * 0.0
  assert_formatted(format_fixed(negative_zero, decimal_places: 2), "0.00")
  assert_formatted(
    format_fixed(1.09999999999999, decimal_places: 15),
    "1.099999999999990"
  )

test "format_significant selects plain or compact scientific notation":
  assert_formatted(format_significant(12345.0, digits: 3), "12300")
  assert_formatted(format_significant(to_f32(12345.0), digits: 3), "12300")
  assert_formatted(format_significant(0.0012345, digits: 3), "0.00123")
  assert_formatted(format_significant(1230000000000000000000.0, digits: 3), "1.23e21")

test "format_scientific controls significant digits and trailing zeros":
  assert_formatted(format_scientific(1234567.0, digits: 3), "1.23e6")
  assert_formatted(format_scientific(to_f32(1234567.0), digits: 3), "1.23e6")
  assert_formatted(format_scientific(0.000001234, digits: 3), "1.23e-6")
  assert_formatted(
    format_scientific(1200.0, digits: 4, trim_trailing_zeros: false),
    "1.200e3"
  )

test "explicit number formatting applies non-finite and precision policies":
  assert_formatted(format_fixed(1.0 / 0.0, decimal_places: 2), "Infinity")
  match(format_fixed(
    1.0 / 0.0,
    decimal_places: 2,
    non_finite: NonFinitePolicy::reject()
  ))
    Ok<String>:
      assert(false, eq: true)
    Err<NumberFormatError> { error }:
      assert(error.code, eq: number_format_error_code_non_finite())

  match(format_fixed(1.0, decimal_places: 16))
    Ok<String>:
      assert(false, eq: true)
    Err<NumberFormatError> { error }:
      assert(error.code, eq: number_format_error_code_invalid_precision())

fn assert_formatted(result: Result<String, NumberFormatError>, expected: String) -> void
  match(result)
    Ok<String> { value }:
      assert(value.equals(expected), eq: true)
    Err<NumberFormatError>:
      assert(false, eq: true)

fn pow2_i64(exp: i32): () -> i64
  var out = to_i64(1)
  var index = 0
  while index < exp:
    out = out * to_i64(2)
    index = index + 1
  out
