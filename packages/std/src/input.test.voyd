use std::bytes::{ ByteBuffer, Bytes }
use std::error::{ HostError, IoError }
use std::optional::types::all
use std::result::types::all
use std::string::type::String
use std::test::assertions::all

test "input request init accepts string":
  let request = InputRequest::init("Name: ".as_slice().to_string())
  match(request.prompt)
    Some<String> { value }:
      assert(value.equals("Name: "), eq: true)
    None:
      assert(false, eq: true)

test "input read_line forwards prompt and decodes line":
  let result = read_line_with_assertions()
  match(result)
    Ok<Option<String>> { value }:
      match(value)
        Some<String> { value: line }:
          assert(line.equals("voyd"), eq: true)
        None:
          assert(false, eq: true)
    Err<HostError>:
      assert(false, eq: true)

test "input read_line decodes end and errors":
  match(read_line_with_result(line_result(false, "", 0)))
    Ok<Option<String>> { value }:
      match(value)
        None:
          assert(true, eq: true)
        Some<String>:
          assert(false, eq: true)
    Err<HostError>:
      assert(false, eq: true)

  match(read_line_with_result(line_result(false, "", 7)))
    Err<HostError> { error }:
      assert(error.code, eq: 7)
      assert(error.message.equals("denied"), eq: true)
    Ok<Option<String>>:
      assert(false, eq: true)

test "input read_bytes forwards limit and decodes bytes":
  let result = read_bytes_with_assertions()
  match(result)
    Ok<Option<Bytes>> { value }:
      match(value)
        Some<Bytes> { value: bytes }:
          let decoded = bytes.to_array()
          assert(decoded.len(), eq: 3)
          assert(optional_i32_or(decoded.get(0), -1), eq: 7)
          assert(optional_i32_or(decoded.get(2), -1), eq: 9)
        None:
          assert(false, eq: true)
    Err<IoError>:
      assert(false, eq: true)

test "input is_tty forwards bool from host":
  assert(is_tty_with_payload(true), eq: true)
  assert(is_tty_with_payload(false), eq: false)

fn line_result(found: bool, value: String, code: i32): () -> InputLineResult
  InputLineResult {
    ok: code == 0,
    found: found,
    value: value,
    code: code,
    message: if code == 0 then: "" else: "denied"
  }

fn bytes_error() -> InputBytesResult
  InputBytesResult {
    ok: false,
    found: false,
    value: ByteBuffer::init().as_bytes(),
    code: 1,
    message: "unavailable"
  }

fn read_line_with_result(result: InputLineResult): () -> Result<Option<String>, HostError>
  try
    read_line()
  Input::read_line(tail, _request):
    tail(result)
  Input::read_bytes_op(tail, _request):
    tail(bytes_error())
  Input::is_tty_op(tail):
    tail(false)

fn read_line_with_assertions(): Test -> Result<Option<String>, HostError>
  try
    read_line("Name: ".as_slice().to_string())
  Input::read_line(tail, request):
    match(request.prompt)
      Some<String> { value }:
        assert(value.equals("Name: "), eq: true)
      None:
        assert(false, eq: true)
    tail(line_result(true, "voyd", 0))
  Input::read_bytes_op(tail, _request):
    tail(bytes_error())
  Input::is_tty_op(tail):
    tail(false)

fn read_bytes_with_assertions(): Test -> Result<Option<Bytes>, IoError>
  try
    read_bytes(3)
  Input::read_bytes_op(tail, request):
    assert(request.max_bytes, eq: 3)
    let ~bytes = ByteBuffer::with_capacity(3)
    bytes.push(7)
    bytes.push(8)
    bytes.push(9)
    tail(InputBytesResult {
      ok: true,
      found: true,
      value: bytes.as_bytes(),
      code: 0,
      message: ""
    })
  Input::read_line(tail, _request):
    tail(line_result(false, "", 1))
  Input::is_tty_op(tail):
    tail(false)

fn is_tty_with_payload(value: bool): () -> bool
  try
    is_tty()
  Input::is_tty_op(tail):
    tail(value)
  Input::read_line(tail, _request):
    tail(line_result(false, "", 1))
  Input::read_bytes_op(tail, _request):
    tail(bytes_error())

fn optional_i32_or(value: Option<i32>, fallback: i32): () -> i32
  match(value)
    Some<i32> { value: present }:
      present
    None:
      fallback
