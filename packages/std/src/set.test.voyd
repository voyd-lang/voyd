use std::optional::types::all
use std::string::type::{ new_string }
use std::test::assertions::all
use std::traits::sequence::Sequence

fn accepts_sequence({ values: Sequence<String> }) -> bool
  true

test "set inserting contains removing clear":
  let ~mutable = Set<String>::init()
  assert(mutable.insert("a"), eq: true)
  assert(mutable.insert("a"), eq: false)
  assert(mutable.insert("b"), eq: true)
  assert(mutable.remove("a"), eq: true)
  assert(mutable.remove("a"), eq: false)
  assert(mutable.contains("a"), eq: false)
  assert(mutable.len(), eq: 1)

  let empty = Set<String>::init()
  assert(empty.is_empty(), eq: true)

  let values = empty.inserting("a").inserting("a").inserting("b")
  assert(values.len(), eq: 2)
  assert(values.contains("a"), eq: true)
  assert(values.contains("z"), eq: false)

  let removed = values.removing("a").removing("a")
  assert(removed.contains("a"), eq: false)

  let ~cleared = removed
  cleared.clear()
  assert(cleared.len(), eq: 0)
  assert(cleared.is_empty(), eq: true)

test "set values returns iterable keys":
  let values = Set<String>::init().inserting("left").inserting("right")

  assert(accepts_sequence(values: values.values()), eq: true)

  let ~iter = values.values().iter()
  var count = 0
  var has_left = false
  var has_right = false
  while true:
    match(iter.next())
      Some<String> { value }:
        count = count + 1
        if value.equals("left"):
          has_left = true
        if value.equals("right"):
          has_right = true
      None:
        break

  assert(count, eq: 2)
  assert(has_left, eq: true)
  assert(has_right, eq: true)
