//! Standard output/error stream helpers backed by host runtime operations.
//!
//! `std::output` is the public surface for stdout/stderr writes, flushing, and
//! terminal detection. Single-argument helpers default to stdout; pass
//! `StdErr {}` when you need to target stderr explicitly.

use std::bytes::Bytes
use std::error::{ IoError, IoOther }
use std::fixed_array::fns::new_fixed_array
use std::number::to_string
use std::optional::types::all
use std::result::types::all
use std::string::type::{ String, StringSlice, new_string }

pub obj StdOut {}
pub obj StdErr {}

pub type OutputTarget = StdOut | StdErr

pub obj OutputWriteRequest {
  api value: String,
  api target: String
}

pub obj OutputWriteBytesRequest {
  api bytes: Bytes,
  api target: String
}

pub obj OutputTargetRequest {
  api target: String
}

pub obj OutputResult {
  api ok: bool,
  api code: i32,
  api message: String
}

/// Host output effect used by `std::output`.
///
/// Operations in this effect forward automatic DTO values to host-managed
/// stdout and stderr streams.
@effect(id: "voyd.std.output")
pub eff Output
  /// Writes UTF-8 text to the selected output stream.
  write_op(tail, request: OutputWriteRequest) -> OutputResult
  /// Writes raw bytes to the selected output stream.
  write_bytes_op(tail, request: OutputWriteBytesRequest) -> OutputResult
  /// Flushes buffered data for the selected output stream.
  flush_op(tail, request: OutputTargetRequest) -> OutputResult
  /// Returns whether the selected stream is a terminal.
  is_tty_op(tail, request: OutputTargetRequest) -> bool

/// Shorthand for `write(value, StdOut {})`.
pub fn write(value: StringSlice): Output -> Result<Unit, IoError>
  write(value, StdOut {})

/// Shorthand for `write(value.as_slice())`.
pub fn write(value: String): Output -> Result<Unit, IoError>
  write(value.as_slice())

/// Writes UTF-8 text to `target`.
///
/// Use this overload as the canonical text-write entry point when you need to
/// choose stdout vs stderr explicitly.
pub fn write(value: StringSlice, target: OutputTarget): Output -> Result<Unit, IoError>
  decode_write_result(Output::write_op(encode_write_payload(value.to_string(), target)))

/// Shorthand for `write(value.as_slice(), target)`.
pub fn write(value: String, target: OutputTarget): Output -> Result<Unit, IoError>
  write(value.as_slice(), target)

/// Shorthand for `write_line(value, StdOut {})`.
pub fn write_line(value: StringSlice): Output -> Result<Unit, IoError>
  write_line(value, StdOut {})

/// Shorthand for `write_line(value.as_slice())`.
pub fn write_line(value: String): Output -> Result<Unit, IoError>
  write_line(value.as_slice())

/// Writes `value` followed by exactly one line-feed byte to `target`.
///
/// This is the canonical line-oriented write API for this module. It always
/// appends `\n` and does not inspect whether `value` already ends with one.
pub fn write_line(value: StringSlice, target: OutputTarget): Output -> Result<Unit, IoError>
  let line = line_string(value)
  write(line.as_slice(), target)

/// Shorthand for `write_line(value.as_slice(), target)`.
pub fn write_line(value: String, target: OutputTarget): Output -> Result<Unit, IoError>
  write_line(value.as_slice(), target)

/// Writes one whole line to stdout.
///
/// `print` is a best-effort convenience helper for debugging and scripting. It
/// intentionally ignores write failures instead of surfacing `IoError`. Use
/// `write_line` when you need to observe or handle output errors.
pub fn print(value: StringSlice): Output -> void
  match(write_line(value))
    Ok<Unit>:
      void
    Err<IoError>:
      void

/// Shorthand for `print(value.as_slice())`.
pub fn print(value: String): Output -> void
  print(value.as_slice())

/// Shorthand for `print(to_string(value))`.
pub fn print(value: i32): Output -> void
  print(to_string(value))

/// Shorthand for `print(to_string(value))`.
pub fn print(value: i64): Output -> void
  print(to_string(value))

/// Shorthand for `print(to_string(value))`.
pub fn print(value: f32): Output -> void
  print(to_string(value))

/// Shorthand for `print(to_string(value))`.
pub fn print(value: f64): Output -> void
  print(to_string(value))

/// Shorthand for `write(bytes, StdOut {})`.
pub fn write(bytes: Bytes): Output -> Result<Unit, IoError>
  write(bytes, StdOut {})

/// Writes raw bytes to `target` without UTF-8 encoding.
///
/// Use this for binary output or when text conversion would be incorrect.
pub fn write(bytes: Bytes, target: OutputTarget): Output -> Result<Unit, IoError>
  decode_write_result(Output::write_bytes_op(encode_write_bytes_payload(bytes, target)))

/// Shorthand for `flush(StdOut {})`.
pub fn flush(): Output -> Result<Unit, IoError>
  flush(StdOut {})

/// Flushes buffered output for `target`.
pub fn flush(target: OutputTarget): Output -> Result<Unit, IoError>
  decode_write_result(Output::flush_op(encode_target_payload(target)))

/// Shorthand for `is_tty(StdOut {})`.
pub fn is_tty(): Output -> bool
  is_tty(StdOut {})

/// Returns whether `target` is attached to an interactive terminal.
pub fn is_tty(target: OutputTarget): Output -> bool
  Output::is_tty_op(encode_target_payload(target))

fn encode_write_payload(value: String, target: OutputTarget): () -> OutputWriteRequest
  OutputWriteRequest { value: value, target: encode_output_target(target) }

fn line_string(value: StringSlice): () -> String
  let byte_count = value.byte_len()
  let line_bytes = new_fixed_array<i32>(byte_count + 1)
  var index = 0
  while index < byte_count:
    match(value.get_byte(index))
      Some<i32> { value: byte }:
        __array_set(line_bytes, index, byte)
      None:
        __array_set(line_bytes, index, 0)
    index = index + 1
  __array_set(line_bytes, byte_count, 10)
  new_string(line_bytes)

fn encode_write_bytes_payload(bytes: Bytes, target: OutputTarget): () -> OutputWriteBytesRequest
  OutputWriteBytesRequest { bytes: bytes, target: encode_output_target(target) }

fn encode_target_payload(target: OutputTarget): () -> OutputTargetRequest
  OutputTargetRequest { target: encode_output_target(target) }

fn encode_output_target(target: OutputTarget): () -> String
  target.match(active)
    StdOut:
      "stdout"
    StdErr:
      "stderr"

fn decode_write_result(result: OutputResult): () -> Result<Unit, IoError>
  if result.ok:
    Ok<Unit> { value: Unit {} }
  else:
    Err<IoError> {
      error: IoError {
        kind: IoOther {},
        code: result.code,
        message: result.message
      }
    }
