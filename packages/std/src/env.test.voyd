use std::error::HostError
use std::optional::types::all
use std::result::types::all
use std::string::type::String
use std::test::assertions::all

test "env get resolves same-name wrapper and decodes strings":
  let result = get_with_payload(string_payload("voyd"))
  match(result)
    Some<String> { value }:
      assert(value.equals("voyd"), eq: true)
    None:
      assert(false, eq: true)

test "env get_bool parses boolean payloads":
  let bool_result = get_bool_with_payload(string_payload("TRUE"))
  match(bool_result)
    Some<bool> { value }:
      assert(value, eq: true)
    None:
      assert(false, eq: true)

test "env get_int parses integer payloads":
  let int_result = get_int_with_payload(string_payload("42"))
  match(int_result)
    Some<i32> { value }:
      assert(value, eq: 42)
    None:
      assert(false, eq: true)

test "env set decodes host errors":
  let result = set_with_payload(EnvSetResult { ok: false, code: 9, message: "denied" })
  match(result)
    Err<HostError> { error }:
      assert(error.code, eq: 9)
      assert(error.message.equals("denied"), eq: true)
    Ok<Unit>:
      assert(false, eq: true)

fn get_with_payload(payload: EnvGetResult): () -> Option<String>
  try
    get("APP_NAME")
  Env::get(tail, _key):
    tail(payload)
  Env::set(tail, _payload):
    tail(EnvSetResult { ok: false, code: -1, message: "unused" })

fn get_bool_with_payload(payload: EnvGetResult): () -> Option<bool>
  try
    get_bool("ENABLED")
  Env::get(tail, _key):
    tail(payload)
  Env::set(tail, _payload):
    tail(EnvSetResult { ok: false, code: -1, message: "unused" })

fn get_int_with_payload(payload: EnvGetResult): () -> Option<i32>
  try
    get_int("PORT")
  Env::get(tail, _key):
    tail(payload)
  Env::set(tail, _payload):
    tail(EnvSetResult { ok: false, code: -1, message: "unused" })

fn set_with_payload(payload: EnvSetResult): () -> Result<Unit, HostError>
  try
    set("PORT", "8080")
  Env::get(tail, _key):
    tail(EnvGetResult { found: false, value: "" })
  Env::set(tail, _payload):
    tail(payload)

fn string_payload(value: String): () -> EnvGetResult
  EnvGetResult { found: true, value: value }
