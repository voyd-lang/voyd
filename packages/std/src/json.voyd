//! JSON value model and UTF-8 parser/serializer helpers.
//! Use `parse` to decode JSON text into `JsonValue` and `stringify`/`stringify_pretty`
//! to encode values back to text. Stringification is fallible because JSON
//! numbers must be finite.

use std::array::Array
use std::bytes::Bytes
use std::data::{
  ArrayKind,
  BoolKind,
  DataKind,
  DataArray,
  DataBool,
  DataBytes,
  DataF32,
  DataF64,
  DataField,
  DataI32,
  DataI64,
  DataNull,
  DataObject,
  DataString,
  DataValue,
  DataVariant,
  DataReader,
  DataWriter,
  DecodeError,
  DecodeOptions,
  IgnoreUnknownFields,
  F64Kind,
  I32Kind,
  I64Kind,
  NullKind,
  RecordKind,
  RejectUnknownFields,
  StringKind,
  VariantKind,
  UnknownFieldPolicy,
  decode as decode_data
}
use std::dict::Dict
use std::meta::{
  ArrayShape,
  BoolShape,
  BytesShape,
  F32Shape,
  F64Shape,
  I32Shape,
  I64Shape,
  RecordShape,
  RefShape,
  Shape,
  ShapeDefinition,
  ShapeField,
  ShapeNode,
  ShapeVariant,
  StringShape,
  UnionShape,
  UnitShape,
  shape_of
}
use std::math::{ floor, is_finite }
use std::number::cast::{ to_f32, to_i32_checked, to_i64_checked }
use std::number::cast::self as number_cast
use std::optional::types::all
use std::result::types::{ Result, Ok, Err, Unit }
use std::string::{ String, StringSlice, new_string }

pub obj JsonError {
  /// Machine-readable error code.
  api code: i32,
  /// Human-readable error message.
  api message: String
}

/// Direct compact-JSON sink used by compiler-generated DTO traversal.
pub obj JsonWriter {
  out: Array<i32>,
  container_kinds: Array<i32>,
  expected_values: Array<i32>,
  written_values: Array<i32>,
  pending_fields: Array<i32>,
  root_count: i32,
  failed: bool
}

impl JsonWriter
  /// Creates an empty compact JSON writer.
  pub fn init() -> JsonWriter
    JsonWriter {
      out: Array<i32>::with_capacity(64),
      container_kinds: Array<i32>::init(),
      expected_values: Array<i32>::init(),
      written_values: Array<i32>::init(),
      pending_fields: Array<i32>::init(),
      root_count: 0,
      failed: false
    }

  /// Finishes exactly one balanced JSON value.
  api fn finish(self) -> Result<String, JsonError>
    if self.failed:
      return json_writer_failure<String>("json writer session has failed")
    if self.container_kinds.is_empty() == false:
      return json_writer_failure<String>("json writer has unclosed containers")
    if self.root_count != 1:
      return json_writer_failure<String>("json writer expected one root value")
    Ok<String> { value: new_string(self.out.to_fixed_array()) }

  fn fail(~self, message: String) -> Result<Unit, JsonError>
    self.failed = true
    json_writer_failure<Unit>(message)

  fn before_value(~self) -> Result<Unit, JsonError>
    if self.failed:
      return json_writer_failure<Unit>("json writer session has failed")
    if self.container_kinds.is_empty():
      if self.root_count != 0:
        return self.fail("json writer received more than one root value")
      self.root_count = 1
      return json_writer_success()
    let index = self.container_kinds.len() - 1
    let written = self.written_values.at(index)
    if written >= self.expected_values.at(index):
      return self.fail("json writer container received too many values")
    if self.container_kinds.at(index) == 0:
      if written > 0:
        self.out.push(44)
    else:
      if self.pending_fields.at(index) == 0:
        return self.fail("json writer field is missing its descriptor")
      self.pending_fields.replace(index, with: 0)
    self.written_values.replace(index, with: written + 1)
    json_writer_success()

  fn begin_container(
    ~self,
    { kind: i32, length: i32 }
  ) -> Result<Unit, JsonError>
    if length < 0:
      return self.fail("json writer container length cannot be negative")
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        self.out.push(if kind == 0 then: 91 else: 123)
        self.container_kinds.push(kind)
        self.expected_values.push(length)
        self.written_values.push(0)
        self.pending_fields.push(0)
        json_writer_success()

  fn end_container(~self, { kind: i32 }) -> Result<Unit, JsonError>
    if self.container_kinds.is_empty():
      return self.fail("json writer has no container to close")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != kind:
      return self.fail("json writer closed a different container")
    if self.written_values.at(index) != self.expected_values.at(index) or self.pending_fields.at(index) != 0:
      return self.fail("json writer container is incomplete")
    self.container_kinds.pop()
    self.expected_values.pop()
    self.written_values.pop()
    self.pending_fields.pop()
    self.out.push(if kind == 0 then: 93 else: 125)
    json_writer_success()

  fn write_dynamic_field(~self, name: String) -> Result<Unit, JsonError>
    if self.container_kinds.is_empty():
      return self.fail("json writer field is outside a record or variant")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) == 0 or self.pending_fields.at(index) != 0:
      return self.fail("json writer field is not ready")
    if self.written_values.at(index) > 0:
      self.out.push(44)
    append_json_string(self.out, name.as_slice())
    self.out.push(58)
    self.pending_fields.replace(index, with: 1)
    json_writer_success()

impl DataWriter<JsonError> for JsonWriter
  fn write_null(~self) -> Result<Unit, JsonError>
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_ascii(self.out, "null".as_slice())
        json_writer_success()

  fn write_bool(~self, value: bool) -> Result<Unit, JsonError>
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_ascii(self.out, if value then: "true".as_slice() else: "false".as_slice())
        json_writer_success()

  fn write_i32(~self, value: i32) -> Result<Unit, JsonError>
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_string(self.out, number_cast::to_string(value).as_slice())
        json_writer_success()

  fn write_i64(~self, value: i64) -> Result<Unit, JsonError>
    let exact_max = exact_json_i64_max()
    if value < -exact_max or value > exact_max:
      return self.fail("json writer i64 exceeds the exact integer range")
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_string(self.out, number_cast::to_string(value).as_slice())
        json_writer_success()

  fn write_f32(~self, value: f32) -> Result<Unit, JsonError>
    if is_finite(value) == false:
      return self.fail("json writer number must be finite")
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_string(self.out, number_cast::to_string(value).as_slice())
        json_writer_success()

  fn write_f64(~self, value: f64) -> Result<Unit, JsonError>
    if is_finite(value) == false:
      return self.fail("json writer number must be finite")
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_string(self.out, number_cast::to_string(value).as_slice())
        json_writer_success()

  fn write_string(~self, value: String) -> Result<Unit, JsonError>
    match(self.before_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        append_json_string(self.out, value.as_slice())
        json_writer_success()

  fn write_bytes(~self, value: Bytes) -> Result<Unit, JsonError>
    self.fail("json writer bytes require an explicit representation")

  fn begin_array(~self, { length: i32 }) -> Result<Unit, JsonError>
    self.begin_container(kind: 0, length: length)

  fn end_array(~self) -> Result<Unit, JsonError>
    self.end_container(kind: 0)

  fn begin_record(
    ~self,
    { shape: RecordShape, field_count: i32 }
  ) -> Result<Unit, JsonError>
    self.begin_container(kind: 1, length: field_count)

  fn write_field(~self, { field: ShapeField }) -> Result<Unit, JsonError>
    self.write_dynamic_field(field.name)

  fn end_record(~self) -> Result<Unit, JsonError>
    self.end_container(kind: 1)

  fn begin_variant(
    ~self,
    { shape: UnionShape, variant: ShapeVariant }
  ) -> Result<Unit, JsonError>
    match(self.begin_container(kind: 2, length: variant.fields.len() + 1))
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        match(self.write_dynamic_field("$variant"))
          Err<JsonError> { error }:
            Err<JsonError> { error }
          Ok<Unit>:
            self.write_string(variant.name)

  fn end_variant(~self) -> Result<Unit, JsonError>
    self.end_container(kind: 2)

fn json_writer_success() -> Result<Unit, JsonError>
  Ok<Unit> { value: Unit {} }

fn json_writer_failure<T>(message: String) -> Result<T, JsonError>
  Err<JsonError> { error: json_stringify_error(message) }

/// The JSON text itself was malformed.
pub obj JsonParseFailure {}

/// A parsed value did not match the requested Voyd type.
pub obj JsonSchemaFailure {}

/// A versioned document could not be dispatched or migrated.
pub obj JsonVersionFailure {}

/// A decoded number violated an explicit application constraint.
pub obj JsonConstraintFailure {}

/// Stable categories for typed JSON decoding failures.
pub type JsonDecodeErrorKind = JsonParseFailure
  | JsonSchemaFailure
  | JsonVersionFailure
  | JsonConstraintFailure

/// Typed JSON failure with a rooted JSON path and retained cause text.
pub obj JsonDecodeError {
  api kind: JsonDecodeErrorKind,
  api path: String,
  api message: String
}

/// Unknown-field behavior used by typed JSON decoding.
pub obj JsonDecodeOptions {
  api unknown_fields: UnknownFieldPolicy
}

/// Migration callback for a parsed versioned document.
pub type JsonMigration = fn(
  version: i32,
  document: JsonValue
) -> Result<JsonValue, JsonDecodeError>

/// Represents the JSON `null` literal.
pub obj JsonNull {}

/// Represents a JSON boolean literal.
pub obj JsonBool {
  /// Stored boolean payload.
  api value: bool
}

/// Represents a JSON number.
pub obj JsonNumber {
  /// Stored numeric payload.
  api value: f64
}

/// Represents a JSON string.
pub obj JsonString {
  /// Stored string payload.
  api value: String
}

/// Represents a JSON array.
pub obj JsonArray {
  /// Stored element values.
  api value: Array<JsonValue>
}

/// Represents a JSON object keyed by strings.
pub obj JsonObject {
  /// Stored object fields.
  api value: Dict<String, JsonValue>
}

/// Tagged union over all supported JSON value variants.
pub type JsonValue = JsonNull | JsonBool | JsonNumber | JsonString | JsonArray | JsonObject

obj JsonParser {
  source: StringSlice,
  index: i32
}

obj JsonEscapeState {
  out: Array<i32>,
  parser: JsonParser
}

/// Pull reader over one JSON source without constructing a `JsonValue` tree.
pub obj JsonReader {
  parser: JsonParser,
  container_kinds: Array<i32>,
  consumed_values: Array<i32>,
  pending_fields: Array<i32>,
  root_consumed: bool,
  failed: bool
}

impl JsonReader
  /// Creates a reader over borrowed JSON source text.
  pub fn init(source: StringSlice) -> JsonReader
    JsonReader {
      parser: JsonParser { source, index: 0 },
      container_kinds: Array<i32>::init(),
      consumed_values: Array<i32>::init(),
      pending_fields: Array<i32>::init(),
      root_consumed: false,
      failed: false
    }

  /// Creates a reader over owned JSON source text.
  pub fn init(source: String) -> JsonReader
    JsonReader::init(source.as_slice())

  /// Returns true after one balanced root and all source text are consumed.
  api fn is_complete(self) -> bool
    if self.failed or self.root_consumed == false or self.container_kinds.is_empty() == false:
      return false
    let ~probe = JsonParser {
      source: self.parser.source,
      index: self.parser.index
    }
    skip_whitespace(probe)
    probe.index == probe.source.byte_len()

  fn fail<T>(~self, message: String) -> Result<T, JsonError>
    self.failed = true
    json_reader_failure<T>(message)

  fn prepare_value(~self) -> Result<Unit, JsonError>
    if self.failed:
      return json_reader_failure<Unit>("json reader session has failed")
    skip_whitespace(self.parser)
    if self.container_kinds.is_empty():
      if self.root_consumed:
        return self.fail<Unit>("json reader received more than one root value")
      self.root_consumed = true
      return json_reader_success()
    let index = self.container_kinds.len() - 1
    let kind = self.container_kinds.at(index)
    let consumed = self.consumed_values.at(index)
    if kind == 0:
      if consumed > 0:
        if consume_byte(self.parser, 44) == false:
          return self.fail<Unit>("json reader expected ',' between array values")
        skip_whitespace(self.parser)
      self.consumed_values.replace(index, with: consumed + 1)
      return json_reader_success()
    if self.pending_fields.at(index) == 0:
      return self.fail<Unit>("json reader field is missing its descriptor")
    self.pending_fields.replace(index, with: 0)
    self.consumed_values.replace(index, with: consumed + 1)
    json_reader_success()

  fn begin_container(~self, { kind: i32 }) -> Result<Unit, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        let opening = if kind == 0 then: 91 else: 123
        if consume_byte(self.parser, opening) == false:
          return self.fail<Unit>("json reader expected a container")
        self.container_kinds.push(kind)
        self.consumed_values.push(0)
        self.pending_fields.push(0)
        json_reader_success()

  fn end_container(~self, { kind: i32 }) -> Result<Unit, JsonError>
    if self.container_kinds.is_empty():
      return self.fail<Unit>("json reader has no container to close")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != kind:
      return self.fail<Unit>("json reader closed a different container")
    if self.pending_fields.at(index) != 0:
      return self.fail<Unit>("json reader field has no value")
    skip_whitespace(self.parser)
    let closing = if kind == 0 then: 93 else: 125
    if consume_byte(self.parser, closing) == false:
      return self.fail<Unit>("json reader container has unread values")
    self.container_kinds.pop()
    self.consumed_values.pop()
    self.pending_fields.pop()
    json_reader_success()

  fn read_number_value(~self) -> Result<f64, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        match(parse_number(self.parser))
          Err<JsonError> { error }:
            self.failed = true
            Err<JsonError> { error }
          Ok<JsonValue> { value }:
            value.match(number)
              JsonNumber:
                Ok<f64> { value: number.value }
              else:
                self.fail<f64>("json reader expected number")

impl DataReader<JsonError> for JsonReader
  fn kind(self) -> Result<DataKind, JsonError>
    let ~probe = JsonParser {
      source: self.parser.source,
      index: self.parser.index
    }
    skip_whitespace(probe)
    if self.container_kinds.is_empty() == false:
      let index = self.container_kinds.len() - 1
      if self.container_kinds.at(index) == 0 and self.consumed_values.at(index) > 0:
        if consume_byte(probe, 44) == false:
          return json_reader_failure<DataKind>("json reader expected ',' between array values")
        skip_whitespace(probe)
    match(peek(probe))
      None:
        json_reader_failure<DataKind>("json reader has no current value")
      Some<i32> { value: byte }:
        if byte == 110:
          return Ok<DataKind> { value: NullKind {} }
        if byte == 116 or byte == 102:
          return Ok<DataKind> { value: BoolKind {} }
        if byte == 34:
          return Ok<DataKind> { value: StringKind {} }
        if byte == 91:
          return Ok<DataKind> { value: ArrayKind {} }
        if byte == 123:
          if json_object_starts_variant(probe):
            return Ok<DataKind> { value: VariantKind {} }
          return Ok<DataKind> { value: RecordKind {} }
        match(parse_number(probe))
          Err<JsonError> { error }:
            Err<JsonError> { error }
          Ok<JsonValue> { value }:
            value.match(number)
              JsonNumber:
                if is_integral(number.value):
                  match(to_i32_checked(number.value))
                    Ok<i32>:
                      return Ok<DataKind> { value: I32Kind {} }
                    Err:
                      match(to_i64_checked(number.value))
                        Ok<i64>:
                          return Ok<DataKind> { value: I64Kind {} }
                        Err:
                          void
                Ok<DataKind> { value: F64Kind {} }
              else:
                json_reader_failure<DataKind>("json reader expected a value")

  fn read_null(~self) -> Result<Unit, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        if consume_literal(self.parser, "null".as_slice()):
          return json_reader_success()
        self.fail<Unit>("json reader expected null")

  fn read_bool(~self) -> Result<bool, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        if consume_literal(self.parser, "true".as_slice()):
          return Ok<bool> { value: true }
        if consume_literal(self.parser, "false".as_slice()):
          return Ok<bool> { value: false }
        self.fail<bool>("json reader expected bool")

  fn read_i32(~self) -> Result<i32, JsonError>
    match(self.read_number_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<f64> { value }:
        if is_integral(value):
          match(to_i32_checked(value))
            Ok<i32> { value }:
              return Ok<i32> { value }
            Err:
              void
        self.fail<i32>("json reader expected a 32-bit integer")

  fn read_i64(~self) -> Result<i64, JsonError>
    match(self.read_number_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<f64> { value }:
        if is_integral(value):
          match(to_i64_checked(value))
            Ok<i64> { value }:
              return Ok<i64> { value }
            Err:
              void
        self.fail<i64>("json reader expected a 64-bit integer")

  fn read_f32(~self) -> Result<f32, JsonError>
    match(self.read_number_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<f64> { value }:
        let narrowed = to_f32(value)
        if is_finite(narrowed):
          return Ok<f32> { value: narrowed }
        self.fail<f32>("json reader expected a finite 32-bit number")

  fn read_f64(~self) -> Result<f64, JsonError>
    self.read_number_value()

  fn read_string(~self) -> Result<String, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        match(parse_string(self.parser))
          Err<JsonError> { error }:
            self.failed = true
            Err<JsonError> { error }
          Ok<String> { value }:
            Ok<String> { value }

  fn read_bytes(~self) -> Result<Bytes, JsonError>
    self.fail<Bytes>("json reader bytes require an explicit representation")

  fn begin_array(~self) -> Result<i32, JsonError>
    match(self.begin_container(kind: 0))
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        let ~probe = JsonParser {
          source: self.parser.source,
          index: self.parser.index
        }
        match(count_json_array_values(probe))
          Err<JsonError> { error }:
            self.failed = true
            Err<JsonError> { error }
          Ok<i32> { value }:
            Ok<i32> { value }

  fn has_next_element(self) -> Result<bool, JsonError>
    if self.container_kinds.is_empty():
      return json_reader_failure<bool>("json reader is outside an array")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != 0:
      return json_reader_failure<bool>("json reader is outside an array")
    let ~probe = JsonParser {
      source: self.parser.source,
      index: self.parser.index
    }
    skip_whitespace(probe)
    if self.consumed_values.at(index) > 0:
      if consume_byte(probe, 44) == false:
        return Ok<bool> { value: false }
      skip_whitespace(probe)
    Ok<bool> { value: peek_byte_or(probe, -1) != 93 }

  fn end_array(~self) -> Result<Unit, JsonError>
    self.end_container(kind: 0)

  fn begin_record(~self) -> Result<Unit, JsonError>
    self.begin_container(kind: 1)

  fn next_field(~self) -> Result<Option<String>, JsonError>
    if self.container_kinds.is_empty():
      return self.fail<Option<String>>("json reader is outside a record")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) == 0:
      return self.fail<Option<String>>("json reader is outside a record")
    if self.container_kinds.at(index) == 3:
      return Ok<Option<String>> { value: None {} }
    if self.pending_fields.at(index) != 0:
      return self.fail<Option<String>>("json reader field has no value")
    skip_whitespace(self.parser)
    if self.consumed_values.at(index) > 0:
      if peek_byte_or(self.parser, -1) == 125:
        return Ok<Option<String>> { value: None {} }
      if consume_byte(self.parser, 44) == false:
        return self.fail<Option<String>>("json reader expected ',' between fields")
      skip_whitespace(self.parser)
    else:
      if peek_byte_or(self.parser, -1) == 125:
        return Ok<Option<String>> { value: None {} }
    match(parse_string(self.parser))
      Err<JsonError> { error }:
        self.failed = true
        Err<JsonError> { error }
      Ok<String> { value: name }:
        skip_whitespace(self.parser)
        if consume_byte(self.parser, 58) == false:
          return self.fail<Option<String>>("json reader expected ':' after a field")
        self.pending_fields.replace(index, with: 1)
        Ok<Option<String>> { value: Some<String> { value: name } }

  fn skip_value(~self) -> Result<Unit, JsonError>
    match(self.prepare_value())
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        match(skip_json_value(self.parser))
          Err<JsonError> { error }:
            self.failed = true
            Err<JsonError> { error }
          Ok<Unit>:
            json_reader_success()

  fn end_record(~self) -> Result<Unit, JsonError>
    self.end_container(kind: 1)

  fn begin_variant(~self) -> Result<String, JsonError>
    let ~probe = JsonParser {
      source: self.parser.source,
      index: self.parser.index
    }
    skip_whitespace(probe)
    if peek_byte_or(probe, -1) == 34:
      match(self.prepare_value())
        Err<JsonError> { error }:
          return Err<JsonError> { error }
        Ok<Unit>:
          match(parse_string(self.parser))
            Err<JsonError> { error }:
              self.failed = true
              return Err<JsonError> { error }
            Ok<String> { value }:
              self.container_kinds.push(3)
              self.consumed_values.push(0)
              self.pending_fields.push(0)
              return Ok<String> { value }
    match(self.begin_container(kind: 2))
      Err<JsonError> { error }:
        Err<JsonError> { error }
      Ok<Unit>:
        match(self.next_field())
          Err<JsonError> { error }:
            Err<JsonError> { error }
          Ok<Option<String>> { value }:
            value.match(field)
              None:
                self.fail<String>("json reader variant discriminator is missing")
              Some<String>:
                if field.value != "$variant":
                  return self.fail<String>("json reader expected the variant tag first")
                self.read_string()

  fn end_variant(~self) -> Result<Unit, JsonError>
    if self.container_kinds.is_empty() == false:
      let index = self.container_kinds.len() - 1
      if self.container_kinds.at(index) == 3:
        self.container_kinds.pop()
        self.consumed_values.pop()
        self.pending_fields.pop()
        return json_reader_success()
    self.end_container(kind: 2)

fn json_reader_success() -> Result<Unit, JsonError>
  Ok<Unit> { value: Unit {} }

fn json_reader_failure<T>(message: String) -> Result<T, JsonError>
  Err<JsonError> { error: json_parse_error(message) }

/// Parses UTF-8 JSON text into a `JsonValue`.
///
/// Params:
/// - `source`: JSON source text.
///
/// Returns:
/// - `Ok<JsonValue>` when the full input parses successfully.
/// - `Err<JsonError>` for malformed JSON or trailing characters.
///
/// Example:
/// ```voyd
/// use std::json
///
/// let parsed = json::parse("{\"ok\":true}")
/// ```
pub fn parse(source: String) -> Result<JsonValue, JsonError>
  parse(source.as_slice())

pub fn parse(source: StringSlice) -> Result<JsonValue, JsonError>
  let ~parser = JsonParser { source: source, index: 0 }
  skip_whitespace(parser)
  let value_result = parse_value(parser)
  match(value_result)
    Ok<JsonValue> { value }:
      skip_whitespace(parser)
      if parser.index != parser.source.byte_len():
        return Err<JsonError> { error: json_parse_error("json parse error: trailing characters") }
      Ok<JsonValue> { value: value }
    Err<JsonError> { error }:
      Err<JsonError> { error: error }

/// Serializes a `JsonValue` to compact JSON text.
///
/// Params:
/// - `value`: JSON value to serialize.
///
/// Returns `Err(JsonError)` when serialization would produce invalid JSON, such
/// as a `JsonNumber` containing `NaN` or infinity.
///
/// Example:
/// ```voyd
/// use std::json
///
/// let text = json::stringify(JsonBool { value: true })
/// ```
pub fn stringify(value: JsonValue) -> Result<String, JsonError>
  let ~bytes = Array<i32>::with_capacity(64)
  match(write_json_value(bytes, value, false, 0))
    Ok<Unit>:
      Ok<String> { value: new_string(bytes.to_fixed_array()) }
    Err<JsonError> { error }:
      Err<JsonError> { error: error }

/// Serializes a `JsonValue` to pretty JSON text with indentation.
///
/// Params:
/// - `value`: JSON value to serialize.
///
/// Returns `Err(JsonError)` when serialization would produce invalid JSON.
pub fn stringify_pretty(value: JsonValue) -> Result<String, JsonError>
  let ~bytes = Array<i32>::with_capacity(64)
  match(write_json_value(bytes, value, true, 0))
    Ok<Unit>:
      Ok<String> { value: new_string(bytes.to_fixed_array()) }
    Err<JsonError> { error }:
      Err<JsonError> { error: error }

/// Returns strict typed-decoder options that reject unknown record fields.
pub fn strict_decode_options() -> JsonDecodeOptions
  JsonDecodeOptions { unknown_fields: RejectUnknownFields {} }

/// Returns forward-compatible typed-decoder options that ignore unknown fields.
pub fn permissive_decode_options() -> JsonDecodeOptions
  JsonDecodeOptions { unknown_fields: IgnoreUnknownFields {} }

/// Encodes a DTO-compatible value as compact JSON text.
///
/// Signed 64-bit integers outside JavaScript's exact integer range are
/// rejected. `Bytes` requires an explicit application representation.
pub fn encode<T>(value: T): () -> Result<String, JsonError>
  let ~writer = JsonWriter::init()
  match(write_data_value_json(writer, dto_value_to_data(value)))
    Err<JsonError> { error }:
      Err<JsonError> { error }
    Ok<Unit>:
      writer.finish()

/// Parses and strictly decodes JSON into a closed boundary-compatible type.
pub fn decode<T>(source: String): () -> Result<T, JsonDecodeError>
  decode<T>(source.as_slice())

/// Parses and strictly decodes a borrowed JSON source.
pub fn decode<T>(source: StringSlice): () -> Result<T, JsonDecodeError>
  decode<T>(source, options: strict_decode_options())

/// Parses and decodes JSON with an explicit unknown-field policy.
pub fn decode<T>(
  source: String,
  { options: JsonDecodeOptions }
): () -> Result<T, JsonDecodeError>
  decode<T>(source.as_slice(), options: options)

/// Parses and decodes borrowed JSON with an explicit unknown-field policy.
pub fn decode<T>(
  source: StringSlice,
  { options: JsonDecodeOptions }
): () -> Result<T, JsonDecodeError>
  let shape = shape_of<T>()
  let ~reader = JsonReader::init(source)
  match(json_reader_to_data(
    reader,
    shape.root,
    shape,
    "$",
    options.unknown_fields
  ))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<DataValue> { value }:
      if reader.is_complete() == false:
        return decode_failure<T>(
          JsonParseFailure {},
          "$",
          "json parse error: trailing characters"
        )
      decode_data_result<T>(value, options)

/// Strictly decodes an already-parsed JSON value.
pub fn decode<T>(value: JsonValue): () -> Result<T, JsonDecodeError>
  decode<T>(value, options: strict_decode_options())

/// Decodes an already-parsed JSON value with explicit field policy.
pub fn decode<T>(
  value: JsonValue,
  { options: JsonDecodeOptions }
): () -> Result<T, JsonDecodeError>
  let shape = shape_of<T>()
  match(json_value_to_data(value, shape.root, shape, "$"))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<DataValue> { value: data_value }:
      decode_data_result<T>(data_value, options)

/// Decodes a versioned document and requires migrations to produce `current`.
pub fn decode_versioned<T>(
  source: String,
  {
    current current_version: i32,
    migrate: JsonMigration
  }
): () -> Result<T, JsonDecodeError>
  decode_versioned<T>(
    source.as_slice(),
    current: current_version,
    migrate: migrate
  )

/// Decodes a borrowed versioned document with explicit migration dispatch.
pub fn decode_versioned<T>(
  source: StringSlice,
  {
    current current_version: i32,
    migrate: JsonMigration
  }
): () -> Result<T, JsonDecodeError>
  match(parse(source))
    Err<JsonError> { error }:
      decode_failure<T>(JsonParseFailure {}, "$", error.message)
    Ok<JsonValue> { value: document }:
      decode_versioned<T>(
        document,
        current: current_version,
        migrate: migrate
      )

/// Decodes an already-parsed versioned document with explicit migration dispatch.
pub fn decode_versioned<T>(
  document: JsonValue,
  {
    current current_version: i32,
    migrate: JsonMigration
  }
): () -> Result<T, JsonDecodeError>
  match(document_version(document))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<i32> { value: version }:
      if version == current_version:
        return decode<T>(document)
      match(migrate(version, document))
        Err<JsonDecodeError> { error }:
          Err<JsonDecodeError> { error }
        Ok<JsonValue> { value: migrated }:
          match(document_version(migrated))
            Err<JsonDecodeError> { error }:
              Err<JsonDecodeError> { error }
            Ok<i32> { value: migrated_version }:
              if migrated_version != current_version:
                return decode_failure<T>(
                  JsonVersionFailure {},
                  "$.version",
                  "migration did not produce the requested document version"
                )
              decode<T>(migrated)

/// Reads a JSON number and enforces an inclusive finite range.
pub fn number_in_range(
  value: JsonValue,
  { at path: String, min: f64, max: f64 }
): () -> Result<f64, JsonDecodeError>
  value.match(decoded)
    JsonNumber:
      if is_finite(decoded.value) and decoded.value >= min and decoded.value <= max:
        Ok<f64> { value: decoded.value }
      else:
        decode_failure<f64>(
          JsonConstraintFailure {},
          path,
          "number is outside the allowed range"
        )
    else:
      decode_failure<f64>(JsonSchemaFailure {}, path, "expected number")

/// Reads a ranged JSON number using a borrowed path.
pub fn number_in_range(
  value: JsonValue,
  { at path: StringSlice, min: f64, max: f64 }
): () -> Result<f64, JsonDecodeError>
  number_in_range(value, at: path.to_string(), min: min, max: max)

fn decode_data_result<T>(
  data_value: DataValue,
  options: JsonDecodeOptions
) -> Result<T, JsonDecodeError>
  match(decode_data<T>(
    data_value,
    options: DecodeOptions { unknown_fields: options.unknown_fields }
  ))
    Ok<T> { value }:
      Ok<T> { value }
    Err<DecodeError> { error }:
      decode_failure<T>(
        JsonSchemaFailure {},
        error.path,
        "expected ".concat(error.expected).concat(", received ").concat(error.actual)
      )

fn json_reader_to_data(
  ~reader: JsonReader,
  shape: ShapeNode,
  graph: Shape,
  path: String,
  unknown_fields: UnknownFieldPolicy
): () -> Result<DataValue, JsonDecodeError>
  shape.match(active)
    BoolShape:
      match(reader.read_bool())
        Ok<bool> { value }:
          Ok<DataValue> { value: DataBool { value } }
        Err<JsonError>:
          schema_mismatch(path, "boolean")
    I32Shape:
      match(reader.read_i32())
        Ok<i32> { value }:
          Ok<DataValue> { value: DataI32 { value } }
        Err<JsonError>:
          schema_mismatch(path, "32-bit integer")
    I64Shape:
      match(reader.read_i64())
        Ok<i64> { value }:
          Ok<DataValue> { value: DataI64 { value } }
        Err<JsonError>:
          schema_mismatch(path, "64-bit integer")
    F32Shape:
      match(reader.read_f32())
        Ok<f32> { value }:
          Ok<DataValue> { value: DataF32 { value } }
        Err<JsonError>:
          schema_mismatch(path, "finite 32-bit number")
    F64Shape:
      match(reader.read_f64())
        Ok<f64> { value }:
          Ok<DataValue> { value: DataF64 { value } }
        Err<JsonError>:
          schema_mismatch(path, "number")
    StringShape:
      match(reader.read_string())
        Ok<String> { value }:
          Ok<DataValue> { value: DataString { value } }
        Err<JsonError>:
          schema_mismatch(path, "string")
    BytesShape:
      schema_mismatch(path, "bytes require an explicit JSON representation")
    UnitShape:
      match(reader.read_null())
        Ok<Unit>:
          Ok<DataValue> { value: DataNull {} }
        Err<JsonError>:
          schema_mismatch(path, "null")
    ArrayShape:
      match(reader.begin_array())
        Err<JsonError>:
          schema_mismatch(path, "array")
        Ok<i32> { value: length }:
          let ~values = Array<DataValue>::with_capacity(length)
          var index = 0
          while index < length:
            match(json_reader_to_data(
              reader,
              active.element,
              graph,
              json_index_path(path, index),
              unknown_fields
            ))
              Err<JsonDecodeError> { error }:
                return Err<JsonDecodeError> { error }
              Ok<DataValue> { value }:
                values.push(value)
            index = index + 1
          match(reader.end_array())
            Err<JsonError> { error }:
              decode_failure<DataValue>(JsonParseFailure {}, path, error.message)
            Ok<Unit>:
              Ok<DataValue> { value: DataArray { values } }
    RecordShape:
      json_reader_record_to_data(
        reader,
        active.fields,
        graph,
        path,
        unknown_fields
      )
    UnionShape:
      json_reader_variant_to_data(reader, active, graph, path, unknown_fields)
    RefShape:
      match(find_shape_definition(graph.definitions, active.key))
        Some<ShapeNode> { value: target }:
          json_reader_to_data(reader, target, graph, path, unknown_fields)
        None:
          decode_failure<DataValue>(
            JsonSchemaFailure {},
            path,
            "type shape contains an unresolved reference"
          )

fn json_reader_record_to_data(
  ~reader: JsonReader,
  fields: Array<ShapeField>,
  graph: Shape,
  path: String,
  unknown_fields: UnknownFieldPolicy
) -> Result<DataValue, JsonDecodeError>
  match(reader.begin_record())
    Err<JsonError>:
      schema_mismatch(path, "object")
    Ok<Unit>:
      let ~out = Array<DataField>::with_capacity(fields.len())
      while true:
        match(reader.next_field())
          Err<JsonError> { error }:
            return decode_failure<DataValue>(JsonParseFailure {}, path, error.message)
          Ok<Option<String>> { value }:
            value.match(next)
              None:
                break
              Some<String>:
                let name = next.value
                let nested_path = json_field_path(path, name)
                match(find_shape_field(fields, name))
                  Some<ShapeField> { value: field }:
                    match(json_reader_to_data(
                      reader,
                      field.shape,
                      graph,
                      nested_path,
                      unknown_fields
                    ))
                      Err<JsonDecodeError> { error }:
                        return Err<JsonDecodeError> { error }
                      Ok<DataValue> { value }:
                        out.push(DataField { name, value })
                  None:
                    if rejects_unknown_fields(unknown_fields):
                      return decode_failure<DataValue>(
                        JsonSchemaFailure {},
                        nested_path,
                        "unknown field"
                      )
                    match(reader.skip_value())
                      Err<JsonError> { error }:
                        return decode_failure<DataValue>(
                          JsonParseFailure {},
                          nested_path,
                          error.message
                        )
                      Ok<Unit>:
                        void
      match(reader.end_record())
        Err<JsonError> { error }:
          decode_failure<DataValue>(JsonParseFailure {}, path, error.message)
        Ok<Unit>:
          Ok<DataValue> { value: DataObject { fields: out } }

fn json_reader_variant_to_data(
  ~reader: JsonReader,
  shape: UnionShape,
  graph: Shape,
  path: String,
  unknown_fields: UnknownFieldPolicy
) -> Result<DataValue, JsonDecodeError>
  match(reader.begin_variant())
    Err<JsonError>:
      schema_mismatch(path, "variant object")
    Ok<String> { value: name }:
      match(find_shape_variant(shape.variants, name))
        None:
          decode_failure<DataValue>(
            JsonSchemaFailure {},
            json_field_path(path, "$variant"),
            "unknown variant ".concat(name)
          )
        Some<ShapeVariant> { value: variant }:
          let ~out = Array<DataField>::with_capacity(variant.fields.len())
          while true:
            match(reader.next_field())
              Err<JsonError> { error }:
                return decode_failure<DataValue>(JsonParseFailure {}, path, error.message)
              Ok<Option<String>> { value }:
                value.match(next)
                  None:
                    break
                  Some<String>:
                    let field_name = next.value
                    let nested_path = json_field_path(path, field_name)
                    match(find_shape_field(variant.fields, field_name))
                      Some<ShapeField> { value: field }:
                        match(json_reader_to_data(
                          reader,
                          field.shape,
                          graph,
                          nested_path,
                          unknown_fields
                        ))
                          Err<JsonDecodeError> { error }:
                            return Err<JsonDecodeError> { error }
                          Ok<DataValue> { value }:
                            out.push(DataField { name: field_name, value })
                      None:
                        if rejects_unknown_fields(unknown_fields):
                          return decode_failure<DataValue>(
                            JsonSchemaFailure {},
                            nested_path,
                            "unknown field"
                          )
                        match(reader.skip_value())
                          Err<JsonError> { error }:
                            return decode_failure<DataValue>(
                              JsonParseFailure {},
                              nested_path,
                              error.message
                            )
                          Ok<Unit>:
                            void
          match(reader.end_variant())
            Err<JsonError> { error }:
              decode_failure<DataValue>(JsonParseFailure {}, path, error.message)
            Ok<Unit>:
              Ok<DataValue> {
                value: DataVariant { name: variant.name, fields: out }
              }

fn rejects_unknown_fields(policy: UnknownFieldPolicy) -> bool
  policy.match(active)
    RejectUnknownFields:
      true
    IgnoreUnknownFields:
      false

fn json_value_to_data(
  value: JsonValue,
  shape: ShapeNode,
  graph: Shape,
  path: String
): () -> Result<DataValue, JsonDecodeError>
  shape.match(active)
    BoolShape:
      value.match(decoded)
        JsonBool:
          Ok<DataValue> { value: DataBool { value: decoded.value } }
        else:
          schema_mismatch(path, "boolean")
    I32Shape:
      value.match(decoded)
        JsonNumber:
          if is_integral(decoded.value):
            match(to_i32_checked(decoded.value))
              Ok<i32> { value }:
                Ok<DataValue> { value: DataI32 { value } }
              Err:
                schema_mismatch(path, "32-bit integer")
          else:
            schema_mismatch(path, "32-bit integer")
        else:
          schema_mismatch(path, "32-bit integer")
    I64Shape:
      value.match(decoded)
        JsonNumber:
          if is_integral(decoded.value):
            match(to_i64_checked(decoded.value))
              Ok<i64> { value }:
                Ok<DataValue> { value: DataI64 { value } }
              Err:
                schema_mismatch(path, "64-bit integer")
          else:
            schema_mismatch(path, "64-bit integer")
        else:
          schema_mismatch(path, "64-bit integer")
    F32Shape:
      value.match(decoded)
        JsonNumber:
          let demoted = to_f32(decoded.value)
          if is_finite(demoted):
            Ok<DataValue> { value: DataF32 { value: demoted } }
          else:
            schema_mismatch(path, "finite 32-bit number")
        else:
          schema_mismatch(path, "number")
    F64Shape:
      value.match(decoded)
        JsonNumber:
          Ok<DataValue> { value: DataF64 { value: decoded.value } }
        else:
          schema_mismatch(path, "number")
    StringShape:
      value.match(decoded)
        JsonString:
          Ok<DataValue> { value: DataString { value: decoded.value } }
        else:
          schema_mismatch(path, "string")
    BytesShape:
      schema_mismatch(path, "bytes require an explicit JSON representation")
    UnitShape:
      value.match(decoded)
        JsonNull:
          Ok<DataValue> { value: DataNull {} }
        else:
          schema_mismatch(path, "null")
    ArrayShape:
      value.match(decoded)
        JsonArray:
          json_array_to_data(decoded, active.element, graph, path)
        else:
          schema_mismatch(path, "array")
    RecordShape:
      value.match(decoded)
        JsonObject:
          json_object_to_data(decoded, active.fields, graph, path)
        else:
          schema_mismatch(path, "object")
    UnionShape:
      json_union_to_data(value, active, graph, path)
    RefShape:
      match(find_shape_definition(graph.definitions, active.key))
        Some<ShapeNode> { value: target }:
          json_value_to_data(value, target, graph, path)
        None:
          decode_failure<DataValue>(
            JsonSchemaFailure {},
            path,
            "type shape contains an unresolved reference"
          )

fn data_value_to_json(
  value: DataValue,
  path: String
): () -> Result<JsonValue, JsonError>
  value.match(decoded)
    DataNull:
      Ok<JsonValue> { value: JsonNull {} }
    DataBool:
      Ok<JsonValue> { value: JsonBool { value: decoded.value } }
    DataI32:
      Ok<JsonValue> {
        value: JsonNumber { value: number_cast::to_f64(decoded.value) }
      }
    DataI64:
      let exact_max = exact_json_i64_max()
      if decoded.value < -exact_max or decoded.value > exact_max:
        Err<JsonError> {
          error: json_stringify_error(
            "json encode failed at ".concat(path).concat(
              ": i64 is outside the exact JSON integer range"
            )
          )
        }
      else:
        Ok<JsonValue> {
          value: JsonNumber { value: number_cast::to_f64(decoded.value) }
        }
    DataF32:
      Ok<JsonValue> {
        value: JsonNumber { value: number_cast::to_f64(decoded.value) }
      }
    DataF64:
      Ok<JsonValue> { value: JsonNumber { value: decoded.value } }
    DataString:
      Ok<JsonValue> { value: JsonString { value: decoded.value } }
    DataBytes:
      Err<JsonError> {
        error: json_stringify_error(
          "json encode failed at ".concat(path).concat(
            ": bytes require an explicit JSON representation"
          )
        )
      }
    DataArray:
      data_array_to_json(decoded, path)
    DataObject:
      data_fields_to_json(decoded.fields, path)
    DataVariant:
      data_variant_to_json(decoded, path)

fn write_data_value_json(
  ~writer: JsonWriter,
  value: DataValue
) -> Result<Unit, JsonError>
  value.match(data)
    DataNull:
      writer.write_null()
    DataBool:
      writer.write_bool(data.value)
    DataI32:
      writer.write_i32(data.value)
    DataI64:
      writer.write_i64(data.value)
    DataF32:
      writer.write_f32(data.value)
    DataF64:
      writer.write_f64(data.value)
    DataString:
      writer.write_string(data.value)
    DataBytes:
      writer.write_bytes(data.value)
    DataArray:
      match(writer.begin_array(length: data.values.len()))
        Err<JsonError> { error }:
          Err<JsonError> { error }
        Ok<Unit>:
          var index = 0
          while index < data.values.len():
            match(write_data_value_json(writer, data.values.at(index)))
              Err<JsonError> { error }:
                return Err<JsonError> { error }
              Ok<Unit>:
                void
            index = index + 1
          writer.end_array()
    DataObject:
      write_data_fields_json(writer, data.fields, variant_name: None {})
    DataVariant:
      write_data_fields_json(
        writer,
        data.fields,
        variant_name: Some<String> { value: data.name }
      )

fn write_data_fields_json(
  ~writer: JsonWriter,
  fields: Array<DataField>,
  { variant_name: Option<String> }
) -> Result<Unit, JsonError>
  let extra = variant_name.match(value)
    Some<String>: 1
    None: 0
  let kind = if extra == 1 then: 2 else: 1
  match(writer.begin_container(kind: kind, length: fields.len() + extra))
    Err<JsonError> { error }:
      Err<JsonError> { error }
    Ok<Unit>:
      match(variant_name)
        Some<String> { value: name }:
          match(writer.write_dynamic_field("$variant"))
            Err<JsonError> { error }:
              return Err<JsonError> { error }
            Ok<Unit>:
              match(writer.write_string(name))
                Err<JsonError> { error }:
                  return Err<JsonError> { error }
                Ok<Unit>:
                  void
        None:
          void
      var index = 0
      while index < fields.len():
        let field = fields.at(index)
        match(writer.write_dynamic_field(field.name))
          Err<JsonError> { error }:
            return Err<JsonError> { error }
          Ok<Unit>:
            match(write_data_value_json(writer, field.value))
              Err<JsonError> { error }:
                return Err<JsonError> { error }
              Ok<Unit>:
                void
        index = index + 1
      writer.end_container(kind: kind)

fn data_array_to_json(
  value: DataArray,
  path: String
): () -> Result<JsonValue, JsonError>
  let ~out = Array<JsonValue>::with_capacity(value.values.len())
  var index = 0
  while index < value.values.len():
    match(data_value_to_json(value.values.at(index), index_path(path, index)))
      Err<JsonError> { error }:
        return Err<JsonError> { error }
      Ok<JsonValue> { value }:
        out.push(value)
    index = index + 1
  Ok<JsonValue> { value: JsonArray { value: out } }

fn data_fields_to_json(
  fields: Array<DataField>,
  path: String
): () -> Result<JsonValue, JsonError>
  let ~out = Dict<String, JsonValue>::init()
  var index = 0
  while index < fields.len():
    let field = fields.at(index)
    match(data_value_to_json(field.value, field_path(path, field.name)))
      Err<JsonError> { error }:
        return Err<JsonError> { error }
      Ok<JsonValue> { value }:
        out.set(field.name, value)
    index = index + 1
  Ok<JsonValue> { value: JsonObject { value: out } }

fn data_variant_to_json(
  value: DataVariant,
  path: String
): () -> Result<JsonValue, JsonError>
  match(data_fields_to_json(value.fields, path))
    Err<JsonError> { error }:
      Err<JsonError> { error }
    Ok<JsonValue> { value: object }:
      object.match(decoded)
        JsonObject:
          Ok<JsonValue> {
            value: JsonObject {
              value: decoded.value.setting(
                "$variant",
                JsonString { value: value.name }
              )
            }
          }
        else:
          Err<JsonError> {
            error: json_stringify_error("json encode failed: invalid variant")
          }

fn field_path(path: String, field: String) -> String
  path.concat(".").concat(field)

fn index_path(path: String, index: i32) -> String
  path.concat("[").concat(number_cast::to_string(index)).concat("]")

fn exact_json_i64_max() -> i64
  number_cast::to_i64(2147483647) * number_cast::to_i64(4194304)
    + number_cast::to_i64(4194303)

@intrinsic(name: "__dto_value_to_data")
fn dto_value_to_data<T>(value: T): () -> DataValue
  __dto_value_to_data(value)

fn json_array_to_data(
  value: JsonArray,
  element: ShapeNode,
  graph: Shape,
  path: String
): () -> Result<DataValue, JsonDecodeError>
  let ~out = Array<DataValue>::with_capacity(value.value.len())
  var index = 0
  while index < value.value.len():
    match(json_value_to_data(
      value.value.at(index),
      element,
      graph,
      json_index_path(path, index)
    ))
      Err<JsonDecodeError> { error }:
        return Err<JsonDecodeError> { error }
      Ok<DataValue> { value: item }:
        out.push(item)
    index = index + 1
  Ok<DataValue> { value: DataArray { values: out } }

fn json_object_to_data(
  value: JsonObject,
  fields: Array<ShapeField>,
  graph: Shape,
  path: String
): () -> Result<DataValue, JsonDecodeError>
  let entries = value.value.entries()
  let ~out = Array<DataField>::with_capacity(entries.len())
  var index = 0
  while index < entries.len():
    let entry = entries.at(index)
    let name = entry.0
    let nested_path = json_field_path(path, name)
    match(find_shape_field(fields, name))
      Some<ShapeField> { value: field }:
        match(json_value_to_data(entry.1, field.shape, graph, nested_path))
          Err<JsonDecodeError> { error }:
            return Err<JsonDecodeError> { error }
          Ok<DataValue> { value: field_value }:
            out.push(DataField { name, value: field_value })
      None:
        out.push(DataField {
          name,
          value: json_untyped_data(entry.1)
        })
    index = index + 1
  Ok<DataValue> { value: DataObject { fields: out } }

fn json_union_to_data(
  value: JsonValue,
  shape: UnionShape,
  graph: Shape,
  path: String
): () -> Result<DataValue, JsonDecodeError>
  value.match(decoded)
    JsonString:
      match(find_shape_variant(shape.variants, decoded.value))
        Some<ShapeVariant> { value: variant }:
          if variant.fields.is_empty():
            return Ok<DataValue> {
              value: DataVariant {
                name: decoded.value,
                fields: Array<DataField>::init()
              }
            }
          schema_mismatch(path, "variant object with payload fields")
        None:
          decode_failure<DataValue>(
            JsonSchemaFailure {},
            path,
            "unknown variant ".concat(decoded.value)
          )
    JsonObject:
      match(decoded.value.get("$variant"))
        None:
          decode_failure<DataValue>(
            JsonSchemaFailure {},
            json_field_path(path, "$variant"),
            "variant discriminator is required"
          )
        Some<JsonValue> { value: discriminator }:
          discriminator.match(tag)
            JsonString:
              match(find_shape_variant(shape.variants, tag.value))
                None:
                  decode_failure<DataValue>(
                    JsonSchemaFailure {},
                    json_field_path(path, "$variant"),
                    "unknown variant ".concat(tag.value)
                  )
                Some<ShapeVariant> { value: variant }:
                  json_variant_object_to_data(decoded, variant, graph, path)
            else:
              schema_mismatch(json_field_path(path, "$variant"), "string")
    else:
      schema_mismatch(path, "variant string or object")

fn json_variant_object_to_data(
  value: JsonObject,
  variant: ShapeVariant,
  graph: Shape,
  path: String
): () -> Result<DataValue, JsonDecodeError>
  let entries = value.value.entries()
  let capacity = if entries.len() > 0 then: entries.len() - 1 else: 0
  let ~out = Array<DataField>::with_capacity(capacity)
  var index = 0
  while index < entries.len():
    let entry = entries.at(index)
    let name = entry.0
    if name != "$variant":
      let nested_path = json_field_path(path, name)
      match(find_shape_field(variant.fields, name))
        Some<ShapeField> { value: field }:
          match(json_value_to_data(entry.1, field.shape, graph, nested_path))
            Err<JsonDecodeError> { error }:
              return Err<JsonDecodeError> { error }
            Ok<DataValue> { value: field_value }:
              out.push(DataField { name, value: field_value })
        None:
          out.push(DataField { name, value: json_untyped_data(entry.1) })
    index = index + 1
  Ok<DataValue> {
    value: DataVariant { name: variant.name, fields: out }
  }

fn json_untyped_data(value: JsonValue) -> DataValue
  value.match(decoded)
    JsonNull:
      DataNull {}
    JsonBool:
      DataBool { value: decoded.value }
    JsonNumber:
      DataF64 { value: decoded.value }
    JsonString:
      DataString { value: decoded.value }
    JsonArray:
      DataArray {
        values: decoded.value.map((item: JsonValue) -> DataValue => json_untyped_data(item))
      }
    JsonObject:
      let entries = decoded.value.entries()
      let ~fields = Array<DataField>::with_capacity(entries.len())
      var index = 0
      while index < entries.len():
        let entry = entries.at(index)
        fields.push(DataField { name: entry.0, value: json_untyped_data(entry.1) })
        index = index + 1
      DataObject { fields }

fn document_version(value: JsonValue) -> Result<i32, JsonDecodeError>
  value.match(decoded)
    JsonObject:
      match(decoded.value.get("version"))
        None:
          decode_failure<i32>(
            JsonVersionFailure {},
            "$.version",
            "version field is required"
          )
        Some<JsonValue> { value: version }:
          version.match(number)
            JsonNumber:
              if is_integral(number.value):
                match(to_i32_checked(number.value))
                  Ok<i32> { value }:
                    Ok<i32> { value }
                  Err:
                    decode_failure<i32>(
                      JsonVersionFailure {},
                      "$.version",
                      "version must be a 32-bit integer"
                    )
              else:
                decode_failure<i32>(
                  JsonVersionFailure {},
                  "$.version",
                  "version must be a 32-bit integer"
                )
            else:
              decode_failure<i32>(
                JsonVersionFailure {},
                "$.version",
                "version must be a number"
              )
    else:
      decode_failure<i32>(JsonVersionFailure {}, "$", "versioned document must be an object")

fn find_shape_field(fields: Array<ShapeField>, name: String) -> Option<ShapeField>
  var index = 0
  while index < fields.len():
    let field = fields.at(index)
    if field.name == name:
      return Some<ShapeField> { value: field }
    index = index + 1
  None {}

fn find_shape_variant(
  variants: Array<ShapeVariant>,
  name: String
) -> Option<ShapeVariant>
  var index = 0
  while index < variants.len():
    let variant = variants.at(index)
    if variant.name == name:
      return Some<ShapeVariant> { value: variant }
    index = index + 1
  None {}

fn find_shape_definition(
  definitions: Array<ShapeDefinition>,
  key: String
) -> Option<ShapeNode>
  var index = 0
  while index < definitions.len():
    let definition = definitions.at(index)
    if definition.key == key:
      return Some<ShapeNode> { value: definition.shape }
    index = index + 1
  None {}

fn json_field_path(path: String, name: String) -> String
  path.concat(".").concat(name)

fn json_index_path(path: String, index: i32) -> String
  path.concat("[").concat(number_cast::to_string(index)).concat("]")

fn is_integral(value: f64) -> bool
  is_finite(value) and value == floor(value)

fn schema_mismatch<T>(path: String, expected: String) -> Result<T, JsonDecodeError>
  decode_failure<T>(
    JsonSchemaFailure {},
    path,
    "expected ".concat(expected)
  )

fn decode_failure<T>(
  kind: JsonDecodeErrorKind,
  path: String,
  message: String
) -> Result<T, JsonDecodeError>
  Err<JsonDecodeError> {
    error: JsonDecodeError { kind, path, message }
  }

fn json_object_starts_variant(~parser: JsonParser) -> bool
  if consume_byte(parser, 123) == false:
    return false
  skip_whitespace(parser)
  match(parse_string(parser))
    Err<JsonError>:
      false
    Ok<String> { value }:
      value == "$variant"

fn count_json_array_values(~parser: JsonParser) -> Result<i32, JsonError>
  skip_whitespace(parser)
  if consume_byte(parser, 93):
    return Ok<i32> { value: 0 }
  var count = 0
  while true:
    match(skip_json_value(parser))
      Err<JsonError> { error }:
        return Err<JsonError> { error }
      Ok<Unit>:
        count = count + 1
    skip_whitespace(parser)
    if consume_byte(parser, 93):
      return Ok<i32> { value: count }
    if consume_byte(parser, 44) == false:
      return json_reader_failure<i32>("json reader expected ',' or ']' in array")
    skip_whitespace(parser)
  json_reader_failure<i32>("json reader expected ']' in array")

fn skip_json_value(~parser: JsonParser) -> Result<Unit, JsonError>
  skip_whitespace(parser)
  match(peek(parser))
    None:
      json_reader_failure<Unit>("json reader found an incomplete value")
    Some<i32> { value: byte }:
      if byte == 110:
        if consume_literal(parser, "null".as_slice()):
          return json_reader_success()
        return json_reader_failure<Unit>("json reader found an invalid literal")
      if byte == 116:
        if consume_literal(parser, "true".as_slice()):
          return json_reader_success()
        return json_reader_failure<Unit>("json reader found an invalid literal")
      if byte == 102:
        if consume_literal(parser, "false".as_slice()):
          return json_reader_success()
        return json_reader_failure<Unit>("json reader found an invalid literal")
      if byte == 34:
        match(parse_string(parser))
          Err<JsonError> { error }:
            return Err<JsonError> { error }
          Ok<String>:
            return json_reader_success()
      if byte == 91:
        parser.index = parser.index + 1
        skip_whitespace(parser)
        if consume_byte(parser, 93):
          return json_reader_success()
        while true:
          match(skip_json_value(parser))
            Err<JsonError> { error }:
              return Err<JsonError> { error }
            Ok<Unit>:
              void
          skip_whitespace(parser)
          if consume_byte(parser, 93):
            return json_reader_success()
          if consume_byte(parser, 44) == false:
            return json_reader_failure<Unit>("json reader expected ',' or ']' in array")
          skip_whitespace(parser)
      if byte == 123:
        parser.index = parser.index + 1
        skip_whitespace(parser)
        if consume_byte(parser, 125):
          return json_reader_success()
        while true:
          match(parse_string(parser))
            Err<JsonError> { error }:
              return Err<JsonError> { error }
            Ok<String>:
              void
          skip_whitespace(parser)
          if consume_byte(parser, 58) == false:
            return json_reader_failure<Unit>("json reader expected ':' after a field")
          match(skip_json_value(parser))
            Err<JsonError> { error }:
              return Err<JsonError> { error }
            Ok<Unit>:
              void
          skip_whitespace(parser)
          if consume_byte(parser, 125):
            return json_reader_success()
          if consume_byte(parser, 44) == false:
            return json_reader_failure<Unit>("json reader expected ',' or '}' in object")
          skip_whitespace(parser)
      match(parse_number(parser))
        Err<JsonError> { error }:
          Err<JsonError> { error }
        Ok<JsonValue>:
          json_reader_success()

fn parse_value(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  skip_whitespace(parser)
  match(peek(parser))
    Some<i32> { value: byte }:
      if byte == 110:
        return parse_literal_null(parser)
      if byte == 116:
        return parse_literal_true(parser)
      if byte == 102:
        return parse_literal_false(parser)
      if byte == 34:
        return parse_string_value(parser)
      if byte == 91:
        return parse_array(parser)
      if byte == 123:
        return parse_object(parser)
      parse_number(parser)
    None:
      Err<JsonError> { error: json_parse_error("json parse error: unexpected end of input") }

fn parse_literal_null(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  if consume_literal(parser, "null".as_slice()):
    return Ok<JsonValue> { value: JsonNull {} }
  Err<JsonError> { error: json_parse_error("json parse error: invalid literal") }

fn parse_literal_true(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  if consume_literal(parser, "true".as_slice()):
    return Ok<JsonValue> { value: JsonBool { value: true } }
  Err<JsonError> { error: json_parse_error("json parse error: invalid literal") }

fn parse_literal_false(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  if consume_literal(parser, "false".as_slice()):
    return Ok<JsonValue> { value: JsonBool { value: false } }
  Err<JsonError> { error: json_parse_error("json parse error: invalid literal") }

fn parse_string_value(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  match(parse_string(parser))
    Ok<String> { value }:
      Ok<JsonValue> { value: JsonString { value: value } }
    Err<JsonError> { error }:
      Err<JsonError> { error: error }

fn parse_string(~parser: JsonParser): () -> Result<String, JsonError>
  if not consume_byte(parser, 34):
    return Err<JsonError> { error: json_parse_error("json parse error: expected string") }

  let ~bytes = Array<i32>::with_capacity(16)
  let ~escape = JsonEscapeState { out: bytes, parser: parser }
  while true:
    let byte = next_byte_or(parser, -1)
    if byte < 0:
      return Err<JsonError> { error: json_parse_error("json parse error: unterminated string") }
    if byte == 34:
      return string_from_utf8(bytes)
    if byte == 92:
      let escaped = next_byte_or(parser, -1)
      if escaped < 0:
        return Err<JsonError> { error: json_parse_error("json parse error: unterminated escape") }
      let append_result = append_escaped(escape, escaped)
      if append_result != 0:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid string escape") }
      continue
    if byte < 32:
      return Err<JsonError> {
        error: json_parse_error("json parse error: unescaped control character in string")
      }
    bytes.push(byte)

  Err<JsonError> { error: json_parse_error("json parse error: unterminated string") }

fn parse_array(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  parser.index = parser.index + 1
  skip_whitespace(parser)

  let ~items = Array<JsonValue>::with_capacity(4)
  if consume_byte(parser, 93):
    return Ok<JsonValue> { value: JsonArray { value: items } }

  while true:
    match(parse_value(parser))
      Ok<JsonValue> { value }:
        items.push(value)
      Err<JsonError> { error }:
        return Err<JsonError> { error: error }

    skip_whitespace(parser)
    if consume_byte(parser, 44):
      skip_whitespace(parser)
      continue
    if consume_byte(parser, 93):
      return Ok<JsonValue> { value: JsonArray { value: items } }
    return Err<JsonError> { error: json_parse_error("json parse error: expected ',' or ']' in array") }

  Err<JsonError> { error: json_parse_error("json parse error: expected ',' or ']' in array") }

fn parse_object(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  parser.index = parser.index + 1
  skip_whitespace(parser)

  let ~fields = Dict<String, JsonValue>::init()
  if consume_byte(parser, 125):
    return Ok<JsonValue> { value: JsonObject { value: fields } }

  while true:
    match(parse_string(parser))
      Ok<String> { value: key }:
        skip_whitespace(parser)
        if not consume_byte(parser, 58):
          return Err<JsonError> { error: json_parse_error("json parse error: expected ':' after object key") }
        skip_whitespace(parser)
        match(parse_value(parser))
          Ok<JsonValue> { value }:
            fields.set(key, value)
          Err<JsonError> { error }:
            return Err<JsonError> { error: error }
      Err<JsonError> { error }:
        return Err<JsonError> { error: error }

    skip_whitespace(parser)
    if consume_byte(parser, 44):
      skip_whitespace(parser)
      continue
    if consume_byte(parser, 125):
      return Ok<JsonValue> { value: JsonObject { value: fields } }
    return Err<JsonError> { error: json_parse_error("json parse error: expected ',' or '}' in object") }

  Err<JsonError> { error: json_parse_error("json parse error: expected ',' or '}' in object") }

fn parse_number(~parser: JsonParser): () -> Result<JsonValue, JsonError>
  let start = parser.index
  if consume_byte(parser, 45):
    void

  match(peek(parser))
    Some<i32> { value: first_digit }:
      if first_digit == 48:
        parser.index = parser.index + 1
      else:
        if is_digit(first_digit):
          consume_digits(parser)
        else:
          return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }
    None:
      return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  if consume_byte(parser, 46):
    match(peek(parser))
      Some<i32> { value: digit }:
        if not is_digit(digit):
          return Err<JsonError> { error: json_parse_error("json parse error: invalid fraction") }
        consume_digits(parser)
      None:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid fraction") }

  let next = peek(parser)
  let has_exponent = match(next)
    Some<i32> { value }:
      value == 101 or value == 69
    None:
      false
  if has_exponent:
    parser.index = parser.index + 1
    let _ = consume_byte(parser, 43) or consume_byte(parser, 45)
    match(peek(parser))
      Some<i32> { value: digit }:
        if not is_digit(digit):
          return Err<JsonError> { error: json_parse_error("json parse error: invalid exponent") }
        consume_digits(parser)
      None:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid exponent") }

  let lexeme = parser.source.slice(bytes: start, len: parser.index - start)
  match(parse_json_number(lexeme))
    Ok<f64> { value }:
      Ok<JsonValue> { value: JsonNumber { value: value } }
    Err:
      Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

/// Writes one JSON value into `out`.
///
/// Params:
/// - `out`: Destination UTF-8 byte buffer.
/// - `value`: Value to serialize.
/// - `pretty`: Enables indentation/newlines when `true`.
/// - `depth`: Current indentation depth.
fn write_json_value(~out: Array<i32>, value: JsonValue, pretty: bool, depth: i32) -> Result<Unit, JsonError>
  value.match(active)
    JsonNull:
      append_ascii(out, "null".as_slice())
      Ok<Unit> { value: Unit {} }
    JsonBool:
      if active.value:
        append_ascii(out, "true".as_slice())
      else:
        append_ascii(out, "false".as_slice())
      Ok<Unit> { value: Unit {} }
    JsonNumber:
      if is_non_finite_float(active.value):
        return Err<JsonError> { error: json_stringify_error("json stringify error: numbers must be finite") }
      append_string(out, number_cast::to_string(active.value).as_slice())
      Ok<Unit> { value: Unit {} }
    JsonString:
      append_json_string(out, active.value.as_slice())
      Ok<Unit> { value: Unit {} }
    JsonArray:
      append_json_array(out, active.value, pretty, depth)
    JsonObject:
      append_json_object(out, active.value, pretty, depth)

fn append_json_array(
  ~out: Array<i32>,
  items: Array<JsonValue>,
  pretty: bool,
  depth: i32
) -> Result<Unit, JsonError>
  out.push(91)
  if items.is_empty():
    out.push(93)
    return Ok<Unit> { value: Unit {} }

  var index = 0
  while index < items.len():
    if pretty:
      out.push(10)
      append_indent(out, depth + 1)

    match(items.get(index))
      Some<JsonValue> { value }:
        match(write_json_value(out, value, pretty, depth + 1))
          Err<JsonError> { error }:
            return Err<JsonError> { error: error }
          Ok<Unit>:
            void
      None:
        append_ascii(out, "null".as_slice())

    index = index + 1
    if index < items.len():
      out.push(44)
      if not pretty:
        void

  if pretty:
    out.push(10)
    append_indent(out, depth)
  out.push(93)
  Ok<Unit> { value: Unit {} }

fn append_json_object(
  ~out: Array<i32>,
  value: Dict<String, JsonValue>,
  pretty: bool,
  depth: i32
) -> Result<Unit, JsonError>
  out.push(123)
  let entries = value.entries()
  if entries.is_empty():
    out.push(125)
    return Ok<Unit> { value: Unit {} }

  var index = 0
  while index < entries.len():
    if pretty:
      out.push(10)
      append_indent(out, depth + 1)

    match(entries.get(index))
      Some<(String, JsonValue)> { value: entry }:
        append_json_string(out, entry.0.as_slice())
        out.push(58)
        if pretty:
          out.push(32)
        match(write_json_value(out, entry.1, pretty, depth + 1))
          Err<JsonError> { error }:
            return Err<JsonError> { error: error }
          Ok<Unit>:
            void
      None:
        append_ascii(out, "\"\"".as_slice())

    index = index + 1
    if index < entries.len():
      out.push(44)

  if pretty:
    out.push(10)
    append_indent(out, depth)
  out.push(125)
  Ok<Unit> { value: Unit {} }

fn append_json_string(~out: Array<i32>, value: StringSlice) -> void
  out.push(34)
  var index = 0
  while index < value.byte_len():
    let byte = byte_at_or(value, index, -1)
    if not append_json_escape(out, byte):
      out.push(byte)
    index = index + 1
  out.push(34)

fn append_json_escape(~out: Array<i32>, byte: i32) -> bool
  if byte == 34:
    out.push(92)
    out.push(34)
    return true
  if byte == 92:
    out.push(92)
    out.push(92)
    return true
  if byte == 8:
    out.push(92)
    out.push(98)
    return true
  if byte == 12:
    out.push(92)
    out.push(102)
    return true
  if byte == 10:
    out.push(92)
    out.push(110)
    return true
  if byte == 13:
    out.push(92)
    out.push(114)
    return true
  if byte == 9:
    out.push(92)
    out.push(116)
    return true
  if byte >= 0 and byte < 32:
    out.push(92)
    out.push(117)
    out.push(48)
    out.push(48)
    out.push(hex_digit(byte / 16))
    out.push(hex_digit(byte - (byte / 16) * 16))
    return true
  false

fn append_indent(~out: Array<i32>, depth: i32) -> void
  var index = 0
  while index < depth:
    out.push(32)
    out.push(32)
    index = index + 1

fn append_ascii(~out: Array<i32>, value: StringSlice) -> void
  append_string(out, value)

fn append_string(~out: Array<i32>, value: StringSlice) -> void
  var index = 0
  while index < value.byte_len():
    match(value.get_byte(index))
      Some<i32> { value: byte }:
        out.push(byte)
      None:
        return void
    index = index + 1

fn consume_digits(~parser: JsonParser) -> void
  while true:
    match(peek(parser))
      Some<i32> { value }:
        if is_digit(value):
          parser.index = parser.index + 1
        else:
          break
      None:
        break

fn consume_literal(~parser: JsonParser, literal: StringSlice) -> bool
  let start = parser.index
  var index = 0
  while index < literal.byte_len():
    match(next_byte(parser))
      Some<i32> { value }:
        if value != byte_at_or(literal, index, -1):
          parser.index = start
          return false
      None:
        parser.index = start
        return false
    index = index + 1
  true

fn skip_whitespace(~parser: JsonParser) -> void
  while true:
    match(peek(parser))
      Some<i32> { value }:
        if is_whitespace(value):
          parser.index = parser.index + 1
        else:
          break
      None:
        break

fn peek(parser: JsonParser): () -> Option<i32>
  parser.source.get_byte(parser.index)

fn peek_byte_or(parser: JsonParser, fallback: i32) -> i32
  match(peek(parser))
    Some<i32> { value }:
      value
    None:
      fallback

fn next_byte(~parser: JsonParser): () -> Option<i32>
  match(parser.source.get_byte(parser.index))
    Some<i32> { value }:
      parser.index = parser.index + 1
      Some<i32> { value: value }
    None:
      None {}

fn next_byte_or(~parser: JsonParser, fallback: i32) -> i32
  match(next_byte(parser))
    Some<i32> { value }:
      value
    None:
      fallback

fn consume_byte(~parser: JsonParser, expected: i32) -> bool
  match(peek(parser))
    Some<i32> { value }:
      if value != expected:
        return false
      parser.index = parser.index + 1
      true
    None:
      false

fn append_escaped(~state: JsonEscapeState, escaped: i32) -> i32
  if escaped == 34:
    state.out.push(34)
    return 0
  if escaped == 92:
    state.out.push(92)
    return 0
  if escaped == 47:
    state.out.push(47)
    return 0
  if escaped == 98:
    state.out.push(8)
    return 0
  if escaped == 102:
    state.out.push(12)
    return 0
  if escaped == 110:
    state.out.push(10)
    return 0
  if escaped == 114:
    state.out.push(13)
    return 0
  if escaped == 116:
    state.out.push(9)
    return 0
  if escaped != 117:
    return -1

  let lead = read_unicode_escape(state.parser)
  if lead < 0:
    return -1
  if is_high_surrogate(lead):
    let checkpoint = state.parser.index
    if consume_byte(state.parser, 92):
      if consume_byte(state.parser, 117):
        let trail = read_unicode_escape(state.parser)
        if is_low_surrogate(trail):
          append_codepoint(state.out, decode_surrogate_pair(lead, trail))
          return 0
      state.parser.index = checkpoint
    append_replacement(state.out)
    return 0
  if is_low_surrogate(lead):
    append_replacement(state.out)
    return 0

  append_codepoint(state.out, lead)
  0

fn read_unicode_escape(~parser: JsonParser) -> i32
  var codepoint = 0
  var index = 0
  while index < 4:
    match(next_byte(parser))
      Some<i32> { value }:
        let digit = hex_to_i32(value)
        if digit < 0:
          return -1
        codepoint = codepoint * 16 + digit
      None:
        return -1
    index = index + 1
  codepoint

fn append_codepoint(~out: Array<i32>, codepoint: i32) -> void
  if codepoint < 0:
    append_replacement(out)
    return void
  if codepoint <= 127:
    out.push(codepoint)
    return void
  if codepoint <= 2047:
    out.push(192 + (codepoint / 64))
    out.push(128 + (codepoint - (codepoint / 64) * 64))
    return void
  if codepoint <= 65535:
    if codepoint >= 55296 and codepoint <= 57343:
      append_replacement(out)
      return void
    out.push(224 + (codepoint / 4096))
    out.push(128 + ((codepoint / 64) - (codepoint / 4096) * 64))
    out.push(128 + (codepoint - (codepoint / 64) * 64))
    return void
  if codepoint <= 1114111:
    out.push(240 + (codepoint / 262144))
    out.push(128 + ((codepoint / 4096) - (codepoint / 262144) * 64))
    out.push(128 + ((codepoint / 64) - (codepoint / 4096) * 64))
    out.push(128 + (codepoint - (codepoint / 64) * 64))
    return void
  append_replacement(out)

fn append_replacement(~out: Array<i32>) -> void
  out.push(239)
  out.push(191)
  out.push(189)

fn string_from_utf8(bytes: Array<i32>): () -> Result<String, JsonError>
  Ok<String> { value: new_string(bytes.to_fixed_array()) }

fn byte_at_or(value: StringSlice, index: i32, fallback: i32) -> i32
  match(value.get_byte(index))
    Some<i32> { value: read }:
      read
    None:
      fallback

fn is_whitespace(value: i32) -> bool
  value == 9 or value == 10 or value == 13 or value == 32

fn is_digit(value: i32) -> bool
  value >= 48 and value <= 57

fn hex_to_i32(value: i32) -> i32
  if value >= 48 and value <= 57:
    return value - 48
  if value >= 65 and value <= 70:
    return value - 55
  if value >= 97 and value <= 102:
    return value - 87
  -1

fn hex_digit(value: i32) -> i32
  if value < 10:
    return 48 + value
  97 + (value - 10)

fn is_high_surrogate(value: i32) -> bool
  value >= 55296 and value <= 56319

fn is_low_surrogate(value: i32) -> bool
  value >= 56320 and value <= 57343

fn decode_surrogate_pair(lead: i32, trail: i32) -> i32
  65536 + (lead - 55296) * 1024 + (trail - 56320)

fn is_non_finite_float(value: f64) -> bool
  if value != value:
    return true
  let delta = value - value
  delta != delta

fn digit_to_f64(value: i32) -> f64
  if value == 0:
    return 0.0
  if value == 1:
    return 1.0
  if value == 2:
    return 2.0
  if value == 3:
    return 3.0
  if value == 4:
    return 4.0
  if value == 5:
    return 5.0
  if value == 6:
    return 6.0
  if value == 7:
    return 7.0
  if value == 8:
    return 8.0
  if value == 9:
    return 9.0
  0.0

fn parse_json_number(source: StringSlice): () -> Result<f64, JsonError>
  let len = source.byte_len()
  if len <= 0:
    return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  var index = 0
  var sign = 1.0
  let first = byte_at_or(source, 0, -1)
  if first == 45:
    sign = -1.0
    index = 1

  if index >= len:
    return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  var significand = 0.0
  var collected_digits = 0
  var significant_digits = 0
  var saw_nonzero_digit = false

  var saw_int_digit = false
  if byte_at_or(source, index, -1) == 48:
    saw_int_digit = true
    index = index + 1
  else:
    while index < len:
      let digit = parse_decimal_digit(byte_at_or(source, index, -1))
      if digit < 0:
        break
      saw_int_digit = true
      if digit != 0 or saw_nonzero_digit:
        saw_nonzero_digit = true
        significant_digits = significant_digits + 1
        if collected_digits < 17:
          significand = significand * 10.0 + digit_to_f64(digit)
          collected_digits = collected_digits + 1
      index = index + 1
  if not saw_int_digit:
    return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  var frac_digits = 0
  if index < len and byte_at_or(source, index, -1) == 46:
    index = index + 1
    if index >= len:
      return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

    var saw_fraction_digit = false
    while index < len:
      let digit = parse_decimal_digit(byte_at_or(source, index, -1))
      if digit < 0:
        break
      frac_digits = frac_digits + 1
      if digit != 0 or saw_nonzero_digit:
        saw_nonzero_digit = true
        significant_digits = significant_digits + 1
        if collected_digits < 17:
          significand = significand * 10.0 + digit_to_f64(digit)
          collected_digits = collected_digits + 1
      saw_fraction_digit = true
      index = index + 1
    if not saw_fraction_digit:
      return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  var exponent = 0
  var exponent_sign = 1
  if index < len:
    let marker = byte_at_or(source, index, -1)
    if marker == 101 or marker == 69:
      index = index + 1
      if index >= len:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

      let sign_byte = byte_at_or(source, index, -1)
      if
        sign_byte == 45:
          exponent_sign = -1
          index = index + 1
        sign_byte == 43:
          index = index + 1

      if index >= len:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

      var saw_exp_digit = false
      while index < len:
        let digit = parse_decimal_digit(byte_at_or(source, index, -1))
        if digit < 0:
          break
        if exponent < 1000000:
          exponent = exponent * 10 + digit
        saw_exp_digit = true
        index = index + 1
      if not saw_exp_digit:
        return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  if index != len:
    return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  if not saw_nonzero_digit:
    return Ok<f64> { value: sign * 0.0 }

  let omitted_digits = significant_digits - collected_digits
  let signed_exponent = exponent_sign * exponent - frac_digits + omitted_digits

  let value = sign * significand * pow10_i32(signed_exponent)
  if is_non_finite_float(value):
    return Err<JsonError> { error: json_parse_error("json parse error: invalid number") }

  Ok<f64> { value: value }

fn parse_decimal_digit(byte: i32) -> i32
  if byte >= 48 and byte <= 57:
    return byte - 48
  -1

fn pow10_i32(value: i32) -> f64
  if value == 0:
    return 1.0
  if value < 0:
    return pow10_negative_i32(0 - value)
  pow10_positive_i32(value)

fn pow10_positive_i32(value: i32) -> f64
  var out = 1.0
  var base = 10.0
  var remaining = value
  while remaining > 0:
    let half = remaining / 2
    let odd = remaining - half * 2
    if odd == 1:
      out = out * base
    base = base * base
    remaining = half
  out

fn pow10_negative_i32(value: i32) -> f64
  var out = 1.0
  var base = 0.1
  var remaining = value
  while remaining > 0:
    let half = remaining / 2
    let odd = remaining - half * 2
    if odd == 1:
      out = out * base
    base = base * base
    remaining = half
  out

fn json_parse_error(message: String) -> JsonError
  JsonError { code: 1, message: message }

fn json_stringify_error(message: String) -> JsonError
  JsonError { code: 2, message: message }
