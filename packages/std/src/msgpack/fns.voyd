//! MessagePack serializer implementation used by `std::msgpack`.
//! This module owns the in-memory codec and value constructors/unpackers.

use std::array::{ Array, new_array_unchecked }
use std::bytes::{ ByteBuffer, Bytes }
use std::fixed_array::fns::{ new_fixed_array }
use std::dict::{ Dict, DictKey }
use std::data::{
  ArrayKind,
  BoolKind,
  BytesKind,
  DataKind,
  DataArray,
  DataBool,
  DataBytes,
  DataF32,
  DataF64,
  DataField,
  DataI32,
  DataI64,
  DataNull,
  DataObject,
  DataReader,
  DataString,
  DataValue,
  DataVariant,
  DataWriter,
  DecodeLimits,
  EncodeLimits,
  F32Kind,
  F64Kind,
  HostTransportProvider,
  I32Kind,
  I64Kind,
  NullKind,
  RecordKind,
  StringKind,
  default_decode_limits,
  default_encode_limits
}
use std::error::panic
use std::meta::{ RecordShape, ShapeField, ShapeVariant, UnionShape }
use std::memory::self as memory
use std::msgpack::errors::{ MsgPackError, error_code_buffer_too_small, error_code_decode_failed, error_code_trailing_bytes, error_code_type_mismatch, make_custom_error, make_error }
use std::msgpack::types::{ Binary, Bool, F32, F64, I32, I64, Null, Numeric }
use std::number::cast::self as cast
use std::optional::types::all
use std::result::types::all
use std::shared_cell::SharedCell
use std::string::type::{ new_string, String, StringSlice }

obj MsgPackHostTransport {}

/// Recursive MessagePack value union used by the serializer boundary.
pub type MsgPack = Null | Numeric | Bool | String | Binary | Array<MsgPack> | MsgPackMap

/// Internal representation for MessagePack maps before conversion to `Dict`.
pub obj MsgPackMap {
  entries: Array<(String, MsgPack)>
}

obj MemoryEncoderSink {
  ptr: i32,
  len: i32
}

obj BytesEncoderSink {}

type EncoderSink = MemoryEncoderSink | BytesEncoderSink

obj Encoder {
  sink: EncoderSink,
  state: SharedCell<EncoderState>
}

obj EncoderState {
  bytes: EncoderByteLink,
  byte_count: i32,
  pos: i32,
  ok: bool
}

obj EncoderByte {
  value: i32,
  previous: EncoderByteLink
}

obj EncoderByteEnd {}

type EncoderByteLink = EncoderByte | EncoderByteEnd

/// Direct MessagePack sink used by compiler-generated DTO traversal.
pub obj MsgPackWriter {
  encoder: Encoder,
  container_kinds: Array<i32>,
  remaining_values: Array<i32>,
  pending_fields: Array<i32>,
  root_count: i32,
  failed: bool,
  limits: EncodeLimits
}

/// Direct MessagePack source used by compiler-generated DTO traversal.
pub obj MsgPackReader {
  decoder: Decoder,
  container_kinds: Array<i32>,
  remaining_values: Array<i32>,
  root_consumed: bool,
  failed: bool,
  limits: DecodeLimits,
  path: String,
  parents: Array<String>
}

impl MsgPackReader
  /// Creates a reader over one immutable MessagePack byte buffer.
  pub fn init(bytes: Bytes) -> MsgPackReader
    MsgPackReader::init(bytes, limits: default_decode_limits())

  /// Creates a reader with explicit resource limits.
  pub fn init(bytes: Bytes, { limits: DecodeLimits }) -> MsgPackReader
    MsgPackReader {
      decoder: bytes_decoder(bytes),
      container_kinds: Array<i32>::init(),
      remaining_values: Array<i32>::init(),
      root_consumed: false,
      failed: invalid_decode_limits(limits, bytes.len()),
      limits: limits,
      path: "$".to_string(),
      parents: Array<String>::init()
    }

  /// Returns true after one balanced root and every source byte are consumed.
  api fn is_complete(self) -> bool
    self.failed == false
      and self.decoder.is_ok()
      and self.root_consumed
      and self.container_kinds.is_empty()
      and self.decoder.at_end()

  fn fail<T>(~self, message: String) -> Result<T, MsgPackError>
    self.failed = true
    msgpack_reader_failure<T>(message)

  fn consume_value(~self) -> Result<Unit, MsgPackError>
    if self.failed or self.decoder.is_ok() == false:
      return self.fail<Unit>("msgpack reader session has failed")
    if self.container_kinds.is_empty():
      if self.root_consumed:
        return self.fail<Unit>("msgpack reader has no remaining root value")
      self.root_consumed = true
      return msgpack_reader_success()
    let index = self.remaining_values.len() - 1
    let remaining = self.remaining_values.at(index)
    if remaining <= 0:
      return self.fail<Unit>("msgpack reader container has no remaining values")
    self.remaining_values.replace(index, with: remaining - 1)
    msgpack_reader_success()

  fn begin_container(~self, { kind: i32 }) -> Result<i32, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        let length = if kind == 0
          then: self.decoder.read_array_length()
          else: self.decoder.read_map_length()
        if length < 0 or self.decoder.is_ok() == false:
          return self.fail<i32>("msgpack reader expected a container")
        if length > self.limits.max_collection_length:
          return self.fail<i32>("msgpack reader collection exceeds configured limit")
        if self.container_kinds.len() >= self.limits.max_depth:
          return self.fail<i32>("msgpack reader nesting exceeds configured limit")
        self.container_kinds.push(kind)
        self.remaining_values.push(length)
        Ok<i32> { value: length }

  fn end_container(~self, { kind: i32 }) -> Result<Unit, MsgPackError>
    if self.container_kinds.is_empty():
      return self.fail<Unit>("msgpack reader has no container to close")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != kind:
      return self.fail<Unit>("msgpack reader closed a different container")
    if self.remaining_values.at(index) != 0:
      return self.fail<Unit>("msgpack reader container has unread values")
    self.container_kinds.pop()
    self.remaining_values.pop()
    msgpack_reader_success()

impl MsgPackWriter
  /// Creates an empty immutable-byte writer.
  pub fn init() -> MsgPackWriter
    MsgPackWriter::init(limits: default_encode_limits())

  /// Creates a writer with explicit resource limits.
  pub fn init({ limits: EncodeLimits }) -> MsgPackWriter
    MsgPackWriter {
      encoder: byte_encoder(),
      container_kinds: Array<i32>::init(),
      remaining_values: Array<i32>::init(),
      pending_fields: Array<i32>::init(),
      root_count: 0,
      failed: invalid_encode_limits(limits),
      limits: limits
    }

  /// Finishes exactly one balanced DTO value.
  api fn finish(self) -> Result<Bytes, MsgPackError>
    if self.failed or self.encoder.is_ok() == false:
      return msgpack_writer_failure<Bytes>("msgpack writer session has failed")
    if self.container_kinds.is_empty() == false:
      return msgpack_writer_failure<Bytes>("msgpack writer has unclosed containers")
    if self.root_count != 1:
      return msgpack_writer_failure<Bytes>("msgpack writer expected one root value")
    let bytes = self.encoder.encoded_bytes()
    if bytes.len() > self.limits.max_bytes:
      return msgpack_writer_failure<Bytes>("msgpack writer output exceeds configured byte limit")
    Ok<Bytes> { value: bytes }

  fn fail(~self, message: String) -> Result<Unit, MsgPackError>
    self.failed = true
    msgpack_writer_failure<Unit>(message)

  fn consume_value(~self) -> Result<Unit, MsgPackError>
    if self.failed:
      return msgpack_writer_failure<Unit>("msgpack writer session has failed")
    if self.container_kinds.is_empty():
      if self.root_count != 0:
        return self.fail("msgpack writer received more than one root value")
      self.root_count = 1
      return msgpack_writer_success()

    let index = self.container_kinds.len() - 1
    let remaining = self.remaining_values.at(index)
    if remaining <= 0:
      return self.fail("msgpack writer container received too many values")
    if self.container_kinds.at(index) != 0 and self.pending_fields.at(index) == 0:
      return self.fail("msgpack writer field is missing its descriptor")
    self.remaining_values.replace(index, with: remaining - 1)
    self.pending_fields.replace(index, with: 0)
    msgpack_writer_success()

  fn begin_container(
    ~self,
    { kind: i32, length: i32 }
  ) -> Result<Unit, MsgPackError>
    if length < 0:
      return self.fail("msgpack writer container length cannot be negative")
    if length > self.limits.max_collection_length:
      return self.fail("msgpack writer collection exceeds configured limit")
    if self.container_kinds.len() >= self.limits.max_depth:
      return self.fail("msgpack writer nesting exceeds configured limit")
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        if kind == 0:
          self.encoder.encode_array_header(length)
        else:
          self.encoder.encode_map_header(length)
        self.container_kinds.push(kind)
        self.remaining_values.push(length)
        self.pending_fields.push(0)
        msgpack_writer_success()

  fn end_container(~self, { kind: i32 }) -> Result<Unit, MsgPackError>
    if self.container_kinds.is_empty():
      return self.fail("msgpack writer has no container to close")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != kind:
      return self.fail("msgpack writer closed a different container")
    if self.remaining_values.at(index) != 0 or self.pending_fields.at(index) != 0:
      return self.fail("msgpack writer container is incomplete")
    self.container_kinds.pop()
    self.remaining_values.pop()
    self.pending_fields.pop()
    msgpack_writer_success()

  fn write_dynamic_field(~self, name: String) -> Result<Unit, MsgPackError>
    if self.container_kinds.is_empty():
      return self.fail("msgpack writer field is outside a record or variant")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) == 0 or self.pending_fields.at(index) != 0:
      return self.fail("msgpack writer field is not ready")
    self.encoder.encode_string(name)
    self.pending_fields.replace(index, with: 1)
    msgpack_writer_success()

impl DataWriter<MsgPackError> for MsgPackWriter
  fn reject(~self, message: String) -> Result<Unit, MsgPackError>
    self.fail(message)

  fn write_null(~self) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.write_u8(192)
        msgpack_writer_success()

  fn write_bool(~self, value: bool) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.write_u8(if value then: 195 else: 194)
        msgpack_writer_success()

  fn write_i32(~self, value: i32) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_i32(value)
        msgpack_writer_success()

  fn write_i64(~self, value: i64) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_i64(value)
        msgpack_writer_success()

  fn write_f32(~self, value: f32) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_f32(value)
        msgpack_writer_success()

  fn write_f64(~self, value: f64) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_f64(value)
        msgpack_writer_success()

  fn write_string(~self, value: String) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_string(value)
        msgpack_writer_success()

  fn write_bytes(~self, value: Bytes) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.encoder.encode_bytes(value)
        msgpack_writer_success()

  fn begin_array(~self, { length: i32 }) -> Result<Unit, MsgPackError>
    self.begin_container(kind: 0, length: length)

  fn end_array(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 0)

  fn begin_record(
    ~self,
    { name: String, field_count: i32 }
  ) -> Result<Unit, MsgPackError>
    self.begin_container(kind: 1, length: field_count)

  fn write_field(~self, name: String) -> Result<Unit, MsgPackError>
    if self.container_kinds.is_empty():
      return self.fail("msgpack writer field is outside a record or variant")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) == 0:
      return self.fail("msgpack writer field is outside a record or variant")
    if self.pending_fields.at(index) != 0:
      return self.fail("msgpack writer field is missing its value")
    self.encoder.encode_string(name)
    self.pending_fields.replace(index, with: 1)
    msgpack_writer_success()

  fn end_record(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 1)

  fn begin_variant(
    ~self,
    { union: String, variant: String, field_count: i32 }
  ) -> Result<Unit, MsgPackError>
    match(self.begin_container(kind: 2, length: field_count + 1))
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        let index = self.container_kinds.len() - 1
        self.encoder.encode_string("$variant")
        self.encoder.encode_string(variant)
        self.remaining_values.replace(
          index,
          with: self.remaining_values.at(index) - 1
        )
        msgpack_writer_success()

  fn end_variant(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 2)

fn invalid_encode_limits(limits: EncodeLimits) -> bool
  limits.max_depth < 0
    or limits.max_bytes < 0
    or limits.max_collection_length < 0

fn invalid_decode_limits(limits: DecodeLimits, bytes: i32) -> bool
  bytes > limits.max_bytes
    or limits.max_depth < 0
    or limits.max_collection_length < 0

impl DataReader<MsgPackError> for MsgPackReader
  fn reject(~self, message: String) -> Result<Unit, MsgPackError>
    self.fail<Unit>(message)

  fn reject_custom(
    ~self,
    code: String,
    message: String
  ) -> Result<Unit, MsgPackError>
    self.failed = true
    Err<MsgPackError> {
      error: make_custom_error(code, self.path, message)
    }

  fn current_path(self) -> String
    self.path

  fn matches_name(self, actual: String, expected: String) -> bool
    actual == expected

  fn enter_field(~self, name: String) -> void
    self.parents.push(self.path)
    self.path = self.path.concat(".").concat(name)

  fn enter_index(~self, index: i32) -> void
    self.parents.push(self.path)
    self.path = self.path.concat("[").concat(cast::to_string(index)).concat("]")

  fn leave(~self) -> void
    if self.parents.is_empty() == false:
      let index = self.parents.len() - 1
      self.path = self.parents.at(index)
      self.parents.pop()

  fn kind(self) -> Result<DataKind, MsgPackError>
    let prefix = self.decoder.peek_u8()
    if self.decoder.is_ok() == false or prefix < 0:
      return msgpack_reader_failure<DataKind>("msgpack reader has no current value")
    if prefix == 192:
      return Ok<DataKind> { value: NullKind {} }
    if prefix == 194 or prefix == 195:
      return Ok<DataKind> { value: BoolKind {} }
    if prefix == 202:
      return Ok<DataKind> { value: F32Kind {} }
    if prefix == 203:
      return Ok<DataKind> { value: F64Kind {} }
    if prefix == 207 or prefix == 211:
      return Ok<DataKind> { value: I64Kind {} }
    if self.decoder.is_integer_prefix(prefix):
      return Ok<DataKind> { value: I32Kind {} }
    if self.decoder.is_string_prefix(prefix):
      return Ok<DataKind> { value: StringKind {} }
    if self.decoder.is_binary_prefix(prefix):
      return Ok<DataKind> { value: BytesKind {} }
    if self.decoder.is_array_prefix(prefix):
      return Ok<DataKind> { value: ArrayKind {} }
    if self.decoder.is_map_prefix(prefix):
      return Ok<DataKind> { value: RecordKind {} }
    msgpack_reader_failure<DataKind>("msgpack reader found an unsupported value")

  fn read_null(~self) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        if self.decoder.read_u8() != 192:
          return self.fail<Unit>("msgpack reader expected null")
        msgpack_reader_success()

  fn read_bool(~self) -> Result<bool, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        let prefix = self.decoder.read_u8()
        if prefix == 194:
          return Ok<bool> { value: false }
        if prefix == 195:
          return Ok<bool> { value: true }
        self.fail<bool>("msgpack reader expected bool")

  fn read_i32(~self) -> Result<i32, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        match(self.decoder.read_i32_value())
          None:
            self.fail<i32>("msgpack reader expected i32")
          Some<i32> { value }:
            Ok<i32> { value }

  fn read_i64(~self) -> Result<i64, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        match(self.decoder.read_i64_value())
          None:
            self.fail<i64>("msgpack reader expected i64")
          Some<i64> { value }:
            Ok<i64> { value }

  fn read_f32(~self) -> Result<f32, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        let prefix = self.decoder.peek_u8()
        if prefix == 202:
          self.decoder.read_u8()
          return Ok<f32> { value: cast::reinterpret_f32(self.decoder.read_u32()) }
        if prefix == 203:
          self.decoder.read_u8()
          return Ok<f32> {
            value: cast::to_f32(cast::reinterpret_f64(self.decoder.read_u64()))
          }
        if self.decoder.is_integer_prefix(prefix):
          match(self.decoder.read_i64_value())
            Some<i64> { value }:
              return Ok<f32> { value: cast::to_f32(value) }
            None:
              return self.fail<f32>("msgpack reader expected f32")
        self.fail<f32>("msgpack reader expected f32")

  fn read_f64(~self) -> Result<f64, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        let prefix = self.decoder.peek_u8()
        if prefix == 203:
          self.decoder.read_u8()
          return Ok<f64> { value: cast::reinterpret_f64(self.decoder.read_u64()) }
        if prefix == 202:
          self.decoder.read_u8()
          return Ok<f64> {
            value: cast::to_f64(cast::reinterpret_f32(self.decoder.read_u32()))
          }
        if self.decoder.is_integer_prefix(prefix):
          match(self.decoder.read_i64_value())
            Some<i64> { value }:
              return Ok<f64> { value: cast::to_f64(value) }
            None:
              return self.fail<f64>("msgpack reader expected f64")
        self.fail<f64>("msgpack reader expected f64")

  fn read_string(~self) -> Result<String, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        match(self.decoder.read_string_value())
          None:
            self.fail<String>("msgpack reader expected string")
          Some<String> { value }:
            Ok<String> { value }

  fn read_bytes(~self) -> Result<Bytes, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        match(self.decoder.read_bytes_value())
          None:
            self.fail<Bytes>("msgpack reader expected bytes")
          Some<Bytes> { value }:
            Ok<Bytes> { value }

  fn begin_array(~self) -> Result<i32, MsgPackError>
    self.begin_container(kind: 0)

  fn has_next_element(self) -> Result<bool, MsgPackError>
    if self.container_kinds.is_empty():
      return msgpack_reader_failure<bool>("msgpack reader is outside an array")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) != 0:
      return msgpack_reader_failure<bool>("msgpack reader is outside an array")
    Ok<bool> { value: self.remaining_values.at(index) > 0 }

  fn end_array(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 0)

  fn begin_record(~self) -> Result<Unit, MsgPackError>
    match(self.begin_container(kind: 1))
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<i32>:
        msgpack_reader_success()

  fn next_field(~self) -> Result<Option<String>, MsgPackError>
    if self.container_kinds.is_empty():
      return self.fail<Option<String>>("msgpack reader is outside a record")
    let index = self.container_kinds.len() - 1
    if self.container_kinds.at(index) == 0:
      return self.fail<Option<String>>("msgpack reader is outside a record")
    if self.remaining_values.at(index) <= 0:
      return Ok<Option<String>> { value: None {} }
    match(self.decoder.read_string_value())
      None:
        self.fail<Option<String>>("msgpack reader expected a string field name")
      Some<String> { value }:
        Ok<Option<String>> { value: Some<String> { value } }

  fn skip_value(~self) -> Result<Unit, MsgPackError>
    match(self.consume_value())
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<Unit>:
        self.decoder.skip_any(
          depth: self.container_kinds.len(),
          limits: self.limits
        )
        if self.decoder.is_ok():
          return msgpack_reader_success()
        self.fail<Unit>("msgpack reader could not skip the value")

  fn end_record(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 1)

  fn begin_variant(~self) -> Result<String, MsgPackError>
    match(self.begin_container(kind: 2))
      Err<MsgPackError> { error }:
        Err<MsgPackError> { error }
      Ok<i32> { value: length }:
        if length <= 0:
          return self.fail<String>("msgpack reader expected a variant map")
        match(self.decoder.read_string_value())
          None:
            self.fail<String>("msgpack reader expected the variant tag field")
          Some<String> { value: key }:
            if key != "$variant":
              return self.fail<String>("msgpack reader expected the variant tag first")
            match(self.decoder.read_string_value())
              None:
                self.fail<String>("msgpack reader expected a variant name")
              Some<String> { value: name }:
                let name_slice = name.as_slice()
                let ~name_bytes = Array<i32>::with_capacity(name_slice.byte_len())
                var name_index = 0
                while name_index < name_slice.byte_len():
                  match(name_slice.get_byte(name_index))
                    Some<i32> { value: byte }:
                      name_bytes.push(byte)
                    None:
                      void
                  name_index = name_index + 1
                let stable_name = new_string(name_bytes.to_fixed_array())
                let index = self.remaining_values.len() - 1
                self.remaining_values.replace(index, with: length - 1)
                Ok<String> { value: stable_name }

  fn end_variant(~self) -> Result<Unit, MsgPackError>
    self.end_container(kind: 2)

fn msgpack_writer_success() -> Result<Unit, MsgPackError>
  Ok<Unit> { value: Unit {} }

fn msgpack_writer_failure<T>(message: String) -> Result<T, MsgPackError>
  Err<MsgPackError> {
    error: make_error(error_code_type_mismatch(), message)
  }

fn msgpack_reader_success() -> Result<Unit, MsgPackError>
  Ok<Unit> { value: Unit {} }

fn msgpack_reader_failure<T>(message: String) -> Result<T, MsgPackError>
  Err<MsgPackError> {
    error: make_error(error_code_decode_failed(), message)
  }

/// Encodes a neutral data value directly to MessagePack bytes.
pub fn encode_data_value_bytes(value: DataValue) -> Result<Bytes, MsgPackError>
  encode_value_bytes(msgpack_from_data_value(value))

/// Decodes MessagePack bytes directly into one neutral data value.
pub fn decode_data_value_bytes(bytes: Bytes) -> Result<DataValue, MsgPackError>
  let byte_count = bytes.len()
  let storage = new_fixed_array<i32>(byte_count)
  var byte_index = 0
  while byte_index < byte_count:
    __array_set(storage, byte_index, bytes.at(byte_index))
    byte_index = byte_index + 1
  let owned = Bytes {
    storage: new_array_unchecked<i32>({ from: storage })
  }
  let ~reader = MsgPackReader::init(owned)
  match(read_data_value(reader))
    Err<MsgPackError> { error }:
      Err<MsgPackError> { error }
    Ok<DataValue> { value }:
      if reader.is_complete():
        return Ok<DataValue> { value }
      msgpack_reader_failure<DataValue>("msgpack decode has trailing bytes")

fn msgpack_from_data_value(value: DataValue) -> MsgPack
  value.match(data)
    DataNull:
      make_null()
    DataBool:
      make_bool(data.value)
    DataI32:
      make_i32(data.value)
    DataI64:
      make_i64(data.value)
    DataF32:
      make_f32(data.value)
    DataF64:
      F64 { value: data.value }
    DataString:
      make_string(data.value)
    DataBytes:
      make_binary(Binary { bytes: data.value.to_array() })
    DataArray:
      var values = Array<MsgPack>::with_capacity(data.values.len())
      var index = 0
      while index < data.values.len():
        values = values.pushed(msgpack_from_data_value(data.values.at(index)))
        index = index + 1
      make_array(values)
    DataObject:
      MsgPackMap { entries: msgpack_entries_from_data_fields(data.fields) }
    DataVariant:
      let entries = msgpack_entries_from_data_fields(data.fields)
      MsgPackMap {
        entries: entries.pushed(("$variant".to_string(), make_string(data.name)))
      }

fn msgpack_entries_from_data_fields(
  fields: Array<DataField>
) -> Array<(String, MsgPack)>
  var entries = Array<(String, MsgPack)>::with_capacity(fields.len())
  var index = 0
  while index < fields.len():
    let field = fields.at(index)
    entries = entries.pushed((field.name, msgpack_from_data_value(field.value)))
    index = index + 1
  entries

fn read_data_value(~reader: MsgPackReader) -> Result<DataValue, MsgPackError>
  match(reader.kind())
    Err<MsgPackError> { error }:
      Err<MsgPackError> { error }
    Ok<DataKind> { value: kind }:
      kind.match(active)
        NullKind:
          match(reader.read_null())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<Unit>:
              Ok<DataValue> { value: DataNull {} }
        BoolKind:
          match(reader.read_bool())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<bool> { value }:
              Ok<DataValue> { value: DataBool { value } }
        I32Kind:
          match(reader.read_i32())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<i32> { value }:
              Ok<DataValue> { value: DataI32 { value } }
        I64Kind:
          match(reader.read_i64())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<i64> { value }:
              Ok<DataValue> { value: DataI64 { value } }
        F32Kind:
          match(reader.read_f32())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<f32> { value }:
              Ok<DataValue> { value: DataF32 { value } }
        F64Kind:
          match(reader.read_f64())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<f64> { value }:
              Ok<DataValue> { value: DataF64 { value } }
        StringKind:
          match(reader.read_string())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<String> { value }:
              Ok<DataValue> { value: DataString { value } }
        BytesKind:
          match(reader.read_bytes())
            Err<MsgPackError> { error }:
              Err<MsgPackError> { error }
            Ok<Bytes> { value }:
              Ok<DataValue> { value: DataBytes { value } }
        ArrayKind:
          read_data_array(reader)
        RecordKind:
          read_data_fields(reader)
        else:
          msgpack_reader_failure<DataValue>("msgpack reader found an unsupported kind")

fn read_data_array(~reader: MsgPackReader) -> Result<DataValue, MsgPackError>
  match(reader.begin_array())
    Err<MsgPackError> { error }:
      Err<MsgPackError> { error }
    Ok<i32> { value: length }:
      let ~values = Array<DataValue>::with_capacity(length)
      while values.len() < length:
        match(read_data_value(reader))
          Err<MsgPackError> { error }:
            return Err<MsgPackError> { error }
          Ok<DataValue> { value }:
            values.push(value)
      match(reader.end_array())
        Err<MsgPackError> { error }:
          Err<MsgPackError> { error }
        Ok<Unit>:
          Ok<DataValue> { value: DataArray { values } }

fn read_data_fields(~reader: MsgPackReader) -> Result<DataValue, MsgPackError>
  match(reader.begin_record())
    Err<MsgPackError> { error }:
      Err<MsgPackError> { error }
    Ok<Unit>:
      let ~fields = Array<DataField>::init()
      var variant_name = "".to_string()
      var has_variant = false
      var reading = true
      while reading:
        match(reader.next_field())
          Err<MsgPackError> { error }:
            return Err<MsgPackError> { error }
          Ok<Option<String>> { value }:
            value.match(field)
              None:
                reading = false
              Some<String> { value: name }:
                let name_slice = name.as_slice()
                let ~name_bytes = Array<i32>::with_capacity(name_slice.byte_len())
                var name_index = 0
                while name_index < name_slice.byte_len():
                  match(name_slice.get_byte(name_index))
                    Some<i32> { value: byte }:
                      name_bytes.push(byte)
                    None:
                      void
                  name_index = name_index + 1
                let stable_name = new_string(name_bytes.to_fixed_array())
                if name == "$variant":
                  match(reader.read_string())
                    Err<MsgPackError> { error }:
                      return Err<MsgPackError> { error }
                    Ok<String> { value }:
                      variant_name = value
                      has_variant = true
                else:
                  match(read_data_value(reader))
                    Err<MsgPackError> { error }:
                      return Err<MsgPackError> { error }
                    Ok<DataValue> { value }:
                      fields.push(DataField { name: stable_name, value })
      match(reader.end_record())
        Err<MsgPackError> { error }:
          Err<MsgPackError> { error }
        Ok<Unit>:
          if has_variant:
            return Ok<DataValue> {
              value: DataVariant { name: variant_name, fields }
            }
          Ok<DataValue> { value: DataObject { fields } }

obj MemoryDecoderSource {
  ptr: i32,
  len: i32
}

obj BytesDecoderSource {
  bytes: Bytes
}

type DecoderSource = MemoryDecoderSource | BytesDecoderSource

obj Decoder {
  source: DecoderSource,
  state: SharedCell<DecoderState>
}

obj DecoderState {
  pos: i32,
  ok: bool
}

fn byte_encoder() -> Encoder
  Encoder {
    sink: BytesEncoderSink {},
    state: SharedCell(EncoderState {
      bytes: EncoderByteEnd {},
      byte_count: 0,
      pos: 0,
      ok: true
    })
  }

fn bytes_decoder(bytes: Bytes) -> Decoder
  Decoder {
    source: BytesDecoderSource { bytes },
    state: SharedCell(DecoderState {
      pos: 0,
      ok: true
    })
  }

/// Encodes one MessagePack value into a caller-provided memory region.
///
/// Params:
/// - `value`: MessagePack value to encode.
/// - `ptr`: Start offset in linear memory where bytes are written.
/// - `len`: Maximum writable bytes at `ptr`.
///
/// Returns the number of bytes written, or `-1` when encoding fails due to
/// bounds checks. Prefer `std::msgpack::encode_value` for the public fallible
/// API.
pub fn encode_value_raw(value: MsgPack, ptr: i32, len: i32): () -> i32
  let ~encoder = Encoder(ptr, len)
  encoder.encode_any(value)
  if encoder.is_ok() then: encoder.position() else: -1

pub fn encode_value_result(value: MsgPack, ptr: i32, len: i32): () -> Result<i32, MsgPackError>
  let written = encode_value_raw(value, ptr, len)
  if written >= 0:
    return Ok<i32> { value: written }
  Err<MsgPackError> {
    error: make_error(
      error_code_buffer_too_small(),
      "msgpack encode failed: destination buffer is too small"
    )
  }

/// Encodes one parsed MessagePack value into immutable bytes.
pub fn encode_value_bytes(value: MsgPack): () -> Result<Bytes, MsgPackError>
  let ~encoder = byte_encoder()
  encoder.encode_any(value)
  if encoder.is_ok():
    return Ok<Bytes> { value: encoder.encoded_bytes() }
  Err<MsgPackError> {
    error: make_error(
      error_code_buffer_too_small(),
      "msgpack encode failed"
    )
  }

pub fn encode_value(value: MsgPack, ptr: i32, len: i32): () -> i32
  encode_value_raw(value, ptr, len)

/// Decodes one MessagePack value from a memory region.
///
/// Params:
/// - `ptr`: Start offset in linear memory where encoded bytes are read.
/// - `len`: Number of readable bytes from `ptr`.
///
/// Returns the decoded value, or `Null` when decoding fails. Prefer
/// `std::msgpack::decode_value` for the public fallible API.
pub fn decode_value_raw(ptr: i32, len: i32): () -> MsgPack
  let ~decoder = Decoder(ptr, len)
  let value = decoder.decode_any()
  if decoder.is_ok() then: value else: make_null()

pub fn decode_value_result(ptr: i32, len: i32): () -> Result<MsgPack, MsgPackError>
  let ~decoder = Decoder(ptr, len)
  let value = decoder.decode_any()
  if decoder.is_ok() == false:
    return Err<MsgPackError> {
      error: make_error(
        error_code_decode_failed(),
        "msgpack decode failed: malformed or truncated payload"
      )
    }
  if decoder.position() != len:
    return Err<MsgPackError> {
      error: make_error(
        error_code_trailing_bytes(),
        "msgpack decode failed: trailing bytes remain after one value"
      )
    }
  Ok<MsgPack> { value: value }

/// Decodes exactly one parsed MessagePack value from immutable bytes.
pub fn decode_value_bytes(bytes: Bytes): () -> Result<MsgPack, MsgPackError>
  let decoder = bytes_decoder(bytes)
  let value = decoder.decode_any()
  if decoder.is_ok() == false:
    return Err<MsgPackError> {
      error: make_error(
        error_code_decode_failed(),
        "msgpack decode failed: malformed or truncated payload"
      )
    }
  if decoder.position() != bytes.len():
    return Err<MsgPackError> {
      error: make_error(
        error_code_trailing_bytes(),
        "msgpack decode failed: trailing bytes remain after one value"
      )
    }
  Ok<MsgPack> { value: value }

pub fn decode_value(ptr: i32, len: i32): () -> MsgPack
  decode_value_raw(ptr, len)

@compiler_impl(id: "voyd.std.msgpack", version: 1)
impl HostTransportProvider<MsgPackReader, MsgPackWriter> for MsgPackHostTransport
  fn create_reader(ptr: i32, len: i32) -> MsgPackReader
    let limits = DecodeLimits {
      max_depth: 128,
      max_bytes: 16777216,
      max_collection_length: 1048576
    }
    MsgPackReader {
      decoder: Decoder(ptr, len),
      container_kinds: Array<i32>::init(),
      remaining_values: Array<i32>::init(),
      root_consumed: false,
      failed: (len > limits.max_bytes or ptr < 0 or len < 0),
      limits: limits,
      path: "$".to_string(),
      parents: Array<String>::init()
    }

  fn reader_complete(reader: MsgPackReader) -> bool
    reader.failed == false
      and reader.decoder.is_ok()
      and reader.root_consumed
      and reader.container_kinds.is_empty()
      and reader.decoder.position() == reader.decoder.source_length()

  fn create_writer(ptr: i32, len: i32) -> MsgPackWriter
    let limits = EncodeLimits {
      max_depth: 128,
      max_bytes: 16777216,
      max_collection_length: 1048576
    }
    MsgPackWriter {
      encoder: Encoder(ptr, len),
      container_kinds: Array<i32>::init(),
      remaining_values: Array<i32>::init(),
      pending_fields: Array<i32>::init(),
      root_count: 0,
      failed: (ptr < 0 or len < 0),
      limits: limits
    }

  fn finish_writer(writer: MsgPackWriter) -> i32
    if writer.failed or writer.encoder.is_ok() == false:
      return -1
    if writer.container_kinds.is_empty() == false or writer.root_count != 1:
      return -1
    if writer.encoder.position() > writer.limits.max_bytes:
      return -1
    writer.encoder.position()

fn empty_binary(): () -> Binary
  Binary { bytes: Array<i32>::init() }

fn empty_array(): () -> Array<MsgPack>
  Array<MsgPack>::init()

fn empty_map(): () -> Dict<String, MsgPack>
  Dict<String, MsgPack>::init()

fn empty_text(): () -> String
  new_string(new_fixed_array<i32>(0))

/// Returns a MessagePack null value.
pub fn make_null(): () -> MsgPack
  Null {}

/// Wraps a 32-bit integer as a MessagePack value.
pub fn make_i32(value: i32): () -> MsgPack
  I32 { value }

/// Wraps a 64-bit integer as a MessagePack value.
pub fn make_i64(value: i64): () -> MsgPack
  I64 { value }

/// Wraps a 32-bit float as a MessagePack value.
pub fn make_f32(value: f32): () -> MsgPack
  F32 { value }

/// Wraps a boolean as a MessagePack value.
pub fn make_bool(value: bool): () -> MsgPack
  Bool { value }

/// Wraps a string as a MessagePack value.
pub fn make_string(value: String): () -> MsgPack
  value

/// Wraps a string slice as a MessagePack value.
pub fn make_string(value: StringSlice): () -> MsgPack
  value.to_string()

/// Wraps binary data as a MessagePack value.
pub fn make_binary(value: Binary): () -> MsgPack
  value

/// Wraps an array as a MessagePack value.
pub fn make_array(value: Array<MsgPack>): () -> MsgPack
  value

/// Wraps a string-keyed dictionary as a MessagePack map value.
pub fn make_map(value: Dict<String, MsgPack>): () -> MsgPack
  MsgPackMap { entries: value.entries() }

/// Extracts a 32-bit integer from a MessagePack value.
pub fn unpack_i32(value: MsgPack): () -> i32
  value.match(decoded)
    I32:
      decoded.value
    I64:
      cast::to_i32_wrapping(decoded.value)
    else:
      0

/// Extracts a 64-bit integer from a MessagePack value.
pub fn unpack_i64(value: MsgPack): () -> i64
  value.match(decoded)
    I64:
      decoded.value
    I32:
      cast::to_i64(decoded.value)
    else:
      cast::to_i64(0)

/// Extracts a 32-bit float from a MessagePack value.
pub fn unpack_f32(value: MsgPack): () -> f32
  value.match(decoded)
    F32:
      decoded.value
    F64:
      cast::to_f32(decoded.value)
    I32:
      cast::to_f32(decoded.value)
    I64:
      cast::to_f32(decoded.value)
    else:
      cast::reinterpret_f32(0)

/// Extracts a 64-bit float from a MessagePack value.
pub fn unpack_f64(value: MsgPack): () -> f64
  value.match(decoded)
    F64:
      decoded.value
    F32:
      cast::to_f64(decoded.value)
    I32:
      cast::to_f64(decoded.value)
    I64:
      cast::to_f64(decoded.value)
    else:
      0.0

/// Extracts a boolean from a MessagePack value.
pub fn unpack_bool(value: MsgPack): () -> bool
  value.match(decoded)
    Bool:
      decoded.value
    else:
      false

/// Extracts a string from a MessagePack value.
pub fn unpack_string(value: MsgPack): () -> String
  value.match(decoded)
    Bool:
      if decoded.value:
        "true".as_slice().to_string()
      else:
        "false".as_slice().to_string()
    I32:
      cast::to_string(decoded.value)
    I64:
      cast::to_string(decoded.value)
    F32:
      cast::to_string(decoded.value)
    F64:
      cast::to_string(decoded.value)
    String:
      decoded
    else:
      empty_text()

/// Extracts binary data from a MessagePack value.
pub fn unpack_binary(value: MsgPack): () -> Binary
  value.match(boxed)
    Binary:
      boxed
    else:
      empty_binary()

/// Extracts an array from a MessagePack value.
pub fn unpack_array(value: MsgPack): () -> Array<MsgPack>
  value.match(boxed)
    Array<MsgPack>:
      boxed
    else:
      empty_array()

/// Extracts a string-keyed map from a MessagePack value.
pub fn unpack_map(value: MsgPack): () -> Dict<String, MsgPack>
  value.match(boxed)
    MsgPackMap:
      var out = Dict<String, MsgPack>::init()
      let entries = boxed.entries
      var index = 0
      while index < entries.len():
        match(entries.get(index))
          Some<(String, MsgPack)> { value: entry }:
            out = out.setting(entry.0, entry.1)
          None:
            void
        index = index + 1
      out
    else:
      empty_map()

pub fn unpack_map_result(value: MsgPack): () -> Result<Dict<String, MsgPack>, MsgPackError>
  value.match(boxed)
    MsgPackMap:
      Ok<Dict<String, MsgPack>> { value: unpack_map(value) }
    else:
      Err<MsgPackError> {
        error: make_error(
          error_code_type_mismatch(),
          "msgpack unpack failed: expected map"
        )
      }

impl Encoder
  /// Initializes a codec cursor over the provided memory region.
  pub fn init(ptr: i32, len: i32)
    Encoder {
      sink: MemoryEncoderSink { ptr: ptr, len: len },
      state: SharedCell(EncoderState {
        bytes: EncoderByteEnd {},
        byte_count: 0,
        pos: 0,
        ok: true
      })
    }

  fn is_ok(self) -> bool
    self.state.with((state) => state.ok)

  fn position(self) -> i32
    self.state.with((state) => state.pos)

  fn mark_failed(self) -> void
    self.state.with_mut((~state) -> void => state.ok = false)

  fn can_write(self, count: i32) -> bool
    if self.is_ok() == false:
      return false
    if count <= 0:
      return true
    let next = self.position() + count
    self.sink.match(active)
      MemoryEncoderSink:
        if next > active.len:
          self.mark_failed()
          return false
        let memory_end = memory::size() * 65536
        if (active.ptr + next) > memory_end:
          self.mark_failed()
          return false
        true
      BytesEncoderSink:
        true

  fn write_u8(self, value: i32) -> void
    if self.can_write(1) == false:
      return void
    self.sink.match(active)
      MemoryEncoderSink:
        memory::store_u8(active.ptr + self.position(), value)
        self.state.with_mut((~state) -> void => state.pos = state.pos + 1)
      BytesEncoderSink:
        self.state.with_mut((~state) -> void =>
          state.bytes = EncoderByte { value, previous: state.bytes }
          state.byte_count = state.byte_count + 1
          state.pos = state.pos + 1
        )

  fn encoded_bytes(self) -> Bytes
    self.sink.match(active)
      BytesEncoderSink:
        self.state.with((state) -> Bytes =>
          let storage = new_fixed_array<i32>(state.byte_count)
          var index = state.byte_count - 1
          var current: EncoderByteLink = state.bytes
          while index >= 0:
            current.match(byte)
              EncoderByte:
                __array_set(storage, index, byte.value)
                current = byte.previous
              EncoderByteEnd:
                return Bytes { storage: Array<i32>::init() }
            index = index - 1
          let array = new_array_unchecked<i32>({ from: storage })
          Bytes { storage: array }
        )
      MemoryEncoderSink:
        panic()
        Bytes { storage: Array<i32>::init() }

  fn write_u16(self, value: i32) -> void
    if self.can_write(2) == false:
      return void
    self.write_u8(shift_ru(value, 8))
    self.write_u8(bit_and(value, 255))

  fn write_u32(self, value: i32) -> void
    if self.can_write(4) == false:
      return void
    self.write_u8(shift_ru(value, 24))
    self.write_u8(bit_and(shift_ru(value, 16), 255))
    self.write_u8(bit_and(shift_ru(value, 8), 255))
    self.write_u8(bit_and(value, 255))

  fn write_u64(self, value: i64) -> void
    if self.can_write(8) == false:
      return void
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 56)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 48)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 40)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 32)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 24)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 16)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(shift_ru(value, 8)), 255))
    self.write_u8(bit_and(cast::to_i32_wrapping(value), 255))

  fn encode_numeric(self, value: Numeric) -> void
    value.match(number)
      I32:
        self.encode_i32(number.value)
      I64:
        self.encode_i64(number.value)
      F32:
        self.encode_f32(number.value)
      F64:
        self.encode_f64(number.value)

  fn encode_i32(self, value: i32) -> void
    if value >= 0 and value < 128:
      self.write_u8(value)
      return void
    if value >= -32 and value < 0:
      self.write_u8(value + 256)
      return void
    self.write_u8(210)
    self.write_u32(value)

  fn encode_i64(self, value: i64) -> void
    self.write_u8(211)
    self.write_u64(value)

  fn encode_f32(self, value: f32) -> void
    self.write_u8(202)
    self.write_u32(cast::reinterpret_i32(value))

  fn encode_f64(self, value: f64) -> void
    self.write_u8(203)
    self.write_u64(cast::reinterpret_i64(value))

  fn encode_string(self, value: String) -> void
    let len = value.byte_count
    if
      len < 32:
        self.write_u8(160 + len)
      len < 256:
        self.write_u8(217)
        self.write_u8(len)
      len < 65536:
        self.write_u8(218)
        self.write_u16(len)
      else:
        self.write_u8(219)
        self.write_u32(len)

    var index = 0
    while index < len:
      match(value.get_byte(index))
        Some<i32> { value: byte }:
          self.write_u8(byte)
        None:
          return void
      index = index + 1

  fn encode_bytes(self, bytes: Bytes) -> void
    let len = bytes.len()
    self.encode_binary_header(len)
    var index = 0
    while index < len:
      self.write_u8(bytes.at(index))
      index = index + 1

  fn encode_binary_header(self, len: i32) -> void
    if
      len < 256:
        self.write_u8(196)
        self.write_u8(len)
      len < 65536:
        self.write_u8(197)
        self.write_u16(len)
      else:
        self.write_u8(198)
        self.write_u32(len)

  fn encode_binary(self, bytes: Array<i32>) -> void
    let len = bytes.len()
    self.encode_binary_header(len)

    let source = bytes.raw_storage()
    var index = 0
    while index < len:
      self.write_u8(__array_get(source, index))
      index = index + 1

  fn encode_array(self, value: Array<MsgPack>) -> void
    let len = value.len()
    self.encode_array_header(len)
    let source = value.raw_storage()
    var index = 0
    while index < len:
      self.encode_any(__array_get(source, index))
      index = index + 1

  fn encode_array_header(self, len: i32) -> void
    if
      len < 16:
        self.write_u8(144 + len)
      len < 65536:
        self.write_u8(220)
        self.write_u16(len)
      else:
        self.write_u8(221)
        self.write_u32(len)

  fn encode_map(self, value: Dict<String, MsgPack>) -> void
    self.encode_map_entries(value.entries())

  fn encode_map_entries(self, entries: Array<(String, MsgPack)>) -> void
    let len = entries.len()
    self.encode_map_header(len)
    let storage = entries.raw_storage()
    let entry_count = entries.len()
    var index = 0
    while index < entry_count:
      let entry = __array_get(storage, index)
      self.encode_string(entry.0)
      self.encode_any(entry.1)
      index = index + 1

  fn encode_map_header(self, len: i32) -> void
    if
      len < 16:
        self.write_u8(128 + len)
      len < 65536:
        self.write_u8(222)
        self.write_u16(len)
      else:
        self.write_u8(223)
        self.write_u32(len)

  fn encode_any(self, value: MsgPack) -> void
    value.match(decoded)
      Null:
        self.write_u8(192)
      Bool:
        let flag = if decoded.value then: 195 else: 194
        self.write_u8(flag)
      I32:
        self.encode_numeric(decoded)
      I64:
        self.encode_numeric(decoded)
      F32:
        self.encode_numeric(decoded)
      F64:
        self.encode_numeric(decoded)
      String:
        self.encode_string(decoded)
      Binary:
        self.encode_binary(decoded.bytes)
      Array<MsgPack>:
        self.encode_array(decoded)
      MsgPackMap:
        self.encode_map_entries(decoded.entries)

impl Decoder
  /// Initializes a codec cursor over the provided memory region.
  pub fn init(ptr: i32, len: i32)
    Decoder {
      source: MemoryDecoderSource { ptr: ptr, len: len },
      state: SharedCell(DecoderState {
        pos: 0,
        ok: true
      })
    }

  fn source_length(self) -> i32
    self.source.match(active)
      MemoryDecoderSource:
        active.len
      BytesDecoderSource:
        active.bytes.len()

  fn is_ok(self) -> bool
    self.state.with((state) => state.ok)

  fn position(self) -> i32
    self.state.with((state) => state.pos)

  fn mark_failed(self) -> void
    self.state.with_mut((~state) -> void => state.ok = false)

  fn at_end(self) -> bool
    self.position() == self.source_length()

  fn peek_u8(self) -> i32
    let pos = self.position()
    if self.is_ok() == false or pos < 0 or pos >= self.source_length():
      return -1
    self.source.match(active)
      MemoryDecoderSource:
        memory::load_u8(active.ptr + pos)
      BytesDecoderSource:
        active.bytes.at(pos)

  fn is_integer_prefix(self, prefix: i32) -> bool
    prefix < 128
      or prefix >= 224
      or (prefix >= 204 and prefix <= 211)

  fn is_string_prefix(self, prefix: i32) -> bool
    (prefix >= 160 and prefix < 192)
      or prefix == 217
      or prefix == 218
      or prefix == 219

  fn is_binary_prefix(self, prefix: i32) -> bool
    prefix == 196 or prefix == 197 or prefix == 198

  fn is_array_prefix(self, prefix: i32) -> bool
    (prefix >= 144 and prefix < 160) or prefix == 220 or prefix == 221

  fn is_map_prefix(self, prefix: i32) -> bool
    (prefix >= 128 and prefix < 144) or prefix == 222 or prefix == 223

  fn read_i32_value(self) -> Option<i32>
    let prefix = self.read_u8()
    if prefix < 128:
      return Some<i32> { value: prefix }
    if prefix >= 224:
      return Some<i32> { value: prefix - 256 }
    if prefix == 204:
      return Some<i32> { value: self.read_u8() }
    if prefix == 205:
      return Some<i32> { value: self.read_u16() }
    if prefix == 206:
      let value = self.read_u32()
      if value < 0:
        return None {}
      return Some<i32> { value }
    if prefix == 208:
      let value = self.read_u8()
      return Some<i32> { value: if value >= 128 then: value - 256 else: value }
    if prefix == 209:
      let value = self.read_u16()
      return Some<i32> { value: if value >= 32768 then: value - 65536 else: value }
    if prefix == 210:
      return Some<i32> { value: self.read_u32() }
    if prefix == 207:
      let value = self.read_u64()
      if value < cast::to_i64(0):
        return None {}
      match(cast::to_i32_checked(value))
        Err:
          return None {}
        Ok<i32> { value }:
          return Some<i32> { value }
    if prefix == 211:
      match(cast::to_i32_checked(self.read_u64()))
        Err:
          return None {}
        Ok<i32> { value }:
          return Some<i32> { value }
    None {}

  fn read_i64_value(self) -> Option<i64>
    let prefix = self.read_u8()
    if prefix < 128:
      return Some<i64> { value: cast::to_i64(prefix) }
    if prefix >= 224:
      return Some<i64> { value: cast::to_i64(prefix - 256) }
    if prefix == 204:
      return Some<i64> { value: cast::to_i64(self.read_u8()) }
    if prefix == 205:
      return Some<i64> { value: cast::to_i64(self.read_u16()) }
    if prefix == 206:
      return Some<i64> { value: extend_i32_u(self.read_u32()) }
    if prefix == 207:
      let value = self.read_u64()
      if value < cast::to_i64(0):
        return None {}
      return Some<i64> { value }
    if prefix == 211:
      return Some<i64> { value: self.read_u64() }
    if prefix == 208:
      let value = self.read_u8()
      return Some<i64> {
        value: cast::to_i64(if value >= 128 then: value - 256 else: value)
      }
    if prefix == 209:
      let value = self.read_u16()
      return Some<i64> {
        value: cast::to_i64(if value >= 32768 then: value - 65536 else: value)
      }
    if prefix == 210:
      return Some<i64> { value: cast::to_i64(self.read_u32()) }
    None {}

  fn read_string_length(self) -> i32
    let prefix = self.read_u8()
    if prefix >= 160 and prefix < 192:
      return prefix - 160
    if prefix == 217:
      return self.read_u8()
    if prefix == 218:
      return self.read_u16()
    if prefix == 219:
      return self.read_u32()
    -1

  fn read_string_value(self) -> Option<String>
    let length = self.read_string_length()
    if length < 0:
      return None {}
    Some<String> { value: self.decode_string(length) }

  fn read_bytes_value(self) -> Option<Bytes>
    let prefix = self.read_u8()
    let length = if
      prefix == 196: self.read_u8()
      prefix == 197: self.read_u16()
      prefix == 198: self.read_u32()
      else: -1
    if length < 0:
      return None {}
    let ~bytes = ByteBuffer::with_capacity(length)
    var index = 0
    while index < length:
      bytes.push(self.read_u8())
      index = index + 1
    Some<Bytes> { value: bytes.as_bytes() }

  fn read_array_length(self) -> i32
    let prefix = self.read_u8()
    if prefix >= 144 and prefix < 160:
      return prefix - 144
    if prefix == 220:
      return self.read_u16()
    if prefix == 221:
      return self.read_u32()
    -1

  fn read_map_length(self) -> i32
    let prefix = self.read_u8()
    if prefix >= 128 and prefix < 144:
      return prefix - 128
    if prefix == 222:
      return self.read_u16()
    if prefix == 223:
      return self.read_u32()
    -1

  fn skip_bytes(self, count: i32) -> void
    if self.can_read(count):
      self.state.with_mut((~state) -> void => state.pos = state.pos + count)

  fn skip_any(
    ~self,
    { depth: i32, limits: DecodeLimits }
  ) -> void
    let prefix = self.read_u8()
    if self.is_ok() == false:
      return void
    if prefix < 128 or prefix >= 224 or prefix == 192 or prefix == 194 or prefix == 195:
      return void
    if prefix == 204 or prefix == 208:
      self.skip_bytes(1)
      return void
    if prefix == 205 or prefix == 209:
      self.skip_bytes(2)
      return void
    if prefix == 202 or prefix == 206 or prefix == 210:
      self.skip_bytes(4)
      return void
    if prefix == 203 or prefix == 207 or prefix == 211:
      self.skip_bytes(8)
      return void
    var length = -1
    if prefix >= 160 and prefix < 192:
      length = prefix - 160
    if prefix == 217 or prefix == 196:
      length = self.read_u8()
    if prefix == 218 or prefix == 197:
      length = self.read_u16()
    if prefix == 219 or prefix == 198:
      length = self.read_u32()
    if length >= 0:
      self.skip_bytes(length)
      return void
    var values = -1
    if prefix >= 144 and prefix < 160:
      values = prefix - 144
    if prefix == 220:
      values = self.read_u16()
    if prefix == 221:
      values = self.read_u32()
    if prefix >= 128 and prefix < 144:
      values = (prefix - 128) * 2
    if prefix == 222:
      values = self.read_u16() * 2
    if prefix == 223:
      values = self.read_u32() * 2
    if values < 0:
      self.mark_failed()
      return void
    let collection_length = if self.is_map_prefix(prefix) then: values / 2 else: values
    if collection_length > limits.max_collection_length or depth >= limits.max_depth:
      self.mark_failed()
      return void
    var index = 0
    while index < values:
      self.skip_any(depth: depth + 1, limits: limits)
      index = index + 1

  fn can_read(self, count: i32) -> bool
    if self.is_ok() == false:
      return false
    if count <= 0:
      return true
    let next = self.position() + count
    let source_length = self.source_length()
    let memory_in_bounds = self.source.match(active)
      MemoryDecoderSource:
        let memory_end = memory::size() * 65536
        active.ptr + next <= memory_end
      BytesDecoderSource:
        true
    if next > source_length or memory_in_bounds == false:
      self.mark_failed()
      return false
    true

  fn read_u8(self) -> i32
    if self.can_read(1) == false:
      return 0
    let value = self.peek_u8()
    self.state.with_mut((~state) -> void => state.pos = state.pos + 1)
    value

  fn read_u16(self) -> i32
    if self.can_read(2) == false:
      return 0
    let high = self.read_u8()
    let low = self.read_u8()
    bit_or(shift_l(high, 8), low)

  fn read_u32(self) -> i32
    if self.can_read(4) == false:
      return 0
    let b1 = self.read_u8()
    let b2 = self.read_u8()
    let b3 = self.read_u8()
    let b4 = self.read_u8()
    var value = bit_or(shift_l(b1, 24), shift_l(b2, 16))
    value = bit_or(value, shift_l(b3, 8))
    bit_or(value, b4)

  fn read_u64(self) -> i64
    if self.can_read(8) == false:
      return extend_i32_u(0)
    let b1 = extend_i32_u(self.read_u8())
    let b2 = extend_i32_u(self.read_u8())
    let b3 = extend_i32_u(self.read_u8())
    let b4 = extend_i32_u(self.read_u8())
    let b5 = extend_i32_u(self.read_u8())
    let b6 = extend_i32_u(self.read_u8())
    let b7 = extend_i32_u(self.read_u8())
    let b8 = extend_i32_u(self.read_u8())

    var value = bit_or(shift_l(b1, 56), shift_l(b2, 48))
    value = bit_or(value, shift_l(b3, 40))
    value = bit_or(value, shift_l(b4, 32))
    value = bit_or(value, shift_l(b5, 24))
    value = bit_or(value, shift_l(b6, 16))
    value = bit_or(value, shift_l(b7, 8))
    bit_or(value, b8)

  fn decode_string(self, length: i32) -> String
    if length <= 0:
      return empty_text()
    let storage = new_fixed_array<i32>(length)
    var index = 0
    while index < length:
      __array_set(storage, index, self.read_u8())
      index = index + 1
    new_string(storage)

  fn decode_binary(self, length: i32) -> Binary
    if length <= 0:
      return Binary { bytes: Array<i32>::with_capacity(0) }
    let ~bytes = Array<i32>::with_capacity(length)
    var index = 0
    while index < length:
      bytes.push(self.read_u8())
      index = index + 1
    Binary { bytes: bytes }

  fn decode_array(self, length: i32) -> Array<MsgPack>
    let capacity = if length < 0 then: 0 else: length
    let ~out = Array<MsgPack>::with_capacity(capacity)
    var index = 0
    while index < length:
      out.push(self.decode_any())
      index = index + 1
    out

  fn decode_map(self, length: i32) -> Dict<String, MsgPack>
    var out = Dict<String, MsgPack>::init()
    var index = 0
    while index < length:
      let key = self.decode_any()
      key.match(decoded_key)
        String:
          let key_slice = decoded_key.as_slice()
          let ~key_bytes = Array<i32>::with_capacity(key_slice.byte_len())
          var key_index = 0
          while key_index < key_slice.byte_len():
            match(key_slice.get_byte(key_index))
              Some<i32> { value: byte }:
                key_bytes.push(byte)
              None:
                void
            key_index = key_index + 1
          let stable_key = new_string(key_bytes.to_fixed_array())
          let value = self.decode_any()
          out = out.setting(stable_key, value)
        else:
          self.decode_any()
      index = index + 1
    out

  fn decode_integer(self, prefix: i32) -> MsgPack
    if prefix < 128:
      return make_i32(prefix)
    if prefix >= 224:
      return make_i32(prefix - 256)
    if prefix == 204:
      return make_i32(self.read_u8())
    if prefix == 205:
      return make_i32(self.read_u16())
    if prefix == 206:
      let value = self.read_u32()
      if value < 0:
        let extended = extend_i32_u(value)
        return make_i64(extended)
      return make_i32(value)
    if prefix == 207:
      return make_i64(self.read_u64())
    if prefix == 208:
      return make_i32(self.read_u8() - 256)
    if prefix == 209:
      let value = self.read_u16()
      if value >= 32768:
        return make_i32(value - 65536)
      return make_i32(value)
    if prefix == 210:
      return make_i32(self.read_u32())
    if prefix == 211:
      return make_i64(self.read_u64())
    self.mark_failed()
    make_null()

  fn decode_any(self) -> MsgPack
    let prefix = self.read_u8()
    if self.is_ok() == false:
      return make_null()
    if prefix == 192:
      return make_null()
    if prefix == 194:
      return make_bool(false)
    if prefix == 195:
      return make_bool(true)
    if prefix >= 160 and prefix < 192:
      let len = prefix - 160
      return make_string(self.decode_string(len))
    if prefix >= 144 and prefix < 160:
      return make_array(self.decode_array(prefix - 144))
    if prefix >= 128 and prefix < 144:
      return make_map(self.decode_map(prefix - 128))
    if prefix == 217:
      return make_string(self.decode_string(self.read_u8()))
    if prefix == 218:
      return make_string(self.decode_string(self.read_u16()))
    if prefix == 219:
      return make_string(self.decode_string(self.read_u32()))
    if prefix == 220:
      return make_array(self.decode_array(self.read_u16()))
    if prefix == 221:
      return make_array(self.decode_array(self.read_u32()))
    if prefix == 222:
      return make_map(self.decode_map(self.read_u16()))
    if prefix == 223:
      return make_map(self.decode_map(self.read_u32()))
    if prefix == 196:
      return make_binary(self.decode_binary(self.read_u8()))
    if prefix == 197:
      return make_binary(self.decode_binary(self.read_u16()))
    if prefix == 198:
      return make_binary(self.decode_binary(self.read_u32()))
    if prefix == 202:
      let raw = self.read_u32()
      return make_f32(cast::reinterpret_f32(raw))
    if prefix == 203:
      let raw = self.read_u64()
      return F64 { value: cast::reinterpret_f64(raw) }
    self.decode_integer(prefix)

@intrinsic(name: "__shift_l")
fn shift_l(value: i32, bits: i32): () -> i32 __shift_l(value, bits)

@intrinsic(name: "__shift_l")
fn shift_l(value: i64, bits: i32): () -> i64 __shift_l(value, bits)

@intrinsic(name: "__shift_ru")
fn shift_ru(value: i32, bits: i32): () -> i32 __shift_ru(value, bits)

@intrinsic(name: "__shift_ru")
fn shift_ru(value: i64, bits: i32): () -> i64 __shift_ru(value, bits)

@intrinsic(name: "__bit_and")
fn bit_and(value: i32, mask: i32): () -> i32 __bit_and(value, mask)

@intrinsic(name: "__bit_or")
fn bit_or(value: i32, other: i32): () -> i32 __bit_or(value, other)

@intrinsic(name: "__bit_or")
fn bit_or(value: i64, other: i64): () -> i64 __bit_or(value, other)

@intrinsic(name: "__i64_extend_u")
fn extend_i32_u(value: i32): () -> i64 __i64_extend_u(value)
