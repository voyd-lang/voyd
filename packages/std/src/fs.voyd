//! File system APIs backed by host runtime operations.
//!
//! `std::fs` provides read/write/existence/removal/listing helpers that operate on
//! `std::path::Path` and return typed `Result` values where host I/O can fail.
//! Effect payloads use automatic DTO conversion.

use std::array::Array
use std::bytes::Bytes
use std::error::{
  IoAlreadyExists,
  IoConflict,
  IoError,
  IoErrorKind,
  IoNotFound,
  IoOther,
  IoPermissionDenied
}
use std::optional::types::all
use std::path::Path
use std::result::types::all
use std::string::type::{ String, StringSlice, new_string }

/// Host file-system effect used by `std::fs`.
///
pub obj FsResult<T> {
  api ok: bool,
  api value: T,
  api error_kind: String,
  api error_code: i32,
  api error_message: String
}

pub obj FsWriteBytesRequest {
  api path: String,
  api bytes: Bytes
}

pub obj FsWriteStringRequest {
  api path: String,
  api value: String
}

pub obj FsWriteRequest {
  api path: String,
  api kind: String,
  api bytes?: Bytes,
  api value?: String
}

pub obj FsRenameRequest {
  api from: String,
  api to: String
}

/// Operations in this effect proxy host file APIs using automatic DTO values.
@effect(id: "voyd.std.fs")
pub eff Fs
  /// Reads file contents from `path` and returns raw byte data or an I/O error DTO.
  read_bytes(tail, path: String) -> FsResult<Bytes>
  /// Reads UTF-8 text contents from `path` and returns string data or an I/O error DTO.
  read_string(tail, path: String) -> FsResult<String>
  /// Writes raw byte data to a file.
  write_bytes(tail, request: FsWriteBytesRequest) -> FsResult<Unit>
  /// Writes UTF-8 text to a file.
  write_string(tail, request: FsWriteStringRequest) -> FsResult<Unit>
  /// Returns the host-reported existence check for `path`.
  exists(tail, path: String) -> bool
  /// Lists child paths in the directory at `path`, or returns an I/O error DTO.
  list_dir(tail, path: String) -> FsResult<Array<String>>
  /// Removes the file or empty directory at `path`, or returns an I/O error DTO.
  remove(tail, path: String) -> FsResult<Unit>
  /// Creates `path` and any missing parent directories, or returns an I/O error DTO.
  create_dir_all(tail, path: String) -> FsResult<Unit>
  /// Renames a file or directory.
  rename(tail, request: FsRenameRequest) -> FsResult<Unit>
  /// Atomically replaces a file after fully writing a same-directory temporary.
  write_atomic(tail, request: FsWriteRequest) -> FsResult<Unit>
  /// Creates and writes a file only when its path does not already exist.
  create_exclusive(tail, request: FsWriteRequest) -> FsResult<Unit>

/// Reads a file as raw bytes.
///
/// Example:
/// `let bytes = fs::read_bytes(Path::new("./image.bin".as_slice()))`
pub fn read_bytes(path: Path): Fs -> Result<Bytes, IoError>
  decode_result(Fs::read_bytes(path.as_string()))

/// Reads text from a file.
///
/// This expects host-side UTF-8 text decoding.
pub fn read_string(path: Path): Fs -> Result<String, IoError>
  decode_result(Fs::read_string(path.as_string()))

/// Writes bytes to a file.
///
/// Example:
/// `let write_result = fs::write_bytes(file_path, payload)`
pub fn write_bytes(path: Path, bytes: Bytes): Fs -> Result<Unit, IoError>
  decode_result(Fs::write_bytes(FsWriteBytesRequest {
    path: path.as_string(),
    bytes: bytes
  }))

/// Writes text to a file.
///
/// Example:
/// `let write_result = fs::write_string(file_path, "hello".as_slice())`
pub fn write_string(path: Path, value: String): Fs -> Result<Unit, IoError>
  decode_result(Fs::write_string(FsWriteStringRequest {
    path: path.as_string(),
    value: value
  }))

/// Writes text to a file.
pub fn write_string(path: Path, value: StringSlice): Fs -> Result<Unit, IoError>
  write_string(path, value.to_string())

/// Returns true when the path exists in the file system.
pub fn exists(path: Path): Fs -> bool
  Fs::exists(path.as_string())

/// Removes a file or empty directory.
pub fn remove(path: Path): Fs -> Result<Unit, IoError>
  decode_result(Fs::remove(path.as_string()))

/// Lists child paths in a directory.
///
/// Each returned `Path` is decoded from host-provided string entries.
pub fn list_dir(path: Path): Fs -> Result<Array<Path>, IoError>
  let result = Fs::list_dir(path.as_string())
  if not result.ok:
    return Err<IoError> {
      error: IoError {
        kind: decode_io_error_kind(result.error_kind),
        code: result.error_code,
        message: result.error_message
      }
    }

  let value = result.value
  if value.is_empty():
    return Ok<Array<Path>> { value: Array<Path>::init() }

  let ~paths = Array<Path>::with_capacity(value.len())
  var index = 0
  while index < value.len():
    paths.push(Path { raw: value.at(index) })
    index = index + 1
  Ok<Array<Path>> { value: paths }

/// Creates a directory and all missing parent directories.
///
/// Existing directories are accepted as success.
pub fn create_dir_all(path: Path): Fs -> Result<Unit, IoError>
  decode_result(Fs::create_dir_all(path.as_string()))

/// Renames a file or directory from `source` to `destination`.
///
/// Host filesystem rename semantics apply. Renaming a temporary file over its
/// destination can be used for atomic replacement when both paths share a
/// filesystem.
pub fn rename(source: Path, { to destination: Path }): Fs -> Result<Unit, IoError>
  decode_result(Fs::rename(FsRenameRequest {
    from: source.as_string(),
    to: destination.as_string()
  }))

/// Atomically writes bytes, replacing the destination only after the complete
/// value has been written to a temporary file in the same directory.
///
/// A successful call guarantees that readers see either the previous complete
/// file or the new complete file. Host and operating-system durability after a
/// process or machine crash is outside this contract.
pub fn write_atomic(path: Path, bytes: Bytes): Fs -> Result<Unit, IoError>
  decode_result(Fs::write_atomic(FsWriteRequest {
    path: path.as_string(),
    kind: "bytes",
    bytes: Some<Bytes> { value: bytes }
  }))

/// Atomically writes owned UTF-8 text. See the bytes overload for replacement
/// and durability guarantees.
pub fn write_atomic(path: Path, value: String): Fs -> Result<Unit, IoError>
  decode_result(Fs::write_atomic(FsWriteRequest {
    path: path.as_string(),
    kind: "string",
    value: Some<String> { value: value }
  }))

/// Atomically writes borrowed UTF-8 text.
pub fn write_atomic(path: Path, value: StringSlice): Fs -> Result<Unit, IoError>
  write_atomic(path, value.to_string())

/// Creates and writes a new file atomically with respect to competing creators.
/// Returns `IoAlreadyExists` when another writer owns the destination.
pub fn create_exclusive(path: Path, bytes: Bytes): Fs -> Result<Unit, IoError>
  decode_result(Fs::create_exclusive(FsWriteRequest {
    path: path.as_string(),
    kind: "bytes",
    bytes: Some<Bytes> { value: bytes }
  }))

/// Creates and writes a new UTF-8 text file atomically with respect to competing
/// creators.
pub fn create_exclusive(path: Path, value: String): Fs -> Result<Unit, IoError>
  decode_result(Fs::create_exclusive(FsWriteRequest {
    path: path.as_string(),
    kind: "string",
    value: Some<String> { value: value }
  }))

/// Creates and writes a borrowed UTF-8 text file atomically with respect to
/// competing creators.
pub fn create_exclusive(path: Path, value: StringSlice): Fs -> Result<Unit, IoError>
  create_exclusive(path, value.to_string())

fn decode_result<T>(result: FsResult<T>): () -> Result<T, IoError>
  if result.ok:
    Ok<T> { value: result.value }
  else:
    Err<IoError> {
      error: IoError {
        kind: decode_io_error_kind(result.error_kind),
        code: result.error_code,
        message: result.error_message
      }
    }

fn decode_io_error_kind(value: String): () -> IoErrorKind
  if value.equals("not-found"):
    return IoNotFound {}
  if value.equals("already-exists"):
    return IoAlreadyExists {}
  if value.equals("permission-denied"):
    return IoPermissionDenied {}
  if value.equals("conflict"):
    return IoConflict {}
  IoOther {}
