use std::array::Array
use std::bytes::{ ByteBuffer, Bytes }
use std::error::{ IoAlreadyExists, IoError }
use std::optional::types::all
use std::path::Path
use std::result::types::all
use std::string::type::String
use std::test::assertions::all

test "fs reads typed string and byte payloads":
  match(read_string_with_payload(fs_ok("hello")))
    Ok<String> { value }:
      assert(value.equals("hello"), eq: true)
    Err<IoError>:
      assert(false, eq: true)

  let ~bytes = ByteBuffer::init()
  bytes.push(1)
  bytes.push(255)
  match(read_bytes_with_payload(fs_ok(bytes.as_bytes())))
    Ok<Bytes> { value }:
      assert(value.len(), eq: 2)
      assert(value.at(0), eq: 1)
      assert(value.at(1), eq: 255)
    Err<IoError>:
      assert(false, eq: true)

test "fs writes typed paths, strings, and bytes":
  match(write_string_with_assertions())
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

  match(write_bytes_with_assertions())
    Ok<Unit>:
      void
    Err<IoError>:
      assert(false, eq: true)

test "fs lists typed child paths":
  match(list_dir_with_payload(fs_ok(["/tmp/a", "/tmp/b"])))
    Ok<Array<Path>> { value }:
      assert(value.len(), eq: 2)
      assert(value.at(0).as_string().equals("/tmp/a"), eq: true)
      assert(value.at(1).as_string().equals("/tmp/b"), eq: true)
    Err<IoError>:
      assert(false, eq: true)

test "fs preserves an empty typed child path list":
  match(list_dir_with_payload(fs_ok(Array<String>::init())))
    Ok<Array<Path>> { value }:
      assert(value.len(), eq: 0)
    Err<IoError>:
      assert(false, eq: true)

test "fs preserves portable error categories":
  match(create_exclusive_with_payload(fs_error<Unit>(
    value: Unit {},
    kind: "already-exists",
    code: 17,
    message: "host EEXIST detail"
  )))
    Ok<Unit>:
      assert(false, eq: true)
    Err<IoError> { error }:
      assert(error.code, eq: 17)
      assert(error.message.equals("host EEXIST detail"), eq: true)
      error.kind.match(kind)
        IoAlreadyExists:
          void
        else:
          assert(false, eq: true)

test "fs atomic writes preserve semantic content":
  match(write_atomic_with_assertions())
    Err<IoError>:
      assert(false, eq: true)
    Ok<Unit>:
      void

fn read_string_with_payload(payload: FsResult<String>): () -> Result<String, IoError>
  try
    read_string(Path::new("/tmp/app.log"))
  Fs::read_string(tail, _path):
    tail(payload)
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn read_bytes_with_payload(payload: FsResult<Bytes>): () -> Result<Bytes, IoError>
  try
    read_bytes(Path::new("/tmp/data.bin"))
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(payload)
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn write_string_with_assertions(): Test -> Result<Unit, IoError>
  try
    write_string(Path::new("/tmp/app.log"), "line")
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, request):
    assert(request.path.equals("/tmp/app.log"), eq: true)
    assert(request.value.equals("line"), eq: true)
    tail(fs_ok(Unit {}))
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn write_bytes_with_assertions(): Test -> Result<Unit, IoError>
  let ~buffer = ByteBuffer::init()
  buffer.push(7)
  buffer.push(8)
  try
    write_bytes(Path::new("/tmp/data.bin"), buffer.as_bytes())
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, request):
    assert(request.path.equals("/tmp/data.bin"), eq: true)
    assert(request.bytes.len(), eq: 2)
    assert(request.bytes.at(0), eq: 7)
    assert(request.bytes.at(1), eq: 8)
    tail(fs_ok(Unit {}))
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn list_dir_with_payload(payload: FsResult<Array<String>>): () -> Result<Array<Path>, IoError>
  try
    list_dir(Path::new("/tmp"))
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(payload)
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn create_exclusive_with_payload(payload: FsResult<Unit>): () -> Result<Unit, IoError>
  try
    create_exclusive(Path::new("/tmp/new.txt"), "value")
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, _request):
    tail(unit_error())
  Fs::create_exclusive(tail, _request):
    tail(payload)

fn write_atomic_with_assertions(): Test -> Result<Unit, IoError>
  try
    write_atomic(Path::new("/tmp/state.json"), "complete")
  Fs::read_string(tail, _path):
    tail(string_error())
  Fs::read_bytes(tail, _path):
    tail(bytes_error())
  Fs::write_bytes(tail, _request):
    tail(unit_error())
  Fs::write_string(tail, _request):
    tail(unit_error())
  Fs::exists(tail, _path):
    tail(false)
  Fs::list_dir(tail, _path):
    tail(paths_error())
  Fs::remove(tail, _path):
    tail(unit_error())
  Fs::create_dir_all(tail, _path):
    tail(unit_error())
  Fs::rename(tail, _request):
    tail(unit_error())
  Fs::write_atomic(tail, request):
    assert(request.path.equals("/tmp/state.json"), eq: true)
    assert(request.kind.equals("string"), eq: true)
    match(request.value)
      Some<String> { value }:
        assert(value.equals("complete"), eq: true)
      None:
        assert(false, eq: true)
    tail(fs_ok(Unit {}))
  Fs::create_exclusive(tail, _request):
    tail(unit_error())

fn fs_ok<T>(value: T) -> FsResult<T>
  FsResult<T> {
    ok: true,
    value: value,
    error_kind: "other",
    error_code: 0,
    error_message: ""
  }

fn fs_error<T>({ value: T, kind: String, code: i32, message: String }) -> FsResult<T>
  FsResult<T> {
    ok: false,
    value: value,
    error_kind: kind,
    error_code: code,
    error_message: message
  }

fn unit_error() -> FsResult<Unit>
  fs_error<Unit>(value: Unit {}, kind: "other", code: -1, message: "unused")

fn string_error() -> FsResult<String>
  fs_error<String>(value: "", kind: "other", code: -1, message: "unused")

fn bytes_error() -> FsResult<Bytes>
  fs_error<Bytes>(
    value: ByteBuffer::init().as_bytes(),
    kind: "other",
    code: -1,
    message: "unused"
  )

fn paths_error() -> FsResult<Array<String>>
  fs_error<Array<String>>(
    value: Array<String>::init(),
    kind: "other",
    code: -1,
    message: "unused"
  )
