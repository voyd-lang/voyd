use std::memory::self as memory
use std::array::Array
use std::bytes::ByteBuffer
use std::data::{ DataReader, DataWriter }
use std::data::self as data
use std::dict::{ Dict, DictKey }
use std::enums::{ enum }
use std::optional::types::all
use self::errors::{
  MsgPackError,
  error_code_buffer_too_small,
  error_code_decode_failed,
  error_code_numeric_overflow,
  error_code_trailing_bytes,
  error_code_type_mismatch
}
use std::number::cast::to_i64
use std::string::type::String
use std::test::assertions::all

obj BoundaryCodecProfile {
  displayName: String,
  nickname?: String
}

enum BoundaryCodecEvent
  Created { id: i32, labels: Array<String> }
  Deleted { reason: String }

obj BoundaryCodecEnvelope {
  version: i32,
  requestId: String,
  profiles: Array<BoundaryCodecProfile>,
  event: BoundaryCodecEvent
}

test "derived msgpack codecs preserve nested records arrays optionals and enum payloads":
  let source = BoundaryCodecEnvelope {
    version: 3,
    requestId: "request-7",
    profiles: [
      BoundaryCodecProfile { displayName: "Ada" },
      BoundaryCodecProfile { displayName: "Grace", nickname: "Amazing Grace" }
    ],
    event: BoundaryCodecEvent::Created { id: 42, labels: ["compiler", "host"] }
  }
  let packed = from_data_value(data::encode(source))

  match(unpack_map(packed))
    Err<MsgPackError>:
      assert(false, eq: true)
    Ok<Dict<String, MsgPack>> { value: root }:
      assert(root.contains("requestId"), eq: true)
      assert(root.contains("request_id"), eq: false)
      assert_i32_map_field(root, "version", 3)
      match(root.get("event"))
        None:
          assert(false, eq: true)
        Some<MsgPack> { value: event }:
          match(unpack_map(event))
            Err<MsgPackError>:
              assert(false, eq: true)
            Ok<Dict<String, MsgPack>> { value: event_map }:
              assert_string_map_field(event_map, "$variant", "Created")
              assert_i32_map_field(event_map, "id", 42)

  assert_same_encoding(packed, from_data_value(data::encode(source)))

test "typed msgpack encode and decode use immutable bytes":
  let source = BoundaryCodecEnvelope {
    version: 4,
    requestId: "request-8",
    profiles: [BoundaryCodecProfile { displayName: "Lin" }],
    event: BoundaryCodecEvent::Deleted { reason: "complete" }
  }

  match(encode(source))
    Err<MsgPackError>:
      assert(false, eq: true)
    Ok { value: bytes }:
      assert(bytes.is_empty(), eq: false)
      match(decode<BoundaryCodecEnvelope>(bytes))
        Err<MsgPackError>:
          assert(false, eq: true)
        Ok<BoundaryCodecEnvelope> { value }:
          assert(value.version, eq: 4)
          assert(value.requestId, eq: "request-8")
          assert(value.profiles.at(0).displayName, eq: "Lin")
          value.event.match(event)
            Deleted:
              assert(event.reason, eq: "complete")
            else:
              assert(false, eq: true)

test "msgpack encode_value returns error when the destination buffer is too small":
  let base = reserve_test_page()

  match(encode_value(make_string("hello"), base, 1))
    Ok<i32>:
      assert(false, eq: true)
    Err<MsgPackError> { error }:
      assert(error.code, eq: error_code_buffer_too_small())

test "msgpack decode_value rejects malformed bytes":
  let base = reserve_test_page()
  memory::store_u8(base, 193)

  match(decode_value(base, 1))
    Ok<MsgPack>:
      assert(false, eq: true)
    Err<MsgPackError> { error }:
      assert(error.code, eq: error_code_decode_failed())

test "msgpack decode_value rejects trailing bytes":
  let base = reserve_test_page()
  memory::store_u8(base, 192)
  memory::store_u8(base + 1, 192)

  match(decode_value(base, 2))
    Ok<MsgPack>:
      assert(false, eq: true)
    Err<MsgPackError> { error }:
      assert(error.code, eq: error_code_trailing_bytes())

test "msgpack unpack helpers reject mismatched variants":
  match(unpack_bool(make_i32(7)))
    Ok<bool>:
      assert(false, eq: true)
    Err<MsgPackError> { error }:
      assert(error.code, eq: error_code_type_mismatch())

test "msgpack unpack_i32 rejects numeric overflow":
  let overflow = to_i64(2147483647) + to_i64(1)

  match(unpack_i32(make_i64(overflow)))
    Ok<i32>:
      assert(false, eq: true)
    Err<MsgPackError> { error }:
      assert(error.code, eq: error_code_numeric_overflow())

test "MsgPackWriter streams nested DTO values directly to bytes":
  let ~source = ByteBuffer::with_capacity(2)
  source.push(255)
  source.push(0)
  let ~writer = MsgPackWriter::init()
  match(writer.begin_array(length: 2))
    Err<MsgPackError>:
      Test::fail()
    Ok<Unit>:
      void
  match(writer.write_i32(1))
    Err<MsgPackError>:
      Test::fail()
    Ok<Unit>:
      void
  match(writer.write_bytes(source.as_bytes()))
    Err<MsgPackError>:
      Test::fail()
    Ok<Unit>:
      void
  match(writer.end_array())
    Err<MsgPackError>:
      Test::fail()
    Ok<Unit>:
      void
  match(writer.finish())
    Err<MsgPackError>:
      Test::fail()
    Ok { value: encoded }:
      assert(encoded.len(), eq: 6)
      assert(encoded.at(0), eq: 146)
      assert(encoded.at(1), eq: 1)
      assert(encoded.at(2), eq: 196)
      assert(encoded.at(3), eq: 2)
      assert(encoded.at(4), eq: 255)
      assert(encoded.at(5), eq: 0)
      let ~reader = MsgPackReader::init(encoded)
      match(reader.begin_array())
        Err<MsgPackError>:
          Test::fail()
        Ok<i32> { value: length }:
          assert(length, eq: 2)
      match(reader.read_i32())
        Err<MsgPackError>:
          Test::fail()
        Ok<i32> { value }:
          assert(value, eq: 1)
      match(reader.read_bytes())
        Err<MsgPackError>:
          Test::fail()
        Ok { value: bytes }:
          assert(bytes.len(), eq: 2)
          assert(bytes.at(0), eq: 255)
          assert(bytes.at(1), eq: 0)
      match(reader.end_array())
        Err<MsgPackError>:
          Test::fail()
        Ok<Unit>:
          void
      assert(reader.is_complete(), eq: true)

fn assert_i32_map_field(
  map: Dict<String, MsgPack>,
  name: String,
  expected: i32
) -> void
  match(map.get(name))
    None:
      assert(false, eq: true)
    Some<MsgPack> { value }:
      match(unpack_i32(value))
        Err<MsgPackError>:
          assert(false, eq: true)
        Ok<i32> { value: decoded }:
          assert(decoded, eq: expected)

fn assert_string_map_field(
  map: Dict<String, MsgPack>,
  name: String,
  expected: String
) -> void
  match(map.get(name))
    None:
      assert(false, eq: true)
    Some<MsgPack> { value }:
      match(unpack_string(value))
        Err<MsgPackError>:
          assert(false, eq: true)
        Ok<String> { value: decoded }:
          assert(decoded, eq: expected)

fn assert_same_encoding(first: MsgPack, second: MsgPack) -> void
  let base = reserve_test_page()
  let capacity = 32768
  match(encode_value(first, base, capacity))
    Err<MsgPackError>:
      assert(false, eq: true)
    Ok<i32> { value: first_len }:
      match(encode_value(second, base + capacity, capacity))
        Err<MsgPackError>:
          assert(false, eq: true)
        Ok<i32> { value: second_len }:
          assert(first_len, eq: second_len)
          var index = 0
          while index < first_len:
            assert(
              memory::load_u8(base + index),
              eq: memory::load_u8(base + capacity + index)
            )
            index = index + 1

fn reserve_test_page(): () -> i32
  let base = memory::size() * 65536
  memory::grow(1)
  base
