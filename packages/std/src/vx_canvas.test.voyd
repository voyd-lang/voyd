use std::array::Array
use std::dict::{ Dict, DictKey }
use std::enums::{ enum }
use std::msgpack::MsgPack
use std::msgpack::self as msgpack
use std::result::types::all
use std::string::type::String
use std::test::assertions::all
use std::vx::Cmd
use std::vx::canvas::all

enum CanvasTestMsg
  Measured { metrics: TextMetrics }

test "vx canvas constructors encode typed draw primitives":
  let line_draw = line(
    from: Point { x: 1.0, y: 2.0 },
    to: Point { x: 3.0, y: 4.0 },
    color: "#ffffff",
    width: 2.5,
    alpha: 0.75,
    glow_color: "#88ccff",
    glow_blur: 6.0
  )
  assert_string_payload_field(line_draw.payload, "kind", "line")
  assert_f64_payload_field(line_draw.payload, "width", 2.5)
  assert_f64_payload_field(line_draw.payload, "alpha", 0.75)
  assert_string_payload_field(line_draw.payload, "glowColor", "#88ccff")

  let polyline_draw = polyline(
    points: [
      Point { x: 0.0, y: 0.0 },
      Point { x: 5.0, y: 8.0 }
    ],
    color: "#6699ff",
    closed: true,
    fill: "#112244"
  )
  assert_string_payload_field(polyline_draw.payload, "kind", "polyline")
  assert_array_payload_len(polyline_draw.payload, "points", 2)

  let ellipse_draw = ellipse(
    center: Point { x: 12.0, y: 18.0 },
    radius_x: 9.0,
    radius_y: 4.0,
    rotation: 0.5,
    stroke: "#aabbcc"
  )
  assert_string_payload_field(ellipse_draw.payload, "kind", "ellipse")
  assert_f64_payload_field(ellipse_draw.payload, "radiusX", 9.0)
  assert_f64_payload_field(ellipse_draw.payload, "radiusY", 4.0)

  let label = text(
    position: Point { x: 20.0, y: 24.0 },
    value: "Voyd",
    color: "#ffffff",
    font: "600 14px sans-serif",
    align: "center",
    baseline: "middle",
    max_width: 120.0
  )
  assert_string_payload_field(label.payload, "kind", "text")
  assert_string_payload_field(label.payload, "value", "Voyd")
  assert_f64_payload_field(label.payload, "maxWidth", 120.0)

test "vx canvas frame and command encode radial circle rendering":
  let gradient = radial_gradient(
    inner_color: "#ffffff",
    outer_color: "#ff880000",
    inner_radius: 1.0,
    outer_radius: 16.0
  )
  let circle_draw = circle(
    center: Point { x: 80.0, y: 64.0 },
    radius: 16.0,
    stroke: "#ffcc88",
    stroke_width: 2.0,
    glow_color: "#ff8800",
    glow_blur: 12.0,
    radial_gradient: gradient
  )
  assert_string_payload_field(circle_draw.payload, "kind", "circle")
  assert_f64_payload_field(circle_draw.payload, "radius", 16.0)
  assert_payload_has_field(circle_draw.payload, "radialGradient")

  match(msgpack::unpack_map(circle_draw.payload))
    Ok<Dict<String, MsgPack>> { value }:
      match(value.get("radialGradient"))
        Some<MsgPack> { value: radial }:
          match(msgpack::unpack_map(radial))
            Ok<Dict<String, MsgPack>> { value: radial_map }:
              assert_string_field(radial_map, "innerColor", "#ffffff")
              assert_string_field(radial_map, "outerColor", "#ff880000")
              assert_f64_field(radial_map, "outerRadius", 16.0)
            Err:
              assert(false, eq: true)
        None:
          assert(false, eq: true)
    Err:
      assert(false, eq: true)

  let canvas = frame(
    selector: "#scene",
    width: 960.0,
    height: 540.0,
    draws: [circle_draw],
    background: "#050711"
  )
  match(msgpack::unpack_map(canvas.payload))
    Ok<Dict<String, MsgPack>> { value }:
      assert_i32_field(value, "version", 2)
      assert_string_field(value, "selector", "#scene")
      assert_f64_field(value, "width", 960.0)
      assert_f64_field(value, "height", 540.0)
      assert_bool_field(value, "clear", true)
      assert_string_field(value, "background", "#050711")
      match(value.get("draws"))
        Some<MsgPack> { value: draws }:
          match(msgpack::unpack_array(draws))
            Ok<Array<MsgPack>> { value: list }:
              assert(list.len(), eq: 1)
            Err:
              assert(false, eq: true)
        None:
          assert(false, eq: true)
    Err:
      assert(false, eq: true)

  let render_cmd: Cmd<MsgPack> = render(canvas)
  assert_string_payload_field(render_cmd.payload, "type", "cmd")
  assert_string_payload_field(render_cmd.payload, "kind", "canvas_render")
  assert_payload_has_field(render_cmd.payload, "value")

test "vx canvas paths and state operations encode validated wire primitives":
  let path_draw = path(
    segments: [
      path_move_to(Point { x: 0.0, y: 0.0 }),
      path_line_to(Point { x: 12.0, y: 0.0 }),
      path_quadratic_curve_to(
        control: Point { x: 18.0, y: 6.0 },
        to: Point { x: 12.0, y: 12.0 }
      ),
      path_bezier_curve_to(
        control_1: Point { x: 8.0, y: 16.0 },
        control_2: Point { x: 4.0, y: 16.0 },
        to: Point { x: 0.0, y: 12.0 }
      ),
      path_close()
    ],
    fill: "#224466",
    stroke: "#88ccff",
    stroke_width: 2.0,
    fill_rule: FillRule::EvenOdd {}
  )
  assert_string_payload_field(path_draw.payload, "kind", "path")
  assert_array_payload_len(path_draw.payload, "segments", 5)
  assert_string_payload_field(path_draw.payload, "fillRule", "evenodd")

  let transform_draw = transform(Transform {
    a: 1.0,
    b: 0.0,
    c: 0.0,
    d: 1.0,
    e: 20.0,
    f: 30.0
  })
  assert_string_payload_field(transform_draw.payload, "kind", "transform")
  assert_f64_payload_field(transform_draw.payload, "e", 20.0)
  assert_string_payload_field(save().payload, "kind", "save")
  assert_string_payload_field(restore().payload, "kind", "restore")
  assert_string_payload_field(rotate(0.5).payload, "kind", "rotate")
  assert_string_payload_field(translate(x: 4.0, y: 5.0).payload, "kind", "translate")
  assert_string_payload_field(scale(x: 2.0, y: 3.0).payload, "kind", "scale")

  let dash = line_dash(pattern: [3.0, 2.0], offset: 1.0)
  assert_string_payload_field(dash.payload, "kind", "lineDash")
  assert_array_payload_len(dash.payload, "pattern", 2)
  assert_f64_payload_field(dash.payload, "offset", 1.0)

  let composite_draw = composite(CompositeOperation::Lighter {})
  assert_string_payload_field(composite_draw.payload, "kind", "composite")
  assert_string_payload_field(composite_draw.payload, "operation", "lighter")

test "vx canvas command constructors preserve runtime envelopes":
  let measure_by_id = measure_text<i32>(
    selector: "#scene",
    value: "Voyd",
    font: "600 14px sans-serif",
    handler_id: 91
  )
  assert_string_payload_field(measure_by_id.payload, "type", "cmd")
  assert_string_payload_field(measure_by_id.payload, "kind", "canvas_measure_text")
  assert_string_payload_field(measure_by_id.payload, "selector", "#scene")
  assert_string_payload_field(measure_by_id.payload, "value", "Voyd")
  assert_payload_has_field(measure_by_id.payload, "handlerId")

  let measure_typed = measure_text<CanvasTestMsg>(
    selector: "#scene",
    value: "Voyd",
    font: "600 14px sans-serif",
    handler: (metrics: TextMetrics) -> CanvasTestMsg =>
      CanvasTestMsg::Measured { metrics }
  )
  assert_payload_has_field(measure_typed.payload, "handlerId")
  assert_array_payload_len(measure_typed.payload, "__vxOwnedMapHandlerIds", 1)

fn assert_string_field(map: Dict<String, MsgPack>, field: String, expected: String) -> void
  match(map.get(field))
    Some<MsgPack> { value }:
      match(msgpack::unpack_string(value))
        Ok<String> { value: actual }:
          assert(actual.equals(expected), eq: true)
        Err:
          assert(false, eq: true)
    None:
      assert(false, eq: true)

fn assert_bool_field(map: Dict<String, MsgPack>, field: String, expected: bool) -> void
  match(map.get(field))
    Some<MsgPack> { value }:
      match(msgpack::unpack_bool(value))
        Ok<bool> { value: actual }:
          assert(actual, eq: expected)
        Err:
          assert(false, eq: true)
    None:
      assert(false, eq: true)

fn assert_i32_field(map: Dict<String, MsgPack>, field: String, expected: i32) -> void
  match(map.get(field))
    Some<MsgPack> { value }:
      match(msgpack::unpack_i32(value))
        Ok<i32> { value: actual }:
          assert(actual, eq: expected)
        Err:
          assert(false, eq: true)
    None:
      assert(false, eq: true)

fn assert_f64_field(map: Dict<String, MsgPack>, field: String, expected: f64) -> void
  match(map.get(field))
    Some<MsgPack> { value }:
      match(msgpack::unpack_f64(value))
        Ok<f64> { value: actual }:
          assert(actual, eq: expected)
        Err:
          assert(false, eq: true)
    None:
      assert(false, eq: true)

fn assert_string_payload_field(payload: MsgPack, field: String, expected: String) -> void
  match(msgpack::unpack_map(payload))
    Ok<Dict<String, MsgPack>> { value }:
      assert_string_field(value, field, expected)
    Err:
      assert(false, eq: true)

fn assert_f64_payload_field(payload: MsgPack, field: String, expected: f64) -> void
  match(msgpack::unpack_map(payload))
    Ok<Dict<String, MsgPack>> { value }:
      assert_f64_field(value, field, expected)
    Err:
      assert(false, eq: true)

fn assert_array_payload_len(payload: MsgPack, field: String, expected: i32) -> void
  match(msgpack::unpack_map(payload))
    Ok<Dict<String, MsgPack>> { value }:
      match(value.get(field))
        Some<MsgPack> { value: children }:
          match(msgpack::unpack_array(children))
            Ok<Array<MsgPack>> { value: list }:
              assert(list.len(), eq: expected)
            Err:
              assert(false, eq: true)
        None:
          assert(false, eq: true)
    Err:
      assert(false, eq: true)

fn assert_payload_has_field(payload: MsgPack, field: String) -> void
  match(msgpack::unpack_map(payload))
    Ok<Dict<String, MsgPack>> { value }:
      match(value.get(field))
        Some<MsgPack>:
          assert(true, eq: true)
        None:
          assert(false, eq: true)
    Err:
      assert(false, eq: true)
