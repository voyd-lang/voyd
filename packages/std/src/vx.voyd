pub fn on_drag_with<Msg>({ options: EventOptions, message: Msg }): () -> Attr<Msg>
  event_message<Msg>(name: "drag", message: message, options: options)

pub fn on_drag_end_message<Msg>(message: Msg): () -> Attr<Msg>
  event_message<Msg>(name: "dragend", message: message)

pub fn on_drag_end_with<Msg>({ options: EventOptions, message: Msg }): () -> Attr<Msg>
  event_message<Msg>(name: "dragend", message: message, options: options)

pub fn on_drop_message<Msg>(message: Msg): () -> Attr<Msg>
  event_message<Msg>(name: "drop", message: message)

pub fn on_drop_with<Msg>({ options: EventOptions, message: Msg }): () -> Attr<Msg>
  event_message<Msg>(name: "drop", message: message, options: options)

pub fn on_context_menu_message<Msg>(message: Msg): () -> Attr<Msg>
  event_message<Msg>(name: "contextmenu", message: message)

pub fn on_context_menu_with<Msg>({ options: EventOptions, message: Msg }): () -> Attr<Msg>
  event_message<Msg>(name: "contextmenu", message: message, options: options)

pub fn program<Model, Msg>({
  model: Model,
  frame?: Html<Msg>,
  commands?: Cmd<Msg>,
  subscriptions?: Sub<Msg>
}) -> Program<Model, Msg>
  program_plan<Model, Msg>(() -> ProgramWire =>
    let lowered_frame: Optional<HtmlWire> = match(frame)
      Some<Html<Msg>> { value }:
        Some<HtmlWire> { value: lower_html_node(value) }
      None:
        None {}
    let lowered_commands: Optional<CommandWire> = match(commands)
      Some<Cmd<Msg>> { value }:
        Some<CommandWire> { value: lower_command(value) }
      None:
        None {}
    let lowered_subscriptions: Optional<SubscriptionWire> = match(subscriptions)
      Some<Sub<Msg>> { value }:
        Some<SubscriptionWire> { value: lower_sub(value) }
      None:
        None {}
    ProgramWire::ProgramResult {
      model: encode_payload(model),
      frame: lowered_frame,
      commands: lowered_commands,
      subscriptions: lowered_subscriptions
    }
  )

/// Creates the next program transition from an explicit model.
pub fn next<Model, Msg>(model: Model) -> Program<Model, Msg>
  program<Model, Msg>(model: model)

/// Creates the next program transition with one command.
pub fn next<Model, Msg>({ model: Model, cmd: Cmd<Msg> }) -> Program<Model, Msg>
  program<Model, Msg>(model: model, commands: cmd)

fn map_model_with_handler_ids<Model, Msg, NextModel>({
  program: Program<Model, Msg>,
  handler_id: i32,
  hydrate_handler_id?: i32
}) -> Program<NextModel, Msg>
  program_plan<NextModel, Msg>(() -> ProgramWire =>
    ProgramWire::ProgramMapModel {
      child: lower_program(program),
      handler_ref: handler_id,
      hydrate_handler_ref: hydrate_handler_id
    }
  )

/// Lifts a child program result through a typed model mapper.
pub fn map_model<Model, Msg, NextModel>(
  program: Program<Model, Msg>,
  handler: fn(Model) -> NextModel
) -> Program<NextModel, Msg>
  map_model_with_handler_ids(
    program: program,
    handler_id: retain_program_callback_id(handler)
  )

/// Lifts a child program through model mappers in both runtime directions.
/// The hydrate mapper is required when the mapped program adopts an SSR model.
pub fn map_model<Model, Msg, NextModel>({
  program: Program<Model, Msg>,
  map: fn(Model) -> NextModel,
  hydrate: fn(NextModel) -> Model
}) -> Program<NextModel, Msg>
  map_model_with_handler_ids(
    program: program,
    handler_id: retain_program_callback_id(map),
    hydrate_handler_id: retain_program_callback_id(hydrate)
  )

fn map_message_with_handler_id<Model, ChildMsg, ParentMsg>({
  program: Program<Model, ChildMsg>,
  handler_id: i32
}) -> Program<Model, ParentMsg>
  program_plan<Model, ParentMsg>(() -> ProgramWire =>
    ProgramWire::ProgramMapMessage {
      child: lower_program(program),
      handler_ref: handler_id
    }
  )

/// Lifts a child program result through a typed message mapper.
pub fn map_message<Model, ChildMsg, ParentMsg>(
  program: Program<Model, ChildMsg>,
  handler: fn(ChildMsg) -> ParentMsg
) -> Program<Model, ParentMsg>
  map_message_with_handler_id(
    program: program,
    handler_id: retain_program_callback_id(handler)
  )

pub fn program<Model, Msg>({
  init: fn() : (open) -> Model,
  hydrate: fn(Model) : (open) -> Program<Model, Msg> = ((model: Model) : (open) -> Program<Model, Msg>) => next(model),
  step: fn(Model, Msg) : (open) -> Program<Model, Msg>,
  view: fn(Model) : (open) -> Html<Msg>,
  subscriptions: fn(Model) : (open) -> Sub<Msg> = ((_model: Model) : (open) -> Sub<Msg>) => Sub<Msg>::none()
}) -> Program<Model, Msg>
  program_handlers<Model, Msg>(
    init_id: retain_program_callback_id(init),
    hydrate_id: retain_program_callback_id(hydrate),
    step_id: retain_program_callback_id(step),
    view_id: retain_program_callback_id(view),
    subscriptions_id: retain_program_callback_id(subscriptions)
  )

pub fn program<Model, Msg>({
  init: fn() : (open) -> Program<Model, Msg>,
  hydrate: fn(Model) : (open) -> Program<Model, Msg> = ((model: Model) : (open) -> Program<Model, Msg>) => next(model),
  step: fn(Model, Msg) : (open) -> Program<Model, Msg>,
  view: fn(Model) : (open) -> Html<Msg>,
  subscriptions: fn(Model) : (open) -> Sub<Msg> = ((_model: Model) : (open) -> Sub<Msg>) => Sub<Msg>::none()
}) -> Program<Model, Msg>
  program_handlers<Model, Msg>(
    init_id: retain_program_callback_id(init),
    hydrate_id: retain_program_callback_id(hydrate),
    step_id: retain_program_callback_id(step),
    view_id: retain_program_callback_id(view),
    subscriptions_id: retain_program_callback_id(subscriptions)
  )

fn program_handlers<Model, Msg>({
  init_id: i32,
  hydrate_id: i32,
  step_id: i32,
  view_id: i32,
  subscriptions_id?: i32
}) -> Program<Model, Msg>
  program_plan<Model, Msg>(() -> ProgramWire =>
    ProgramWire::ProgramHandlers {
      init_handler_ref: init_id,
      hydrate_handler_ref: hydrate_id,
      step_handler_ref: step_id,
      view_handler_ref: view_id,
      subscriptions_handler_ref: subscriptions_id
    }
  )

fn named_value(kind: String, name: String, value: AttrValueWire): () -> AttrWire
  attr_wire(AttrWireNode::NamedAttr { kind, name, value })

fn join_classes(values: Array<String>): () -> String
  var out = String::init()
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<String> { value }:
        if out.byte_len() == 0:
          out = value
        else:
          out = out.concat(" ").concat(value)
      None:
        void
    index = index + 1
  out

fn event_options_to_wire(options: EventOptions): () -> EventOptionsWire
  EventOptionsWire {
    prevent_default: options.prevent_default,
    stop_propagation: options.stop_propagation,
    capture: options.capture,
    passive: options.passive,
    pointer_capture: options.pointer_capture
  }

fn mark_owned_subscription<Msg>(sub: Sub<Msg>, handler_id: i32) -> Sub<Msg>
  subscription_plan(() -> SubscriptionWire =>
    SubscriptionWire::SubscriptionOwned {
      child: lower_sub(sub),
      handler_ref: handler_id
    }
  )

fn sub_map_with_handler_id<ChildMsg, ParentMsg>(
  sub: Sub<ChildMsg>,
  { handler_id: i32, handler_key?: i32 }
) -> Sub<ParentMsg>
  subscription_plan(() -> SubscriptionWire =>
    SubscriptionWire::SubscriptionMap {
      child: lower_sub(sub),
      handler_ref: handler_id,
      handler_key: handler_key
    }
  )

fn keyboard_subscription<Msg>({ kind: String, key: String, value: PayloadLower }) -> Sub<Msg>
  subscription_plan(() -> SubscriptionWire =>
    SubscriptionWire::SubscriptionRuntime {
      kind: "keyboard",
      key,
      event: kind,
      payload: value()
    }
  )

