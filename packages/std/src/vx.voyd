/// Opaque virtual DOM node plan. The message parameter records the event
/// message type while the renderer wire stays private to VX.
pub obj HtmlNode {
  payload: MsgPack
}

pub type Html<Msg> = HtmlNode

/// Opaque virtual DOM attribute or event plan.
pub obj HtmlAttr {
  payload: MsgPack
}

pub type Attr<Msg> = HtmlAttr
pub type RenderKey = String

pub obj ProgramPlan {
  payload: MsgPack
}

pub type Program<Model, Msg> = ProgramPlan

pub obj SubPlan {
  payload: MsgPack
}

pub type Sub<Msg> = SubPlan

impl CustomDto<ProgramPlan, Bytes> for ProgramPlan
  fn write(value: ProgramPlan) -> Bytes
    encode_vx_wire(value.payload)

  fn read(value: Bytes) -> Result<ProgramPlan, CustomDtoError>
    Ok<ProgramPlan> {
      value: ProgramPlan { payload: decode_vx_wire(value) }
    }

impl CustomDto<SubPlan, Bytes> for SubPlan
  fn write(value: SubPlan) -> Bytes
    encode_vx_wire(value.payload)

  fn read(value: Bytes) -> Result<SubPlan, CustomDtoError>
    Ok<SubPlan> {
      value: SubPlan { payload: decode_vx_wire(value) }
    }

impl<Msg> CustomDto<Cmd<Msg>, Bytes> for Cmd<Msg>
  fn write(value: Cmd<Msg>) -> Bytes
    encode_vx_wire(value.payload)

  fn read(value: Bytes) -> Result<Cmd<Msg>, CustomDtoError>
    Ok<Cmd<Msg>> {
      value: Cmd<Msg> { payload: decode_vx_wire(value) }
    }

impl CustomDto<HtmlNode, Bytes> for HtmlNode
  fn write(value: HtmlNode) -> Bytes
    encode_vx_wire(value.payload)

  fn read(value: Bytes) -> Result<HtmlNode, CustomDtoError>
    Ok<HtmlNode> { value: HtmlNode { payload: decode_vx_wire(value) } }

impl CustomDto<HtmlAttr, Bytes> for HtmlAttr
  fn write(value: HtmlAttr) -> Bytes
    encode_vx_wire(value.payload)

  fn read(value: Bytes) -> Result<HtmlAttr, CustomDtoError>
    Ok<HtmlAttr> { value: HtmlAttr { payload: decode_vx_wire(value) } }

fn encode_vx_wire(value: MsgPack) -> Bytes
  match(msgpack::encode_value_bytes(value))
    Ok<Bytes> { value }:
      value
    Err:
      ByteBuffer::init().as_bytes()

fn decode_vx_wire(value: Bytes) -> MsgPack
  match(msgpack::decode_value_bytes(value))
    Ok<MsgPack> { value }:
      value
    Err:
      msgpack::make_null()

/// Lowers an opaque HTML plan to the immutable VX renderer wire.
pub fn lower_html(value: HtmlNode) -> Bytes
  encode_vx_wire(value.payload)

fn html_node_payloads(values: Array<HtmlNode>) -> Array<MsgPack>
  let ~out = Array<MsgPack>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    out.push(values.at(index).payload)
    index = index + 1
  out

fn html_attr_payloads(values: Array<HtmlAttr>) -> Array<MsgPack>
  let ~out = Array<MsgPack>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    out.push(values.at(index).payload)
    index = index + 1
  out

