pub fn styles(values: Array<(String, String)>): () -> Array<HtmlAttr>
  let ~out = Array<HtmlAttr>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<(String, String)> { value }:
        out.push(style(name: value.0, value: value.1))
      None:
        void
    index = index + 1
  out

pub fn keyed({ key: String, child: HtmlNode }): () -> HtmlNode
  match(msgpack::unpack_map(child.payload))
    Ok<Dict<String, MsgPack>> { value }:
      HtmlNode { payload: msgpack::make_map(value.setting("key", key)) }
    Err:
      child

pub fn keyed({ key: StringSlice, child: HtmlNode }): () -> HtmlNode
  keyed(key: key.to_string(), child: child)

pub fn keyed({ key: String, body: fn() -> HtmlNode }): Component -> HtmlNode
  Component::state_scope(encode_vx_payload(key))
  keyed(key: key, child: body())

pub fn keyed({ key: StringSlice, body: fn() -> HtmlNode }): Component -> HtmlNode
