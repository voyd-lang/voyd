/// Reads a component-local typed state handle.
pub fn state_handle<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<T>
  state_handle_at(id: id, initial: initial)

fn state_handle_at<T>({ id: i32, initial: T }): Component -> StateHandle<T>
  let slot = Component::state_key(id)
  StateHandle<T> {
    id: slot,
    value: decode_vx_value<T>(
      Component::state_get(slot, encode_vx_value(initial)),
      initial
    )
  }

pub fn state_handle({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<String>
  state_handle_at<String>(id: id, initial: initial.to_string())

/// Reads component-local typed state as a `(value, setter)` pair.
pub fn state<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> (T, fn(T) -> void)
  let handle = state_handle_at(id: id, initial: initial)
  (handle.value, (value: T) -> void => handle.set(value))

pub fn state({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> (String, fn(String) -> void)
  let handle = state_handle_at(id: id, initial: initial.to_string())
  (handle.value, (value: String) -> void => handle.set(value))

/// Registers a task with the current component instance.
pub fn task<Key, T>({ key: Key, task: Task<T> }): Component -> Unit
  Component::task_started(encode_vx_value(key), task.id)
  Unit {}

/// Associates closure-backed handlers in a prebuilt view with the active server render.
pub fn claim_server_render_callbacks<Msg>(value: Html<Msg>): () -> void
  claim_server_render_callbacks_in(lower_html_node(value))

fn claim_server_render_callbacks_in(value: DataValue): () -> void
  match(wire::unpack_array(value))
    Ok<Array<DataValue>> { value }:
      claim_server_render_callback_array(value)
      return void
    Err:
      void

  match(wire::unpack_map(value))
    Ok<WireMap> { value }:
      claim_server_render_callback_map(value)
    Err:
      void

fn claim_server_render_callback_array(values: Array<DataValue>): () -> void
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<DataValue> { value }:
        claim_server_render_callbacks_in(value)
      None:
        void
    index = index + 1

fn claim_server_render_callback_map(value: WireMap): () -> void
  match(value.get("kind"))
    Some<DataValue> { value: kind_value }:
      match(wire::unpack_string(kind_value))
        Ok<String> { value: kind }:
          if kind == "event":
            claim_server_render_callback_id(value)
            return void
          if kind == "map":
            claim_server_render_callback_id(value)
            claim_server_render_callback_field(value, "child")
            return void
          if kind == "element":
            claim_server_render_callback_field(value, "events")
            claim_server_render_callback_field(value, "children")
            return void
          if kind == "fragment":
            claim_server_render_callback_field(value, "children")
            return void
        Err:
          void
    None:
      void

  claim_server_render_callback_field(value, "root")

fn claim_server_render_callback_id(value: WireMap): () -> void
  match(value.get("handlerId"))
    Some<DataValue> { value }:
      match(wire::unpack_i32(value))
        Ok<i32> { value: handler_id }:
          claim_render_callback_id(handler_id)
        Err:
          void
    None:
      void

fn claim_server_render_callback_field(value: WireMap, name: String): () -> void
  match(value.get(name))
    Some<DataValue> { value }:
      claim_server_render_callbacks_in(value)
    None:
      void

/// Creates a versioned VX render frame.
pub fn frame<Msg>(root: Html<Msg>): () -> Html<Msg>
  html_plan<Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("version", wire::make_i32(1))
    out.set("root", lower_html_node(root))
    wire::make_map(out)
  )

/// Creates a VX text node.
pub fn text(value: String): () -> Html<void>
  html_plan<void>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "text")
    out.set("value", value)
    wire::make_map(out)
  )

/// Creates a VX text node from a string slice.
pub fn text(value: StringSlice): () -> Html<void>
  text(value.to_string())

/// Converts a nested node into the opaque child plan expected by VSX lowering.
pub fn html_child(value: Html<void>): () -> Html<void>
  value

pub fn html_child<Msg>(value: Html<Msg>): () -> Html<Msg>
  value

pub fn html_child<Msg>(value: HtmlInput<Msg>): () -> Html<Msg>
  Html<Msg> { plan: value.plan }

/// Converts interpolated text into an opaque child plan.
pub fn html_child(value: String): () -> Html<void>
  text(value)

pub fn html_child(value: StringSlice): () -> Html<void>
  text(value)

/// Flattens an interpolated child list into one fragment plan.
pub fn html_child(value: Array<Html<void>>): () -> Html<void>
  fragment(value)

pub fn html_child<Msg>(value: Array<HtmlInput<Msg>>): () -> Html<Msg>
  fragment<Msg>(value)

pub fn html_child<Msg>(value: Array<Html<Msg>>): () -> Html<Msg>
  html_plan<Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "fragment")
    out.set("children", typed_html_node_payloads<Msg>(value))
    wire::make_map(out)
  )

/// Creates a VX fragment node.
pub fn fragment(children: Array<Html<void>>): () -> Html<void>
  html_plan<void>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "fragment")
    out.set("children", typed_html_node_payloads<void>(children))
    wire::make_map(out)
