pub fn styles(values: Array<(String, String)>): () -> Array<Attr<void>>
  let ~out = Array<Attr<void>>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<(String, String)> { value }:
        out.push(style(name: value.0, value: value.1))
      None:
        void
    index = index + 1
  out

pub fn keyed({ key: String, child: Html<void> }): () -> Html<void>
  html_plan<void>(() -> DataValue =>
    match(wire::unpack_map(lower_html_node(child)))
      Ok<WireMap> { value }:
        wire::make_map(value.setting("key", key))
      Err:
        lower_html_node(child)
  )

pub fn keyed({ key: StringSlice, child: Html<void> }): () -> Html<void>
  keyed(key: key.to_string(), child: child)

pub fn keyed<Msg>({ key: String, child: Html<Msg> }): () -> Html<Msg>
  html_plan<Msg>(() -> DataValue =>
    match(wire::unpack_map(lower_html_node(child)))
      Ok<WireMap> { value }:
        wire::make_map(value.setting("key", key))
      Err:
        lower_html_node(child)
  )

pub fn keyed<Msg>({ key: StringSlice, child: Html<Msg> }): () -> Html<Msg>
  keyed<Msg>(key: key.to_string(), child: child)

pub fn keyed({ key: String, body: fn() -> Html<void> }): Component -> Html<void>
  Component::state_scope(encode_vx_value(key))
  keyed(key: key, child: body())

pub fn keyed({ key: StringSlice, body: fn() -> Html<void> }): Component -> Html<void>
  keyed(key: key.to_string(), body: body)

/// Lifts child HTML through a message mapper owned by the current render.
pub fn map_html<ChildMsg, ParentMsg>({ html: Html<ChildMsg>, handler: fn(ChildMsg) -> ParentMsg }) -> Html<ParentMsg>
  map_html_with_handler_id<ChildMsg, ParentMsg>(
    html: html,
    handler_id: retain_typed_html_message_mapper_id(handler)
  )

fn map_html_with_handler_id<ChildMsg, ParentMsg>({ html: Html<ChildMsg>, handler_id: i32 }) -> Html<ParentMsg>
  html_plan<ParentMsg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "map")
    out.set("child", lower_html_node(html))
    out.set("handlerId", wire::make_i32(handler_id))
    wire::make_map(out)
  )

fn event_with_handler_id<Msg>({ name: String, handler_id: i32, options?: EventOptions }): () -> Attr<Msg>
  attr_plan<Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "event")
    out.set("event", name)
    out.set("handlerId", wire::make_i32(handler_id))
    if options is Some:
      out.set("options", wire::make_map(event_options_to_map(options.value)))
    wire::make_map(out)
  )

pub fn event_handler<Msg>({ name: String, handler: fn() -> Msg, options?: EventOptions }): () -> Attr<Msg>
  event_with_handler_id<Msg>(name: name, handler_id: retain_typed_event_handler_id(handler), options: options)

pub fn event_handler<Msg>({ name: StringSlice, handler: fn() -> Msg, options?: EventOptions }): () -> Attr<Msg>
  event_handler<Msg>(name: name.to_string(), handler: handler, options: options)

pub fn event_payload_handler<Event, Msg>({ name: String, handler: fn(Event) -> Msg, options?: EventOptions }): () -> Attr<Msg>
  event_with_handler_id<Msg>(name: name, handler_id: retain_typed_event_handler_with_payload_id(handler), options: options)

pub fn event_payload_handler<Event, Msg>({ name: StringSlice, handler: fn(Event) -> Msg, options?: EventOptions }): () -> Attr<Msg>
