/// Reads a component-local typed state handle.
pub fn state_handle<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<T>
  state_handle_at(id: id, initial: initial)

fn state_handle_at<T>({ id: i32, initial: T }): Component -> StateHandle<T>
  let slot = Component::state_key(id)
  StateHandle<T> {
    id: slot,
    value: decode_vx_payload<T>(
      Component::state_get(slot, encode_vx_payload(initial)),
      initial
    )
  }

pub fn state_handle({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<String>
  state_handle_at<String>(id: id, initial: initial.to_string())

/// Reads component-local typed state as a `(value, setter)` pair.
pub fn state<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> (T, fn(T) -> void)
  let handle = state_handle_at(id: id, initial: initial)
  (handle.value, (value: T) -> void => handle.set(value))

pub fn state({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> (String, fn(String) -> void)
  let handle = state_handle_at(id: id, initial: initial.to_string())
  (handle.value, (value: String) -> void => handle.set(value))

/// Registers a task with the current component instance.
pub fn task<Key, T>({ key: Key, task: Task<T> }): Component -> Unit
  Component::task_started(encode_vx_payload(key), task.id)
  Unit {}

/// Associates closure-backed handlers in a prebuilt view with the active server render.
pub fn claim_server_render_callbacks(value: HtmlNode): () -> void
  claim_server_render_callbacks_in(value.payload)

fn claim_server_render_callbacks_in(value: MsgPack): () -> void
  match(msgpack::unpack_array(value))
    Ok<Array<MsgPack>> { value }:
      claim_server_render_callback_array(value)
      return void
    Err:
      void

  match(msgpack::unpack_map(value))
    Ok<Dict<String, MsgPack>> { value }:
      claim_server_render_callback_map(value)
    Err:
      void

fn claim_server_render_callback_array(values: Array<MsgPack>): () -> void
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<MsgPack> { value }:
        claim_server_render_callbacks_in(value)
      None:
        void
    index = index + 1

fn claim_server_render_callback_map(value: Dict<String, MsgPack>): () -> void
  match(value.get("kind"))
    Some<MsgPack> { value: kind_value }:
      match(msgpack::unpack_string(kind_value))
        Ok<String> { value: kind }:
          if kind == "event":
            claim_server_render_callback_id(value)
            return void
          if kind == "map":
            claim_server_render_callback_id(value)
            claim_server_render_callback_field(value, "child")
            return void
          if kind == "element":
            claim_server_render_callback_field(value, "events")
            claim_server_render_callback_field(value, "children")
            return void
          if kind == "fragment":
            claim_server_render_callback_field(value, "children")
            return void
        Err:
          void
    None:
      void

  claim_server_render_callback_field(value, "root")

fn claim_server_render_callback_id(value: Dict<String, MsgPack>): () -> void
  match(value.get("handlerId"))
    Some<MsgPack> { value }:
      match(msgpack::unpack_i32(value))
        Ok<i32> { value: handler_id }:
          claim_render_callback_id(handler_id)
        Err:
          void
    None:
      void

fn claim_server_render_callback_field(value: Dict<String, MsgPack>, name: String): () -> void
  match(value.get(name))
    Some<MsgPack> { value }:
      claim_server_render_callbacks_in(value)
    None:
      void

/// Creates a versioned VX render frame.
pub fn frame(root: HtmlNode): () -> HtmlNode
  let ~out = Dict<String, MsgPack>::init()
  out.set("version", msgpack::make_i32(1))
  out.set("root", root.payload)
  HtmlNode { payload: msgpack::make_map(out) }

/// Creates a VX text node.
pub fn text(value: String): () -> HtmlNode
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "text")
  out.set("value", value)
  HtmlNode { payload: msgpack::make_map(out) }

/// Creates a VX text node from a string slice.
pub fn text(value: StringSlice): () -> HtmlNode
  text(value.to_string())

/// Converts a nested node into the opaque child plan expected by VSX lowering.
pub fn html_child(value: HtmlNode): () -> HtmlNode
  value

/// Converts interpolated text into an opaque child plan.
pub fn html_child(value: String): () -> HtmlNode
  text(value)

pub fn html_child(value: StringSlice): () -> HtmlNode
  text(value)

/// Flattens an interpolated child list into one fragment plan.
pub fn html_child(value: Array<HtmlNode>): () -> HtmlNode
  fragment(value)

/// Creates a VX fragment node.
pub fn fragment(children: Array<HtmlNode>): () -> HtmlNode
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "fragment")
  out.set("children", html_node_payloads(children))
  HtmlNode { payload: msgpack::make_map(out) }

/// Creates a VX element node using the versioned renderer schema.
pub fn element({
  tag: String,
  attrs?: Array<HtmlAttr>,
  children: Array<HtmlNode>
}) -> HtmlNode
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "element")
  out.set("tag", tag)
  out.set("children", html_node_payloads(children))
  if attrs is Some:
    let normalized = normalize_attrs(html_attr_payloads(attrs.value))
    if normalized.attrs.len() > 0:
      out.set("attrs", msgpack::make_map(normalized.attrs))
    if normalized.props.len() > 0:
      out.set("props", msgpack::make_map(normalized.props))
    if normalized.styles.len() > 0:
      out.set("styles", msgpack::make_map(normalized.styles))
    if normalized.events.len() > 0:
      out.set("events", normalized.events)
  HtmlNode { payload: msgpack::make_map(out) }

pub fn html_element({
  tag: String,
  attrs?: Array<HtmlAttr>,
  children: Array<HtmlNode>
}) -> HtmlNode
  element(tag: tag, attrs: attrs, children: children)

