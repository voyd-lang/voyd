@boundary(type: "payload", field: "payload")
pub obj CanvasRadialGradient {
  api payload: MsgPack,
  pri cached_wire_record?: CanvasRadialGradientWireRecord
}

impl CanvasPathSegment
  fn from_wire_record(record: CanvasPathSegmentWireRecord) -> CanvasPathSegment
    CanvasPathSegment {
      payload: msgpack::pack_boundary_value(record),
      cached_wire_record: record
    }

  fn to_wire_record(self) -> CanvasPathSegmentWireRecord
    match(self.cached_wire_record)
      Some<CanvasPathSegmentWireRecord> { value }:
        value
      None:
        msgpack::unpack_boundary_value<CanvasPathSegmentWireRecord>(self.payload)

impl CanvasDraw
  fn from_wire_record(record: CanvasDrawWireRecord) -> CanvasDraw
    CanvasDraw {
      payload: msgpack::pack_boundary_value(record),
      cached_wire_record: record
    }

  fn to_wire_record(self) -> CanvasDrawWireRecord
    match(self.cached_wire_record)
      Some<CanvasDrawWireRecord> { value }:
        value
      None:
        msgpack::unpack_boundary_value<CanvasDrawWireRecord>(self.payload)

impl CanvasRadialGradient
  fn from_wire_record(record: CanvasRadialGradientWireRecord) -> CanvasRadialGradient
    CanvasRadialGradient {
      payload: msgpack::pack_boundary_value(record),
      cached_wire_record: record
    }

  fn to_wire_record(self) -> CanvasRadialGradientWireRecord
    match(self.cached_wire_record)
      Some<CanvasRadialGradientWireRecord> { value }:
        value
      None:
        msgpack::unpack_boundary_value<CanvasRadialGradientWireRecord>(self.payload)

