/// Adds a cubic Bézier segment.
pub fn canvas_path_bezier_curve_to({
  control_1: CanvasPoint,
  control_2: CanvasPoint,
  to: CanvasPoint
}) -> CanvasPathSegment
  canvas_path_segment({
    kind: "bezierCurveTo",
    control1: control_1,
    control2: control_2,
    to
  })

/// Adds a circular arc. Angles are expressed in radians.
pub fn canvas_path_arc({
  center: CanvasPoint,
  radius: f64,
  start_angle: f64,
  end_angle: f64,
  counter_clockwise: bool = false
}) -> CanvasPathSegment
  canvas_path_segment({
    kind: "arc",
    center,
    radius,
    startAngle: start_angle,
    endAngle: end_angle,
    counterClockwise: counter_clockwise
  })

/// Adds an arc tangent to two lines.
pub fn canvas_path_arc_to({
  control_1: CanvasPoint,
  control_2: CanvasPoint,
  radius: f64
}) -> CanvasPathSegment
  canvas_path_segment({
    kind: "arcTo",
    control1: control_1,
    control2: control_2,
    radius
  })

/// Adds an elliptical arc. Angles and rotation are expressed in radians.
pub fn canvas_path_ellipse({
  center: CanvasPoint,
  radius_x: f64,
  radius_y: f64,
  rotation: f64,
  start_angle: f64,
  end_angle: f64,
  counter_clockwise: bool = false
}) -> CanvasPathSegment
  canvas_path_segment({
    kind: "ellipse",
    center,
    radiusX: radius_x,
    radiusY: radius_y,
    rotation,
    startAngle: start_angle,
    endAngle: end_angle,
    counterClockwise: counter_clockwise
  })

/// Adds a rectangular subpath.
pub fn canvas_path_rect({
  origin: CanvasPoint,
  width: f64,
  height: f64
}) -> CanvasPathSegment
  canvas_path_segment({ kind: "rect", origin, width, height })

/// Closes the current path subpath.
pub fn canvas_path_close() -> CanvasPathSegment
  canvas_path_segment({ kind: "closePath" })

/// Paints a typed path from its segments.
pub fn canvas_path({
  segments: Array<CanvasPathSegment>,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  fill_rule: CanvasFillRule = CanvasFillRule::NonZero {},
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0
}) -> CanvasDraw
  canvas_draw({
    kind: "path",
    segments: canvas_path_segment_wire_records(segments),
    fill,
    stroke,
    strokeWidth: stroke_width,
    fillRule: canvas_fill_rule_name(fill_rule),
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur
  })

/// Saves the current transform, dash, compositing, and paint state.
pub fn canvas_save() -> CanvasDraw
  canvas_draw({ kind: "save" })

/// Restores the most recently saved Canvas state.
pub fn canvas_restore() -> CanvasDraw
  canvas_draw({ kind: "restore" })

/// Multiplies the current Canvas transform by an affine matrix.
pub fn canvas_transform(matrix: CanvasTransform) -> CanvasDraw
  canvas_draw({
    kind: "transform",
    a: matrix.a,
    b: matrix.b,
    c: matrix.c,
    d: matrix.d,
    e: matrix.e,
    f: matrix.f
  })

/// Translates subsequent draws in logical CSS pixels.
pub fn canvas_translate({ x: f64, y: f64 }) -> CanvasDraw
  canvas_draw({ kind: "translate", x, y })

/// Rotates subsequent draws by radians.
pub fn canvas_rotate(radians: f64) -> CanvasDraw
  canvas_draw({ kind: "rotate", radians })

/// Scales subsequent draws along each axis.
pub fn canvas_scale({ x: f64, y: f64 }) -> CanvasDraw
  canvas_draw({ kind: "scale", x, y })

/// Sets the line-dash pattern for subsequent draws. An empty pattern resets it.
pub fn canvas_line_dash({ pattern: Array<f64>, offset: f64 = 0.0 }) -> CanvasDraw
  canvas_draw({ kind: "lineDash", pattern, offset })

/// Sets the compositing operation for subsequent draws.
pub fn canvas_composite(operation: CanvasCompositeOperation) -> CanvasDraw
  canvas_draw({
    kind: "composite",
    operation: canvas_composite_operation_name(operation)
  })

/// Creates a versioned canvas frame in CSS-pixel logical coordinates.
pub fn canvas_frame({
  selector: String,
  width: f64,
  height: f64,
  draws: Array<CanvasDraw>,
  clear: bool = true,
  background?: String
}) -> CanvasFrame
  let value: CanvasFrameWireRecord = {
    version: 2,
    selector,
    width,
    height,
    clear,
    background,
    draws: canvas_draw_wire_records(draws)
  }
  CanvasFrame { payload: msgpack::pack_boundary_value(value) }

/// Creates a straight canvas line.
pub fn canvas_line({
  from: CanvasPoint,
  to: CanvasPoint,
  color: String,
  width: f64 = 1.0,
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0
}) -> CanvasDraw
  canvas_draw({
    kind: "line",
    from,
    to,
    color,
    width,
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur
  })

/// Creates a connected canvas path, optionally closed and filled.
pub fn canvas_polyline({
  points: Array<CanvasPoint>,
  color: String,
  width: f64 = 1.0,
  alpha: f64 = 1.0,
  closed: bool = false,
  fill?: String
}) -> CanvasDraw
  canvas_draw({ kind: "polyline", points, color, width, alpha, closed, fill })

/// Creates a canvas circle with optional stroke, glow, and radial fill.
pub fn canvas_circle({
  center: CanvasPoint,
  radius: f64,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  alpha: f64 = 1.0,
  glow_color?: String,
  glow_blur: f64 = 0.0,
  radial_gradient?: CanvasRadialGradient
}) -> CanvasDraw
  canvas_draw({
    kind: "circle",
    center,
    radius,
    fill,
    stroke,
    strokeWidth: stroke_width,
    alpha,
    glowColor: glow_color,
    glowBlur: glow_blur,
    radialGradient: canvas_radial_gradient_wire_record(radial_gradient)
  })

/// Creates a canvas ellipse. Rotation is expressed in radians.
pub fn canvas_ellipse({
  center: CanvasPoint,
  radius_x: f64,
  radius_y: f64,
  rotation: f64 = 0.0,
  fill?: String,
  stroke?: String,
  stroke_width: f64 = 1.0,
  alpha: f64 = 1.0
}) -> CanvasDraw
  canvas_draw({
    kind: "ellipse",
    center,
    radiusX: radius_x,
    radiusY: radius_y,
    rotation,
    fill,
    stroke,
    strokeWidth: stroke_width,
    alpha
  })

/// Creates canvas text using a CSS canvas font string.
pub fn canvas_text({
  position: CanvasPoint,
  value: String,
  color: String,
  font: String = "12px sans-serif",
  align: String = "left",
  baseline: String = "alphabetic",
  alpha: f64 = 1.0,
  max_width?: f64
}) -> CanvasDraw
  canvas_draw({
    kind: "text",
    position,
    value,
    color,
    font,
    align,
    baseline,
    alpha,
    maxWidth: max_width
  })

/// Creates a versioned VX render frame.
pub fn frame(root: MsgPack): () -> MsgPack
  let ~out = Dict<String, MsgPack>::init()
  out.set("version", msgpack::make_i32(1))
  out.set("root", root)
  msgpack::make_map(out)

/// Creates a VX text node.
pub fn text(value: String): () -> MsgPack
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "text")
  out.set("value", value)
  msgpack::make_map(out)

/// Creates a VX text node from a string slice.
pub fn text(value: StringSlice): () -> MsgPack
  text(value.to_string())

/// Creates a VX fragment node.
pub fn fragment(children: Array<MsgPack>): () -> MsgPack
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "fragment")
  out.set("children", children)
  msgpack::make_map(out)

/// Creates a VX element node using the versioned renderer schema.
pub fn element({
  tag: String,
  attrs?: Array<MsgPack>,
  children: Array<MsgPack>
}) -> MsgPack
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "element")
  out.set("tag", tag)
  out.set("children", children)
  if attrs is Some:
    let normalized = normalize_attrs(attrs.value)
    if normalized.attrs.len() > 0:
      out.set("attrs", msgpack::make_map(normalized.attrs))
    if normalized.props.len() > 0:
      out.set("props", msgpack::make_map(normalized.props))
    if normalized.styles.len() > 0:
      out.set("styles", msgpack::make_map(normalized.styles))
    if normalized.events.len() > 0:
      out.set("events", normalized.events)
  msgpack::make_map(out)

pub fn html_element({
  tag: String,
  attrs?: Array<HtmlAttr>,
  children: Array<HtmlNode>
}) -> HtmlNode
  element(tag: tag, attrs: attrs, children: children)

