  subscriptions?: Sub<Msg>
}) -> Program<Model, Msg>
  program_plan<Model, Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("$vx", "runtime_result")
    out.set("model", wire::from_data_value(data::encode(model)))
    if frame is Some:
      out.set("frame", lower_html_node(frame.value))
    if commands is Some:
      out.set(
        "commands",
        wire::from_data_value(data::encode(lower_command(commands.value)))
      )
    if subscriptions is Some:
      out.set("subscriptions", lower_sub(subscriptions.value))
    wire::make_map(out)
  )

/// Creates the next program transition from an explicit model.
pub fn next<Model, Msg>(model: Model) -> Program<Model, Msg>
  program<Model, Msg>(model: model)

/// Creates the next program transition with one command.
pub fn next<Model, Msg>({ model: Model, cmd: Cmd<Msg> }) -> Program<Model, Msg>
  program<Model, Msg>(model: model, commands: cmd)

fn map_model_with_handler_ids<Model, Msg, NextModel>({
  program: Program<Model, Msg>,
  handler_id: i32,
  hydrate_handler_id?: i32
}) -> Program<NextModel, Msg>
  program_plan<NextModel, Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "program_map_model")
    out.set("child", lower_program(program))
    out.set("handlerId", wire::make_i32(handler_id))
    if hydrate_handler_id is Some:
      out.set("hydrateHandlerId", wire::make_i32(hydrate_handler_id.value))
    wire::make_map(out)
  )

/// Lifts a child program result through a typed model mapper.
pub fn map_model<Model, Msg, NextModel>(
  program: Program<Model, Msg>,
  handler: fn(Model) -> NextModel
) -> Program<NextModel, Msg>
  map_model_with_handler_ids(
    program: program,
    handler_id: retain_program_callback_id(handler)
  )

/// Lifts a child program through model mappers in both runtime directions.
/// The hydrate mapper is required when the mapped program adopts an SSR model.
pub fn map_model<Model, Msg, NextModel>({
  program: Program<Model, Msg>,
  map: fn(Model) -> NextModel,
  hydrate: fn(NextModel) -> Model
}) -> Program<NextModel, Msg>
  map_model_with_handler_ids(
    program: program,
    handler_id: retain_program_callback_id(map),
    hydrate_handler_id: retain_program_callback_id(hydrate)
  )

fn map_message_with_handler_id<Model, ChildMsg, ParentMsg>({
  program: Program<Model, ChildMsg>,
  handler_id: i32
}) -> Program<Model, ParentMsg>
  program_plan<Model, ParentMsg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "program_map_message")
    out.set("child", lower_program(program))
    out.set("handlerId", wire::make_i32(handler_id))
    wire::make_map(out)
  )

/// Lifts a child program result through a typed message mapper.
pub fn map_message<Model, ChildMsg, ParentMsg>(
  program: Program<Model, ChildMsg>,
  handler: fn(ChildMsg) -> ParentMsg
) -> Program<Model, ParentMsg>
  map_message_with_handler_id(
    program: program,
    handler_id: retain_program_callback_id(handler)
  )

pub fn program<Model, Msg>({
  init: fn() : (open) -> Model,
  hydrate: fn(Model) : (open) -> Program<Model, Msg> = ((model: Model) : (open) -> Program<Model, Msg>) => next(model),
  step: fn(Model, Msg) : (open) -> Program<Model, Msg>,
  view: fn(Model) : (open) -> Html<Msg>,
  subscriptions: fn(Model) : (open) -> Sub<Msg> = ((_model: Model) : (open) -> Sub<Msg>) => Sub<Msg>::none()
}) -> Program<Model, Msg>
  program_handlers<Model, Msg>(
    init_id: retain_program_callback_id(init),
    hydrate_id: retain_program_callback_id(hydrate),
    step_id: retain_program_callback_id(step),
    view_id: retain_program_callback_id(view),
    subscriptions_id: retain_program_callback_id(subscriptions)
  )

pub fn program<Model, Msg>({
  init: fn() : (open) -> Program<Model, Msg>,
  hydrate: fn(Model) : (open) -> Program<Model, Msg> = ((model: Model) : (open) -> Program<Model, Msg>) => next(model),
  step: fn(Model, Msg) : (open) -> Program<Model, Msg>,
  view: fn(Model) : (open) -> Html<Msg>,
  subscriptions: fn(Model) : (open) -> Sub<Msg> = ((_model: Model) : (open) -> Sub<Msg>) => Sub<Msg>::none()
}) -> Program<Model, Msg>
  program_handlers<Model, Msg>(
    init_id: retain_program_callback_id(init),
    hydrate_id: retain_program_callback_id(hydrate),
    step_id: retain_program_callback_id(step),
    view_id: retain_program_callback_id(view),
    subscriptions_id: retain_program_callback_id(subscriptions)
  )

fn program_handlers<Model, Msg>({
  init_id: i32,
  hydrate_id: i32,
  step_id: i32,
  view_id: i32,
  subscriptions_id?: i32
}) -> Program<Model, Msg>
  program_plan<Model, Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "program")
    out.set("initHandlerId", wire::make_i32(init_id))
    out.set("hydrateHandlerId", wire::make_i32(hydrate_id))
    out.set("stepHandlerId", wire::make_i32(step_id))
    out.set("viewHandlerId", wire::make_i32(view_id))
    if subscriptions_id is Some:
      out.set("subscriptionsHandlerId", wire::make_i32(subscriptions_id.value))
    wire::make_map(out)
  )

obj NormalizedAttrs {
  attrs: WireMap,
  props: WireMap,
  styles: WireMap,
  events: Array<DataValue>
}

fn normalize_attrs(attributes: Array<DataValue>): () -> NormalizedAttrs
  let ~normalized = NormalizedAttrs {
    attrs: WireMap::init(),
    props: WireMap::init(),
    styles: WireMap::init(),
    events: Array<DataValue>::init()
  }
  var index = 0
  while index < attributes.len():
    match(attributes.get(index))
      Some<DataValue> { value }:
        match(wire::unpack_map(value))
          Ok<WireMap> { value: entry }:
            consume_attr_entry(entry, normalized)
          Err:
            void
      None:
        void
    index = index + 1
  normalized

fn consume_attr_entry(
  entry: WireMap,
  ~normalized: NormalizedAttrs
) -> void
  match(entry.get("kind"))
    Some<DataValue> { value }:
      match(wire::unpack_string(value))
        Ok<String> { value: kind }:
          if kind == "event":
            normalized.events.push(wire::make_map(entry))
          else:
            if kind == "style":
              consume_named_attr(entry, normalized.styles)
            else:
              if kind == "prop":
                consume_named_attr(entry, normalized.props)
              else:
                consume_named_attr(entry, normalized.attrs)
        Err:
          void
    None:
      void

fn consume_named_attr(entry: WireMap, ~attrs: WireMap) -> void
  match(entry.get("name"))
    Some<DataValue> { value }:
      match(wire::unpack_string(value))
        Ok<String> { value: name }:
          match(entry.get("value"))
            Some<DataValue> { value: attr_value }:
              attrs.set(name, attr_value)
            None:
              void
        Err:
          void
    None:
      void

fn named_value(kind: String, name: String, value: DataValue): () -> DataValue
  let ~out = WireMap::init()
  out.set("kind", kind)
  out.set("name", name)
  out.set("value", value)
  wire::make_map(out)

fn named_value(kind: String, name: String, value: String): () -> DataValue
  named_value(kind, name, wire::make_string(value))

fn join_classes(values: Array<String>): () -> String
  var out = String::init()
  var index = 0
  while index < values.len():
    match(values.get(index))
      Some<String> { value }:
        if out.byte_len() == 0:
          out = value
        else:
          out = out.concat(" ").concat(value)
      None:
        void
    index = index + 1
  out

fn event_options_to_map(options: EventOptions): () -> WireMap
  let ~out = WireMap::init()
  set_bool_option(out, "preventDefault", options.prevent_default)
  set_bool_option(out, "stopPropagation", options.stop_propagation)
  set_bool_option(out, "capture", options.capture)
  set_bool_option(out, "passive", options.passive)
  set_bool_option(out, "pointerCapture", options.pointer_capture)
  out

fn set_bool_option(~out: WireMap, name: String, value: Optional<bool>) -> void
  match(value)
    Some<bool> { value }:
      out.set(name, wire::make_bool(value))
    None:
      void

fn mark_owned_subscription<Msg>(sub: Sub<Msg>, handler_id: i32) -> Sub<Msg>
  subscription_plan(() -> DataValue =>
    match(wire::unpack_map(lower_sub(sub)))
      Ok<WireMap> { value }:
        wire::make_map(with_owned_handler(value, handler_id))
      Err:
        lower_sub(sub)
  )

fn sub_map_with_handler_id<ChildMsg, ParentMsg>(
  sub: Sub<ChildMsg>,
  { handler_id: i32, handler_key?: i32 }
) -> Sub<ParentMsg>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("map")
    out.set("child", lower_sub(sub))
    out.set("handlerId", wire::make_i32(handler_id))
    if handler_key is Some:
      out.set("handlerKey", wire::make_i32(handler_key.value))
    wire::make_map(out)
  )

fn with_owned_handler(
  out: WireMap,
  handler_id: i32
) -> WireMap
  let ~owned = Array<DataValue>::with_capacity(1)
  owned.push(wire::make_i32(handler_id))
  out.setting("__vxOwnedMapHandlerIds", wire::make_array(owned))

fn subscription_payload(kind: String): () -> DataValue
  wire::make_map(subscription_map(kind))

fn subscription_map(kind: String): () -> WireMap
  tagged_vx_runtime_map("sub", kind)

fn keyboard_subscription<Msg>({ kind: String, key: String, value: VxLower }) -> Sub<Msg>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("keyboard")
    out.set("key", key)
    out.set("event", kind)
    out.set("value", value())
    wire::make_map(out)
  )

fn keyboard_payload_subscription({ kind: String, key: String }) -> Sub<KeyboardEvent>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("keyboard")
    out.set("key", key)
    out.set("event", kind)
    wire::make_map(out)
  )

fn window_event_subscription<Msg>({
  kind: String,
  event: String,
  key: String,
  value: VxLower
}) -> Sub<Msg>
  subscription_plan(() -> DataValue =>
    let out = subscription_map(kind)
      .setting("key", key)
      .setting("event", event)
      .setting("value", value())
    wire::make_map(out)
  )

fn window_event_payload_subscription({
  kind: String,
  event: String,
  key: String
}) -> Sub<GenericEvent>
  subscription_plan(() -> DataValue =>
    let out = subscription_map(kind)
      .setting("key", key)
      .setting("event", event)
    wire::make_map(out)
  )

fn media_query_subscription<Msg>({ query: String, value: VxLower }) -> Sub<Msg>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("media_query")
    out.set("key", query)
    out.set("query", query)
    out.set("value", value())
    wire::make_map(out)
  )

fn media_query_payload_subscription(query: String) -> Sub<MediaQuery>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("media_query")
    out.set("key", query)
    out.set("query", query)
    wire::make_map(out)
  )

fn broadcast_channel_subscription<Msg>({ name: String, value: VxLower }) -> Sub<Msg>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("broadcast_channel")
    out.set("key", name)
    out.set("name", name)
    out.set("value", value())
    wire::make_map(out)
  )

fn broadcast_channel_payload_subscription<Payload>(name: String) -> Sub<Payload>
  subscription_plan(() -> DataValue =>
    let ~out = subscription_map("broadcast_channel")
    out.set("key", name)
    out.set("name", name)
