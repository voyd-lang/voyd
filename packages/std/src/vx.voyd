pub fn fragment<Msg>(children: Array<HtmlInput<Msg>>): () -> Html<Msg>
  html_plan<Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "fragment")
    out.set("children", html_node_payloads<Msg>(children))
    wire::make_map(out)
  )

fn element_plan<Msg>({
  tag: String,
  attrs: Array<DataValue>,
  children: Array<DataValue>
}) -> Html<Msg>
  html_plan<Msg>(() -> DataValue =>
    let ~out = WireMap::init()
    out.set("kind", "element")
    out.set("tag", tag)
    out.set("children", children)
    let normalized = normalize_attrs(attrs)
    if normalized.attrs.len() > 0:
      out.set("attrs", wire::make_map(normalized.attrs))
    if normalized.props.len() > 0:
      out.set("props", wire::make_map(normalized.props))
    if normalized.styles.len() > 0:
      out.set("styles", wire::make_map(normalized.styles))
    if normalized.events.len() > 0:
      out.set("events", normalized.events)
    wire::make_map(out)
  )

/// Creates a VX element node using the versioned renderer schema.
pub fn element({
  tag: String,
  attrs: Array<Attr<void>> = Array<Attr<void>>::init(),
  children: Array<Html<void>>
