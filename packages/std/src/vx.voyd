@effect(id: "voyd.std.vx.component")
pub eff Component
  state_scope(tail, key: EncodedPayload) -> void

  state_key(tail, id: i32) -> i32

  state_get(tail, id: i32, initial: EncodedPayload) -> EncodedPayload

  state_set(tail, id: i32, value: EncodedPayload) -> void

  task_started(tail, key: EncodedPayload, task_id: i32) -> void

@intrinsic(name: "__render_retain_callback", uses_signature: true)
fn retain_typed_event_handler_id<Msg>(handler: fn() -> Msg): () -> i32
  __render_retain_callback(handler)

@intrinsic(name: "__render_retain_callback", uses_signature: true)
fn retain_typed_event_handler_with_payload_id<Event, Msg>(handler: fn(Event) -> Msg): () -> i32
  __render_retain_callback(handler)

@intrinsic(name: "__render_retain_callback", uses_signature: true)
fn retain_typed_html_message_mapper_id<From, To>(handler: fn(From) -> To): () -> i32
  __render_retain_callback(handler)

@intrinsic(name: "__render_claim_callback", uses_signature: true)
fn claim_render_callback_id(handler_id: i32): () -> void
  void

@intrinsic(name: "__retain_callback", uses_signature: true)
fn retain_program_callback_id<Handler>(handler: Handler): () -> i32
  0

@intrinsic(name: "__stable_callsite_id")
fn stable_callsite_id(): () -> i32
  0

fn encode_vx_value<T>(value: T) -> EncodedPayload
  encode_payload(value)

fn decode_vx_value<T>(value: EncodedPayload, fallback: T) -> T
  decode_payload(value, fallback)

impl<T> StateHandle<T>
  /// Replaces component-local typed state and schedules the component runtime.
  api fn set(self, value: T): Component -> void
    Component::state_set(self.id, encode_vx_value(value))

  /// Replaces component-local typed state and returns the updated handle.
  api fn update(self, value: T): Component -> StateHandle<T>
    Component::state_set(self.id, encode_vx_value(value))
    StateHandle<T> { id: self.id, value: value }

impl<Msg> Sub<Msg>
  /// Lifts a child subscription through a retained typed message mapper.
  api fn map<NextMsg>(
    self,
    handler: fn(Msg) -> NextMsg,
    { handler_key: i32 = stable_callsite_id() }
  ) -> Sub<NextMsg>
    let handler_id = retain_typed_message_mapper(handler)
    mark_owned_subscription<NextMsg>(
      sub_map_with_handler_id<Msg, NextMsg>(self, handler_id: handler_id, handler_key: handler_key),
      handler_id
    )

impl<Msg> Sub<Msg>
  /// Creates an empty subscription set.
  api fn none() -> Sub<Msg>
    subscription_plan(() -> SubscriptionWire => SubscriptionWire::SubscriptionNone {})

  /// Creates a subscription batch from existing subscription values.
  api fn batch(values: Array<Sub<Msg>>) -> Sub<Msg>
    subscription_plan(() -> SubscriptionWire =>
      let ~children = Array<SubscriptionWire>::with_capacity(values.len())
      var index = 0
      while index < values.len():
        children.push(lower_sub(values.at(index)))
        index = index + 1
      SubscriptionWire::SubscriptionBatch { children }
    )

  /// Creates a host/runtime subscription envelope for a registered VX subscription runner.
  fn runtime({ kind: String, key: String, value?: PayloadLower }) -> Sub<Msg>
    subscription_plan(() -> SubscriptionWire =>
      match(value)
        Some<PayloadLower> { value: lower_value }:
          SubscriptionWire::SubscriptionRuntime {
            kind,
            key,
            payload: lower_value()
          }
        None:
          SubscriptionWire::SubscriptionRuntime { kind, key }
    )

  fn runtime({ kind: StringSlice, key: StringSlice, value?: PayloadLower }) -> Sub<Msg>
    Sub<Msg>::runtime(kind: kind.to_string(), key: key.to_string(), value: value)

  /// Creates a host/runtime subscription and maps incoming payloads through a typed handler.
  fn runtime_payload<Payload>({
    kind: String,
    key: String,
    handler: fn(Payload) -> Msg
  }) -> Sub<Msg>
    Sub<Payload>::runtime(kind: kind, key: key).map<Msg>(handler)

  fn runtime_payload<Payload>({
    kind: StringSlice,
    key: StringSlice,
    handler: fn(Payload) -> Msg
  }) -> Sub<Msg>
    Sub<Msg>::runtime_payload<Payload>(
      kind: kind.to_string(),
      key: key.to_string(),
      handler: handler
    )

  /// Creates an interval subscription that dispatches a typed message.
  api fn every({ key: String, millis: i64, value: Msg }) -> Sub<Msg>
    subscription_plan(() -> SubscriptionWire =>
      SubscriptionWire::SubscriptionRuntime {
        kind: "interval",
        key,
        millis,
        payload: encode_payload(value)
      }
    )

  api fn every({ key: StringSlice, millis: i64, value: Msg }) -> Sub<Msg>
    Sub<Msg>::every(key: key.to_string(), millis: millis, value: value)

/// Subscribes to global keydown events through the browser VX runtime host.
pub fn keyboard_on_key_down<Msg>({ key: String, value: Msg }) -> Sub<Msg>
  keyboard_subscription<Msg>(
    kind: "keydown",
    key: key,
    value: () -> EncodedPayload => encode_payload(value)
  )

pub fn keyboard_on_key_down<Msg>({ key: String, handler: fn(KeyboardEvent) -> Msg }) -> Sub<Msg>
  keyboard_payload_subscription(kind: "keydown", key: key).map<Msg>(handler)

pub fn keyboard_on_key_down<Msg>({ key: StringSlice, value: Msg }) -> Sub<Msg>
