/// A logical point in CSS-pixel canvas coordinates.
pub val CanvasPoint {
  api x: f64,
  api y: f64
}

/// A 2D affine transform using the browser Canvas matrix convention.
pub val CanvasTransform {
  api a: f64,
  api b: f64,
  api c: f64,
  api d: f64,
  api e: f64,
  api f: f64
}

type CanvasRadialGradientWireRecord = {
  innerColor: String,
  outerColor: String,
  innerRadius: f64,
  outerRadius?: f64
}

type CanvasPathSegmentWireRecord = {
  kind: String,
  point?: CanvasPoint,
  control?: CanvasPoint,
  to?: CanvasPoint,
  control1?: CanvasPoint,
  control2?: CanvasPoint,
  center?: CanvasPoint,
  origin?: CanvasPoint,
  radius?: f64,
  radiusX?: f64,
  radiusY?: f64,
  rotation?: f64,
  startAngle?: f64,
  endAngle?: f64,
  counterClockwise?: bool,
  width?: f64,
  height?: f64
}

type CanvasDrawWireRecord = {
  kind: String,
  from?: CanvasPoint,
  to?: CanvasPoint,
  color?: String,
  width?: f64,
  alpha?: f64,
  glowColor?: String,
  glowBlur?: f64,
  points?: Array<CanvasPoint>,
  closed?: bool,
  fill?: String,
  center?: CanvasPoint,
  radius?: f64,
  stroke?: String,
  strokeWidth?: f64,
  radialGradient?: CanvasRadialGradientWireRecord,
  radiusX?: f64,
  radiusY?: f64,
  rotation?: f64,
  position?: CanvasPoint,
  value?: String,
  font?: String,
  align?: String,
  baseline?: String,
  maxWidth?: f64,
  segments?: Array<CanvasPathSegmentWireRecord>,
  fillRule?: String,
  a?: f64,
  b?: f64,
  c?: f64,
  d?: f64,
  e?: f64,
  f?: f64,
  x?: f64,
  y?: f64,
  radians?: f64,
  pattern?: Array<f64>,
  offset?: f64,
  operation?: String
}

type CanvasFrameWireRecord = {
  version: i32,
  selector: String,
  width: f64,
  height: f64,
  clear: bool,
  background?: String,
  draws: Array<CanvasDrawWireRecord>
}

/// A typed segment in a Canvas path.
@boundary(type: "payload", field: "payload")
pub obj CanvasPathSegment {
  api payload: MsgPack,
  pri cached_wire_record?: CanvasPathSegmentWireRecord
}

pub enum CanvasFillRule
  NonZero
  EvenOdd

pub enum CanvasCompositeOperation
  SourceOver
  SourceIn
  SourceOut
  SourceAtop
  DestinationOver
  DestinationIn
  DestinationOut
  DestinationAtop
  Lighter
  Copy
  Xor
  Multiply
  Screen
  Overlay
  Darken
  Lighten
  ColorDodge
  ColorBurn
  HardLight
  SoftLight
  Difference
  Exclusion
