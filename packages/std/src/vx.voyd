/// Opaque virtual DOM node plan. The message parameter records the event
/// message type while the renderer wire stays private to VX.
type VxLower = fn() : () -> DataValue
obj VxPlan { thunk: Array<VxLower> }
pub obj Html<Msg> { plan: VxPlan }

/// Opaque virtual DOM attribute or event plan.
pub obj Attr<Msg> { plan: VxPlan }
pub type HtmlInput<Msg> = Html<void> | Html<Msg>
pub type AttrInput<Msg> = Attr<void> | Attr<Msg>
type VxThunkPlan = { plan: VxPlan }
pub type RenderKey = String

pub obj Program<Model, Msg> {
  plan: VxPlan
}

pub obj Sub<Msg> { plan: VxPlan }

fn lower_program<Model, Msg>(value: Program<Model, Msg>) -> DataValue
  lower_vx_plan(value)

fn lower_sub<Msg>(value: Sub<Msg>) -> DataValue
  lower_vx_plan(value)

fn lower_html_node<Msg>(value: Html<Msg>) -> DataValue
  lower_vx_plan(value)

fn lower_html_attr<Msg>(value: Attr<Msg>) -> DataValue
  lower_vx_plan(value)

fn html_plan<Msg>(run: VxLower) -> Html<Msg>
  Html<Msg> { plan: vx_plan(run) }

fn attr_plan<Msg>(run: VxLower) -> Attr<Msg>
  Attr<Msg> { plan: vx_plan(run) }

fn program_plan<Model, Msg>(run: VxLower) -> Program<Model, Msg>
  Program<Model, Msg> { plan: vx_plan(run) }

fn subscription_plan<Msg>(run: VxLower) -> Sub<Msg>
  Sub<Msg> { plan: vx_plan(run) }

fn vx_plan(run: VxLower) -> VxPlan
  let ~thunk = Array<VxLower>::with_capacity(1)
  thunk.push(run)
  VxPlan { thunk: thunk }

fn lower_vx_plan(value: VxThunkPlan) -> DataValue
  match(value.plan.thunk.get<VxLower>(0))
    Some<VxLower> { value: run }:
      run()
    None:
      wire::make_null()

impl<Model, Msg> CustomDto<Program<Model, Msg>, DataValue> for Program<Model, Msg>
  fn write(value: Program<Model, Msg>) -> DataValue
    wire::to_data_value(lower_program(value))

  fn read(value: DataValue) -> Result<Program<Model, Msg>, CustomDtoError>
    Ok<Program<Model, Msg>> {
      value: Program<Model, Msg> {
        plan: vx_plan(() -> DataValue => wire::from_data_value(value))
      }
    }

impl<Msg> CustomDto<Sub<Msg>, DataValue> for Sub<Msg>
  fn write(value: Sub<Msg>) -> DataValue
    wire::to_data_value(lower_sub(value))

  fn read(value: DataValue) -> Result<Sub<Msg>, CustomDtoError>
    Ok<Sub<Msg>> {
      value: Sub<Msg> {
        plan: vx_plan(() -> DataValue => wire::from_data_value(value))
      }
    }

impl<Msg> CustomDto<Cmd<Msg>, CommandWire> for Cmd<Msg>
  fn write(value: Cmd<Msg>) -> CommandWire
    lower_command(value)

  fn read(value: CommandWire) -> Result<Cmd<Msg>, CustomDtoError>
    Ok<Cmd<Msg>> {
      value: command_plan<Msg>(() -> CommandWire => value)
    }

impl<Msg> CustomDto<Html<Msg>, DataValue> for Html<Msg>
  fn write(value: Html<Msg>) -> DataValue
    wire::to_data_value(lower_html_node(value))

  fn read(value: DataValue) -> Result<Html<Msg>, CustomDtoError>
    Ok<Html<Msg>> {
      value: Html<Msg> {
        plan: vx_plan(() -> DataValue => wire::from_data_value(value))
      }
    }

impl<Msg> CustomDto<Attr<Msg>, DataValue> for Attr<Msg>
  fn write(value: Attr<Msg>) -> DataValue
    wire::to_data_value(lower_html_attr(value))

  fn read(value: DataValue) -> Result<Attr<Msg>, CustomDtoError>
    Ok<Attr<Msg>> {
      value: Attr<Msg> {
        plan: vx_plan(() -> DataValue => wire::from_data_value(value))
      }
    }

fn typed_html_node_payloads<Msg>(values: Array<Html<Msg>>) -> Array<DataValue>
  let ~out = Array<DataValue>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    out.push(lower_html_node(values.at(index)))
    index = index + 1
  out

fn typed_html_attr_payloads<Msg>(values: Array<Attr<Msg>>) -> Array<DataValue>
  let ~out = Array<DataValue>::with_capacity(values.len())
  var index = 0
  while index < values.len():
    out.push(lower_html_attr(values.at(index)))
    index = index + 1
  out

fn lower_vx_input(value: VxThunkPlan) -> DataValue
  lower_vx_plan(value)

fn html_node_payloads<Msg>(values: Array<HtmlInput<Msg>>) -> Array<DataValue>
