  Saturation
  Color
  Luminosity

/// A typed canvas draw or state operation produced by the Canvas constructors.
@boundary(type: "payload", field: "payload")
pub obj CanvasDraw {
  api payload: MsgPack,
  pri cached_wire_record?: CanvasDrawWireRecord
}

/// A versioned canvas frame ready for the browser VX runtime.
@boundary(type: "payload", field: "payload")
