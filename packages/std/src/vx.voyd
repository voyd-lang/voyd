  value.match(active)
    SourceOver:
      "source-over".to_string()
    SourceIn:
      "source-in".to_string()
    SourceOut:
      "source-out".to_string()
    SourceAtop:
      "source-atop".to_string()
    DestinationOver:
      "destination-over".to_string()
    DestinationIn:
      "destination-in".to_string()
    DestinationOut:
      "destination-out".to_string()
    DestinationAtop:
      "destination-atop".to_string()
    Lighter:
      "lighter".to_string()
    Copy:
      "copy".to_string()
    Xor:
      "xor".to_string()
    Multiply:
      "multiply".to_string()
    Screen:
      "screen".to_string()
    Overlay:
      "overlay".to_string()
    Darken:
      "darken".to_string()
    Lighten:
      "lighten".to_string()
    ColorDodge:
      "color-dodge".to_string()
    ColorBurn:
      "color-burn".to_string()
    HardLight:
      "hard-light".to_string()
    SoftLight:
      "soft-light".to_string()
    Difference:
      "difference".to_string()
    Exclusion:
      "exclusion".to_string()
