pub obj EventOptionsWire {
  api prevent_default?: bool,
  api stop_propagation?: bool,
  api capture?: bool,
  api passive?: bool,
  api pointer_capture?: bool
}

pub enum AttrValueWire
  AttrString { api value: String }
  AttrBool { api value: bool }
  AttrI32 { api value: i32 }

pub enum AttrWireNode
  NamedAttr { api kind: String, api name: String, api value: AttrValueWire }
  EventAttr { api event: String, api handler_ref: i32, api options?: EventOptionsWire }
pub obj AttrWire { api node: AttrWireNode }

pub enum HtmlWireList
  HtmlWireEnd
  HtmlWireNext { api value: HtmlWire, api rest: HtmlWireList }

pub enum AttrWireList
  AttrWireEnd
  AttrWireNext { api value: AttrWire, api rest: AttrWireList }

pub enum HtmlWireNode
  HtmlText { api value: String }
  HtmlFragment { api children: HtmlWireList }
  HtmlElement { api element_name: String, api attrs: AttrWireList, api children: HtmlWireList }
  HtmlKeyed { api key: String, api child: HtmlWire }
  HtmlMapped { api child: HtmlWire, api handler_ref: i32 }
  HtmlFrame { api version: i32, api root: HtmlWire }
pub obj HtmlWire { api node: HtmlWireNode }

fn html_wire(node: HtmlWireNode) -> HtmlWire
  HtmlWire { node }

fn attr_wire(node: AttrWireNode) -> AttrWire
  AttrWire { node }

pub enum SubscriptionWire
  SubscriptionNone
  SubscriptionBatch { children: Array<SubscriptionWire> }
  SubscriptionRuntime {
    kind: String,
    key: String,
    event?: String,
    query?: String,
    name?: String,
    millis?: i64,
    payload?: EncodedPayload
  }
  SubscriptionMap { child: SubscriptionWire, handler_ref: i32, handler_key?: i32 }
  SubscriptionOwned { child: SubscriptionWire, handler_ref: i32 }

pub enum ProgramWire
  ProgramResult {
    model: EncodedPayload,
    frame: Optional<HtmlWire>,
    commands: Optional<CommandWire>,
    subscriptions: Optional<SubscriptionWire>
  }
  ProgramMapModel { child: ProgramWire, handler_ref: i32, hydrate_handler_ref: Optional<i32> }
  ProgramMapMessage { child: ProgramWire, handler_ref: i32 }
  ProgramHandlers {
    init_handler_ref: i32,
    hydrate_handler_ref: i32,
    step_handler_ref: i32,
    view_handler_ref: i32,
    subscriptions_handler_ref: Optional<i32>
  }

type ProgramLower = fn() : () -> ProgramWire
obj ProgramPlan { thunk: Array<ProgramLower> }
type SubscriptionLower = fn() : () -> SubscriptionWire
obj SubscriptionPlan { thunk: Array<SubscriptionLower> }
type PayloadLower = fn() : () -> EncodedPayload

/// Opaque virtual DOM node plan. The message parameter records the event
/// message type while the renderer wire stays private to VX.
type HtmlLower = fn() : () -> HtmlWire
obj HtmlPlan { thunk: Array<HtmlLower> }
type HtmlThunkPlan = { plan: HtmlPlan }
pub obj Html<Msg> { plan: HtmlPlan }

/// Opaque virtual DOM attribute or event plan.
type AttrLower = fn() : () -> AttrWire
obj AttrPlan { thunk: Array<AttrLower> }
type AttrThunkPlan = { plan: AttrPlan }
pub obj Attr<Msg> { plan: AttrPlan }
pub type HtmlInput<Msg> = Html<void> | Html<Msg>
pub type AttrInput<Msg> = Attr<void> | Attr<Msg>
pub type RenderKey = String

pub obj Program<Model, Msg> {
  plan: ProgramPlan
}

pub obj Sub<Msg> { plan: SubscriptionPlan }

fn lower_program<Model, Msg>(value: Program<Model, Msg>) -> ProgramWire
  let run = value.plan.thunk.at(0)
  run()

fn lower_sub<Msg>(value: Sub<Msg>) -> SubscriptionWire
  let run = value.plan.thunk.at(0)
  run()

fn lower_html_node<Msg>(value: Html<Msg>) -> HtmlWire
  lower_html_plan(value.plan)

fn lower_html_plan(plan: HtmlPlan) -> HtmlWire
  let run: HtmlLower = plan.thunk.at(0)
  run()

fn lower_html_attr<Msg>(value: Attr<Msg>) -> AttrWire
  let run = value.plan.thunk.at(0)
  run()

fn html_plan<Msg>(run: HtmlLower) -> Html<Msg>
  let ~thunk = Array<HtmlLower>::with_capacity(1)
  thunk.push(run)
  Html<Msg> { plan: HtmlPlan { thunk } }

fn attr_plan<Msg>(run: AttrLower) -> Attr<Msg>
  let ~thunk = Array<AttrLower>::with_capacity(1)
  thunk.push(run)
  Attr<Msg> { plan: AttrPlan { thunk } }

fn program_plan<Model, Msg>(run: ProgramLower) -> Program<Model, Msg>
  let ~thunk = Array<ProgramLower>::with_capacity(1)
  thunk.push(run)
  Program<Model, Msg> { plan: ProgramPlan { thunk } }

fn subscription_plan<Msg>(run: SubscriptionLower) -> Sub<Msg>
  let ~thunk = Array<SubscriptionLower>::with_capacity(1)
  thunk.push(run)
  Sub<Msg> { plan: SubscriptionPlan { thunk } }

impl<Model, Msg> CustomDto<Program<Model, Msg>, ProgramWire> for Program<Model, Msg>
  fn write(value: Program<Model, Msg>) -> ProgramWire
    lower_program(value)

  fn read(value: ProgramWire) -> Result<Program<Model, Msg>, CustomDtoError>
    Ok<Program<Model, Msg>> {
      value: program_plan<Model, Msg>(() -> ProgramWire => value)
    }

impl<Msg> CustomDto<Sub<Msg>, SubscriptionWire> for Sub<Msg>
  fn write(value: Sub<Msg>) -> SubscriptionWire
    lower_sub(value)

  fn read(value: SubscriptionWire) -> Result<Sub<Msg>, CustomDtoError>
    Ok<Sub<Msg>> {
      value: subscription_plan<Msg>(() -> SubscriptionWire => value)
    }

impl<Msg> CustomDto<Cmd<Msg>, CommandWire> for Cmd<Msg>
  fn write(value: Cmd<Msg>) -> CommandWire
    lower_command(value)

  fn read(value: CommandWire) -> Result<Cmd<Msg>, CustomDtoError>
    Ok<Cmd<Msg>> {
      value: command_plan<Msg>(() -> CommandWire => value)
    }

impl<Msg> CustomDto<Html<Msg>, HtmlWire> for Html<Msg>
  fn write(value: Html<Msg>) -> HtmlWire
    lower_html_node(value)

  fn read(value: HtmlWire) -> Result<Html<Msg>, CustomDtoError>
    Ok<Html<Msg>> {
      value: html_plan<Msg>(() -> HtmlWire => value)
    }

impl<Msg> CustomDto<Attr<Msg>, AttrWire> for Attr<Msg>
  fn write(value: Attr<Msg>) -> AttrWire
    lower_html_attr(value)

  fn read(value: AttrWire) -> Result<Attr<Msg>, CustomDtoError>
    Ok<Attr<Msg>> {
      value: attr_plan<Msg>(() -> AttrWire => value)
    }

fn typed_html_node_payloads<Msg>(values: Array<Html<Msg>>) -> HtmlWireList
  var out: HtmlWireList = HtmlWireList::HtmlWireEnd {}
  var index = values.len() - 1
  while index >= 0:
    out = HtmlWireList::HtmlWireNext {
      value: lower_html_node(values.at(index)),
      rest: out
    }
    index = index - 1
  out

fn typed_html_attr_payloads<Msg>(values: Array<Attr<Msg>>) -> AttrWireList
  var out: AttrWireList = AttrWireList::AttrWireEnd {}
  var index = values.len() - 1
  while index >= 0:
    out = AttrWireList::AttrWireNext {
      value: lower_html_attr(values.at(index)),
      rest: out
    }
    index = index - 1
  out

fn lower_html_input(value: HtmlThunkPlan) -> HtmlWire
  lower_html_plan(value.plan)

fn lower_attr_input(value: AttrThunkPlan) -> AttrWire
  let run = value.plan.thunk.at(0)
  run()

fn html_node_payloads<Msg>(values: Array<HtmlInput<Msg>>) -> HtmlWireList
  var out: HtmlWireList = HtmlWireList::HtmlWireEnd {}
  var index = values.len() - 1
  while index >= 0:
    out = HtmlWireList::HtmlWireNext {
      value: lower_html_input(values.at(index)),
      rest: out
    }
    index = index - 1
  out

fn html_attr_payloads<Msg>(values: Array<AttrInput<Msg>>) -> AttrWireList
  var out: AttrWireList = AttrWireList::AttrWireEnd {}
  var index = values.len() - 1
  while index >= 0:
    out = AttrWireList::AttrWireNext {
      value: lower_attr_input(values.at(index)),
      rest: out
    }
    index = index - 1
  out

