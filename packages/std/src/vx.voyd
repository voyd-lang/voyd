    html: html,
    handler_id: retain_typed_html_message_mapper_id(handler)
  )

fn map_html_with_handler_id<ChildMsg, ParentMsg>({ html: Html<ChildMsg>, handler_id: i32 }) -> Html<ParentMsg>
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "map")
  out.set("child", html.payload)
  out.set("handlerId", msgpack::make_i32(handler_id))
  HtmlNode { payload: msgpack::make_map(out) }

fn event_with_handler_id({ name: String, handler_id: i32, options?: EventOptions }): () -> HtmlAttr
  let ~out = Dict<String, MsgPack>::init()
  out.set("kind", "event")
  out.set("event", name)
  out.set("handlerId", msgpack::make_i32(handler_id))
  if options is Some:
    out.set("options", msgpack::make_map(event_options_to_map(options.value)))
  HtmlAttr { payload: msgpack::make_map(out) }

