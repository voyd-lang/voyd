  broadcast_channel<Msg>(name: name.to_string(), value: value)

pub fn broadcast_channel<Payload, Msg>({
  name: StringSlice,
  handler: fn(Payload) -> Msg
}) -> Sub<Msg>
  broadcast_channel<Payload, Msg>(name: name.to_string(), handler: handler)

/// Reads a component-local typed state handle.
pub fn state_handle<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<T>
  state_handle_at(id: id, initial: initial)

fn state_handle_at<T>({ id: i32, initial: T }): Component -> StateHandle<T>
  let slot = Component::state_key(id)
  StateHandle<T> {
    id: slot,
    value: decode_vx_value<T>(
      Component::state_get(slot, encode_vx_value(initial)),
      initial
    )
  }

pub fn state_handle({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> StateHandle<String>
  state_handle_at<String>(id: id, initial: initial.to_string())

/// Reads component-local typed state as a `(value, setter)` pair.
pub fn state<T>({
  initial: T,
  id: i32 = stable_callsite_id()
}): Component -> (T, fn(T) -> void)
  let handle = state_handle_at(id: id, initial: initial)
  (handle.value, (value: T) -> void => handle.set(value))

pub fn state({
  initial: StringSlice,
  id: i32 = stable_callsite_id()
}): Component -> (String, fn(String) -> void)
  let handle = state_handle_at(id: id, initial: initial.to_string())
  (handle.value, (value: String) -> void => handle.set(value))

/// Registers a task with the current component instance.
pub fn task<Key, T>({ key: Key, task: Task<T> }): Component -> Unit
  Component::task_started(encode_vx_value(key), task.id)
  Unit {}

/// Lowers a view for server rendering, claims its callbacks, and removes
/// client-only message mapping nodes.
pub fn lower_server_html_node<Msg>(value: Html<Msg>): () -> HtmlWire
  lower_server_html_wire(lower_html_node(value))

fn lower_server_html_wire(value: HtmlWire): () -> HtmlWire
  value.node.match(node)
    HtmlText:
      value
    HtmlFragment:
      html_wire(HtmlWireNode::HtmlFragment {
        children: lower_server_html_children(node.children)
      })
    HtmlElement:
      claim_server_render_attr_array(node.attrs)
      html_wire(HtmlWireNode::HtmlElement {
        element_name: node.element_name,
        attrs: node.attrs,
        children: lower_server_html_children(node.children)
      })
    HtmlKeyed:
      html_wire(HtmlWireNode::HtmlKeyed {
        key: node.key,
        child: lower_server_html_wire(node.child)
      })
    HtmlMapped:
      claim_render_callback_id(node.handler_ref)
      lower_server_html_wire(node.child)
    HtmlFrame:
      html_wire(HtmlWireNode::HtmlFrame {
        version: node.version,
        root: lower_server_html_wire(node.root)
      })

fn lower_server_html_children(values: HtmlWireList): () -> HtmlWireList
  values.match(node)
    HtmlWireEnd:
      HtmlWireList::HtmlWireEnd {}
    HtmlWireNext:
      HtmlWireList::HtmlWireNext {
        value: lower_server_html_wire(node.value),
        rest: lower_server_html_children(node.rest)
      }

fn claim_server_render_attr_array(values: AttrWireList): () -> void
  values.match(node)
    AttrWireEnd:
      void
    AttrWireNext:
      node.value.node.match(entry)
        EventAttr:
          claim_render_callback_id(entry.handler_ref)
        else:
          void
      claim_server_render_attr_array(node.rest)

/// Creates a versioned VX render frame.
pub fn frame<Msg>(root: Html<Msg>): () -> Html<Msg>
  html_plan<Msg>(() -> HtmlWire =>
    html_wire(HtmlWireNode::HtmlFrame { version: 1, root: lower_html_node(root) })
  )

/// Creates a VX text node.
pub fn text(value: String): () -> Html<void>
