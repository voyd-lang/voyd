use std::array::Array
use std::result::types::{ Result, Ok, Err }
use std::string::type::String
use src::mutable_empty_loop_array_provider::{ Source, Payload, Path, Failure, collect }

fn run() -> Result<Array<Path>, Failure>
  try
    collect()
  Source::values(tail):
    tail(Payload { ok: true, value: Array<String>::init() })

pub fn main() -> i32
  match(run())
    Ok<Array<Path>> { value }:
      value.len()
    Err<Failure>:
      -1
