use std::shared_cell::SharedCell

eff Local
  next(tail) -> i32
  next_with_max(tail, max: i32) -> i32

fn helper(): Local -> i32
  Local::next_with_max(4) + Local::next()

fn big_helper(): Local -> i32
  var total = 0
  total = total + Local::next_with_max(0)
  total = total + Local::next_with_max(1)
  total = total + Local::next_with_max(2)
  total = total + Local::next_with_max(3)
  total = total + Local::next_with_max(4)
  total = total + Local::next_with_max(5)
  total = total + Local::next_with_max(6)
  total = total + Local::next_with_max(7)
  total = total + Local::next_with_max(8)
  total

pub fn direct_local(): () -> i32
  try
    Local::next()
  Local::next(tail):
    tail(7)
  Local::next_with_max(tail, max: i32):
    tail(max + 1)

pub fn helper_local(): () -> i32
  try
    helper()
  Local::next(tail):
    tail(5)
  Local::next_with_max(tail, max: i32):
    tail(max + 1)

pub fn big_local(): () -> i32
  try
    big_helper()
  Local::next(tail):
    tail(5)
  Local::next_with_max(tail, max: i32):
    tail(max + 1)

pub fn captured_handler_env(): () -> i32
  let handled = SharedCell(0)
  try
    Local::next()
  Local::next(tail):
    handled.with_mut((~count) => count = count + 1)
    tail(7)
  Local::next_with_max(tail, max: i32):
    tail(max + 1)
  handled.with((count) => count + 0)
