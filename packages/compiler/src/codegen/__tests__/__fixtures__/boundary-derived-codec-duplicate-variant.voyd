use std::msgpack::pack_boundary_value
use std::string::type::String

obj RepeatedBoundaryVariant<T> {
  value: T
}

type AmbiguousBoundaryUnion = RepeatedBoundaryVariant<i32> | RepeatedBoundaryVariant<String>

pub fn main() -> void
  let value: AmbiguousBoundaryUnion = RepeatedBoundaryVariant { value: 7 }
  pack_boundary_value(value)
  void
