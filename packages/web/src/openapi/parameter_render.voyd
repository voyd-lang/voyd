//! OpenAPI parameter rendering from typed record shapes.

use std::array::Array
use std::dict::Dict
use std::json::{ JsonBool, JsonObject, JsonString, JsonValue }
use std::meta::{ RecordShape, Shape }
use std::optional::types::all
use std::string::type::{ String, StringSlice }
use super::identity::schema_identity_prefix
use super::schema::{ schema_components, schema_node }

pub obj RenderedParameters {
  api value: Array<JsonValue>,
  api components: Dict<String, JsonValue>
}

pub fn render_parameters(
  shape: Option<Shape>,
  {
    location: StringSlice,
    required: bool,
    prefix: String,
    include_doc_comments: bool
  }
) -> RenderedParameters
  render_parameters(
    shape,
    location: location.to_string(),
    required: required,
    prefix: prefix,
    include_doc_comments: include_doc_comments
  )

pub fn render_parameters(
  shape: Option<Shape>,
  {
    location: String,
    required: bool,
    prefix: String,
    include_doc_comments: bool
  }
) -> RenderedParameters
  let ~out = Array<JsonValue>::init()
  match(shape)
    None:
      void
    Some<Shape> { value }:
      return render_shape_parameters(value, location: location, required: required, prefix: prefix, include_doc_comments: include_doc_comments)
  RenderedParameters {
    value: out,
    components: Dict<String, JsonValue>::init()
  }

fn render_shape_parameters(
  shape: Shape,
  {
    location: String,
    required: bool,
    prefix: String,
    include_doc_comments: bool
  }
) -> RenderedParameters
  let ~out = Array<JsonValue>::init()
  let rendered_components = schema_components(shape, prefix: prefix, include_doc_comments: include_doc_comments)
  let stable_prefix = schema_identity_prefix(shape, fallback: prefix)
  shape.root.match(root)
    RecordShape:
      var index = 0
      while index < root.fields.len():
        let field = root.fields.at(index)
        var parameter = Dict<String, JsonValue>::init()
        parameter = parameter.setting("name", JsonString { value: field.name })
        parameter = parameter.setting("in", JsonString { value: location })
        let parameter_required = required or not field.optional
        parameter = parameter.setting("required", JsonBool { value: parameter_required })
        if include_doc_comments:
          parameter = setting_optional_string(parameter, "description", field.documentation)
        parameter = parameter.setting("schema", schema_node(field.shape, prefix: stable_prefix))
        out.push(JsonObject { value: parameter })
        index = index + 1
    else:
      void
  RenderedParameters { value: out, components: rendered_components }

fn setting_optional_string(target: Dict<String, JsonValue>, key: StringSlice, value: Option<String>) -> Dict<String, JsonValue>
  match(value)
    Some<String> { value }:
      target.setting(key.to_string(), JsonString { value: value })
    None:
      target

fn setting_optional_string(target: Dict<String, JsonValue>, key: String, value: Option<String>) -> Dict<String, JsonValue>
  setting_optional_string(target, key.as_slice(), value)
