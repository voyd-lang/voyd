//! Deterministic OpenAPI response rendering and same-status media merging.

use std::array::Array
use std::dict::Dict
use std::json::{ JsonArray, JsonBool, JsonObject, JsonString, JsonValue }
use std::meta::Shape
use std::number::cast::to_string
use std::optional::types::all
use std::string::type::{ String, StringSlice }
use super::contract::{ OpenApiHeader, OpenApiResponseContract, OpenApiResponseSchemaDocs, OpenApiSchemaDocs }
use super::json_copy::{ copy_json_object, copy_json_value }
use super::schema::{ RenderedSchema, opaque_schema, render_schema, schema_components, schema_for }
use super::schema_overlay::apply_schema_docs

obj RenderedContent {
  content_type: String,
  schema: JsonValue,
  components: Dict<String, JsonValue>
}

obj PreparedContent {
  content_type: String,
  schema: JsonValue,
  components: Dict<String, JsonValue>
}

obj RenderedHeaders {
  value: Dict<String, JsonValue>,
  components: Dict<String, JsonValue>
}

pub obj RenderedResponses {
  api value: JsonValue,
  api components: Dict<String, JsonValue>
}

pub fn response_contracts_json(
  contracts: Array<OpenApiResponseContract>,
  { schema_docs: Array<OpenApiResponseSchemaDocs>, prefix: String, include_doc_comments: bool }
) -> RenderedResponses
  let ~components = Dict<String, JsonValue>::init()
  let ~responses = Dict<String, JsonValue>::init()
  var index = 0
  while index < contracts.len():
    let contract = contracts.at(index)
    var previous = 0
    var already_rendered = false
    while previous < index:
      if same_response_key(contracts.at(previous), contract):
        already_rendered = true
      previous = previous + 1
    if not already_rendered:
      let ~response = Dict<String, JsonValue>::init()
      response.set("description", JsonString { value: contract.description })
      let ~content = Dict<String, JsonValue>::init()
      let ~headers = Dict<String, JsonValue>::init()
      var candidate_index = index
      while candidate_index < contracts.len():
        let candidate = contracts.at(candidate_index)
        if same_response_key(candidate, contract):
          let response_headers = candidate.headers
          match(render_content(candidate, candidate_index: candidate_index, schema_docs: schema_docs, prefix: prefix, include_doc_comments: include_doc_comments))
            Some<RenderedContent> { value: rendered }:
              components.extend(rendered.components)
              match(content.get(rendered.content_type))
                Some<JsonValue> { value: existing_media }:
                  let existing_media_copy = copy_json_value(existing_media)
                  let _ = content.set(rendered.content_type, merge_media_schemas(existing_media_copy, rendered.schema))
                None:
                  let ~media = Dict<String, JsonValue>::init()
                  media.set("schema", rendered.schema)
                  let _ = content.set(rendered.content_type, JsonObject { value: media })
            None:
              void
          let rendered_headers = render_headers(response_headers, prefix: prefix, include_doc_comments: include_doc_comments)
          headers.extend(rendered_headers.value)
          components.extend(rendered_headers.components)
        candidate_index = candidate_index + 1
      if not content.is_empty():
        let _ = response.set("content", JsonObject { value: content })
      if not headers.is_empty():
        let _ = response.set("headers", JsonObject { value: headers })
      let _ = responses.set(response_key(contract), JsonObject { value: response })
    index = index + 1
  RenderedResponses {
    value: JsonObject { value: responses },
    components
  }

fn render_content(
  candidate: OpenApiResponseContract,
  {
    candidate_index: i32,
    schema_docs: Array<OpenApiResponseSchemaDocs>,
    prefix: String,
    include_doc_comments: bool
  }
) -> Option<RenderedContent>
  match(prepare_content(candidate, candidate_index: candidate_index, schema_docs: schema_docs, prefix: prefix, include_doc_comments: include_doc_comments))
    None:
      None {}
    Some<PreparedContent> { value }:
      Some<RenderedContent> {
        value: RenderedContent {
          content_type: value.content_type.as_slice().to_string(),
          schema: copy_json_value(value.schema),
          components: copy_json_object(value.components)
        }
      }

fn prepare_content(
  candidate: OpenApiResponseContract,
  {
    candidate_index: i32,
    schema_docs: Array<OpenApiResponseSchemaDocs>,
    prefix: String,
    include_doc_comments: bool
  }
) -> Option<PreparedContent>
  match(candidate.content_type)
    None:
      None {}
    Some<String> { value: content_type }:
      let selected_schema_docs = matching_response_schema_docs(
        schema_docs,
        status: candidate.status,
        content_type: content_type
      )
      let prepared = match(candidate.event_schema)
        Some<Shape> { value: event_shape }:
          let event_prefix = prefix.concat("Event".as_slice()).concat(to_string(candidate_index).as_slice())
          let event_schema = render_schema(event_shape, prefix: event_prefix, include_doc_comments: include_doc_comments)
          let event_components = schema_components(event_shape, prefix: event_prefix, include_doc_comments: include_doc_comments)
          let documented_event_schema = apply_schema_docs(
            event_schema,
            selected_schema_docs,
            components: event_components
          )
          let ~stream = Dict<String, JsonValue>::init()
          stream.set("type", JsonString { value: "string".to_string() })
          stream.set("x-voyd-event-schema", documented_event_schema)
          PreparedContent {
            content_type,
            schema: JsonObject { value: stream },
            components: event_components
          }
        None:
          let response_prefix = prefix.concat("Response".as_slice()).concat(to_string(candidate_index).as_slice())
          let inferred_schema = match(candidate.schema)
            Some<Shape> { value }:
              render_schema(value, prefix: response_prefix, include_doc_comments: include_doc_comments)
            None:
              opaque_schema(content_type)
          let response_components = match(candidate.schema)
            Some<Shape> { value }:
              schema_components(value, prefix: response_prefix, include_doc_comments: include_doc_comments)
            None:
              Dict<String, JsonValue>::init()
          let documented_schema = apply_schema_docs(
            inferred_schema,
            selected_schema_docs,
            components: response_components
          )
          PreparedContent {
            content_type,
            schema: documented_schema,
            components: response_components
          }
      Some<PreparedContent> {
        value: prepared
      }

fn merge_media_schemas(existing_media: JsonValue, alternative: JsonValue) -> JsonValue
  let existing_schema = match(existing_media)
    JsonObject { value: media }:
      match(media.get("schema".to_string()))
        Some<JsonValue> { value }:
          value
        None:
          opaque_schema("application/octet-stream")
    _:
      opaque_schema("application/octet-stream")
  let ~alternatives = Array<JsonValue>::with_capacity(2)
  alternatives.push(existing_schema)
  alternatives.push(alternative)
  let ~any_of = Dict<String, JsonValue>::init()
  any_of.set("anyOf", JsonArray { value: alternatives })
  let ~media = Dict<String, JsonValue>::init()
  media.set("schema", JsonObject { value: any_of })
  JsonObject { value: media }

pub fn matching_response_schema_docs(
  docs: Array<OpenApiResponseSchemaDocs>,
  { status: i32, content_type: String }
) -> Option<OpenApiSchemaDocs>
  var index = 0
  while index < docs.len():
    let candidate = docs.at(index)
    if candidate.status == status:
      match(candidate.content_type)
        Some<String> { value }:
          if value.equals(content_type):
            return Some<OpenApiSchemaDocs> { value: candidate.schema }
        None:
          return Some<OpenApiSchemaDocs> { value: candidate.schema }
    index = index + 1
  None {}

fn render_headers(
  response_headers: Array<OpenApiHeader>,
  { prefix: String, include_doc_comments: bool }
) -> RenderedHeaders
  let ~headers = Dict<String, JsonValue>::init()
  let ~components = Dict<String, JsonValue>::init()
  var header_index = 0
  while header_index < response_headers.len():
    let header = response_headers.at(header_index)
    match(headers.get(header.name))
      Some<JsonValue>:
        void
      None:
        let header_name = header.name
        let header_description = header.description
        let header_required = header.required
        let header_schema = header.schema
        let ~header_value = Dict<String, JsonValue>::init()
        set_optional_string(header_value, "description", header_description)
        header_value.set("required", JsonBool { value: header_required })
        let rendered_schema = header_schema_json(
          header_schema,
          prefix: prefix,
          include_doc_comments: include_doc_comments
        )
        components.extend(rendered_schema.components)
        header_value.set("schema", rendered_schema.value)
        let _ = headers.set(header_name, JsonObject { value: header_value })
    header_index = header_index + 1
  RenderedHeaders { value: headers, components }

fn header_schema_json(
  schema: Shape,
  { prefix: String, include_doc_comments: bool }
) -> RenderedSchema
  schema_for(schema, prefix: prefix.concat("Header".as_slice()), include_doc_comments: include_doc_comments)

fn same_response_key(left: OpenApiResponseContract, right: OpenApiResponseContract) -> bool
  left.is_default == right.is_default and left.status == right.status

fn response_key(contract: OpenApiResponseContract) -> String
  if contract.is_default:
    return "default".to_string()
  to_string(contract.status)

@staged(into: target)
fn set_optional_string(~target: Dict<String, JsonValue>, key: StringSlice, value: Option<String>) -> void
  match(value)
    Some<String> { value }:
      let _ = target.set(key.to_string(), JsonString { value: value })
    None:
      void

@staged(into: target)
fn set_optional_string(~target: Dict<String, JsonValue>, key: String, value: Option<String>) -> void
  set_optional_string(target, key.as_slice(), value)
