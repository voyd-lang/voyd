//! Rendering of one OpenAPI operation.

use std::array::Array
use std::dict::Dict
use std::json::{ JsonArray, JsonBool, JsonObject, JsonString, JsonValue }
use std::meta::Shape
use std::number::cast::to_string
use std::optional::types::all
use std::string::type::{ String, StringSlice }
use super::parameter_render::render_parameters
use super::response_render::{ matching_response_schema_docs, response_contracts_json }
use super::schema::{ RenderedSchema, content_json, content_without_schema, opaque_schema, schema_for }
use super::schema_overlay::apply_schema_docs
use super::types::Operation
use super::contract::OpenApiParameterContract

obj RenderedParameterOverride {
  name: String,
  location: String,
  value: JsonValue
}

obj RenderedParameterOverrides {
  values: Array<RenderedParameterOverride>,
  components: Dict<String, JsonValue>
}

pub obj RenderedOperation {
  api value: JsonValue,
  api components: Dict<String, JsonValue>
}

pub fn operation_json(
  operation: Operation,
  { prefix: String, include_doc_comments: bool }
) -> RenderedOperation
  let ~components = Dict<String, JsonValue>::init()
  let ~out = Dict<String, JsonValue>::init()
  set_optional_string(out, "summary", operation.summary)
  set_optional_string(out, "description", operation.description)
  set_optional_string(out, "operationId", operation.operation_id)
  if not operation.tags.is_empty():
    let ~tags = Array<JsonValue>::with_capacity(operation.tags.len())
    var tag_index = 0
    while tag_index < operation.tags.len():
      tags.push(JsonString { value: operation.tags.at(tag_index) })
      tag_index = tag_index + 1
    let _ = out.set("tags", JsonArray { value: tags })

  let ~parameters = Array<JsonValue>::init()
  let path_parameters = render_parameters(operation.path_params, location: "path".as_slice(), required: true, prefix: prefix.concat("Path".as_slice()), include_doc_comments: include_doc_comments)
  parameters.extend(path_parameters.value)
  components.extend(path_parameters.components)
  let query_parameters = render_parameters(operation.query_params, location: "query".as_slice(), required: false, prefix: prefix.concat("Query".as_slice()), include_doc_comments: include_doc_comments)
  parameters.extend(query_parameters.value)
  components.extend(query_parameters.components)
  let header_parameters = render_parameters(operation.header_params, location: "header".as_slice(), required: false, prefix: prefix.concat("Header".as_slice()), include_doc_comments: include_doc_comments)
  parameters.extend(header_parameters.value)
  components.extend(header_parameters.components)
  let cookie_parameters = render_parameters(operation.cookie_params, location: "cookie".as_slice(), required: false, prefix: prefix.concat("Cookie".as_slice()), include_doc_comments: include_doc_comments)
  parameters.extend(cookie_parameters.value)
  components.extend(cookie_parameters.components)
  let rendered_parameter_overrides = render_parameter_overrides(operation.parameter_overrides, prefix: prefix, include_doc_comments: include_doc_comments)
  components.extend(rendered_parameter_overrides.components)
  let overridden_parameters = apply_parameter_overrides(parameters, rendered_parameter_overrides.values)
  if not overridden_parameters.is_empty():
    let _ = out.set("parameters", JsonArray { value: overridden_parameters })

  if operation.has_request_body:
    let ~body = Dict<String, JsonValue>::init()
    let _ = body.set("required", JsonBool { value: operation.request_required })
    set_optional_string(body, "description", operation.request_description)
    let request_content = match(operation.request_body)
      Some<Shape> { value }:
        let rendered_request_schema = schema_for(value, prefix: prefix.concat("Request".as_slice()), include_doc_comments: include_doc_comments)
        components.extend(rendered_request_schema.components)
        let inferred_request_schema = rendered_request_schema.value
        let request_schema = apply_schema_docs(
          inferred_request_schema,
          operation.request_schema_docs,
          components: components
        )
        content_json(
          operation.request_content_type,
          request_schema
        )
      None:
        if operation.request_content_type.starts_with("text/plain") or operation.request_content_type.equals("application/octet-stream"):
          content_json(
            operation.request_content_type,
            apply_schema_docs(
              opaque_schema(operation.request_content_type),
              operation.request_schema_docs,
              components: components
            )
          )
        else:
          content_without_schema(operation.request_content_type)
    let _ = body.set("content", request_content)
    let _ = out.set("requestBody", JsonObject { value: body })

  if not operation.responses.is_empty():
    let rendered_responses = response_contracts_json(operation.responses, schema_docs: operation.response_schema_docs, prefix: prefix, include_doc_comments: include_doc_comments)
    components.extend(rendered_responses.components)
    let _ = out.set("responses", rendered_responses.value)
    return RenderedOperation { value: JsonObject { value: out }, components: components }

  if operation.opaque_response:
    let ~opaque_responses = Dict<String, JsonValue>::init()
    let ~opaque_response = Dict<String, JsonValue>::init()
    let _ = opaque_response.set("description", JsonString { value: "Opaque response".to_string() })
    let _ = opaque_responses.set("default", JsonObject { value: opaque_response })
    let _ = out.set("responses", JsonObject { value: opaque_responses })
    return RenderedOperation { value: JsonObject { value: out }, components: components }

  let ~responses = Dict<String, JsonValue>::init()
  let ~response = Dict<String, JsonValue>::init()
  let _ = response.set("description", JsonString { value: operation.response_description })
  match(operation.response_body)
    Some<Shape> { value }:
      let rendered_response_schema = schema_for(value, prefix: prefix.concat("Response".as_slice()), include_doc_comments: include_doc_comments)
      components.extend(rendered_response_schema.components)
      let inferred_response_schema = rendered_response_schema.value
      let schema = apply_schema_docs(
        inferred_response_schema,
        matching_response_schema_docs(
          operation.response_schema_docs,
          status: operation.response_status,
          content_type: operation.response_content_type
        ),
        components: components
      )
      if operation.response_content_type.equals("text/event-stream"):
        let ~stream_schema = Dict<String, JsonValue>::init()
        let _ = stream_schema.set("type", json_string("string"))
        let _ = stream_schema.set("x-voyd-event-schema", schema)
        let _ = response.set("content", content_json(operation.response_content_type, JsonObject { value: stream_schema }))
      else:
        let _ = response.set("content", content_json(operation.response_content_type, schema))
    None:
      void
  let _ = responses.set(to_string(operation.response_status), JsonObject { value: response })
  let _ = out.set("responses", JsonObject { value: responses })
  RenderedOperation { value: JsonObject { value: out }, components: components }

fn apply_parameter_overrides(
  parameters: Array<JsonValue>,
  overrides: Array<RenderedParameterOverride>
) -> Array<JsonValue>
  let ~result = Array<JsonValue>::with_capacity(parameters.len() + overrides.len())
  var parameter_index = 0
  while parameter_index < parameters.len():
    let parameter = parameters.at(parameter_index)
    let fields = object_fields(parameter)
    var override_index = 0
    var replacement_index = -1
    while override_index < overrides.len():
      let override = overrides.at(override_index)
      if string_value(fields, "name").equals(override.name) and string_value(fields, "in").equals(override.location):
        replacement_index = override_index
      override_index = override_index + 1
    if replacement_index >= 0:
      result.push(overrides.at(replacement_index).value)
    else:
      result.push(parameter)
    parameter_index = parameter_index + 1

  var override_index = 0
  while override_index < overrides.len():
    let override = overrides.at(override_index)
    var source_index = 0
    var replaced = false
    while source_index < parameters.len():
      let fields = object_fields(parameters.at(source_index))
      if string_value(fields, "name").equals(override.name) and string_value(fields, "in").equals(override.location):
        replaced = true
      source_index = source_index + 1
    if not replaced:
      result.push(override.value)
    override_index = override_index + 1
  result

fn render_parameter_overrides(
  overrides: Array<OpenApiParameterContract>,
  { prefix: String, include_doc_comments: bool }
) -> RenderedParameterOverrides
  let ~rendered = Array<RenderedParameterOverride>::with_capacity(overrides.len())
  let ~components = Dict<String, JsonValue>::init()
  var override_index = 0
  while override_index < overrides.len():
    let override = overrides.at(override_index)
    let result = render_parameter_override(
      override,
      prefix: prefix.concat("Parameter".as_slice()),
      include_doc_comments: include_doc_comments
    )
    components.extend(result.components)
    rendered.push(RenderedParameterOverride {
      name: override.name,
      location: override.location,
      value: result.value
    })
    override_index = override_index + 1
  RenderedParameterOverrides { values: rendered, components: components }

fn render_parameter_override(
  parameter: OpenApiParameterContract,
  { prefix: String, include_doc_comments: bool }
) -> RenderedSchema
  let ~out = Dict<String, JsonValue>::init()
  let ~components = Dict<String, JsonValue>::init()
  let _ = out.set("name", JsonString { value: parameter.name })
  let _ = out.set("in", JsonString { value: parameter.location })
  let required = parameter.required or parameter.location.equals("path")
  let _ = out.set("required", JsonBool { value: required })
  set_optional_string(out, "description", parameter.description)
  match(parameter.schema)
    Some<Shape> { value }:
      let rendered_schema = schema_for(value, prefix: prefix, include_doc_comments: include_doc_comments)
      components.extend(rendered_schema.components)
      let _ = out.set("schema", rendered_schema.value)
    None:
      let _ = out.set("schema", JsonObject { value: Dict<String, JsonValue>::init() })
  RenderedSchema {
    value: JsonObject { value: out },
    components: components
  }

fn object_fields(value: JsonValue) -> Dict<String, JsonValue>
  value.match(active)
    JsonObject: active.value
    else: Dict<String, JsonValue>::init()

fn string_value(fields: Dict<String, JsonValue>, key: StringSlice) -> String
  match(fields.get(key.to_string()))
    Some<JsonValue> { value }:
      value.match(active)
        JsonString: active.value
        else: String::init()
    None:
      String::init()

fn string_value(fields: Dict<String, JsonValue>, key: String) -> String
  string_value(fields, key.as_slice())

@access(staged: target)
fn set_optional_string(~target: Dict<String, JsonValue>, key: StringSlice, value: Option<String>) -> void
  match(value)
    Some<String> { value }:
      let _ = target.set(key.to_string(), JsonString { value: value })
    None:
      void

@access(staged: target)
fn set_optional_string(~target: Dict<String, JsonValue>, key: String, value: Option<String>) -> void
  set_optional_string(target, key.as_slice(), value)

fn json_string(value: StringSlice) -> JsonValue
  JsonString { value: value.to_string() }

fn json_string(value: String) -> JsonValue
  JsonString { value: value }
