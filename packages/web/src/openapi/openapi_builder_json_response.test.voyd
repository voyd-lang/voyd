use src::openapi::{ document, info, operation }
use src::openapi::test_types::DocumentedArticle
use src::openapi::automatic::all
use src::openapi::builder_test_helpers::require_contains
use std::http::Method
use std::json::stringify
use std::optional::types::all
use std::result::types::all
use std::string::type::String
use std::test::assertions::all

test "OpenAPI reflects JSON response documentation":
  let route_operation = operation()
    .responds_json<DocumentedArticle>()
  let spec = document(info(
    title: "Article API".as_slice(),
    version: "1.0.0".as_slice(),
    description: "Example API".as_slice().to_string()
  )).route(
    "/articles".as_slice(),
    method: Method::Post {},
    operation: route_operation
  )

  match(stringify(spec.json()))
    Err:
      Test::fail()
    Ok<String> { value }:
      require_contains(value, "Reader-visible article title.".as_slice(), "missing response field documentation")
