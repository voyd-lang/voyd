//! Rendering of deterministic OpenAPI 3.1 documents.

use std::array::Array
use std::dict::Dict
use std::http::method_as_string
use std::json::{ JsonObject, JsonString, JsonValue }
use std::number::cast::to_string
use std::optional::types::all
use std::string::type::{ String, StringSlice }
use super::operation_render::operation_json
use super::types::{ Info, RouteDocument }

pub fn document_json(
  info: Info,
  routes: Array<RouteDocument>,
  { include_doc_comments: bool }
) -> JsonValue
  var paths = Dict<String, JsonValue>::init()
  var components = Dict<String, JsonValue>::init()
  var index = 0
  while index < routes.len():
    let route = routes.at(index)
    if route.operation.hidden:
      index = index + 1
      continue
    let existing = match(paths.get(route.path))
      Some<JsonValue> { value }:
        value.match(active)
          JsonObject: active.value
          else: Dict<String, JsonValue>::init()
      None: Dict<String, JsonValue>::init()
    let rendered_operation = operation_json(
      route.operation,
      prefix: "Operation".concat(to_string(index).as_slice()),
      include_doc_comments: include_doc_comments
    )
    let path_item = existing.setting(
      method_as_string(route.method).lowered(),
      rendered_operation.value
    )
    paths = paths.setting(route.path, JsonObject { value: path_item })
    components = components.merged(rendered_operation.components)
    index = index + 1
  var root = Dict<String, JsonValue>::init()
  root = root.setting("openapi", JsonString { value: "3.1.0".to_string() })
  root = root.setting("info", info_json(info))
  root = root.setting("paths", JsonObject { value: paths })
  if not components.is_empty():
    var component_root = Dict<String, JsonValue>::init()
    component_root = component_root.setting("schemas", JsonObject { value: components })
    root = root.setting("components", JsonObject { value: component_root })
  JsonObject { value: root }

fn info_json(value: Info) -> JsonValue
  var out = Dict<String, JsonValue>::init()
  out = out.setting("title", JsonString { value: value.title })
  out = out.setting("version", JsonString { value: value.version })
  out = setting_optional_string(out, "description", value.description)
  JsonObject { value: out }

fn setting_optional_string(target: Dict<String, JsonValue>, key: StringSlice, value: Option<String>) -> Dict<String, JsonValue>
  match(value)
    Some<String> { value }:
      target.setting(key.to_string(), JsonString { value: value })
    None:
      target

fn setting_optional_string(target: Dict<String, JsonValue>, key: String, value: Option<String>) -> Dict<String, JsonValue>
  setting_optional_string(target, key.as_slice(), value)
