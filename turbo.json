{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": [],
      "env": [
        "VITEST_MAX_WORKERS",
        "VOYD_COMPILER_TEST_SHARD",
        "VOYD_STD_TEST_SHARD",
        "VOYD_TEST_TIMINGS_DIR"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "dev": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
