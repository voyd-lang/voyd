use std::string::type::String
use std::vx::all

pub fn init() -> i32
  0

pub fn step(model: i32, message: i32) -> i32
  model

pub fn view(): Component -> HtmlNode
  let (count, set_count) = state(initial: 0)
  <button on_click={() =>
    set_count(count + 1)
  }>
    Count: {label(count)}
  </button>

fn label(value: i32) -> String
  if
    value == 0: "0"
    value == 1: "1"
    else: "many"
