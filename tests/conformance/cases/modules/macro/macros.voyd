pub macro inc(value)
  syntax_template (+ $value 1.0)

pub attribute macro with_companion(args, declaration)
  if args.length() == 1 then:
    let companion = args.get(0)
    emit_many(
      declaration,
      `(pub fn $companion() -> i32
        39)
    )
  else:
    panic("with_companion expects one argument")
