obj Box {
  value: i32
}

obj Holder {
  value: Box
}

fn mutate(~value: Box) -> void
  value.value = value.value + 1

fn mutate_pair(~left: Box, ~right: Box) -> void
  mutate(~left)
  mutate(~right)

fn retain(~holder: Holder, value: Box) -> void
  holder.value = value

fn view(value: Box) -> borrow Box
  value

fn simultaneous_mutable_aliases(~value: Box) -> void
  mutate_pair(~value, ~value)

fn mutation_after_retaining_ordinary_alias(
  ~value: Box,
  ~holder: Holder
) -> void
  retain(~holder, value)
  mutate(~value)

fn mutation_during_explicit_borrow(~value: Box) -> i32
  let borrowed = view(value)
  mutate(~value)
  borrowed.value

fn extend_local_borrow() -> borrow Box
  let local = Box { value: 1 }
  local
