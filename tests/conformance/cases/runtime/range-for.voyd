use std::random::LocalRng

pub fn range_for_half_open() -> i32
  var total = 0
  for value in 0..5:
    total = total + value
  total

pub fn range_for_inclusive() -> i32
  var total = 0
  for value in 0..=5:
    total = total + value
  total

pub fn range_for_nested() -> i32
  var total = 0
  for y in 0..3:
    for x in 0..3:
      total = total + (x + y)
  total

pub fn range_for_nonzero_negative_and_empty() -> i32
  var total = 0
  for value in -2..2:
    total = total * 10 + value
  for value in 5..2:
    total = total + value * 1000
  for value in 3..3:
    total = total + value * 1000
  total

pub fn range_for_break_and_continue() -> i32
  var total = 0
  for value in 0..10:
    if value == 2:
      continue
    if value == 5:
      break
    total = total + value
  total

pub fn range_for_inclusive_i32_max_stops() -> i32
  var count = 0
  var last = 0
  for value in 2147483647..=2147483647:
    count = count + 1
    last = value
  if count == 1 and last == 2147483647 then: 1 else: 0

obj BoundProbe {
  order: i32,
  evaluations: i32
}

fn record_bound(~probe: BoundProbe, label: i32, value: i32) -> i32
  probe.order = probe.order * 10 + label
  probe.evaluations = probe.evaluations + 1
  value

pub fn range_for_evaluates_bounds_once_in_order() -> i32
  let ~probe = BoundProbe { order: 0, evaluations: 0 }
  var total = 0
  for value in record_bound(~probe, 1, -2)..record_bound(~probe, 2, 2):
    total = total + value
  probe.order * 100 + probe.evaluations * 10 + total

pub fn range_iterator_inclusive_i32_max_stops() -> i32
  let ~iter = (2147483647..=2147483647).iter()

  match(iter.next())
    Some<i32> { value }:
      if value != 2147483647 then:
        return -1
    None:
      return -2

  match(iter.next())
    None:
      1
    Some<i32> { value: _ }:
      0

pub fn range_iterator_retains_prior_values() -> i32
  let ~iter = (3..5).iter()
  let first = iter.next()
  let second = iter.next()

  match(first)
    Some<i32> { value: first_value }:
      match(second)
        Some<i32> { value: second_value }:
          first_value * 10 + second_value
        None:
          -2
    None:
      -1

pub fn range_for_handles_tail_effects_after_host_seed() -> f64
  let ~rng = LocalRng::seeded_from_host()

  try open
    var total = 0.0
    for value in 0..32:
      total = total + RangeForProbe::rand_f64()
    total
  RangeForProbe::rand_f64(tail):
    tail(rng.random_f64())

eff RangeForProbe
  rand_f64(tail) -> f64
