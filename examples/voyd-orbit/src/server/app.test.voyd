use super::app::api_app
use super::repository::{ RepositoryError, SimulationRepository }
use src::shared::{ persisted_simulation, simulation_json }
use src::simulation::default_scenario
use std::array::Array
use std::bytes::{ ByteBuffer, Bytes }
use std::fs::{ Fs, FsResult, FsWriteRequest }
use std::http::{ Body, Headers, IncomingRequest, Method, Response }
use std::json::JsonError
use std::optional::types::all
use std::path::Path
use std::random::Random
use std::result::types::all
use std::shared_cell::SharedCell
use std::string::type::String
use std::test::assertions::all
use std::time::{ Time, TimeResult }

obj MockHost {
  existing: bool,
  list_payload: FsResult<Array<String>>,
  read_payload: FsResult<String>,
  atomic_writes: SharedCell<Array<FsWriteRequest>>,
  exclusive_writes: SharedCell<Array<FsWriteRequest>>
}

test "repository paths are rooted and reject path traversal ids":
  let repository = SimulationRepository::init(Path::new("/srv/orbit/simulations"))
  match(repository.path_for(test_uuid()))
    Err<RepositoryError>:
      assert(false, eq: true)
    Ok<Path> { value }:
      assert(
        value.as_string().equals(
          "/srv/orbit/simulations/00010203-0405-4607-8809-0a0b0c0d0e0f.json"
        ),
        eq: true
      )

  match(repository.path_for("../secrets"))
    Ok<Path>:
      assert(false, eq: true)
    Err<RepositoryError> { error }:
      assert(error.code.equals("invalid-id"), eq: true)

  match(repository.path_for("nested/file"))
    Ok<Path>:
      assert(false, eq: true)
    Err<RepositoryError>:
      assert(true, eq: true)

  match(repository.path_for("00010203-0405-4607-8809-0A0B0C0D0E0F"))
    Ok<Path>:
      assert(false, eq: true)
    Err<RepositoryError> { error }:
      assert(error.code.equals("invalid-id"), eq: true)

test "GET collection returns an empty simulation list":
  let listing = handle(empty_host(), empty_repository(), request(Method::Get {}, "/api/simulations", Body::empty()))
  assert(listing.status.code(), eq: 200)
  assert(response_text(listing).equals("[]"), eq: true)

test "GET missing simulation returns a structured not-found response":
  let missing_path = "/api/simulations/".concat(test_uuid())
  let missing = handle(empty_host(), empty_repository(), request(Method::Get {}, missing_path, Body::empty()))
  assert(missing.status.code(), eq: 404)
  assert(response_text(missing).contains("\"code\":\"not-found\""), eq: true)

test "GET unsafe simulation id returns a structured invalid-id response":
  let unsafe = handle(empty_host(), empty_repository(), request(Method::Get {}, "/api/simulations/bad%2Fid", Body::empty()))
  assert(unsafe.status.code(), eq: 400)
  assert(response_text(unsafe).contains("\"code\":\"invalid-id\""), eq: true)

test "POST malformed JSON returns a structured invalid-json response":
  let malformed = handle(empty_host(), empty_repository(), request(Method::Post {}, "/api/simulations", Body::text("{")))
  assert(malformed.status.code(), eq: 400)
  assert(response_text(malformed).contains("\"code\":\"invalid-json\""), eq: true)

test "POST invalid simulation returns a structured validation response":
  let invalid = handle(
    empty_host(),
    empty_repository(),
    request(
      Method::Post {},
      "/api/simulations",
      Body::text(simulation_json_with_name(String::init()))
    )
  )
  assert(invalid.status.code(), eq: 400)
  assert(response_text(invalid).contains("\"code\":\"invalid-name\""), eq: true)

test "unsupported collection method returns method-not-allowed":
  let wrong_method = handle(empty_host(), empty_repository(), request(Method::Delete {}, "/api/simulations", Body::empty()))
  assert(wrong_method.status.code(), eq: 405)
  assert(response_text(wrong_method).contains("\"code\":\"method-not-allowed\""), eq: true)

test "unknown route returns a structured not-found response":
  let unknown = handle(empty_host(), empty_repository(), request(Method::Get {}, "/api/elsewhere", Body::empty()))
  assert(unknown.status.code(), eq: 404)
  assert(response_text(unknown).contains("\"code\":\"not-found\""), eq: true)

test "POST assigns metadata and uses an exclusive filesystem create":
  let host = empty_host()
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))
  let response = handle(
    host,
    repository,
    request(Method::Post {}, "/api/simulations", Body::text(valid_simulation_json()))
  )

  assert(response.status.code(), eq: 201)
  assert(
    response_text(response).contains(
      "\"id\":\"00010203-0405-4607-8809-0a0b0c0d0e0f\""
    ),
    eq: true
  )
  assert(response_text(response).contains("\"createdAt\":1700000000000"), eq: true)
  assert(host.exclusive_writes.with((writes) => writes.len()), eq: 1)
  assert(host.atomic_writes.with((writes) => writes.len()), eq: 0)

test "a focused open handler overrides exclusive create and forwards the rest":
  let host = empty_host()
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))
  let response = handle_with_create_conflict(
    host,
    repository,
    request(Method::Post {}, "/api/simulations", Body::text(valid_simulation_json()))
  )

  assert(response.status.code(), eq: 500)
  assert(response_text(response).contains("\"code\":\"storage-conflict\""), eq: true)
  assert(host.exclusive_writes.with((writes) => writes.len()), eq: 0)

test "GET PUT and DELETE expose the remaining CRUD status contracts":
  let host = mock_host(
    existing: true,
    list_payload: empty_list_payload(),
    read_payload: fs_ok(valid_simulation_json())
  )
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))

  let item_path = "/api/simulations/".concat(test_uuid())
  let fetched = handle(host, repository, request(Method::Get {}, item_path, Body::empty()))
  assert(fetched.status.code(), eq: 200)
  assert(response_text(fetched).contains("\"id\":\"00010203-0405-4607-8809-0a0b0c0d0e0f\""), eq: true)

  let updated = handle(
    host,
    repository,
    request(
      Method::Put {},
      item_path,
      Body::text(simulation_json_with_name("Renamed orbit"))
    )
  )
  assert(updated.status.code(), eq: 200)
  assert(response_text(updated).contains("\"name\":\"Renamed orbit\""), eq: true)
  assert(host.atomic_writes.with((writes) => writes.len()), eq: 1)
  assert(host.exclusive_writes.with((writes) => writes.len()), eq: 0)

  let deleted = handle(host, repository, request(Method::Delete {}, item_path, Body::empty()))
  assert(deleted.status.code(), eq: 204)
  assert(response_text(deleted).is_empty(), eq: true)

test "a corrupt file is skipped without breaking the simulation list":
  let host = mock_host(
    existing: false,
    list_payload: fs_ok([
      "/memory/simulations/00010203-0405-4607-8809-0a0b0c0d0e0f.json"
    ]),
    read_payload: fs_ok("not-json")
  )
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))
  let response = handle(host, repository, request(Method::Get {}, "/api/simulations", Body::empty()))

  assert(response.status.code(), eq: 200)
  assert(response_text(response).equals("[]"), eq: true)

fn handle(
  host: MockHost,
  repository: SimulationRepository,
  request_value: IncomingRequest
) -> Response
  with_mock_host(host, () => api_app(repository).handle(request_value))

fn handle_with_create_conflict(
  host: MockHost,
  repository: SimulationRepository,
  request_value: IncomingRequest
) -> Response
  with_mock_host(host, () =>
    try open
      api_app(repository).handle(request_value)
    Fs::create_exclusive(tail, _payload):
      tail(fs_error(
        Unit {},
        kind: "already-exists",
        code: 17,
        message: "host EEXIST detail"
      ))
  )

fn with_mock_host<T>(
  host: MockHost,
  work: fn() : (Fs, Random, Time) -> T
) -> T
  try
    work()
  Fs::read_bytes(tail, _path):
    tail(fs_error(ByteBuffer::init().as_bytes(), kind: "other", code: 1, message: "unexpected"))
  Fs::read_string(tail, _path):
    tail(copy_string_result(host.read_payload))
  Fs::write_bytes(tail, _payload):
    tail(fs_error(Unit {}, kind: "other", code: 1, message: "unexpected"))
  Fs::write_string(tail, _payload):
    tail(fs_error(Unit {}, kind: "other", code: 1, message: "unexpected"))
  Fs::exists(tail, _path):
    tail(host.existing)
  Fs::list_dir(tail, _path):
    tail(copy_list_result(host.list_payload))
  Fs::remove(tail, _path):
    tail(fs_ok(Unit {}))
  Fs::create_dir_all(tail, _path):
    tail(fs_ok(Unit {}))
  Fs::rename(tail, _payload):
    tail(fs_error(Unit {}, kind: "other", code: 1, message: "unexpected"))
  Fs::write_atomic(tail, payload):
    host.atomic_writes.with_mut((~writes) => writes.push(payload))
    tail(fs_ok(Unit {}))
  Fs::create_exclusive(tail, payload):
    host.exclusive_writes.with_mut((~writes) => writes.push(payload))
    tail(fs_ok(Unit {}))
  Random::fill_bytes(tail, len):
    tail(deterministic_byte_payload(len))
  Random::next_i64(tail):
    tail(1i64)
  Random::next_u64(tail):
    tail(1i64)
  Time::monotonic_now_millis(tail):
    tail(1700000000000i64)
  Time::system_now_millis(tail):
    tail(1700000000000i64)
  Time::sleep_millis(tail, _millis):
    tail(TimeResult { ok: true, code: 0, message: "" })

fn fs_error<T>(fallback: T, {
  kind: String,
  code: i32,
  message: String
}) -> FsResult<T>
  FsResult<T> {
    ok: false,
    value: fallback,
    error_kind: kind,
    error_code: code,
    error_message: message
  }

fn fs_ok<T>(value: T) -> FsResult<T>
  FsResult<T> {
    ok: true,
    value: value,
    error_kind: "",
    error_code: 0,
    error_message: ""
  }

fn copy_string_result(result: FsResult<String>) -> FsResult<String>
  FsResult<String> {
    ok: result.ok,
    value: result.value,
    error_kind: result.error_kind,
    error_code: result.error_code,
    error_message: result.error_message
  }

fn copy_list_result(result: FsResult<Array<String>>) -> FsResult<Array<String>>
  FsResult<Array<String>> {
    ok: result.ok,
    value: result.value.copied(),
    error_kind: result.error_kind,
    error_code: result.error_code,
    error_message: result.error_message
  }

fn empty_host() -> MockHost
  mock_host(
    existing: false,
    list_payload: empty_list_payload(),
    read_payload: fs_error(String::init(), kind: "other", code: 1, message: "missing")
  )

fn empty_repository() -> SimulationRepository
  SimulationRepository::init(Path::new("/memory/simulations"))

fn mock_host({
  existing: bool,
  list_payload: FsResult<Array<String>>,
  read_payload: FsResult<String>
}) -> MockHost
  MockHost {
    existing,
    list_payload,
    read_payload,
    atomic_writes: SharedCell(Array<FsWriteRequest>::init()),
    exclusive_writes: SharedCell(Array<FsWriteRequest>::init())
  }

fn empty_list_payload() -> FsResult<Array<String>>
  fs_ok(Array<String>::init())

fn request(method: Method, path: String, body: Body) -> IncomingRequest
  IncomingRequest {
    method,
    path,
    query: None {},
    headers: Headers::empty(),
    body
  }

fn valid_simulation_json() -> String
  simulation_json_with_name("Test orbit")

fn simulation_json_with_name(name: String) -> String
  let scenario = default_scenario()
  let value = persisted_simulation(
    id: test_uuid(),
    name: name,
    created_at: 0i64,
    updated_at: 0i64,
    state: {
      bodies: scenario.bodies,
      settings: scenario.settings,
      elapsed_days: 0.0
    },
    camera: scenario.camera
  )
  match(simulation_json(value))
    Ok<String> { value }:
      value
    Err<JsonError>:
      "{}"

fn response_text(response: Response) -> String
  match(response.text())
    Ok<String> { value }:
      value
    Err:
      String::init()

fn test_uuid() -> String
  "00010203-0405-4607-8809-0a0b0c0d0e0f"

fn deterministic_byte_payload(len: i32) -> Bytes
  let ~values = ByteBuffer::with_capacity(len)
  var index = 0
  while index < len:
    values.push(index)
    index = index + 1
  values.as_bytes()
