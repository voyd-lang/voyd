use super::app::api_app
use super::repository::{ RepositoryError, SimulationRepository }
use src::shared::{ persisted_simulation, simulation_json }
use src::simulation::default_scenario
use std::array::Array
use std::fs::Fs
use std::http::{ Body, Headers, IncomingRequest, Method, Response }
use std::json::JsonError
use std::msgpack::MsgPack
use std::msgpack::self as msgpack
use std::optional::types::all
use std::path::Path
use std::random::Random
use std::result::types::all
use std::shared_cell::SharedCell
use std::string::type::String
use std::test::assertions::all
use std::test::host_dto::self as host_dto_test
use std::time::Time

obj MockHost {
  existing: bool,
  list_payload: MsgPack,
  read_payload: MsgPack,
  writes: SharedCell<Array<MsgPack>>,
  renames: SharedCell<Array<MsgPack>>
}

test "repository paths are rooted and reject path traversal ids":
  let repository = SimulationRepository::init(Path::new("/srv/orbit/simulations"))
  match(repository.path_for("alpha-42"))
    Err<RepositoryError>:
      assert(false, eq: true)
    Ok<Path> { value }:
      assert(value.as_string().equals("/srv/orbit/simulations/alpha-42.json"), eq: true)

  match(repository.path_for("../secrets"))
    Ok<Path>:
      assert(false, eq: true)
    Err<RepositoryError> { error }:
      assert(error.code.equals("invalid-id"), eq: true)

  match(repository.path_for("nested/file"))
    Ok<Path>:
      assert(false, eq: true)
    Err<RepositoryError>:
      assert(true, eq: true)

test "REST routes return structured client and routing statuses":
  let host = empty_host()
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))

  let listing = handle(host, repository, request(Method::Get {}, "/api/simulations", Body::empty()))
  assert(listing.status.code(), eq: 200)
  assert(response_text(listing).equals("[]"), eq: true)

  let missing = handle(host, repository, request(Method::Get {}, "/api/simulations/missing", Body::empty()))
  assert(missing.status.code(), eq: 404)
  assert(response_text(missing).contains("\"code\":\"not-found\""), eq: true)

  let unsafe = handle(host, repository, request(Method::Get {}, "/api/simulations/bad%2Fid", Body::empty()))
  assert(unsafe.status.code(), eq: 400)
  assert(response_text(unsafe).contains("\"code\":\"invalid-id\""), eq: true)

  let malformed = handle(host, repository, request(Method::Post {}, "/api/simulations", Body::text("{")))
  assert(malformed.status.code(), eq: 400)
  assert(response_text(malformed).contains("\"code\":\"invalid-json\""), eq: true)

  let invalid = handle(
    host,
    repository,
    request(
      Method::Post {},
      "/api/simulations",
      Body::text(simulation_json_with_name(String::init()))
    )
  )
  assert(invalid.status.code(), eq: 400)
  assert(response_text(invalid).contains("\"code\":\"invalid-name\""), eq: true)

  let wrong_method = handle(host, repository, request(Method::Delete {}, "/api/simulations", Body::empty()))
  assert(wrong_method.status.code(), eq: 405)
  assert(response_text(wrong_method).contains("\"code\":\"method-not-allowed\""), eq: true)

  let unknown = handle(host, repository, request(Method::Get {}, "/api/elsewhere", Body::empty()))
  assert(unknown.status.code(), eq: 404)
  assert(response_text(unknown).contains("\"code\":\"not-found\""), eq: true)

test "POST assigns server metadata and persists through write then rename":
  let host = empty_host()
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))
  let response = handle(
    host,
    repository,
    request(Method::Post {}, "/api/simulations", Body::text(valid_simulation_json()))
  )

  assert(response.status.code(), eq: 201)
  assert(response_text(response).contains("\"id\":\"01010101010101010101010101010101\""), eq: true)
  assert(response_text(response).contains("\"createdAt\":1700000000000"), eq: true)
  assert(host.writes.with((writes) => writes.len()), eq: 1)
  assert(host.renames.with((renames) => renames.len()), eq: 1)

test "GET PUT and DELETE expose the remaining CRUD status contracts":
  let host = mock_host(
    existing: true,
    list_payload: empty_list_payload(),
    read_payload: host_dto_test::host_ok_with_value(
      msgpack::make_string(valid_simulation_json())
    )
  )
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))

  let fetched = handle(host, repository, request(Method::Get {}, "/api/simulations/draft", Body::empty()))
  assert(fetched.status.code(), eq: 200)
  assert(response_text(fetched).contains("\"id\":\"draft\""), eq: true)

  let updated = handle(
    host,
    repository,
    request(
      Method::Put {},
      "/api/simulations/draft",
      Body::text(simulation_json_with_name("Renamed orbit"))
    )
  )
  assert(updated.status.code(), eq: 200)
  assert(response_text(updated).contains("\"name\":\"Renamed orbit\""), eq: true)
  assert(host.writes.with((writes) => writes.len()), eq: 1)
  assert(host.renames.with((renames) => renames.len()), eq: 1)

  let deleted = handle(host, repository, request(Method::Delete {}, "/api/simulations/draft", Body::empty()))
  assert(deleted.status.code(), eq: 204)
  assert(response_text(deleted).is_empty(), eq: true)

test "a corrupt file is skipped without breaking the simulation list":
  let host = mock_host(
    existing: false,
    list_payload: host_dto_test::host_ok_with_value(
      msgpack::make_array([msgpack::make_string("/memory/simulations/broken.json")])
    ),
    read_payload: host_dto_test::host_ok_with_value(msgpack::make_string("not-json"))
  )
  let repository = SimulationRepository::init(Path::new("/memory/simulations"))
  let response = handle(host, repository, request(Method::Get {}, "/api/simulations", Body::empty()))

  assert(response.status.code(), eq: 200)
  assert(response_text(response).equals("[]"), eq: true)

fn handle(
  host: MockHost,
  repository: SimulationRepository,
  request_value: IncomingRequest
) -> Response
  try
    api_app(repository).handle(request_value)
  Fs::read_bytes(tail, _path: MsgPack):
    tail(host_dto_test::host_default_error_payload())
  Fs::read_string(tail, _path: MsgPack):
    tail(host.read_payload)
  Fs::write_bytes(tail, _payload: MsgPack):
    tail(host_dto_test::host_default_error_payload())
  Fs::write_string(tail, payload: MsgPack):
    host.writes.with_mut((~writes) => writes.push(payload))
    tail(host_dto_test::host_ok_payload())
  Fs::exists(tail, _path: MsgPack):
    tail(host.existing)
  Fs::list_dir(tail, _path: MsgPack):
    tail(host.list_payload)
  Fs::remove(tail, _path: MsgPack):
    tail(host_dto_test::host_ok_payload())
  Fs::create_dir_all(tail, _path: MsgPack):
    tail(host_dto_test::host_ok_payload())
  Fs::rename(tail, payload: MsgPack):
    host.renames.with_mut((~renames) => renames.push(payload))
    tail(host_dto_test::host_ok_payload())
  Random::fill_bytes(tail, _len):
    tail(msgpack::make_null())
  Random::next_i64(tail):
    tail(1i64)
  Random::next_u64(tail):
    tail(1i64)
  Time::monotonic_now_millis(tail):
    tail(1700000000000i64)
  Time::system_now_millis(tail):
    tail(1700000000000i64)
  Time::sleep_millis(tail, _millis):
    tail(host_dto_test::host_ok_payload())

fn empty_host() -> MockHost
  mock_host(
    existing: false,
    list_payload: empty_list_payload(),
    read_payload: host_dto_test::host_default_error_payload()
  )

fn mock_host({
  existing: bool,
  list_payload: MsgPack,
  read_payload: MsgPack
}) -> MockHost
  MockHost {
    existing,
    list_payload,
    read_payload,
    writes: SharedCell(Array<MsgPack>::init()),
    renames: SharedCell(Array<MsgPack>::init())
  }

fn empty_list_payload() -> MsgPack
  host_dto_test::host_ok_with_value(msgpack::make_array(Array<MsgPack>::init()))

fn request(method: Method, path: String, body: Body) -> IncomingRequest
  IncomingRequest {
    method,
    path,
    query: None {},
    headers: Headers::empty(),
    body
  }

fn valid_simulation_json() -> String
  simulation_json_with_name("Test orbit")

fn simulation_json_with_name(name: String) -> String
  let scenario = default_scenario()
  let value = persisted_simulation(
    id: "draft",
    name: name,
    created_at: 0i64,
    updated_at: 0i64,
    state: {
      bodies: scenario.bodies,
      settings: scenario.settings,
      elapsed_days: 0.0
    },
    camera: scenario.camera
  )
  match(simulation_json(value))
    Ok<String> { value }:
      value
    Err<JsonError>:
      "{}"

fn response_text(response: Response) -> String
  match(response.text())
    Ok<String> { value }:
      value
    Err:
      String::init()
