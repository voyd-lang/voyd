use std::dict::Dict
use std::msgpack::MsgPack
use std::msgpack::self as msgpack
use std::optional::types::all
use std::result::types::all
use std::test::assertions::all

test "metric labels use deterministic standard number formatting":
  assert(elapsed_label(12.5).equals("12.5 d"), eq: true)
  assert(elapsed_label(730.5).equals("2 yr"), eq: true)

test "saved timestamps use the standard UTC formatter":
  assert(
    saved_timestamp_label(1700000000123i64).equals(
      "Updated 2023-11-14T22:13:20.123Z"
    ),
    eq: true
  )

test "NumberField accepts a natural value property beside JSX value":
  let _field = NumberField(
    label: "X",
    unit: "AU",
    value: 1.25,
    busy: false,
    changed: (value: String) -> Msg => Msg::BodyPositionXChanged { value }
  )
  assert(true, eq: true)

test "scenario options encode JSX value and selection as stable attributes":
  let scenario = built_in_scenarios().at(0)
  match(msgpack::unpack_map(ScenarioOption(scenario: scenario, selected: true)))
    Err:
      assert(false, eq: true)
    Ok<Dict<String, MsgPack>> { value: option }:
      match(option.get("attrs"))
        None:
          assert(false, eq: true)
        Some<MsgPack> { value: attributes }:
          match(msgpack::unpack_map(attributes))
            Err:
              assert(false, eq: true)
            Ok<Dict<String, MsgPack>> { value: attrs }:
              match(attrs.get("value"))
                None:
                  assert(false, eq: true)
                Some<MsgPack> { value }:
                  match(msgpack::unpack_string(value))
                    Err:
                      assert(false, eq: true)
                    Ok<String> { value }:
                      assert(value.equals(scenario.slug), eq: true)
              match(attrs.get("selected"))
                None:
                  assert(false, eq: true)
                Some<MsgPack> { value }:
                  match(msgpack::unpack_bool(value))
                    Err:
                      assert(false, eq: true)
                    Ok<bool> { value }:
                      assert(value, eq: true)
