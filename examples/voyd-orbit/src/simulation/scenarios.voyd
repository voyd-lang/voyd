pub fn slingshot() -> BuiltInScenario
  let sun = make_body(
    id: "slingshot-sun",
    name: "Solis",
    kind: BodyKind::Star {},
    mass_solar: 1.0,
    radius_au: 0.00465,
    position_au: Vec2::zero(),
    velocity_au_per_day: Vec2::zero(),
    appearance: make_appearance(
      primary_color: "#fff5c9",
      secondary_color: "#ffae45",
      trail_color: "#ffcf76",
      glow_strength: 1.0
    )
  )
  let giant = orbiting_body(
    id: "atlas",
    name: "Atlas",
    kind: BodyKind::Planet {},
    mass_solar: 0.00125,
    radius_au: 0.00054,
    orbit_radius_au: 1.35,
    angle_radians: 0.0,
    central_position_au: sun.position_au,
    central_velocity_au_per_day: sun.velocity_au_per_day,
    central_mass_solar: sun.mass_solar,
    clockwise: false,
    appearance: make_appearance(
      primary_color: "#e7b77e",
      secondary_color: "#794c59",
      trail_color: "#d49a73",
      glow_strength: 0.03
    )
  )
  let messenger = make_body(
    id: "messenger",
    name: "Messenger",
    kind: BodyKind::Asteroid {},
    mass_solar: 0.0000000000008,
    radius_au: 0.0000022,
    position_au: Vec2::init(-2.8, -0.72),
    velocity_au_per_day: Vec2::init(0.021, 0.0043),
    appearance: make_appearance(
      primary_color: "#e7f6ff",
      secondary_color: "#7595ad",
      trail_color: "#b8edff",
      glow_strength: 0.08
    )
  )
  make_scenario(
    key: ScenarioKey::Slingshot {},
    slug: "slingshot",
    name: "The Messenger",
    description: "A fast visitor dives through a giant planet's moving gravity well.",
    bodies: [sun, giant, messenger],
    settings: settings(timestep_days: 0.025, softening_au: 0.00025),
    camera: camera(center_au: Vec2::init(-0.55, 0.0), pixels_per_au: 155.0)
  )

pub fn asteroid_belt() -> BuiltInScenario
  let sun = make_body(
    id: "forge",
    name: "Forge",
    kind: BodyKind::Star {},
    mass_solar: 1.05,
    radius_au: 0.0048,
    position_au: Vec2::zero(),
    velocity_au_per_day: Vec2::zero(),
    appearance: make_appearance(
      primary_color: "#fff1b5",
      secondary_color: "#ff8d3d",
      trail_color: "#ffc267",
      glow_strength: 1.0
    )
  )
  let sentinel = orbiting_body(
    id: "sentinel",
    name: "Sentinel",
    kind: BodyKind::Planet {},
    mass_solar: 0.00063,
    radius_au: 0.00036,
    orbit_radius_au: 3.65,
    angle_radians: 1.82,
    central_position_au: sun.position_au,
    central_velocity_au_per_day: sun.velocity_au_per_day,
    central_mass_solar: sun.mass_solar,
    clockwise: false,
    appearance: make_appearance(
      primary_color: "#77a8c3",
      secondary_color: "#31546f",
      trail_color: "#6f9eb8",
      glow_strength: 0.02
    )
  )
  let ~bodies: Array<Body> = [sun, sentinel]
  var index = 0
  while index < 48:
    let band = to_f64(index % 11)
    let orbit_radius_au = 1.55 + (band * 0.072)
    let angle = (to_f64(index) * 2.399963229728653) + (band * 0.013)
    let radial = Vec2::init(cos(angle), sin(angle))
    let tangent = radial.perpendicular()
    let jitter = (to_f64((index * 7) % 9) - 4.0) * 0.000004
    bodies.push(make_body(
      id: "rock-".concat(to_string(index)),
      name: "Belt object ".concat(to_string(index + 1)),
      kind: BodyKind::Asteroid {},
      mass_solar: 0.00000000000015 + (to_f64(index % 5) * 0.00000000000004),
      radius_au: 0.0000015 + (to_f64(index % 4) * 0.00000035),
      position_au: radial * orbit_radius_au,
      velocity_au_per_day: (tangent * circular_speed(sun.mass_solar, orbit_radius_au)) +
        (radial * jitter),
      appearance: make_appearance(
        primary_color: asteroid_primary(index),
        secondary_color: "#4c4948",
        trail_color: "#918b83",
        glow_strength: 0.0
      )
    ))
    index = index + 1
  make_scenario(
    key: ScenarioKey::AsteroidBelt {},
    slug: "asteroid-belt",
    name: "Forge Belt",
    description: "Forty-eight deterministic minor worlds form a living ring around Forge.",
    bodies: bodies,
    settings: settings(timestep_days: 0.15, softening_au: 0.00008),
    camera: camera(center_au: Vec2::zero(), pixels_per_au: 102.0)
  )

pub fn black_hole_flyby() -> BuiltInScenario
  let abyss = make_body(
    id: "abyss",
    name: "Abyss",
    kind: BodyKind::BlackHole {},
    mass_solar: 4.8,
    radius_au: 0.00014,
    position_au: Vec2::init(0.35, 0.0),
    velocity_au_per_day: Vec2::init(0.0, -0.00025),
    appearance: make_appearance(
      primary_color: "#090b16",
      secondary_color: "#f5a65b",
      trail_color: "#7d6ac7",
      glow_strength: 0.72
    )
  )
  let wanderer = make_body(
    id: "wanderer",
    name: "Wanderer",
    kind: BodyKind::Star {},
    mass_solar: 0.72,
    radius_au: 0.0038,
    position_au: Vec2::init(-4.2, -1.05),
    velocity_au_per_day: Vec2::init(0.0315, 0.0068),
    appearance: make_appearance(
      primary_color: "#dceeff",
      secondary_color: "#6f92e8",
      trail_color: "#93b8ff",
      glow_strength: 0.9
    )
  )
  let pilgrim = orbiting_body(
    id: "pilgrim",
    name: "Pilgrim",
    kind: BodyKind::Planet {},
    mass_solar: 0.0000025,
    radius_au: 0.000039,
    orbit_radius_au: 0.42,
    angle_radians: 2.4,
    central_position_au: wanderer.position_au,
    central_velocity_au_per_day: wanderer.velocity_au_per_day,
    central_mass_solar: wanderer.mass_solar,
    clockwise: true,
    appearance: make_appearance(
      primary_color: "#8bc5aa",
      secondary_color: "#315d5c",
      trail_color: "#71b09b",
      glow_strength: 0.02
    )
  )
  make_scenario(
    key: ScenarioKey::BlackHoleFlyby {},
    slug: "black-hole-flyby",
    name: "Abyss Flyby",
    description: "A star and its planet enter a close hyperbolic encounter with a black hole.",
    bodies: [abyss, wanderer, pilgrim],
    settings: settings(timestep_days: 0.018, softening_au: 0.0025),
    camera: camera(center_au: Vec2::init(-1.1, -0.25), pixels_per_au: 115.0)
  )

fn orbiting_body(
  {
    id: String,
    name: String,
    kind: BodyKind,
    mass_solar: f64,
    radius_au: f64,
    orbit_radius_au: f64,
    angle_radians: f64,
    central_position_au: Vec2,
    central_velocity_au_per_day: Vec2,
    central_mass_solar: f64,
    clockwise: bool,
    appearance: BodyAppearance
  }
) -> Body
  let radial_direction = Vec2::init(cos(angle_radians), sin(angle_radians))
  let tangent_direction = radial_direction.perpendicular()
  let signed_tangent = if clockwise then: tangent_direction * -1.0 else: tangent_direction
  make_body(
    id: id,
    name: name,
    kind: kind,
    mass_solar: mass_solar,
    radius_au: radius_au,
    position_au: central_position_au + (radial_direction * orbit_radius_au),
    velocity_au_per_day: central_velocity_au_per_day +
      (signed_tangent * circular_speed(central_mass_solar, orbit_radius_au)),
    appearance: appearance
  )

fn circular_speed(central_mass_solar: f64, orbit_radius_au: f64) -> f64
  sqrt(GRAVITATIONAL_CONSTANT_AU3_PER_SOLAR_MASS_DAY2 * central_mass_solar / orbit_radius_au)

fn make_body(
  {
    id: String,
    name: String,
    kind: BodyKind,
    mass_solar: f64,
    radius_au: f64,
    position_au: Vec2,
    velocity_au_per_day: Vec2,
    appearance: BodyAppearance
  }
) -> Body
  {
    id: id,
    name: name,
    kind: kind,
    mass_solar: mass_solar,
    radius_au: radius_au,
    position_au: position_au,
    velocity_au_per_day: velocity_au_per_day,
    appearance: appearance
  }

fn make_appearance(
  {
    primary_color: String,
    secondary_color: String,
    trail_color: String,
    glow_strength: f64
  }
) -> BodyAppearance
  {
    primary_color: primary_color,
    secondary_color: secondary_color,
    trail_color: trail_color,
    glow_strength: glow_strength
  }

fn settings({ timestep_days: f64, softening_au: f64 }) -> SimulationSettings
  let defaults = default_settings()
  {
    fixed_timestep_days: timestep_days,
    softening_au: softening_au,
    trails_enabled: defaults.trails_enabled,
    velocity_vectors_enabled: defaults.velocity_vectors_enabled,
    labels_enabled: defaults.labels_enabled
  }

fn camera({ center_au: Vec2, pixels_per_au: f64 }) -> CameraView
  { center_au: center_au, pixels_per_au: pixels_per_au }

fn make_scenario(
  {
    key: ScenarioKey,
    slug: String,
    name: String,
    description: String,
    bodies: Array<Body>,
    settings: SimulationSettings,
    camera: CameraView
  }
) -> BuiltInScenario
  {
    key: key,
    slug: slug,
    name: name,
    description: description,
    bodies: bodies,
    settings: settings,
    camera: camera
  }

fn asteroid_primary(index: i32) -> String
  if index % 3 == 0:
    return "#b9a38e"
  if index % 3 == 1:
    return "#8f9aa3"
  "#c28368"
