pub fn binary_star() -> BuiltInScenario
  let primary_mass = 1.0
  let companion_mass = 0.78
  let separation_au = 1.6
  let total_mass = primary_mass + companion_mass
  let relative_speed = circular_speed(total_mass, separation_au)
  let primary = make_body(
    id: "vesper-a",
    name: "Vesper A",
    kind: BodyKind::Star {},
    mass_solar: primary_mass,
    radius_au: 0.00465,
    position_au: Vec2::init(0.0 - (separation_au * companion_mass / total_mass), 0.0),
    velocity_au_per_day: Vec2::init(0.0, relative_speed * companion_mass / total_mass),
    appearance: make_appearance(
      primary_color: "#fff2bc",
      secondary_color: "#ff9b42",
      trail_color: "#ffd27c",
      glow_strength: 1.0
    )
  )
  let companion = make_body(
    id: "vesper-b",
    name: "Vesper B",
    kind: BodyKind::Star {},
    mass_solar: companion_mass,
    radius_au: 0.0039,
    position_au: Vec2::init(separation_au * primary_mass / total_mass, 0.0),
    velocity_au_per_day: Vec2::init(0.0, 0.0 - (relative_speed * primary_mass / total_mass)),
    appearance: make_appearance(
      primary_color: "#dff2ff",
      secondary_color: "#6ba5ff",
      trail_color: "#8fc5ff",
      glow_strength: 0.92
    )
  )
  let circumbinary = orbiting_body(
    id: "far-harbor",
    name: "Far Harbor",
    kind: BodyKind::Planet {},
    mass_solar: 0.00043,
    radius_au: 0.00027,
    orbit_radius_au: 4.1,
    angle_radians: 1.1,
    central_position_au: Vec2::zero(),
    central_velocity_au_per_day: Vec2::zero(),
    central_mass_solar: total_mass,
    clockwise: false,
    appearance: make_appearance(
      primary_color: "#b7d6bc",
      secondary_color: "#426e69",
      trail_color: "#87b69e",
      glow_strength: 0.02
    )
  )
  make_scenario(
    key: ScenarioKey::BinaryStar {},
    slug: "binary-star",
    name: "Vesper Binary",
    description: "Two suns orbit a shared barycenter while a distant world circles both.",
    bodies: [primary, companion, circumbinary],
    settings: settings(timestep_days: 0.075, softening_au: 0.00008),
    camera: camera(center_au: Vec2::zero(), pixels_per_au: 92.0)
  )

pub fn three_body_chaos() -> BuiltInScenario
  let velocity = 0.0061
  let ember = make_body(
    id: "ember",
    name: "Ember",
    kind: BodyKind::Star {},
    mass_solar: 1.0,
    radius_au: 0.0045,
    position_au: Vec2::init(-0.85, -0.45),
    velocity_au_per_day: Vec2::init(velocity, -0.002),
    appearance: make_appearance(
      primary_color: "#ffd09a",
      secondary_color: "#ff694f",
      trail_color: "#ff9670",
      glow_strength: 1.0
    )
  )
  let cobalt = make_body(
    id: "cobalt",
