    velocity_au_per_day: Vec2::init(-0.0055, -0.0025),
    appearance: make_appearance(
      primary_color: "#d9eeff",
      secondary_color: "#5d8dff",
      trail_color: "#8fb3ff",
      glow_strength: 0.93
    )
  )
  let rose = make_body(
    id: "rose",
    name: "Rose",
    kind: BodyKind::Star {},
    mass_solar: 0.73,
    radius_au: 0.0037,
    position_au: Vec2::init(-0.05, 0.92),
