//! Curated deterministic starting systems for Voyd Orbit.

use super::types::{
  Body,
  BodyAppearance,
  BodyKind,
  BuiltInScenario,
  CameraView,
  ScenarioKey,
  SimulationSettings
}
use super::engine::{
  GRAVITATIONAL_CONSTANT_AU3_PER_SOLAR_MASS_DAY2,
  default_settings
}
use super::vector::Vec2
use std::array::Array
use std::math::{ cos, sqrt, sin }
use std::number::cast::{ to_f64, to_string }
use std::string::type::String

pub fn built_in_scenarios() -> Array<BuiltInScenario>
  [
    stable_planetary_system(),
    binary_star(),
    three_body_chaos(),
    slingshot(),
    asteroid_belt(),
    black_hole_flyby()
  ]

pub fn default_scenario() -> BuiltInScenario
  stable_planetary_system()

