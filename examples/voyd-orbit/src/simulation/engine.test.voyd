use super::engine::{
  GRAVITATIONAL_CONSTANT_AU3_PER_SOLAR_MASS_DAY2,
  gravitational_acceleration,
  integrate,
  total_energy,
  total_momentum
}
use super::scenarios::{ built_in_scenarios, default_scenario }
use super::vector::{ Vec2, distance, lerp }
use super::types::{ Body, BodyKind }
use std::array::Array
use std::math::{ abs, sqrt }
use std::string::type::String
use std::test::assertions::all
use std::test::numeric::assert_close

test "Vec2 operations compose without losing value semantics":
  let first = Vec2::init(3.0, 4.0)
  let second = Vec2::init(-1.0, 2.0)
  let sum = first + second
  let difference = first - second
  assert_close(sum.x, to: 2.0, absolute: 0.000000000001, relative: 0.0, message: "sum.x")
  assert_close(sum.y, to: 6.0, absolute: 0.000000000001, relative: 0.0, message: "sum.y")
  assert_close(difference.x, to: 4.0, absolute: 0.000000000001, relative: 0.0, message: "difference.x")
  assert_close(first.length(), to: 5.0, absolute: 0.000000000001, relative: 0.0, message: "vector length")
  assert_close(first.dot(second), to: 5.0, absolute: 0.000000000001, relative: 0.0, message: "dot product")
  assert_close(distance(first, second), to: sqrt(20.0), absolute: 0.000000000001, relative: 0.0, message: "distance")
  let midpoint = lerp(first, to: second, at: 0.5)
  assert_close(midpoint.x, to: 1.0, absolute: 0.000000000001, relative: 0.0, message: "midpoint.x")
  assert_close(midpoint.y, to: 3.0, absolute: 0.000000000001, relative: 0.0, message: "midpoint.y")

test "gravity points toward the source with the expected AU-day magnitude":
  let acceleration = gravitational_acceleration(
    Vec2::init(1.0, 0.0),
    toward: Vec2::zero(),
    source_mass_solar: 1.0,
    softening_au: 0.0
  )
  assert_close(
    acceleration.x,
    to: 0.0 - GRAVITATIONAL_CONSTANT_AU3_PER_SOLAR_MASS_DAY2,
    absolute: 0.000000000000001,
    relative: 0.0,
    message: "gravity x acceleration"
  )
  assert_close(
    acceleration.y,
    to: 0.0,
    absolute: 0.000000000000001,
    relative: 0.0,
    message: "gravity y acceleration"
  )
  let coincident = gravitational_acceleration(
    Vec2::zero(),
    toward: Vec2::zero(),
    source_mass_solar: 1.0,
    softening_au: 0.0001
  )
  assert(coincident.length_squared(), eq: 0.0)

test "velocity Verlet preserves inertial motion for an isolated body":
  let initial = test_body(
    id: "drifter",
    mass_solar: 0.000001,
    position_au: Vec2::init(-1.0, 2.0),
    velocity_au_per_day: Vec2::init(0.25, -0.125)
  )
  let next = integrate([initial], timestep_days: 2.0, softening_au: 0.0001).at(0)
  assert_close(next.position_au.x, to: -0.5, absolute: 0.000000000001, relative: 0.0, message: "inertial position.x")
  assert_close(next.position_au.y, to: 1.75, absolute: 0.000000000001, relative: 0.0, message: "inertial position.y")
  assert_close(next.velocity_au_per_day.x, to: 0.25, absolute: 0.000000000001, relative: 0.0, message: "inertial velocity.x")
  assert_close(next.velocity_au_per_day.y, to: -0.125, absolute: 0.000000000001, relative: 0.0, message: "inertial velocity.y")

test "a symmetric orbit conserves momentum and bounded energy":
  let relative_speed = sqrt(2.0 * GRAVITATIONAL_CONSTANT_AU3_PER_SOLAR_MASS_DAY2)
  let left = test_body(
    id: "left",
    mass_solar: 1.0,
    position_au: Vec2::init(-0.5, 0.0),
    velocity_au_per_day: Vec2::init(0.0, 0.5 * relative_speed)
  )
  let right = test_body(
    id: "right",
    mass_solar: 1.0,
    position_au: Vec2::init(0.5, 0.0),
    velocity_au_per_day: Vec2::init(0.0, -0.5 * relative_speed)
  )
  let softening_au = 0.00001
  let initial: Array<Body> = [left, right]
  let initial_momentum = total_momentum(initial)
  let initial_energy = total_energy(initial, softening_au: softening_au)
  var evolved = initial
  var index = 0
  while index < 1200:
    evolved = integrate(evolved, timestep_days: 0.05, softening_au: softening_au)
    index = index + 1
  let momentum_drift = (total_momentum(evolved) - initial_momentum).length()
  let energy_drift = abs(total_energy(evolved, softening_au: softening_au) - initial_energy)
  assert_close(
    momentum_drift,
    to: 0.0,
    absolute: 0.000000000001,
    relative: 0.0,
    message: "symmetric orbit momentum drift"
  )
  assert_close(
    energy_drift,
    to: 0.0,
    absolute: 0.000000001,
    relative: 0.0,
    message: "symmetric orbit energy drift"
  )

test "the curated catalogue exposes all six scenarios":
  assert(built_in_scenarios().len(), eq: 6)
  assert(default_scenario().bodies.len() >= 6, eq: true)

fn test_body(
  {
    id: String,
    mass_solar: f64,
    position_au: Vec2,
    velocity_au_per_day: Vec2
  }
) -> Body
  {
    id: id,
    name: id,
    kind: BodyKind::Planet {},
    mass_solar: mass_solar,
    radius_au: 0.00001,
    position_au: position_au,
    velocity_au_per_day: velocity_au_per_day,
    appearance: {
      primary_color: "#ffffff",
      secondary_color: "#888888",
      trail_color: "#ffffff",
      glow_strength: 0.0
    }
  }
