//! Small value-semantic vector primitives used by the simulation and renderer.
//! Coordinates are unitless here; domain types name their units at field boundaries.

use std::math::{ sqrt }

pub val Vec2 {
  api x: f64,
  api y: f64
}

impl Vec2
  api fn init(x: f64, y: f64) -> Vec2
    Vec2 { x, y }

  api fn '+'(self, other: Vec2) -> Vec2
    Vec2 { x: self.x + other.x, y: self.y + other.y }

  api fn '-'(self, other: Vec2) -> Vec2
    Vec2 { x: self.x - other.x, y: self.y - other.y }

  api fn '*'(self, scalar: f64) -> Vec2
    Vec2 { x: self.x * scalar, y: self.y * scalar }

  api fn '/'(self, scalar: f64) -> Vec2
    Vec2 { x: self.x / scalar, y: self.y / scalar }

  api fn dot(self, other: Vec2) -> f64
    (self.x * other.x) + (self.y * other.y)

  api fn length_squared(self) -> f64
    self.dot(self)

  api fn length(self) -> f64
    sqrt(self.length_squared())

  api fn normalized_or_zero(self) -> Vec2
    let magnitude = self.length()
    if magnitude <= 0.0 then: Vec2::zero() else: self / magnitude

  api fn perpendicular(self) -> Vec2
    Vec2 { x: 0.0 - self.y, y: self.x }

  api fn zero() -> Vec2
    Vec2 { x: 0.0, y: 0.0 }

pub fn '*'(scalar: f64, vector: Vec2) -> Vec2
  vector * scalar

pub fn distance(left: Vec2, right: Vec2) -> f64
  (right - left).length()

pub fn lerp(start: Vec2, { to end: Vec2, at t: f64 }) -> Vec2
  start + ((end - start) * t)
