//! Versioned, human-readable persistence model and explicit JSON codecs.
//!
//! The same code is compiled into the browser and server programs. Keeping the
//! codec here makes the wire format a real shared contract rather than a host
//! implementation detail.

use src::simulation::{
  Body,
  BodyAppearance,
  BodyKind,
  CameraView,
  SimulationSettings,
  SimulationState,
  Vec2
}
use std::array::Array
use std::dict::Dict
use std::json::{
  JsonArray,
  JsonBool,
  JsonDecodeError,
  JsonSchemaFailure,
  JsonVersionFailure,
  JsonError,
  JsonNumber,
  JsonObject,
  JsonString,
  JsonValue,
  decode as decode_json,
  decode_versioned,
  stringify as stringify_json,
  stringify_pretty as stringify_json_pretty
}
use std::number::cast::self as number_cast
use std::number::cast::to_f64
use std::optional::types::all
use std::result::types::all
use std::string::type::String

pub type PersistedSimulation = {
  version: i32,
  id: String,
  name: String,
  created_at: i64,
  updated_at: i64,
  state: SimulationState,
  camera: CameraView
}

pub type SimulationSummary = {
  id: String,
  name: String,
  created_at: i64,
  updated_at: i64,
  body_count: i32
}

pub type ApiError = {
  code: String,
  message: String
}

type VectorDocumentV1 = {
  x: f64,
  y: f64
}

type AppearanceDocumentV1 = {
  primaryColor: String,
  secondaryColor: String,
  trailColor: String,
  glowStrength: f64
}

type BodyDocumentV1 = {
  id: String,
  name: String,
  kind: String,
  massSolar: f64,
  radiusAu: f64,
  positionAu: VectorDocumentV1,
  velocityAuPerDay: VectorDocumentV1,
  appearance: AppearanceDocumentV1
}

type SettingsDocumentV1 = {
  fixedTimestepDays: f64,
  softeningAu: f64,
  trailsEnabled: bool,
  velocityVectorsEnabled: bool,
  labelsEnabled: bool
}

type CameraDocumentV1 = {
  centerAu: VectorDocumentV1,
  pixelsPerAu: f64
}

type SimulationDocumentV1 = {
  version: i32,
  id: String,
  name: String,
  createdAt: i64,
  updatedAt: i64,
  bodies: Array<BodyDocumentV1>,
  simulationSettings: SettingsDocumentV1,
  elapsedDays: f64,
  camera: CameraDocumentV1
}

type SummaryDocumentV1 = {
  id: String,
  name: String,
  createdAt: i64,
  updatedAt: i64,
  bodyCount: i32
}

pub fn persistence_version() -> i32
  1

pub fn persisted_simulation({
  id: String,
  name: String,
  created_at: i64,
  updated_at: i64,
  state: SimulationState,
  camera: CameraView
}) -> PersistedSimulation
  {
    version: persistence_version(),
    id,
    name,
    created_at,
    updated_at,
    state,
    camera
  }

pub fn simulation_summary(value: PersistedSimulation) -> SimulationSummary
  {
    id: value.id,
    name: value.name,
    created_at: value.created_at,
    updated_at: value.updated_at,
    body_count: value.state.bodies.len()
  }

pub fn simulation_json(value: PersistedSimulation) -> Result<String, JsonError>
  stringify_json(simulation_json_value(value))

pub fn simulation_json_pretty(value: PersistedSimulation) -> Result<String, JsonError>
  stringify_json_pretty(simulation_json_value(value))

pub fn simulation_from_json(source: String) -> Result<PersistedSimulation, JsonDecodeError>
  match(decode_versioned<SimulationDocumentV1>(
    source,
    current: persistence_version(),
    migrate: reject_unknown_simulation_version
  ))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<SimulationDocumentV1> { value }:
      simulation_from_document(value)

pub fn simulation_from_json_value(value: JsonValue) -> Result<PersistedSimulation, JsonDecodeError>
  match(decode_versioned<SimulationDocumentV1>(
    value,
    current: persistence_version(),
    migrate: reject_unknown_simulation_version
  ))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<SimulationDocumentV1> { value }:
      simulation_from_document(value)

pub fn summaries_json(values: Array<SimulationSummary>) -> Result<String, JsonError>
  stringify_json(JsonArray {
    value: values.map((value: SimulationSummary) -> JsonValue => summary_json_value(value))
  })

pub fn summaries_from_json(source: String) -> Result<Array<SimulationSummary>, JsonDecodeError>
  match(decode_json<Array<SummaryDocumentV1>>(source))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<Array<SummaryDocumentV1>> { value }:
      Ok<Array<SimulationSummary>> {
        value: value.map((document: SummaryDocumentV1) -> SimulationSummary => {
          id: document.id,
          name: document.name,
          created_at: document.createdAt,
          updated_at: document.updatedAt,
          body_count: document.bodyCount
        })
      }

pub fn api_error_json(error: ApiError) -> Result<String, JsonError>
  stringify_json(api_error_json_value(error))

pub fn api_error_from_json(source: String) -> Result<ApiError, JsonDecodeError>
  decode_json<ApiError>(source)

pub fn kind_name(kind: BodyKind) -> String
  match(kind)
    BodyKind::Star:
      "star"
    BodyKind::Planet:
      "planet"
    BodyKind::Moon:
      "moon"
    BodyKind::Asteroid:
      "asteroid"
    BodyKind::BlackHole:
      "black-hole"

pub fn kind_from_name(value: String) -> Option<BodyKind>
  let normalized = value.trimmed().lowered()
  if normalized == "star":
    return Some<BodyKind> { value: BodyKind::Star {} }
  if normalized == "planet":
    return Some<BodyKind> { value: BodyKind::Planet {} }
  if normalized == "moon":
    return Some<BodyKind> { value: BodyKind::Moon {} }
  if normalized == "asteroid":
    return Some<BodyKind> { value: BodyKind::Asteroid {} }
  if normalized == "black-hole":
    return Some<BodyKind> { value: BodyKind::BlackHole {} }
  None {}

fn simulation_from_document(
  document: SimulationDocumentV1
) -> Result<PersistedSimulation, JsonDecodeError>
  match(bodies_from_document(document.bodies))
    Err<JsonDecodeError> { error }:
      Err<JsonDecodeError> { error }
    Ok<Array<Body>> { value: bodies }:
      Ok<PersistedSimulation> {
        value: {
          version: document.version,
          id: document.id,
          name: document.name,
          created_at: document.createdAt,
          updated_at: document.updatedAt,
          state: {
            bodies,
            settings: {
              fixed_timestep_days: document.simulationSettings.fixedTimestepDays,
              softening_au: document.simulationSettings.softeningAu,
              trails_enabled: document.simulationSettings.trailsEnabled,
              velocity_vectors_enabled: document.simulationSettings.velocityVectorsEnabled,
              labels_enabled: document.simulationSettings.labelsEnabled
            },
            elapsed_days: document.elapsedDays
          },
          camera: {
            center_au: vector_from_document(document.camera.centerAu),
            pixels_per_au: document.camera.pixelsPerAu
          }
        }
      }

fn simulation_json_value(value: PersistedSimulation) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("version", JsonNumber { value: to_f64(value.version) })
  fields = fields.setting("id", JsonString { value: value.id })
  fields = fields.setting("name", JsonString { value: value.name })
  fields = fields.setting("createdAt", JsonNumber { value: to_f64(value.created_at) })
  fields = fields.setting("updatedAt", JsonNumber { value: to_f64(value.updated_at) })
  fields = fields.setting("bodies", JsonArray {
    value: value.state.bodies.map((body: Body) -> JsonValue => body_json_value(body))
  })
  fields = fields.setting("simulationSettings", settings_json_value(value.state.settings))
  fields = fields.setting("elapsedDays", JsonNumber { value: value.state.elapsed_days })
  fields = fields.setting("camera", camera_json_value(value.camera))
  JsonObject { value: fields }

fn body_json_value(body: Body) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("id", JsonString { value: body.id })
  fields = fields.setting("name", JsonString { value: body.name })
  fields = fields.setting("kind", JsonString { value: kind_name(body.kind) })
  fields = fields.setting("massSolar", JsonNumber { value: body.mass_solar })
  fields = fields.setting("radiusAu", JsonNumber { value: body.radius_au })
  fields = fields.setting("positionAu", vector_json_value(body.position_au))
  fields = fields.setting("velocityAuPerDay", vector_json_value(body.velocity_au_per_day))
  fields = fields.setting("appearance", appearance_json_value(body.appearance))
  JsonObject { value: fields }

fn appearance_json_value(value: BodyAppearance) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("primaryColor", JsonString { value: value.primary_color })
  fields = fields.setting("secondaryColor", JsonString { value: value.secondary_color })
  fields = fields.setting("trailColor", JsonString { value: value.trail_color })
  fields = fields.setting("glowStrength", JsonNumber { value: value.glow_strength })
  JsonObject { value: fields }

fn vector_json_value(value: Vec2) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("x", JsonNumber { value: value.x })
  fields = fields.setting("y", JsonNumber { value: value.y })
  JsonObject { value: fields }

fn settings_json_value(value: SimulationSettings) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("fixedTimestepDays", JsonNumber { value: value.fixed_timestep_days })
  fields = fields.setting("softeningAu", JsonNumber { value: value.softening_au })
  fields = fields.setting("trailsEnabled", JsonBool { value: value.trails_enabled })
  fields = fields.setting("velocityVectorsEnabled", JsonBool { value: value.velocity_vectors_enabled })
  fields = fields.setting("labelsEnabled", JsonBool { value: value.labels_enabled })
  JsonObject { value: fields }

fn camera_json_value(value: CameraView) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("centerAu", vector_json_value(value.center_au))
  fields = fields.setting("pixelsPerAu", JsonNumber { value: value.pixels_per_au })
  JsonObject { value: fields }

fn summary_json_value(value: SimulationSummary) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("id", JsonString { value: value.id })
  fields = fields.setting("name", JsonString { value: value.name })
  fields = fields.setting("createdAt", JsonNumber { value: to_f64(value.created_at) })
  fields = fields.setting("updatedAt", JsonNumber { value: to_f64(value.updated_at) })
  fields = fields.setting("bodyCount", JsonNumber { value: to_f64(value.body_count) })
  JsonObject { value: fields }

fn api_error_json_value(value: ApiError) -> JsonValue
  var fields = Dict<String, JsonValue>::init()
  fields = fields.setting("code", JsonString { value: value.code })
  fields = fields.setting("message", JsonString { value: value.message })
  JsonObject { value: fields }

fn bodies_from_document(
  documents: Array<BodyDocumentV1>
) -> Result<Array<Body>, JsonDecodeError>
  let ~bodies = Array<Body>::with_capacity(documents.len())
  var index = 0
  while index < documents.len():
    let document = documents.at(index)
    match(kind_from_name(document.kind))
      None:
        return schema_error<Array<Body>>(
          "$.bodies[".concat(number_cast::to_string(index)).concat("].kind"),
          "unknown body kind"
        )
      Some<BodyKind> { value: kind }:
        bodies.push({
          id: document.id,
          name: document.name,
          kind,
          mass_solar: document.massSolar,
          radius_au: document.radiusAu,
          position_au: vector_from_document(document.positionAu),
          velocity_au_per_day: vector_from_document(document.velocityAuPerDay),
          appearance: {
            primary_color: document.appearance.primaryColor,
            secondary_color: document.appearance.secondaryColor,
            trail_color: document.appearance.trailColor,
            glow_strength: document.appearance.glowStrength
          }
        })
    index = index + 1
  Ok<Array<Body>> { value: bodies }

fn vector_from_document(document: VectorDocumentV1) -> Vec2
  Vec2::init(document.x, document.y)

fn reject_unknown_simulation_version(
  version: i32,
  _document: JsonValue
) -> Result<JsonValue, JsonDecodeError>
  Err<JsonDecodeError> {
    error: JsonDecodeError {
      kind: JsonVersionFailure {},
      path: "$.version",
      message: "unsupported simulation version ".concat(number_cast::to_string(version))
    }
  }

fn schema_error<T>(path: String, message: String) -> Result<T, JsonDecodeError>
  Err<JsonDecodeError> {
    error: JsonDecodeError { kind: JsonSchemaFailure {}, path, message }
  }
