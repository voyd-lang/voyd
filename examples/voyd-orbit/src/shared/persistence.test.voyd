use super::persistence::{
  PersistedSimulation,
  persisted_simulation,
  simulation_from_json,
  simulation_json,
  summaries_from_json,
  summaries_json,
  simulation_summary
}
use super::validation::{ ValidationError, is_hex_color, is_safe_id, validate_simulation }
use src::simulation::default_scenario
use std::json::{ JsonDecodeError, JsonError }
use std::math::abs
use std::result::types::all
use std::string::type::String
use std::test::assertions::all
use std::time::{ SystemTime, TimestampError }

test "versioned simulation JSON round trips shared state":
  let original = example_simulation()
  let encoded = match(simulation_json(original))
    Err<JsonError>:
      String::init()
    Ok<String> { value }:
      value

  match(simulation_from_json(encoded))
    Err<JsonDecodeError>:
      assert(false, eq: true)
    Ok<PersistedSimulation> { value }:
      assert(value.version, eq: 1)
      assert(value.id.equals(original.id), eq: true)
      assert(value.name.equals(original.name), eq: true)
      assert(value.created_at, eq: original.created_at)
      assert(value.state.bodies.len(), eq: original.state.bodies.len())
      assert(abs(value.state.bodies.at(1).position_au.x - original.state.bodies.at(1).position_au.x) < 0.000000000001, eq: true)
      assert(abs(value.state.bodies.at(1).velocity_au_per_day.y - original.state.bodies.at(1).velocity_au_per_day.y) < 0.000000000001, eq: true)
      assert(value.camera.pixels_per_au, eq: original.camera.pixels_per_au)

test "summary list JSON round trips metadata without body payloads":
  let summary = simulation_summary(example_simulation())
  let encoded = match(summaries_json([summary]))
    Err<JsonError>:
      String::init()
    Ok<String> { value }:
      value
  assert(encoded.contains("\"bodyCount\""), eq: true)
  assert(encoded.contains("\"bodies\""), eq: false)

  match(summaries_from_json(encoded))
    Err<JsonDecodeError>:
      assert(false, eq: true)
    Ok { value }:
      assert(value.len(), eq: 1)
      assert(value.at(0).body_count, eq: summary.body_count)
      assert(value.at(0).name.equals(summary.name), eq: true)

test "typed persistence decoding reports nested paths and rejects unknown versions":
  let encoded = match(simulation_json(example_simulation()))
    Err<JsonError>:
      String::init()
    Ok<String> { value }:
      value

  let mistyped = encoded.replaced(
    old: "\"name\":\"Cinder\"",
    with: "\"name\":42",
    max_replacements: 1
  )
  match(simulation_from_json(mistyped))
    Ok<PersistedSimulation>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.bodies[1].name")

  let future = encoded.replaced(
    old: "\"version\":1",
    with: "\"version\":9",
    max_replacements: 1
  )
  match(simulation_from_json(future))
    Ok<PersistedSimulation>:
      assert(false, eq: true)
    Err<JsonDecodeError> { error }:
      assert(error.path, eq: "$.version")

test "saved metadata uses the standard RFC 3339 timestamp surface":
  let summary = simulation_summary(example_simulation())
  match(SystemTime::from_unix_millis(summary.updated_at).to_rfc3339())
    Err<TimestampError>:
      assert(false, eq: true)
    Ok<String> { value }:
      assert(value.equals("2023-11-14T22:13:20.123Z"), eq: true)

test "persistence validation rejects unsafe ids and duplicate body ids":
  assert(is_safe_id("orbit-42"), eq: true)
  assert(is_safe_id("../orbit"), eq: false)
  assert(is_safe_id("nested/orbit"), eq: false)
  assert(is_hex_color("#74e1f8"), eq: true)
  assert(is_hex_color("violet"), eq: false)

  let original = example_simulation()
  let duplicate = {
    version: original.version,
    id: original.id,
    name: original.name,
    created_at: original.created_at,
    updated_at: original.updated_at,
    state: {
      bodies: [original.state.bodies.at(0), original.state.bodies.at(0)],
      settings: original.state.settings,
      elapsed_days: original.state.elapsed_days
    },
    camera: original.camera
  }
  match(validate_simulation(duplicate))
    Ok<Unit>:
      assert(false, eq: true)
    Err<ValidationError> { error }:
      assert(error.code.equals("duplicate-body-id"), eq: true)

fn example_simulation() -> PersistedSimulation
  let scenario = default_scenario()
  persisted_simulation(
    id: "round-trip",
    name: "Round trip system",
    created_at: 1700000000000i64,
    updated_at: 1700000000123i64,
    state: {
      bodies: scenario.bodies,
      settings: scenario.settings,
      elapsed_days: 84.25
    },
    camera: scenario.camera
  )
